index 0000000..d23b23e
--- /dev/null
+++ b/src/Competency.OrgStructure/Import/ImportHeads.cs
@@ -0,0 +1,161 @@
+namespace Competency.OrgStructure.Import;
+
+/// <summary>
+/// A head chosen for a unit of the plan, checked against the plan.
+/// </summary>
+/// <param name="Unit">The unit.</param>
+/// <param name="EmployeeKey">The key of the chosen employee; null for a unit left without a head.</param>
+internal sealed record HeadChoice(UnitNode Unit, string? EmployeeKey);
+
+/// <summary>
+/// Recognises the employees of a file who may head their unit by the name of their position, offers the head step of the preview, and checks the user's choices.
+/// A unit is headed by an employee with any assignment in it, so candidates and choices are read over every placement of the plan.
+/// </summary>
+internal static class ImportHeads
+{
+    /// <summary>
+    /// The words and phrases a head's position name starts with, in the comparison form of <see cref="ImportText.Key"/>.
+    /// </summary>
+    private static readonly string[] HeadPositionStarts =
+    [
+        "руководитель",
+        "директор",
+        "генеральный директор",
+        "вице-президент",
+        "президент",
+        "начальник",
+        "заведующий",
+        "управляющий",
+        "глава",
+    ];
+
+    /// <summary>
+    /// Whether a position name starts with a head word or phrase, ending at a word boundary: "Директор по персоналу" does, "Заместитель директора" and "Директорат" do not.
+    /// </summary>
+    /// <param name="positionName">The position name.</param>
+    /// <returns><see langword="true"/> when an employee in the position is a candidate for the head of their unit.</returns>
+    public static bool IsHeadPosition(string positionName)
+    {
+        var key = ImportText.Key(ImportText.Clean(positionName));
+        return HeadPositionStarts.Any(start =>
+            key.StartsWith(start, StringComparison.Ordinal) && (key.Length == start.Length || !char.IsLetterOrDigit(key[start.Length])));
+    }
+
+    /// <summary>
+    /// Describes the head step: for every unit of the file that has candidates or a head, who may head it and who is suggested.
+    /// </summary>
+    /// <param name="plan">The plan, before it is applied.</param>
+    /// <returns>The units in file order and the employees they refer to.</returns>
+    public static ImportHeadsResponse Describe(ImportPlan plan)
+    {
+        var data = plan.Snapshot;
+        var unitsById = data.Units.ToDictionary(unit => unit.Id);
+        var employeesById = data.Employees.ToDictionary(employee => employee.Id);
+        var placed = plan.Employees
+            .SelectMany(change => change.Placements.Select(placement => (placement.Unit, Change: change)))
+            .Distinct()
+            .ToLookup(pair => pair.Unit, pair => pair.Change);
+        var candidates = plan.Employees
+            .SelectMany(change => change.Placements.Where(placement => IsHeadPosition(placement.Position.Name)).Select(placement => (placement.Unit, Change: change)))
+            .Distinct()
+            .ToLookup(pair => pair.Unit, pair => pair.Change);
+        var units = new List<ImportHeadUnitResponse>();
+        var employees = new List<ImportHeadEmployeeResponse>();
+        var known = new HashSet<string>();
+
+        void Name(string key, string fullName)
+        {
+            if (known.Add(key))
+            {
+                employees.Add(new ImportHeadEmployeeResponse(key, fullName));
+            }
+        }
+
+        foreach (var node in plan.Units)
+        {
+            var head = node.Id is { } unitId && unitsById.TryGetValue(unitId, out var unit) && unit.HeadEmployeeId is { } headId ? employeesById[headId] : null;
+            var found = candidates[node].ToList();
+            if (found.Count == 0 && head is null)
+            {
+                continue;
+            }
+
+            var workers = placed[node].ToList();
+            var stays = head is not null && workers.Any(change => change.Existing?.Id == head.Id);
+            var suggested = stays ? head!.Id.ToString() : found.Count == 1 ? found[0].Key : null;
+            foreach (var change in workers)
+            {
+                Name(change.Key, change.FullName);
+            }
+
+            if (head is not null)
+            {
+                Name(head.Id.ToString(), head.FullName);
+            }
+
+            units.Add(new ImportHeadUnitResponse(
+                node.PathKey,
+                node.PathText,
+                node.Id,
+                head?.Id.ToString(),
+                stays,
+                [.. found.Select(change => change.Key)],
+                [.. workers.Select(change => change.Key)],
+                suggested));
+        }
+
+        return new ImportHeadsResponse(units, employees);
+    }
+
+    /// <summary>
+    /// Checks the user's head choices: each names a unit of the head step once, and an employee who works in the unit after the apply, which is an employee of the file
+    /// with an assignment there or a missing employee of the unit whom the decisions keep.
+    /// </summary>
+    /// <param name="plan">The plan, before it is applied.</param>
+    /// <param name="shown">The plan as the preview shows it.</param>
+    /// <param name="requested">The choices as the request carries them.</param>
+    /// <param name="effective">The decisions about the missing units and employees.</param>
+    /// <param name="choices">The checked choices; empty when the request is invalid.</param>
+    /// <returns>The reason the request is invalid, addressed to the user; <see langword="null"/> when it is valid.</returns>
+    public static string? Resolve(
+        ImportPlan plan,
+        OrgImportPlanResponse shown,
+        IReadOnlyList<ImportHeadDecisionRequest> requested,
+        EffectiveDecisions effective,
+        out IReadOnlyList<HeadChoice> choices)
+    {
+        choices = [];
+        var units = shown.Heads.Units.ToDictionary(unit => unit.Key);
+        var nodes = plan.Units.ToDictionary(node => node.PathKey);
+        var dismissedIds = effective.EmployeesToDismiss.Select(employee => employee.Id).ToHashSet();
+        var kept = shown.MissingEmployees.Where(employee => !dismissedIds.Contains(employee.Id)).ToDictionary(employee => employee.Id.ToString());
+        var seen = new HashSet<string>();
+        var resolved = new List<HeadChoice>();
+        foreach (var request in requested)
+        {
+            if (!units.TryGetValue(request.Unit, out var unit))
+            {
+                return "Решение о руководителе относится к подразделению, которого нет на шаге «Руководители».";
+            }
+
+            if (!seen.Add(request.Unit))
+            {
+                return "Решение о руководителе по одному подразделению указано дважды.";
+            }
+
+            if (request.Employee is { } key && !Works(unit, key, kept))
+            {
+                return $"Руководителем подразделения «{unit.Path}» может быть только сотрудник, который работает в нём после применения.";
+            }
+
+            resolved.Add(new HeadChoice(nodes[request.Unit], request.Employee));
+        }
+
+        choices = resolved;
+        return null;
+    }
+
+    private static bool Works(ImportHeadUnitResponse unit, string employeeKey, IReadOnlyDictionary<string, MissingEmployeeResponse> kept) =>
+        unit.Employees.Contains(employeeKey)
+        || (unit.UnitId is { } unitId && kept.TryGetValue(employeeKey, out var missing) && missing.OrgUnitIds.Contains(unitId));
+}
diff --git a/src/Competency.OrgStructure/Import/ImportPlan.cs b/src/Competency.OrgStructure/Import/ImportPlan.cs
new file mode 100644
index 0000000..91355db
--- /dev/null
+++ b/src/Competency.OrgStructure/Import/ImportPlan.cs
@@ -0,0 +1,206 @@
+namespace Competency.OrgStructure.Import;
+
+/// <summary>
+/// A unit of the file's tree, matched with an existing unit or to be created. Its id is the existing one, or the new one once the apply has created it.
+/// </summary>
+internal sealed class UnitNode
+{
+    private const string PathSeparator = " / ";
+
+    public required string Name { get; init; }
+
+    public required string PathKey { get; init; }
+
+    public UnitNode? Parent { get; init; }
+
+    public Guid? Id { get; set; }
+
+    public bool IsNew { get; init; }
+
+    public bool WasInactive { get; init; }
+
+    /// <summary>
+    /// Whether some row ends in this unit, so that the file states the unit's own position list; a unit that only appears above others keeps its list.
+    /// </summary>
+    public bool IsDeclared { get; set; }
+
+    /// <summary>
+    /// The positions of the rows that end in this unit, which become its own list.
+    /// </summary>
+    public HashSet<PositionRef> Positions { get; } = [];
+
+    public string PathText => Parent is null ? Name : $"{Parent.PathText}{PathSeparator}{Name}";
+}
+
+/// <summary>
+/// A position of the file, matched with a catalogue position or to be created.
+/// </summary>
+internal sealed class PositionRef
+{
+    public required string Name { get; init; }
+
+    public Guid? Id { get; set; }
+
+    public bool IsNew { get; init; }
+
+    public bool WasInactive { get; init; }
+}
+
+/// <summary>
+/// A legal entity of the file, matched with a directory entry or to be created.
+/// </summary>
+internal sealed class LegalEntityRef
+{
+    public required string Name { get; init; }
+
+    public Guid? Id { get; set; }
+
+    public bool IsNew { get; init; }
+}
+
+/// <summary>
+/// A place an employee works at, as the file states it.
+/// </summary>
+/// <param name="Unit">The unit.</param>
+/// <param name="Position">The position.</param>
+internal sealed record Placement(UnitNode Unit, PositionRef Position)
+{
+    public override string ToString() => $"{Unit.PathText}, {Position.Name}";
+
+    public bool Is(Guid unitId, Guid positionId) => Unit.Id == unitId && Position.Id == positionId;
+}
+
+/// <summary>
+/// What the import does to one employee of the file: create them, or bring them to the file's assignments, legal entities and working status.
+/// </summary>
+internal sealed class EmployeeChange
+{
+    public required PersonName Name { get; init; }
+
+    public SnapshotEmployee? Existing { get; init; }
+
+    public required Placement Main { get; init; }
+
+    public required IReadOnlyList<Placement> Secondary { get; init; }
+
+    public required IReadOnlyDictionary<Placement, List<LegalEntityRef>> LegalEntities { get; init; }
+
+    public bool IsRehire { get; init; }
+
+    public bool IsTransfer { get; init; }
+
+    public IReadOnlyList<Placement> AddedAssignments { get; init; } = [];
+
+    public IReadOnlyList<SnapshotAssignment> RemovedAssignments { get; init; } = [];
+
+    public bool MainLegalEntitiesChanged { get; init; }
+
+    public IReadOnlyList<Placement> ChangedAssignmentLegalEntities { get; init; } = [];
+
+    public string FullName => Existing?.FullName ?? string.Join(' ', new[] { Name.LastName, Name.FirstName, Name.MiddleName }.Where(part => part is not null));
+
+    /// <summary>
+    /// The key the head step names the employee by: the identifier of an existing employee, the normalised full name of a new one.
+    /// </summary>
+    public string Key => Existing is null ? Name.Key : Existing.Id.ToString();
+
+    /// <summary>
+    /// Every place the employee works at once the file is applied, the main one first.
+    /// </summary>
+    public IEnumerable<Placement> Placements => Secondary.Prepend(Main);
+
+    public bool HasChanges =>
+        Existing is null || IsRehire || IsTransfer || AddedAssignments.Count > 0 || RemovedAssignments.Count > 0
+        || MainLegalEntitiesChanged || ChangedAssignmentLegalEntities.Count > 0;
+}
+
+/// <summary>
+/// The positions added to and taken off the own list of one unit of the file.
+/// </summary>
+/// <param name="Unit">The unit.</param>
+/// <param name="Added">The positions put on the list.</param>
+/// <param name="RemovedPositionIds">The catalogue positions taken off the list.</param>
+internal sealed record UnitListChange(UnitNode Unit, IReadOnlyList<PositionRef> Added, IReadOnlyList<Guid> RemovedPositionIds);
+
+/// <summary>
+/// Everything an import would do, computed from the file and the organization as it is now: the same value is shown by the preview
+/// and applied by the apply, which computes it again under the tree lock.
+/// </summary>
+internal sealed class ImportPlan
+{
+    public required ImportSnapshot Snapshot { get; init; }
+
+    /// <summary>
+    /// Every unit of the file's tree, each after its parent.
+    /// </summary>
+    public required IReadOnlyList<UnitNode> Units { get; init; }
+
+    public required IReadOnlyList<PositionRef> Positions { get; init; }
+
+    public required IReadOnlyList<LegalEntityRef> LegalEntities { get; init; }
+
+    public required IReadOnlyList<EmployeeChange> Employees { get; init; }
+
+    public required IReadOnlyList<UnitListChange> UnitLists { get; init; }
+
+    public required IReadOnlyList<MissingUnitResponse> MissingUnits { get; init; }
+
+    public required IReadOnlyList<MissingEmployeeResponse> MissingEmployees { get; init; }
+
+    /// <summary>
+    /// The plan as the preview shows it, without the fingerprint.
+    /// </summary>
+    /// <returns>The groups and the lists of missing units and employees, each in a fixed order.</returns>
+    public OrgImportPlanResponse ToResponse()
+    {
+        var unitPaths = Snapshot.UnitPaths;
+        var positionNames = Snapshot.Positions.ToDictionary(position => position.Id, position => position.Name);
+        var changes = Employees.Where(change => change.HasChanges).ToList();
+        var existing = changes.Where(change => change.Existing is not null).ToList();
+
+        string Described(Guid unitId, Guid positionId) => $"{unitPaths[unitId]}, {positionNames[positionId]}";
+
+        return new OrgImportPlanResponse(
+            Fingerprint: string.Empty,
+            NewUnits: Sorted(Units.Where(unit => unit.IsNew).Select(unit => unit.PathText)),
+            ActivatedUnits: Sorted(Units.Where(unit => !unit.IsNew && unit.WasInactive).Select(unit => unit.PathText)),
+            NewPositions: Sorted(Positions.Where(position => position.IsNew).Select(position => position.Name)),
+            ReactivatedPositions: Sorted(Positions.Where(position => position.WasInactive).Select(position => position.Name)),
+            NewLegalEntities: Sorted(LegalEntities.Where(entity => entity.IsNew).Select(entity => entity.Name)),
+            NewEmployees: Sorted(changes.Where(change => change.Existing is null).Select(change => $"{change.FullName}: {change.Main}")),
+            RehiredEmployees: Sorted(existing.Where(change => change.IsRehire).Select(change => change.FullName)),
+            Transfers: Sorted(existing.Where(change => change.IsTransfer).Select(change =>
+                $"{change.FullName}: {Described(change.Existing!.OrgUnitId, change.Existing.PositionId)} → {change.Main}")),
+            AddedAssignments: Sorted(changes.SelectMany(change => change.AddedAssignments.Select(placement => $"{change.FullName}: {placement}"))),
+            RemovedAssignments: Sorted(existing.SelectMany(change => change.RemovedAssignments
+                .Where(assignment => !change.Main.Is(assignment.OrgUnitId, assignment.PositionId))
+                .Select(assignment => $"{change.FullName}: {Described(assignment.OrgUnitId, assignment.PositionId)}"))),
+            ChangedLegalEntities: Sorted(existing.SelectMany(LegalEntityChanges)),
+            UnitPositionsAdded: Sorted(UnitLists.SelectMany(list => list.Added.Select(position => $"{list.Unit.PathText}: {position.Name}"))),
+            UnitPositionsRemoved: Sorted(UnitLists.SelectMany(list => list.RemovedPositionIds.Select(id => $"{list.Unit.PathText}: {positionNames[id]}"))),
+            MissingUnits: MissingUnits,
+            MissingEmployees: MissingEmployees,
+            Heads: ImportHeads.Describe(this));
+    }
+
+    private static IReadOnlyList<string> Sorted(IEnumerable<string> lines) => [.. lines.Order(StringComparer.Ordinal)];
+
+    private IEnumerable<string> LegalEntityChanges(EmployeeChange change)
+    {
+        var current = Snapshot.LegalEntities.ToDictionary(entity => entity.Id, entity => entity.Name);
+        string Names(IEnumerable<string> names) => names.Any() ? string.Join(", ", names.Order(StringComparer.Ordinal)) : "нет";
+        string Line(Placement placement, IEnumerable<Guid> was) =>
+            $"{change.FullName}, {placement}: {Names(was.Select(id => current[id]))} → {Names(change.LegalEntities[placement].Select(entity => entity.Name))}";
+
+        if (change.MainLegalEntitiesChanged)
+        {
+            yield return Line(change.Main, Snapshot.MainLegalEntityIds[change.Existing!.Id]);
+        }
+
+        foreach (var placement in change.ChangedAssignmentLegalEntities)
+        {
+            var assignment = Snapshot.AssignmentsByEmployee[change.Existing!.Id].Single(candidate => placement.Is(candidate.OrgUnitId, candidate.PositionId));
+            yield return Line(placement, Snapshot.AssignmentLegalEntityIds[assignment.Id]);
+        }
+    }
+}
diff --git a/src/Competency.OrgStructure/Import/ImportResolver.cs b/src/Competency.OrgStructure/Import/ImportResolver.cs
new file mode 100644
index 0000000..06f6516
--- /dev/null
+++ b/src/Competency.OrgStructure/Import/ImportResolver.cs
@@ -0,0 +1,122 @@
+namespace Competency.OrgStructure.Import;
+
+/// <summary>
+/// Matches the names of the file with the units, positions and legal entities of the system, creating one node per distinct name or path
+/// and reporting every name the system holds more than once, once at its first use. The comparison key ignores letter case, «ё» versus «е» and spacing.
+/// A unit is matched by its path from the root, so units of one name under different parents stay apart.
+/// </summary>
+internal sealed class ImportResolver
+{
+    private const char PathKeySeparator = '\u001F';
+
+    private readonly List<ImportError> errors;
+    private readonly ILookup<(Guid? ParentId, string Key), SnapshotUnit> systemUnits;
+    private readonly ILookup<string, SnapshotPosition> systemPositions;
+    private readonly ILookup<string, SnapshotLegalEntity> systemLegalEntities;
+    private readonly Dictionary<string, UnitNode> units = [];
+    private readonly Dictionary<string, PositionRef> positions = [];
+    private readonly Dictionary<string, LegalEntityRef> legalEntities = [];
+
+    public ImportResolver(ImportSnapshot data, List<ImportError> errors)
+    {
+        this.errors = errors;
+        systemUnits = data.Units.ToLookup(unit => (unit.ParentId, ImportText.Key(ImportText.Clean(unit.Name))));
+        systemPositions = data.Positions.ToLookup(position => ImportText.Key(ImportText.Clean(position.Name)));
+        systemLegalEntities = data.LegalEntities.ToLookup(entity => ImportText.Key(ImportText.Clean(entity.Name)));
+    }
+
+    /// <summary>
+    /// Every unit of the file's tree in the order met, each after its parent.
+    /// </summary>
+    public List<UnitNode> Units { get; } = [];
+
+    public List<PositionRef> Positions { get; } = [];
+
+    public List<LegalEntityRef> LegalEntities { get; } = [];
+
+    /// <summary>
+    /// Finds or creates the nodes of the row's path and returns the last one, the unit the row is about.
+    /// </summary>
+    /// <param name="row">The row.</param>
+    /// <returns>The unit node.</returns>
+    public UnitNode Unit(ImportRow row)
+    {
+        UnitNode? parent = null;
+        foreach (var step in row.Path)
+        {
+            var key = parent is null ? ImportText.Key(step.Name) : parent.PathKey + PathKeySeparator + ImportText.Key(step.Name);
+            if (!units.TryGetValue(key, out var node))
+            {
+                node = CreateUnit(step, key, parent, row.Number);
+                units[key] = node;
+                Units.Add(node);
+            }
+
+            parent = node;
+        }
+
+        return parent!;
+    }
+
+    public PositionRef Position(string name, ImportRow row)
+    {
+        var key = ImportText.Key(name);
+        if (positions.TryGetValue(key, out var known))
+        {
+            return known;
+        }
+
+        var matches = systemPositions[key].ToList();
+        if (matches.Count > 1)
+        {
+            errors.Add(new ImportError(row.Number, OrgImportParser.PositionColumn, $"В справочнике несколько должностей «{name}», различающихся только регистром или буквой «ё»."));
+        }
+
+        var match = matches.FirstOrDefault();
+        var created = match is null
+            ? new PositionRef { Name = name, IsNew = true }
+            : new PositionRef { Name = match.Name, Id = match.Id, WasInactive = !match.IsActive };
+        positions[key] = created;
+        Positions.Add(created);
+        return created;
+    }
+
+    public LegalEntityRef LegalEntity(string name, ImportRow row)
+    {
+        var key = ImportText.Key(name);
+        if (legalEntities.TryGetValue(key, out var known))
+        {
+            return known;
+        }
+
+        var matches = systemLegalEntities[key].ToList();
+        if (matches.Count > 1)
+        {
+            errors.Add(new ImportError(row.Number, OrgImportParser.LegalEntityColumn, $"В справочнике несколько юридических лиц «{name}», различающихся только регистром или буквой «ё»."));
+        }
+
+        var match = matches.FirstOrDefault();
+        var created = match is null
+            ? new LegalEntityRef { Name = name, IsNew = true }
+            : new LegalEntityRef { Name = match.Name, Id = match.Id };
+        legalEntities[key] = created;
+        LegalEntities.Add(created);
+        return created;
+    }
+
+    private UnitNode CreateUnit(UnitStep step, string key, UnitNode? parent, int rowNumber)
+    {
+        var matches = parent is { IsNew: true }
+            ? []
+            : systemUnits[(parent?.Id, ImportText.Key(step.Name))].ToList();
+        if (matches.Count > 1)
+        {
+            var path = parent is null ? step.Name : $"{parent.PathText} / {step.Name}";
+            errors.Add(new ImportError(rowNumber, OrgImportParser.UnitColumn(step.Level), $"В системе несколько подразделений с путём «{path}»: переименуйте одно из них."));
+        }
+
+        return matches.FirstOrDefault() is { } match
+            ? new UnitNode { Name = match.Name, PathKey = key, Parent = parent, Id = match.Id, WasInactive = !match.IsActive }
+            : new UnitNode { Name = step.Name, PathKey = key, Parent = parent, IsNew = true };
+    }
+}
diff --git a/src/Competency.OrgStructure/Import/ImportSnapshot.cs b/src/Competency.OrgStructure/Import/ImportSnapshot.cs
new file mode 100644
index 0000000..a906610
--- /dev/null
+++ b/src/Competency.OrgStructure/Import/ImportSnapshot.cs
@@ -0,0 +1,130 @@
+using Competency.Platform;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.OrgStructure.Import;
+
+internal sealed record SnapshotUnit(Guid Id, string Name, Guid? ParentId, Guid? HeadEmployeeId, bool IsActive);
+
+internal sealed record SnapshotPosition(Guid Id, string Name, bool IsActive);
+
+internal sealed record SnapshotLegalEntity(Guid Id, string Name);
+
+internal sealed record SnapshotEmployee(Guid Id, string LastName, string FirstName, string? MiddleName, bool IsActive, Guid OrgUnitId, Guid PositionId)
+{
+    public PersonName Name => new(LastName, FirstName, MiddleName);
+
+    public string FullName => string.Join(' ', new[] { LastName, FirstName, MiddleName }.Where(part => part is not null));
+}
+
+internal sealed record SnapshotAssignment(Guid Id, Guid EmployeeId, Guid OrgUnitId, Guid PositionId);
+
+/// <summary>
+/// The part of the organization an import is compared with, read once in a fixed number of queries so that planning a file of any size
+/// neither queries per row nor per employee. Plain values, never tracked.
+/// </summary>
+internal sealed class ImportSnapshot
+{
+    public required IReadOnlyList<SnapshotUnit> Units { get; init; }
+
+    public required IReadOnlyList<SnapshotPosition> Positions { get; init; }
+
+    public required IReadOnlyList<SnapshotLegalEntity> LegalEntities { get; init; }
+
+    public required IReadOnlyList<SnapshotEmployee> Employees { get; init; }
+
+    public required ILookup<Guid, SnapshotAssignment> AssignmentsByEmployee { get; init; }
+
+    /// <summary>
+    /// The positions on each unit's own list.
+    /// </summary>
+    public required ILookup<Guid, Guid> PositionIdsByUnit { get; init; }
+
+    /// <summary>
+    /// The legal entities of each employee's main assignment.
+    /// </summary>
+    public required ILookup<Guid, Guid> MainLegalEntityIds { get; init; }
+
+    /// <summary>
+    /// The legal entities of each secondary assignment, by the assignment.
+    /// </summary>
+    public required ILookup<Guid, Guid> AssignmentLegalEntityIds { get; init; }
+
+    /// <summary>
+    /// The employees an account is bound to.
+    /// </summary>
+    public required IReadOnlySet<Guid> EmployeesWithAccount { get; init; }
+
+    /// <summary>
+    /// The path of every unit from its root, the names joined by a slash.
+    /// </summary>
+    public IReadOnlyDictionary<Guid, string> UnitPaths => paths ??= ComputePaths();
+
+    private Dictionary<Guid, string>? paths;
+
+    /// <summary>
+    /// Reads the snapshot; call it under the tree lock so that it is what the apply then changes.
+    /// </summary>
+    /// <param name="context">The context to query through.</param>
+    /// <param name="cancellationToken">Cancels the queries.</param>
+    /// <returns>The snapshot.</returns>
+    public static async Task<ImportSnapshot> LoadAsync(AppDbContext context, CancellationToken cancellationToken)
+    {
+        var units = await context.Set<OrgUnit>().AsNoTracking()
+            .Select(unit => new SnapshotUnit(unit.Id, unit.Name, unit.ParentId, unit.HeadEmployeeId, unit.IsActive))
+            .ToListAsync(cancellationToken);
+        var positions = await context.Set<Position>().AsNoTracking()
+            .Select(position => new SnapshotPosition(position.Id, position.Name, position.IsActive))
+            .ToListAsync(cancellationToken);
+        var legalEntities = await context.Set<LegalEntity>().AsNoTracking()
+            .Select(entity => new SnapshotLegalEntity(entity.Id, entity.Name))
+            .ToListAsync(cancellationToken);
+        var employees = await context.Set<Employee>().AsNoTracking()
+            .Select(employee => new SnapshotEmployee(employee.Id, employee.LastName, employee.FirstName, employee.MiddleName, employee.IsActive, employee.OrgUnitId, employee.PositionId))
+            .ToListAsync(cancellationToken);
+        var assignments = await context.Set<EmployeeAssignment>().AsNoTracking()
+            .Select(assignment => new SnapshotAssignment(assignment.Id, assignment.EmployeeId, assignment.OrgUnitId, assignment.PositionId))
+            .ToListAsync(cancellationToken);
+        var unitPositions = await context.Set<OrgUnitPosition>().AsNoTracking()
+            .Select(link => new { link.OrgUnitId, link.PositionId })
+            .ToListAsync(cancellationToken);
+        var mainEntities = await context.Set<EmployeeLegalEntity>().AsNoTracking()
+            .Select(link => new { link.EmployeeId, link.LegalEntityId })
+            .ToListAsync(cancellationToken);
+        var assignmentEntities = await context.Set<AssignmentLegalEntity>().AsNoTracking()
+            .Select(link => new { link.AssignmentId, link.LegalEntityId })
+            .ToListAsync(cancellationToken);
+        var accountEmployeeIds = await context.Set<EmployeeAccount>().AsNoTracking()
+            .Select(account => account.EmployeeId)
+            .ToListAsync(cancellationToken);
+
+        return new ImportSnapshot
+        {
+            Units = units,
+            Positions = positions,
+            LegalEntities = legalEntities,
+            Employees = employees,
+            AssignmentsByEmployee = assignments.ToLookup(assignment => assignment.EmployeeId),
+            PositionIdsByUnit = unitPositions.ToLookup(link => link.OrgUnitId, link => link.PositionId),
+            MainLegalEntityIds = mainEntities.ToLookup(link => link.EmployeeId, link => link.LegalEntityId),
+            AssignmentLegalEntityIds = assignmentEntities.ToLookup(link => link.AssignmentId, link => link.LegalEntityId),
+            EmployeesWithAccount = accountEmployeeIds.ToHashSet(),
+        };
+    }
+
+    private Dictionary<Guid, string> ComputePaths()
+    {
+        var byId = Units.ToDictionary(unit => unit.Id);
+        var result = new Dictionary<Guid, string>();
+
+        string PathOf(SnapshotUnit unit) => result.TryGetValue(unit.Id, out var known)
+            ? known
+            : result[unit.Id] = unit.ParentId is { } parentId && byId.TryGetValue(parentId, out var parent) ? $"{PathOf(parent)} / {unit.Name}" : unit.Name;
+
+        foreach (var unit in Units)
+        {
+            PathOf(unit);
+        }
+
+        return result;
+    }
+}
diff --git a/src/Competency.OrgStructure/Import/ImportText.cs b/src/Competency.OrgStructure/Import/ImportText.cs
new file mode 100644
index 0000000..6ad05bb
--- /dev/null
+++ b/src/Competency.OrgStructure/Import/ImportText.cs
@@ -0,0 +1,22 @@
+namespace Competency.OrgStructure.Import;
+
+/// <summary>
+/// The text conventions of the import: how a cell is cleaned and how two names are compared.
+/// </summary>
+internal static class ImportText
+{
+    /// <summary>
+    /// Trims the value and collapses every run of whitespace into one space, the form in which names are stored.
+    /// </summary>
+    /// <param name="value">The raw cell text, possibly absent.</param>
+    /// <returns>The cleaned text; empty when there is nothing but whitespace.</returns>
+    public static string Clean(string? value) =>
+        value is null ? string.Empty : string.Join(' ', value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
+
+    /// <summary>
+    /// The comparison key of a cleaned name: lower case, with the letter «ё» equal to «е».
+    /// </summary>
+    /// <param name="cleaned">The name as <see cref="Clean"/> returned it.</param>
+    /// <returns>The key.</returns>
+    public static string Key(string cleaned) => cleaned.ToLowerInvariant().Replace('ё', 'е');
+}
diff --git a/src/Competency.OrgStructure/Import/OrgImportApplier.cs b/src/Competency.OrgStructure/Import/OrgImportApplier.cs
new file mode 100644
index 0000000..dd68ff2
--- /dev/null
+++ b/src/Competency.OrgStructure/Import/OrgImportApplier.cs
@@ -0,0 +1,255 @@
+using Competency.Platform;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.OrgStructure.Import;
+
+/// <summary>
+/// Applies an import plan on the context, in the order the rules need: positions, units from the top down, units' position lists,
+/// employees, dismissals with their cascade, deactivations, and last the heads. The caller runs it in its transaction under the tree lock, so everything is applied or nothing.
+/// The plan guarantees what the manual rules check one by one: every unit and position it uses is active, and every position of a row is on the list of the row's unit.
+/// </summary>
+internal sealed class OrgImportApplier(AppDbContext context, IEmployeeAccounts accounts, IHrAssignments hrAssignments)
+{
+    private readonly Dictionary<string, Guid> createdEmployeeIds = [];
+
+    /// <summary>
+    /// Saves the plan and the decisions, then tracks the chosen heads for the caller to save. The heads wait for a save of their own because a unit
+    /// the import creates and its head, an employee the import creates, refer to each other, and one save cannot insert two rows that need each other first.
+    /// </summary>
+    /// <param name="plan">The plan, computed under the same lock.</param>
+    /// <param name="decisions">The decisions, already checked against the rules.</param>
+    /// <param name="heads">The chosen heads, already checked against the plan.</param>
+    /// <param name="cancellationToken">Cancels the queries.</param>
+    /// <returns>The number of units whose head becomes another employee than before.</returns>
+    public async Task<int> ApplyAsync(ImportPlan plan, EffectiveDecisions decisions, IReadOnlyList<HeadChoice> heads, CancellationToken cancellationToken)
+    {
+        context.ChangeTracker.AutoDetectChangesEnabled = false;
+        await AddPositionsAsync(plan, cancellationToken);
+        await AddUnitsAsync(plan, cancellationToken);
+        AddLegalEntities(plan);
+        ChangeUnitLists(plan);
+        await ChangeEmployeesAsync(plan, cancellationToken);
+        await DismissAsync(decisions.EmployeesToDismiss, cancellationToken);
+        await DeactivateAsync(decisions.UnitsToDeactivate, cancellationToken);
+        context.ChangeTracker.AutoDetectChangesEnabled = true;
+        await context.SaveChangesAsync(cancellationToken);
+        context.ChangeTracker.Clear();
+        return await AssignHeadsAsync(heads, cancellationToken);
+    }
+
+    private async Task AddPositionsAsync(ImportPlan plan, CancellationToken cancellationToken)
+    {
+        var created = plan.Positions.Where(position => position.IsNew).Select(position => (Ref: position, Entity: new Position { Name = position.Name })).ToList();
+        context.AddRange(created.Select(pair => pair.Entity));
+        foreach (var (position, entity) in created)
+        {
+            position.Id = entity.Id;
+        }
+
+        var reactivatedIds = plan.Positions.Where(position => position.WasInactive).Select(position => position.Id!.Value).ToArray();
+        foreach (var position in await context.Set<Position>().Where(candidate => reactivatedIds.Contains(candidate.Id)).ToListAsync(cancellationToken))
+        {
+            position.IsActive = true;
+        }
+    }
+
+    private async Task AddUnitsAsync(ImportPlan plan, CancellationToken cancellationToken)
+    {
+        foreach (var node in plan.Units.Where(node => node.IsNew))
+        {
+            var unit = new OrgUnit { Name = node.Name, ParentId = node.Parent?.Id };
+            context.Add(unit);
+            node.Id = unit.Id;
+        }
+
+        var activatedIds = plan.Units.Where(node => node.WasInactive).Select(node => node.Id!.Value).ToArray();
+        foreach (var unit in await context.Set<OrgUnit>().Where(candidate => activatedIds.Contains(candidate.Id)).ToListAsync(cancellationToken))
+        {
+            unit.IsActive = true;
+        }
+    }
+
+    private void AddLegalEntities(ImportPlan plan)
+    {
+        var created = plan.LegalEntities.Where(entity => entity.IsNew).Select(entity => (Ref: entity, Entity: new LegalEntity { Name = entity.Name })).ToList();
+        context.AddRange(created.Select(pair => pair.Entity));
+        foreach (var (entity, row) in created)
+        {
+            entity.Id = row.Id;
+        }
+    }
+
+    private void ChangeUnitLists(ImportPlan plan)
+    {
+        foreach (var list in plan.UnitLists)
+        {
+            var unitId = list.Unit.Id!.Value;
+            context.AddRange(list.Added.Select(position => new OrgUnitPosition { OrgUnitId = unitId, PositionId = position.Id!.Value }));
+            context.RemoveRange(list.RemovedPositionIds.Select(positionId => new OrgUnitPosition { OrgUnitId = unitId, PositionId = positionId }));
+        }
+    }
+
+    private async Task ChangeEmployeesAsync(ImportPlan plan, CancellationToken cancellationToken)
+    {
+        foreach (var change in plan.Employees.Where(change => change.Existing is null))
+        {
+            AddEmployee(change);
+        }
+
+        var existing = plan.Employees.Where(change => change.Existing is not null && change.HasChanges).ToList();
+        if (existing.Count == 0)
+        {
+            return;
+        }
+
+        var ids = existing.Select(change => change.Existing!.Id).ToArray();
+        var employees = await context.Set<Employee>().Where(employee => ids.Contains(employee.Id)).ToDictionaryAsync(employee => employee.Id, cancellationToken);
+        var assignments = (await context.Set<EmployeeAssignment>().Include(assignment => assignment.LegalEntities)
+            .Where(assignment => ids.Contains(assignment.EmployeeId)).ToListAsync(cancellationToken)).ToLookup(assignment => assignment.EmployeeId);
+        var mainLinks = (await context.Set<EmployeeLegalEntity>().Where(link => ids.Contains(link.EmployeeId)).ToListAsync(cancellationToken)).ToLookup(link => link.EmployeeId);
+        var headedUnits = (await context.Set<OrgUnit>().Where(unit => unit.HeadEmployeeId != null && ids.Contains(unit.HeadEmployeeId.Value)).ToListAsync(cancellationToken))
+            .ToLookup(unit => unit.HeadEmployeeId!.Value);
+
+        foreach (var change in existing)
+        {
+            var employee = employees[change.Existing!.Id];
+            ChangeEmployee(change, employee, assignments[employee.Id].ToList(), mainLinks[employee.Id].ToList(), headedUnits[employee.Id]);
+            context.Entry(employee).Property(nameof(IVersioned.Version)).IsModified = true;
+        }
+    }
+
+    private void AddEmployee(EmployeeChange change)
+    {
+        var employee = new Employee
+        {
+            LastName = change.Name.LastName,
+            FirstName = change.Name.FirstName,
+            MiddleName = change.Name.MiddleName,
+            OrgUnitId = change.Main.Unit.Id!.Value,
+            PositionId = change.Main.Position.Id!.Value,
+        };
+        context.Add(employee);
+        createdEmployeeIds[change.Key] = employee.Id;
+        context.AddRange(DistinctIds(change.LegalEntities[change.Main]).Select(id => new EmployeeLegalEntity { EmployeeId = employee.Id, LegalEntityId = id }));
+        foreach (var placement in change.Secondary)
+        {
+            context.Add(NewAssignment(employee.Id, placement, change));
+        }
+    }
+
+    private void ChangeEmployee(
+        EmployeeChange change,
+        Employee employee,
+        List<EmployeeAssignment> assignments,
+        List<EmployeeLegalEntity> mainLinks,
+        IEnumerable<OrgUnit> headedUnits)
+    {
+        if (change.IsRehire)
+        {
+            employee.IsActive = true;
+        }
+
+        var remainingUnitIds = change.Placements.Select(placement => placement.Unit.Id!.Value).ToHashSet();
+        foreach (var unit in headedUnits.Where(unit => !remainingUnitIds.Contains(unit.Id)))
+        {
+            unit.HeadEmployeeId = null;
+        }
+
+        if (change.IsTransfer)
+        {
+            employee.OrgUnitId = change.Main.Unit.Id!.Value;
+            employee.PositionId = change.Main.Position.Id!.Value;
+        }
+
+        var removedIds = change.RemovedAssignments.Select(assignment => assignment.Id).ToHashSet();
+        context.RemoveRange(assignments.Where(assignment => removedIds.Contains(assignment.Id)));
+        foreach (var placement in change.AddedAssignments)
+        {
+            context.Add(NewAssignment(employee.Id, placement, change));
+        }
+
+        foreach (var placement in change.ChangedAssignmentLegalEntities)
+        {
+            var assignment = assignments.Single(candidate => placement.Is(candidate.OrgUnitId, candidate.PositionId));
+            var wanted = DistinctIds(change.LegalEntities[placement]);
+            context.RemoveRange(assignment.LegalEntities.Where(link => !wanted.Contains(link.LegalEntityId)));
+            context.AddRange(wanted
+                .Where(id => assignment.LegalEntities.All(link => link.LegalEntityId != id))
+                .Select(id => new AssignmentLegalEntity { AssignmentId = assignment.Id, LegalEntityId = id }));
+        }
+
+        if (change.MainLegalEntitiesChanged)
+        {
+            var wanted = DistinctIds(change.LegalEntities[change.Main]);
+            context.RemoveRange(mainLinks.Where(link => !wanted.Contains(link.LegalEntityId)));
+            context.AddRange(wanted
+                .Where(id => mainLinks.All(link => link.LegalEntityId != id))
+                .Select(id => new EmployeeLegalEntity { EmployeeId = employee.Id, LegalEntityId = id }));
+        }
+    }
+
+    private static EmployeeAssignment NewAssignment(Guid employeeId, Placement placement, EmployeeChange change)
+    {
+        var assignment = new EmployeeAssignment { EmployeeId = employeeId, OrgUnitId = placement.Unit.Id!.Value, PositionId = placement.Position.Id!.Value };
+        assignment.LegalEntities.AddRange(DistinctIds(change.LegalEntities[placement]).Select(id => new AssignmentLegalEntity { LegalEntityId = id }));
+        return assignment;
+    }
+
+    private static HashSet<Guid> DistinctIds(IEnumerable<LegalEntityRef> entities) => [.. entities.Select(entity => entity.Id!.Value)];
+
+    /// <summary>
+    /// Dismisses the employees with the cascade of a manual dismissal, computing each impact on its own: about 2.5 ms an employee, so 9 000 dismissals take about 25 s;
+    /// a set-based impact is the upgrade path when imports dismiss far more than that.
+    /// </summary>
+    private async Task DismissAsync(IReadOnlyList<MissingEmployeeResponse> dismissed, CancellationToken cancellationToken)
+    {
+        var ids = dismissed.Select(employee => employee.Id).ToArray();
+        foreach (var employee in await context.Set<Employee>().Where(candidate => ids.Contains(candidate.Id)).ToListAsync(cancellationToken))
+        {
+            var impact = await EmployeeImpact.OfAsync(context, accounts, hrAssignments, employee.Id, cancellationToken);
+            await impact.ApplyAsync(employee.Id, accounts, hrAssignments, unbindAccount: false, cancellationToken);
+            employee.IsActive = false;
+        }
+    }
+
+    /// <summary>
+    /// Sets the chosen head of each unit on the saved units, so that a unit whose head is already the chosen one stays untouched, unversioned and unjournaled.
+    /// </summary>
+    private async Task<int> AssignHeadsAsync(IReadOnlyList<HeadChoice> heads, CancellationToken cancellationToken)
+    {
+        var unitIds = heads.Select(choice => choice.Unit.Id!.Value).ToArray();
+        var units = await context.Set<OrgUnit>().Where(candidate => unitIds.Contains(candidate.Id)).ToDictionaryAsync(candidate => candidate.Id, cancellationToken);
+        var assigned = 0;
+        foreach (var choice in heads)
+        {
+            var unit = units[choice.Unit.Id!.Value];
+            var headId = choice.EmployeeKey is { } key ? EmployeeIdOf(key) : (Guid?)null;
+            if (unit.HeadEmployeeId == headId)
+            {
+                continue;
+            }
+
+            unit.HeadEmployeeId = headId;
+            if (headId is not null)
+            {
+                assigned++;
+            }
+        }
+
+        return assigned;
+    }
+
+    /// <summary>
+    /// The identifier behind an employee key: the one given to an employee the import created, else the key is the identifier of an existing employee.
+    /// </summary>
+    private Guid EmployeeIdOf(string key) => createdEmployeeIds.TryGetValue(key, out var createdId) ? createdId : Guid.Parse(key);
+
+    private async Task DeactivateAsync(IReadOnlyList<MissingUnitResponse> deactivated, CancellationToken cancellationToken)
+    {
+        var ids = deactivated.Select(unit => unit.Id).ToArray();
+        foreach (var unit in await context.Set<OrgUnit>().Where(candidate => ids.Contains(candidate.Id)).ToListAsync(cancellationToken))
+        {
+            unit.IsActive = false;
+        }
+    }
+}
diff --git a/src/Competency.OrgStructure/Import/OrgImportEndpoints.cs b/src/Competency.OrgStructure/Import/OrgImportEndpoints.cs
new file mode 100644
index 0000000..c1dee52
--- /dev/null
+++ b/src/Competency.OrgStructure/Import/OrgImportEndpoints.cs
@@ -0,0 +1,200 @@
+using System.Text.Json;
+using Competency.Platform;
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Http.HttpResults;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.Routing;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.OrgStructure.Import;
+
+/// <summary>
+/// The organization import API for global administrators and HR: a stateless preview of what a workbook would change, and an apply that reads the same workbook
+/// again under the tree lock and applies exactly the previewed plan, or nothing. Antiforgery is off because the platform's cross-site check rejects any
+/// cross-site state-changing request whatever its content type; the body limit is raised for these two endpoints alone.
+/// </summary>
+internal static class OrgImportEndpoints
+{
+    public const string PlanChangedCode = "planChanged";
+
+    private const string Route = "/api/v1/org-import";
+    private const string Tag = "OrgImport";
+    private const long MaxBodyBytes = 50L * 1024 * 1024;
+    private const int MaxFileNameLength = 255;
+    private const string AppliedAction = "OrgImport.Applied";
+    private const string AuditEntityType = "OrgImport";
+    private const string ApplyDescription =
+        "Form fields: file, the fingerprint of the previewed plan, optional decisions, a JSON array of { id, decision } where decision is keep, "
+        + "deactivate (a unit) or dismiss (an employee); a missing unit or employee without a decision is deactivated or dismissed; and optional heads, "
+        + "a JSON array of { unit, employee } with the unit key and the employee key of the preview's heads group, or null as the employee for no head. "
+        + "A missing employee the decisions keep may be chosen by their identifier. A unit without a head choice keeps its head if the employee still works in it, "
+        + "else it is left without a head; the choice is applied after the employees and dismissals, and a choice that names an employee who does not work in the unit is a 400. "
+        + "A 409 whose code is planChanged means the file or the organization no longer give the previewed plan.";
+    private const string PlanChangedMessage = "План изменился после предпросмотра: файл или оргструктура другие. Пересчитайте предпросмотр.";
+    private static readonly JsonSerializerOptions WebJson = new(JsonSerializerDefaults.Web)
+    {
+        RespectNullableAnnotations = true,
+        RespectRequiredConstructorParameters = true,
+    };
+
+    public static void Map(IEndpointRouteBuilder endpoints)
+    {
+        var keepers = endpoints.MapGroup(Route)
+            .WithTags(Tag)
+            .RequireAuthorization(AuthorizationPolicies.GlobalAdminOrHr)
+            .DisableAntiforgery()
+            .WithMetadata(new RequestSizeLimitAttribute(MaxBodyBytes))
+            .ProducesProblem(StatusCodes.Status401Unauthorized)
+            .ProducesProblem(StatusCodes.Status403Forbidden);
+
+        keepers.MapPost("/preview", PreviewAsync).WithName("PreviewOrgImport");
+        keepers.MapPost("/apply", ApplyAsync).WithName("ApplyOrgImport")
+            .WithDescription(ApplyDescription)
+            .ProducesProblem(StatusCodes.Status409Conflict);
+    }
+
+    /// <summary>
+    /// Reads the workbook and plans it against the organization, changing nothing. An unusable workbook is a normal outcome, reported as the full list of errors.
+    /// </summary>
+    private static async Task<Ok<OrgImportPreviewResponse>> PreviewAsync(
+        IFormFile file,
+        AppDbContext context,
+        IEmployeeAccounts accounts,
+        CancellationToken cancellationToken)
+    {
+        var content = await ReadAsync(file, cancellationToken);
+        var parsed = OrgImportParser.Parse(content);
+        if (parsed.Errors.Count > 0)
+        {
+            return TypedResults.Ok(Failed(parsed.Errors));
+        }
+
+        await using var transaction = await context.BeginSharedAsync(cancellationToken);
+        var outcome = await OrgImportPlanner.PlanAsync(parsed.Rows, await ImportSnapshot.LoadAsync(context, cancellationToken), accounts, cancellationToken);
+        if (outcome.Plan is not { } plan)
+        {
+            return TypedResults.Ok(Failed(outcome.Errors));
+        }
+
+        var shown = plan.ToResponse();
+        return TypedResults.Ok(new OrgImportPreviewResponse([], shown with { Fingerprint = OrgImportPlanner.Fingerprint(content, shown) }));
+    }
+
+    /// <summary>
+    /// Applies the plan of the workbook in one transaction under the tree lock. It plans again with the code of the preview and refuses with 409 unless the fingerprint
+    /// equals the one the preview gave; a decision about an entity the plan does not list is a 400, and a decision that would break a rule of the organization is a 409
+    /// with the reason. Missing units and employees without a decision are deactivated and dismissed. The decisions are a JSON array of <c>{ id, decision }</c>,
+    /// the head choices a JSON array of <c>{ unit, employee }</c>; a choice naming an employee who does not work in the unit after the apply is a 400.
+    /// </summary>
+    private static async Task<Results<Ok<OrgImportResultResponse>, ValidationProblem, ProblemHttpResult>> ApplyAsync(
+        IFormFile file,
+        [FromForm] string fingerprint,
+        [FromForm] string? decisions,
+        [FromForm] string? heads,
+        AppDbContext context,
+        IEmployeeAccounts accounts,
+        IHrAssignments hrAssignments,
+        IAuditWriter audit,
+        CancellationToken cancellationToken)
+    {
+        if (!TryReadList<ImportDecisionRequest>(decisions, out var requested))
+        {
+            return Rejection.Invalid("decisions", "Решения переданы в неверном формате.");
+        }
+
+        if (!TryReadList<ImportHeadDecisionRequest>(heads, out var requestedHeads))
+        {
+            return Rejection.Invalid("heads", "Выбор руководителей передан в неверном формате.");
+        }
+
+        var content = await ReadAsync(file, cancellationToken);
+        var parsed = OrgImportParser.Parse(content);
+        if (parsed.Errors.Count > 0)
+        {
+            return PlanChanged();
+        }
+
+        await using var transaction = await context.BeginExclusiveAsync(cancellationToken);
+        var data = await ImportSnapshot.LoadAsync(context, cancellationToken);
+        var outcome = await OrgImportPlanner.PlanAsync(parsed.Rows, data, accounts, cancellationToken);
+        if (outcome.Plan is not { } plan)
+        {
+            return PlanChanged();
+        }
+
+        var shown = plan.ToResponse();
+        if (OrgImportPlanner.Fingerprint(content, shown) != fingerprint)
+        {
+            return PlanChanged();
+        }
+
+        if (ImportDecisions.Resolve(shown, requested, out var effective) is { } invalid)
+        {
+            return Rejection.Invalid("decisions", invalid);
+        }
+
+        if (ImportHeads.Resolve(plan, shown, requestedHeads, effective, out var chosenHeads) is { } invalidHeads)
+        {
+            return Rejection.Invalid("heads", invalidHeads);
+        }
+
+        if (await ImportDecisions.BrokenRuleAsync(shown, effective, data, accounts, cancellationToken) is { } broken)
+        {
+            return Rejection.Conflict(broken);
+        }
+
+        var assignedHeads = await new OrgImportApplier(context, accounts, hrAssignments).ApplyAsync(plan, effective, chosenHeads, cancellationToken);
+
+        var result = OrgImportResultResponse.From(shown, effective.UnitsToDeactivate.Count, effective.EmployeesToDismiss.Count, assignedHeads);
+        audit.Stage(new AuditEntry(AppliedAction, AuditEntityType, NewValue: AppliedValue(file.FileName, result)), context);
+        await context.SaveChangesAsync(cancellationToken);
+        await transaction.CommitAsync(cancellationToken);
+        return TypedResults.Ok(result);
+    }
+
+    private static OrgImportPreviewResponse Failed(IReadOnlyList<ImportError> errors) =>
+        new([.. errors.Select(ImportErrorResponse.From)], null);
+
+    private static async Task<byte[]> ReadAsync(IFormFile file, CancellationToken cancellationToken)
+    {
+        var content = new byte[file.Length];
+        await using var stream = file.OpenReadStream();
+        await stream.ReadExactlyAsync(content, cancellationToken);
+        return content;
+    }
+
+    private static bool TryReadList<T>(string? json, out IReadOnlyList<T> requested)
+    {
+        requested = [];
+        if (string.IsNullOrWhiteSpace(json))
+        {
+            return true;
+        }
+
+        try
+        {
+            requested = JsonSerializer.Deserialize<List<T>>(json, WebJson) ?? [];
+            return true;
+        }
+        catch (JsonException)
+        {
+            return false;
+        }
+    }
+
+    private static ProblemHttpResult PlanChanged() =>
+        TypedResults.Problem(new ProblemDetails
+        {
+            Status = StatusCodes.Status409Conflict,
+            Title = Rejection.ConflictTitle,
+            Detail = PlanChangedMessage,
+            Extensions = { ["code"] = PlanChangedCode },
+        });
+
+    private static string AppliedValue(string fileName, OrgImportResultResponse counts)
+    {
+        var name = Path.GetFileName(fileName);
+        return JsonSerializer.Serialize(new { fileName = name.Length > MaxFileNameLength ? name[..MaxFileNameLength] : name, counts }, WebJson);
+    }
+}
diff --git a/src/Competency.OrgStructure/Import/OrgImportParser.cs b/src/Competency.OrgStructure/Import/OrgImportParser.cs
new file mode 100644
index 0000000..f776717
--- /dev/null
+++ b/src/Competency.OrgStructure/Import/OrgImportParser.cs
@@ -0,0 +1,275 @@
+using System.Globalization;
+using System.Text.RegularExpressions;
+using ClosedXML.Excel;
+
+namespace Competency.OrgStructure.Import;
+
+/// <summary>
+/// One level of a unit path: the cleaned name and the number of the level column it stood in.
+/// </summary>
+/// <param name="Name">The cleaned unit name.</param>
+/// <param name="Level">The level number of the column, counting from 1.</param>
+internal sealed record UnitStep(string Name, int Level);
+
+/// <summary>
+/// The parts of an employee's full name as the file gives them.
+/// </summary>
+/// <param name="LastName">The first word.</param>
+/// <param name="FirstName">The second word.</param>
+/// <param name="MiddleName">The remaining words; <see langword="null"/> when there are none.</param>
+internal sealed record PersonName(string LastName, string FirstName, string? MiddleName)
+{
+    /// <summary>
+    /// The comparison key of the whole name, equal for names that differ only in letter case, «ё» versus «е» and spacing.
+    /// </summary>
+    public string Key => ImportText.Key(string.Join(' ', new[] { LastName, FirstName, MiddleName }.Where(part => part is not null)));
+}
+
+/// <summary>
+/// One recognised row of the file.
+/// </summary>
+/// <param name="Number">The row number in the sheet.</param>
+/// <param name="Path">The unit path from the root, the empty levels skipped; never empty.</param>
+/// <param name="Person">The employee of the row; <see langword="null"/> for a row that declares a unit or a position of a unit.</param>
+/// <param name="Position">The cleaned position name, if the row has one.</param>
+/// <param name="LegalEntity">The cleaned legal entity name of an employee row, if it has one.</param>
+internal sealed record ImportRow(int Number, IReadOnlyList<UnitStep> Path, PersonName? Person, string? Position, string? LegalEntity);
+
+/// <summary>
+/// A problem that makes the file unusable, located as far as it can be.
+/// </summary>
+/// <param name="Row">The row number; <see langword="null"/> for a problem of the file or of the data as a whole.</param>
+/// <param name="Column">The column name; <see langword="null"/> when no single column is at fault.</param>
+/// <param name="Message">The reason, addressed to the user.</param>
+internal sealed record ImportError(int? Row, string? Column, string Message);
+
+/// <summary>
+/// The result of reading a file: the rows when it is usable, the errors when it is not.
+/// </summary>
+/// <param name="Rows">The recognised rows; empty when there are errors.</param>
+/// <param name="Errors">Every problem found, up to <see cref="OrgImportParser.MaxReportedErrors"/>.</param>
+internal sealed record ParsedImport(IReadOnlyList<ImportRow> Rows, IReadOnlyList<ImportError> Errors);
+
+/// <summary>
+/// Reads the uploaded workbook into rows, checking the container first and every row against the row rules; all or nothing,
+/// with every problem reported. Cells are read as text without formats, and a formula is refused instead of being evaluated.
+/// </summary>
+internal static partial class OrgImportParser
+{
+    public const int MaxReportedErrors = 10_000;
+    public const string UnitColumnPrefix = "Подразделение";
+    public const string FullNameColumn = "ФИО";
+    public const string PositionColumn = "Должность";
+    public const string LegalEntityColumn = "Юридическое лицо";
+
+    private const string SkippedLevel = "-";
+    private const int PersonNameMaxLength = Employee.NameMaxLength;
+    private const int NameMaxLength = OrgUnit.NameMaxLength;
+
+    /// <summary>
+    /// Reads the file. A file the library cannot open for any reason is a recognition error, never an exception.
+    /// </summary>
+    /// <param name="content">The uploaded file.</param>
+    /// <returns>The rows, or the errors.</returns>
+    public static ParsedImport Parse(byte[] content)
+    {
+        if (XlsxArchiveGuard.Problem(content) is { } archiveProblem)
+        {
+            return Failed(new ImportError(null, null, archiveProblem));
+        }
+
+        try
+        {
+            using var workbook = new XLWorkbook(new MemoryStream(content, writable: false));
+            return workbook.Worksheets.FirstOrDefault() is { } sheet
+                ? ReadSheet(sheet)
+                : Failed(new ImportError(null, null, "В книге нет листов."));
+        }
+        catch (Exception exception) when (exception is not OutOfMemoryException)
+        {
+            return Failed(new ImportError(null, null, XlsxArchiveGuard.NotWorkbookMessage));
+        }
+    }
+
+    /// <summary>
+    /// The name of the unit column of a level, as the header spells it.
+    /// </summary>
+    /// <param name="level">The level number, counting from 1.</param>
+    /// <returns>The column name.</returns>
+    public static string UnitColumn(int level) => $"{UnitColumnPrefix} {level.ToString(CultureInfo.InvariantCulture)}-го уровня";
+
+    [GeneratedRegex(@"^подразделение (\d{1,4})-го уровня$")]
+    private static partial Regex UnitColumnPattern();
+
+    private static ParsedImport Failed(params ImportError[] errors) => new([], errors);
+
+    private static ParsedImport ReadSheet(IXLWorksheet sheet)
+    {
+        var rows = sheet.RowsUsed(XLCellsUsedOptions.Contents).ToList();
+        if (rows.Count == 0)
+        {
+            return Failed(new ImportError(null, null, "Лист пуст."));
+        }
+
+        var headerRow = rows[0];
+        var columns = ReadHeader(headerRow, out var headerErrors);
+        if (headerErrors.Count > 0)
+        {
+            return new ParsedImport([], headerErrors);
+        }
+
+        var recognised = new List<ImportRow>();
+        var errors = new List<ImportError>();
+        foreach (var row in rows.Skip(1))
+        {
+            if (errors.Count >= MaxReportedErrors)
+            {
+                errors.Add(new ImportError(null, null, $"Показаны первые {MaxReportedErrors} ошибок: исправьте их и загрузите файл снова."));
+                break;
+            }
+
+            ReadRow(row, columns, recognised, errors);
+        }
+
+        return errors.Count > 0 ? new ParsedImport([], errors) : new ParsedImport(recognised, []);
+    }
+
+    private static HeaderColumns ReadHeader(IXLRow headerRow, out List<ImportError> errors)
+    {
+        errors = [];
+        var number = headerRow.RowNumber();
+        var levels = new SortedDictionary<int, int>();
+        var named = new Dictionary<string, int>();
+        foreach (var cell in headerRow.CellsUsed(XLCellsUsedOptions.Contents))
+        {
+            var key = ImportText.Key(ImportText.Clean(cell.GetString()));
+            var column = cell.Address.ColumnNumber;
+            if (UnitColumnPattern().Match(key) is { Success: true } match)
+            {
+                var level = int.Parse(match.Groups[1].Value, CultureInfo.InvariantCulture);
+                if (!levels.TryAdd(level, column))
+                {
+                    errors.Add(new ImportError(number, UnitColumn(level), "Колонка повторяется."));
+                }
+            }
+            else if (key is not "" && !named.TryAdd(key, column) && IsRequired(key))
+            {
+                errors.Add(new ImportError(number, ImportText.Clean(cell.GetString()), "Колонка повторяется."));
+            }
+        }
+
+        var maxLevel = levels.Count == 0 ? 0 : levels.Keys.Max();
+        var firstMissing = Enumerable.Range(1, Math.Max(maxLevel, 1)).FirstOrDefault(level => !levels.ContainsKey(level));
+        if (firstMissing != 0)
+        {
+            errors.Add(new ImportError(number, UnitColumn(firstMissing), $"В файле нет колонки «{UnitColumn(firstMissing)}»."));
+        }
+
+        var fullName = Required(named, FullNameColumn, number, errors);
+        var position = Required(named, PositionColumn, number, errors);
+        var legalEntity = Required(named, LegalEntityColumn, number, errors);
+        return new HeaderColumns([.. levels.Select(pair => (pair.Key, pair.Value))], fullName, position, legalEntity);
+    }
+
+    private static bool IsRequired(string key) =>
+        key == ImportText.Key(FullNameColumn) || key == ImportText.Key(PositionColumn) || key == ImportText.Key(LegalEntityColumn);
+
+    private static int Required(Dictionary<string, int> named, string column, int headerNumber, List<ImportError> errors)
+    {
+        if (named.TryGetValue(ImportText.Key(column), out var number))
+        {
+            return number;
+        }
+
+        errors.Add(new ImportError(headerNumber, column, $"В файле нет колонки «{column}»."));
+        return 0;
+    }
+
+    private static void ReadRow(IXLRow row, HeaderColumns columns, List<ImportRow> recognised, List<ImportError> errors)
+    {
+        var number = row.RowNumber();
+        var problems = new List<ImportError>();
+        var path = new List<UnitStep>();
+        foreach (var (level, column) in columns.Levels)
+        {
+            var name = Read(row, column, UnitColumn(level), number, problems);
+            if (name is "" or SkippedLevel)
+            {
+                continue;
+            }
+
+            if (name.Length > NameMaxLength)
+            {
+                problems.Add(new ImportError(number, UnitColumn(level), $"Название длиннее {NameMaxLength} символов."));
+            }
+
+            path.Add(new UnitStep(name, level));
+        }
+
+        var fullName = Read(row, columns.FullName, FullNameColumn, number, problems);
+        var position = Read(row, columns.Position, PositionColumn, number, problems);
+        var legalEntity = Read(row, columns.LegalEntity, LegalEntityColumn, number, problems);
+        if (path.Count == 0 && (fullName.Length > 0 || position.Length > 0 || legalEntity.Length > 0 || problems.Count > 0))
+        {
+            problems.Add(new ImportError(number, UnitColumn(columns.Levels[0].Level), "Все колонки подразделений пусты."));
+        }
+
+        var person = fullName.Length > 0 ? ReadPerson(fullName, position, number, problems) : null;
+        CheckLength(position, PositionColumn, NameMaxLength, number, problems);
+        CheckLength(legalEntity, LegalEntityColumn, NameMaxLength, number, problems);
+
+        errors.AddRange(problems);
+        if (problems.Count == 0 && path.Count > 0)
+        {
+            recognised.Add(new ImportRow(number, path, person, position.Length > 0 ? position : null, person is not null && legalEntity.Length > 0 ? legalEntity : null));
+        }
+    }
+
+    private static PersonName? ReadPerson(string fullName, string position, int number, List<ImportError> problems)
+    {
+        if (position.Length == 0)
+        {
+            problems.Add(new ImportError(number, PositionColumn, "У сотрудника не указана должность."));
+        }
+
+        var words = fullName.Split(' ');
+        if (words.Length < 2)
+        {
+            problems.Add(new ImportError(number, FullNameColumn, "ФИО должно содержать фамилию и имя."));
+            return null;
+        }
+
+        var middle = words.Length > 2 ? string.Join(' ', words.Skip(2)) : null;
+        foreach (var (part, label) in new[] { (words[0], "Фамилия"), (words[1], "Имя"), (middle, "Отчество") })
+        {
+            if (part?.Length > PersonNameMaxLength)
+            {
+                problems.Add(new ImportError(number, FullNameColumn, $"{label} длиннее {PersonNameMaxLength} символов."));
+            }
+        }
+
+        return new PersonName(words[0], words[1], middle);
+    }
+
+    private static void CheckLength(string value, string column, int maxLength, int number, List<ImportError> problems)
+    {
+        if (value.Length > maxLength)
+        {
+            problems.Add(new ImportError(number, column, $"Значение длиннее {maxLength} символов."));
+        }
+    }
+
+    private static string Read(IXLRow row, int column, string columnName, int number, List<ImportError> problems)
+    {
+        var cell = row.Cell(column);
+        if (cell.HasFormula)
+        {
+            problems.Add(new ImportError(number, columnName, "Ячейка содержит формулу: замените её значением."));
+            return string.Empty;
+        }
+
+        return ImportText.Clean(cell.GetString());
+    }
+
+    private sealed record HeaderColumns(IReadOnlyList<(int Level, int Column)> Levels, int FullName, int Position, int LegalEntity);
+}
diff --git a/src/Competency.OrgStructure/Import/OrgImportPlanner.cs b/src/Competency.OrgStructure/Import/OrgImportPlanner.cs
new file mode 100644
index 0000000..ed4b04a
--- /dev/null
+++ b/src/Competency.OrgStructure/Import/OrgImportPlanner.cs
@@ -0,0 +1,203 @@
+using System.Security.Cryptography;
+using System.Text.Json;
+
+namespace Competency.OrgStructure.Import;
+
+/// <summary>
+/// The outcome of planning: the plan, or the errors that make the file unusable against the current data.
+/// </summary>
+/// <param name="Plan">The plan; null when there are errors.</param>
+/// <param name="Errors">The problems found; empty when there is a plan.</param>
+internal sealed record PlanOutcome(ImportPlan? Plan, IReadOnlyList<ImportError> Errors);
+
+/// <summary>
+/// Compares the rows of a file with the organization as it is: matches them by name, decides each employee's main and secondary assignments,
+/// and lists what the file does not name. One code for the preview and the apply, so that what is shown is what is applied.
+/// </summary>
+internal static class OrgImportPlanner
+{
+    /// <summary>
+    /// Plans the import.
+    /// </summary>
+    /// <param name="rows">The recognised rows of the file.</param>
+    /// <param name="data">The organization as it is now.</param>
+    /// <param name="accounts">Says which missing employees are the last active administrator.</param>
+    /// <param name="cancellationToken">Cancels the queries.</param>
+    /// <returns>The plan, or the errors.</returns>
+    public static async Task<PlanOutcome> PlanAsync(
+        IReadOnlyList<ImportRow> rows,
+        ImportSnapshot data,
+        IEmployeeAccounts accounts,
+        CancellationToken cancellationToken)
+    {
+        var errors = new List<ImportError>(NamesakeErrors(data));
+        var resolver = new ImportResolver(data, errors);
+        var people = new Dictionary<string, FilePerson>();
+        foreach (var row in rows)
+        {
+            var unit = resolver.Unit(row);
+            unit.IsDeclared = true;
+            var position = row.Position is null ? null : resolver.Position(row.Position, row);
+            if (position is not null)
+            {
+                unit.Positions.Add(position);
+            }
+
+            if (row.Person is { } person)
+            {
+                var key = person.Key;
+                if (!people.TryGetValue(key, out var filePerson))
+                {
+                    people[key] = filePerson = new FilePerson(person);
+                }
+
+                filePerson.Add(new Placement(unit, position!), row.LegalEntity is null ? null : resolver.LegalEntity(row.LegalEntity, row));
+            }
+        }
+
+        if (errors.Count > 0)
+        {
+            return new PlanOutcome(null, errors);
+        }
+
+        var employeesByKey = data.Employees.ToDictionary(employee => employee.Name.Key);
+        var plan = new ImportPlan
+        {
+            Snapshot = data,
+            Units = resolver.Units,
+            Positions = resolver.Positions,
+            LegalEntities = resolver.LegalEntities,
+            Employees = [.. people.Values.Select(person => ChangeOf(person, employeesByKey.GetValueOrDefault(person.Name.Key), data))],
+            UnitLists = [.. resolver.Units.Where(unit => unit.IsDeclared).Select(unit => ListChangeOf(unit, data)).OfType<UnitListChange>()],
+            MissingUnits = MissingUnits(resolver.Units, data),
+            MissingEmployees = await MissingEmployeesAsync(people.Keys.ToHashSet(), data, accounts, cancellationToken),
+        };
+        return new PlanOutcome(plan, []);
+    }
+
+    /// <summary>
+    /// The fingerprint of a plan for a file: a digest of the file's bytes and of the plan in a fixed serialization, equal exactly when
+    /// the same file gives the same plan.
+    /// </summary>
+    /// <param name="content">The uploaded file.</param>
+    /// <param name="plan">The plan as shown, without a fingerprint.</param>
+    /// <returns>The digest in lower-case hexadecimal.</returns>
+    public static string Fingerprint(byte[] content, OrgImportPlanResponse plan)
+    {
+        byte[] material = [.. SHA256.HashData(content), .. JsonSerializer.SerializeToUtf8Bytes(plan with { Fingerprint = string.Empty })];
+        return Convert.ToHexStringLower(SHA256.HashData(material));
+    }
+
+    private static IEnumerable<ImportError> NamesakeErrors(ImportSnapshot data) => data.Employees
+        .GroupBy(employee => employee.Name.Key)
+        .Where(group => group.Count() > 1)
+        .OrderBy(group => group.Key, StringComparer.Ordinal)
+        .Select(group => new ImportError(
+            null,
+            OrgImportParser.FullNameColumn,
+            $"В системе несколько сотрудников с ФИО «{group.First().FullName}» ({group.Count()}): переименуйте одного из них."));
+
+    private static EmployeeChange ChangeOf(FilePerson person, SnapshotEmployee? existing, ImportSnapshot data)
+    {
+        var wanted = person.Placements;
+        var main = existing is null
+            ? wanted[0]
+            : wanted.FirstOrDefault(placement => placement.Is(existing.OrgUnitId, existing.PositionId)) ?? wanted[0];
+        var secondary = wanted.Where(placement => placement != main).ToList();
+        if (existing is null)
+        {
+            return new EmployeeChange { Name = person.Name, Main = main, Secondary = secondary, LegalEntities = person.LegalEntities, AddedAssignments = secondary };
+        }
+
+        var assignments = data.AssignmentsByEmployee[existing.Id].ToList();
+        var kept = secondary
+            .Select(placement => (Placement: placement, Assignment: assignments.FirstOrDefault(assignment => placement.Is(assignment.OrgUnitId, assignment.PositionId))))
+            .ToList();
+        return new EmployeeChange
+        {
+            Name = person.Name,
+            Existing = existing,
+            Main = main,
+            Secondary = secondary,
+            LegalEntities = person.LegalEntities,
+            IsRehire = !existing.IsActive,
+            IsTransfer = !main.Is(existing.OrgUnitId, existing.PositionId),
+            AddedAssignments = [.. kept.Where(pair => pair.Assignment is null).Select(pair => pair.Placement)],
+            RemovedAssignments = [.. assignments.Where(assignment => !secondary.Any(placement => placement.Is(assignment.OrgUnitId, assignment.PositionId)))],
+            MainLegalEntitiesChanged = !SameEntities(person.LegalEntities[main], data.MainLegalEntityIds[existing.Id]),
+            ChangedAssignmentLegalEntities =
+            [
+                .. kept.Where(pair => pair.Assignment is not null
+                    && !SameEntities(person.LegalEntities[pair.Placement], data.AssignmentLegalEntityIds[pair.Assignment.Id]))
+                    .Select(pair => pair.Placement),
+            ],
+        };
+    }
+
+    private static bool SameEntities(IReadOnlyList<LegalEntityRef> wanted, IEnumerable<Guid> current) =>
+        wanted.All(entity => entity.Id is not null) && wanted.Select(entity => entity.Id!.Value).ToHashSet().SetEquals(current);
+
+    private static UnitListChange? ListChangeOf(UnitNode unit, ImportSnapshot data)
+    {
+        var current = unit.IsNew ? [] : data.PositionIdsByUnit[unit.Id!.Value].ToHashSet();
+        var wantedIds = unit.Positions.Where(position => position.Id is not null).Select(position => position.Id!.Value).ToHashSet();
+        var added = unit.Positions.Where(position => position.Id is not { } id || !current.Contains(id)).ToList();
+        var removed = current.Where(id => !wantedIds.Contains(id)).ToList();
+        return added.Count + removed.Count > 0 ? new UnitListChange(unit, added, removed) : null;
+    }
+
+    private static List<MissingUnitResponse> MissingUnits(IReadOnlyList<UnitNode> nodes, ImportSnapshot data)
+    {
+        var named = nodes.Where(node => node.Id is not null).Select(node => node.Id!.Value).ToHashSet();
+        return
+        [
+            .. data.Units
+                .Where(unit => unit.IsActive && !named.Contains(unit.Id))
+                .Select(unit => new MissingUnitResponse(unit.Id, data.UnitPaths[unit.Id], unit.ParentId))
+                .OrderBy(unit => unit.Path, StringComparer.Ordinal)
+                .ThenBy(unit => unit.Id),
+        ];
+    }
+
+    private static async Task<List<MissingEmployeeResponse>> MissingEmployeesAsync(
+        HashSet<string> namedKeys,
+        ImportSnapshot data,
+        IEmployeeAccounts accounts,
+        CancellationToken cancellationToken)
+    {
+        var missing = new List<MissingEmployeeResponse>();
+        foreach (var employee in data.Employees.Where(employee => employee.IsActive && !namedKeys.Contains(employee.Name.Key)))
+        {
+            var isLast = data.EmployeesWithAccount.Contains(employee.Id) && await accounts.IsLastActiveAdministratorAsync(employee.Id, cancellationToken);
+            var unitIds = data.AssignmentsByEmployee[employee.Id].Select(assignment => assignment.OrgUnitId).Prepend(employee.OrgUnitId).Distinct().Order();
+            missing.Add(new MissingEmployeeResponse(employee.Id, employee.FullName, [.. unitIds], isLast));
+        }
+
+        return [.. missing.OrderBy(employee => employee.FullName, StringComparer.Ordinal).ThenBy(employee => employee.Id)];
+    }
+
+    private sealed class FilePerson(PersonName name)
+    {
+        private readonly Dictionary<Placement, List<LegalEntityRef>> legalEntities = [];
+
+        public PersonName Name { get; } = name;
+
+        public List<Placement> Placements { get; } = [];
+
+        public IReadOnlyDictionary<Placement, List<LegalEntityRef>> LegalEntities => legalEntities;
+
+        public void Add(Placement placement, LegalEntityRef? entity)
+        {
+            if (!legalEntities.TryGetValue(placement, out var entities))
+            {
+                legalEntities[placement] = entities = [];
+                Placements.Add(placement);
+            }
+
+            if (entity is not null && !entities.Contains(entity))
+            {
+                entities.Add(entity);
+            }
+        }
+    }
+}
diff --git a/src/Competency.OrgStructure/Import/OrgImportResponses.cs b/src/Competency.OrgStructure/Import/OrgImportResponses.cs
new file mode 100644
index 0000000..63de6a4
--- /dev/null
+++ b/src/Competency.OrgStructure/Import/OrgImportResponses.cs
@@ -0,0 +1,204 @@
+using System.Text.Json.Serialization;
+
+namespace Competency.OrgStructure.Import;
+
+/// <summary>
+/// A problem that makes the file unusable.
+/// </summary>
+/// <param name="Row">The row number in the sheet; null for a problem of the file or of the data as a whole.</param>
+/// <param name="Column">The column name; null when no single column is at fault.</param>
+/// <param name="Message">The reason, addressed to the user.</param>
+internal sealed record ImportErrorResponse(int? Row, string? Column, string Message)
+{
+    public static ImportErrorResponse From(ImportError error) => new(error.Row, error.Column, error.Message);
+}
+
+/// <summary>
+/// An active unit of the system that no path of the file names, for the user to keep or deactivate.
+/// </summary>
+/// <param name="Id">The unit identifier.</param>
+/// <param name="Path">The names from the root to the unit, joined by a slash.</param>
+/// <param name="ParentId">The parent unit; null for a root.</param>
+internal sealed record MissingUnitResponse(Guid Id, string Path, Guid? ParentId);
+
+/// <summary>
+/// A working employee of the system whom the file does not name, for the user to keep or dismiss.
+/// </summary>
+/// <param name="Id">The employee identifier.</param>
+/// <param name="FullName">The employee's full name.</param>
+/// <param name="OrgUnitIds">The units of the employee's main and secondary assignments.</param>
+/// <param name="IsLastActiveAdministrator">Whether the account bound to the employee is the last active global administrator, so that dismissing the employee is refused.</param>
+internal sealed record MissingEmployeeResponse(Guid Id, string FullName, IReadOnlyList<Guid> OrgUnitIds, bool IsLastActiveAdministrator);
+
+/// <summary>
+/// What applying the file would change, by group, and what the file does not name. Every group lists one line per change.
+/// </summary>
+/// <param name="Fingerprint">Identifies this plan for this file; the apply request carries it back, and the apply is refused when the file or the data no longer give the same plan.</param>
+/// <param name="NewUnits">The units to create, by path.</param>
+/// <param name="ActivatedUnits">The inactive units the file names, which become active.</param>
+/// <param name="NewPositions">The positions to add to the catalogue.</param>
+/// <param name="ReactivatedPositions">The inactive catalogue positions the file names, which become active.</param>
+/// <param name="NewLegalEntities">The legal entities to add to the directory.</param>
+/// <param name="NewEmployees">The employees to create, with their main assignment.</param>
+/// <param name="RehiredEmployees">The dismissed employees the file names, who work again.</param>
+/// <param name="Transfers">The employees whose main assignment changes.</param>
+/// <param name="AddedAssignments">The secondary assignments to add.</param>
+/// <param name="RemovedAssignments">The secondary assignments to remove.</param>
+/// <param name="ChangedLegalEntities">The assignments whose legal entities change.</param>
+/// <param name="UnitPositionsAdded">The positions to put on units' own lists.</param>
+/// <param name="UnitPositionsRemoved">The positions to take off units' own lists.</param>
+/// <param name="MissingUnits">The active units the file does not name.</param>
+/// <param name="MissingEmployees">The working employees the file does not name.</param>
+/// <param name="Heads">The units of the file with head candidates or a head, and the employees they refer to.</param>
+internal sealed record OrgImportPlanResponse(
+    string Fingerprint,
+    IReadOnlyList<string> NewUnits,
+    IReadOnlyList<string> ActivatedUnits,
+    IReadOnlyList<string> NewPositions,
+    IReadOnlyList<string> ReactivatedPositions,
+    IReadOnlyList<string> NewLegalEntities,
+    IReadOnlyList<string> NewEmployees,
+    IReadOnlyList<string> RehiredEmployees,
+    IReadOnlyList<string> Transfers,
+    IReadOnlyList<string> AddedAssignments,
+    IReadOnlyList<string> RemovedAssignments,
+    IReadOnlyList<string> ChangedLegalEntities,
+    IReadOnlyList<string> UnitPositionsAdded,
+    IReadOnlyList<string> UnitPositionsRemoved,
+    IReadOnlyList<MissingUnitResponse> MissingUnits,
+    IReadOnlyList<MissingEmployeeResponse> MissingEmployees,
+    ImportHeadsResponse Heads);
+
+/// <summary>
+/// An employee a head step refers to, named once however many units list them.
+/// </summary>
+/// <param name="Key">The employee key: the identifier of an existing employee, or the normalised full name of one the import creates.</param>
+/// <param name="FullName">The employee's full name.</param>
+internal sealed record ImportHeadEmployeeResponse(string Key, string FullName);
+
+/// <summary>
+/// A unit of the file that has head candidates or a head, for the user to choose its head.
+/// </summary>
+/// <param name="Key">The unit key the head decision names; opaque.</param>
+/// <param name="Path">The names from the root to the unit, joined by a slash.</param>
+/// <param name="UnitId">The unit identifier; null for a unit the import creates.</param>
+/// <param name="CurrentHead">The key of the unit's head now; null when it has none.</param>
+/// <param name="CurrentHeadStays">Whether the file keeps the current head working in the unit. False for a head the file does not name, whom the decision about the missing employees may still keep.</param>
+/// <param name="Candidates">The keys of the file's employees in the unit whose position name starts with a head word.</param>
+/// <param name="Employees">The keys of every employee of the file with an assignment in the unit, the main or a secondary one; a missing employee the user keeps is not listed, the missing list names their units.</param>
+/// <param name="Suggested">The key of the default head, ignoring the decisions about missing employees: the current head when the file keeps them in the unit, otherwise the only candidate; null when the unit is left without a head or has several candidates.</param>
+internal sealed record ImportHeadUnitResponse(
+    string Key,
+    string Path,
+    Guid? UnitId,
+    string? CurrentHead,
+    bool CurrentHeadStays,
+    IReadOnlyList<string> Candidates,
+    IReadOnlyList<string> Employees,
+    string? Suggested);
+
+/// <summary>
+/// The head step of the preview.
+/// </summary>
+/// <param name="Units">The units of the file with candidates or a head, in file order.</param>
+/// <param name="Employees">Every employee the units refer to, by key.</param>
+internal sealed record ImportHeadsResponse(IReadOnlyList<ImportHeadUnitResponse> Units, IReadOnlyList<ImportHeadEmployeeResponse> Employees);
+
+/// <summary>
+/// The user's choice of head for one unit of the head step.
+/// </summary>
+/// <param name="Unit">The unit key from the preview.</param>
+/// <param name="Employee">The employee key from the preview, or the identifier of a missing employee the user keeps; null for no head.</param>
+internal sealed record ImportHeadDecisionRequest(string Unit, string? Employee);
+
+/// <summary>
+/// The outcome of reading a file: the errors that make it unusable, or the plan when there are none.
+/// </summary>
+/// <param name="Errors">Every problem found; empty when the file is usable.</param>
+/// <param name="Plan">What applying the file would change; null when there are errors.</param>
+internal sealed record OrgImportPreviewResponse(IReadOnlyList<ImportErrorResponse> Errors, OrgImportPlanResponse? Plan);
+
+/// <summary>
+/// The decision for one entity the file does not name.
+/// </summary>
+/// <param name="Id">The identifier of a missing unit or a missing employee.</param>
+/// <param name="Decision">Keep for either kind, deactivate for a unit, dismiss for an employee.</param>
+internal sealed record ImportDecisionRequest(Guid Id, ImportDecision Decision);
+
+/// <summary>
+/// What the user decides for a unit or an employee the file does not name. Member names are sent in the API.
+/// </summary>
+[JsonConverter(typeof(JsonStringEnumConverter<ImportDecision>))]
+internal enum ImportDecision
+{
+    /// <summary>
+    /// Leave the unit or the employee as they are.
+    /// </summary>
+    Keep,
+
+    /// <summary>
+    /// Deactivate the unit.
+    /// </summary>
+    Deactivate,
+
+    /// <summary>
+    /// Dismiss the employee, with the cascade of a manual dismissal.
+    /// </summary>
+    Dismiss,
+}
+
+/// <summary>
+/// The changes an applied import made, by group.
+/// </summary>
+/// <param name="NewUnits">The units created.</param>
+/// <param name="ActivatedUnits">The units activated.</param>
+/// <param name="NewPositions">The positions added to the catalogue.</param>
+/// <param name="ReactivatedPositions">The positions activated.</param>
+/// <param name="NewLegalEntities">The legal entities added to the directory.</param>
+/// <param name="NewEmployees">The employees created.</param>
+/// <param name="RehiredEmployees">The employees who work again.</param>
+/// <param name="Transfers">The employees whose main assignment changed.</param>
+/// <param name="AddedAssignments">The secondary assignments added.</param>
+/// <param name="RemovedAssignments">The secondary assignments removed.</param>
+/// <param name="ChangedLegalEntities">The assignments whose legal entities changed.</param>
+/// <param name="UnitPositionsAdded">The positions put on units' own lists.</param>
+/// <param name="UnitPositionsRemoved">The positions taken off units' own lists.</param>
+/// <param name="DeactivatedUnits">The units deactivated by decision.</param>
+/// <param name="DismissedEmployees">The employees dismissed by decision.</param>
+/// <param name="AssignedHeads">The units given a head by decision.</param>
+internal sealed record OrgImportResultResponse(
+    int NewUnits,
+    int ActivatedUnits,
