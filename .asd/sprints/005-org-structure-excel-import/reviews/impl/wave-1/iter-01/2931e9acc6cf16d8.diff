diff --git a/web/src/features/org-import/orgImportApi.ts b/web/src/features/org-import/orgImportApi.ts
new file mode 100644
index 0000000..97a143f
--- /dev/null
+++ b/web/src/features/org-import/orgImportApi.ts
@@ -0,0 +1,109 @@
+import { api } from "../../api/client";
+import type { components } from "../../api/schema";
+import { unwrap } from "../../api/unwrap";
+
+/** What reading a file gave: the full list of errors that make it unusable, or the plan when there are none. */
+export type OrgImportPreview =
+  components["schemas"]["OrgImportPreviewResponse"];
+
+/** What applying the file would change, by group, and the units and employees the file does not name. */
+export type OrgImportPlan = components["schemas"]["OrgImportPlanResponse"];
+
+/** The changes an applied import made, by group. */
+export type OrgImportResult = components["schemas"]["OrgImportResultResponse"];
+
+/** One problem of the file; a row or a column is empty when the problem is not about a single one. */
+export type ImportError = components["schemas"]["ImportErrorResponse"];
+
+/** An active unit the file does not name. */
+export type MissingUnit = components["schemas"]["MissingUnitResponse"];
+
+/** A working employee the file does not name. */
+export type MissingEmployee = components["schemas"]["MissingEmployeeResponse"];
+
+/** The decision about one missing unit or employee, as the apply request carries it. */
+export interface ImportDecision {
+  id: string;
+  decision: "keep" | "deactivate" | "dismiss";
+}
+
+/** A unit of the head step: who may head it after the apply and who heads it now. */
+export type ImportHeadUnit = components["schemas"]["ImportHeadUnitResponse"];
+
+/** The head chosen for one unit of the head step, as the apply request carries it; null leaves the unit without a head. */
+export interface ImportHeadDecision {
+  unit: string;
+  employee: string | null;
+}
+
+/**
+ * The apply request: the file and the fingerprint of the plan shown, with a decision for every missing unit and employee
+ * and a head for every unit of the head step.
+ */
+export interface ApplyInput {
+  file: File;
+  fingerprint: string;
+  decisions: readonly ImportDecision[];
+  heads: readonly ImportHeadDecision[];
+}
+
+/** The plan still held and was applied, or it changed and the file was read again: the fresh preview takes its place. */
+export type ApplyOutcome =
+  | { applied: OrgImportResult }
+  | { recomputed: OrgImportPreview };
+
+const PLAN_CHANGED_CODE = "planChanged";
+
+function isPlanChanged(problem: unknown): boolean {
+  return (
+    typeof problem === "object" &&
+    problem !== null &&
+    "code" in problem &&
+    problem.code === PLAN_CHANGED_CODE
+  );
+}
+
+/** The generated client types a file part as a string; the form is built by hand, so the typed body only names the fields. */
+function formOf(fields: Record<string, string | File>): FormData {
+  const form = new FormData();
+  for (const [name, value] of Object.entries(fields)) form.append(name, value);
+  return form;
+}
+
+/** Reads the file and plans it against the organization; the server keeps nothing. */
+export async function previewOrgImport(file: File): Promise<OrgImportPreview> {
+  const form = formOf({ file });
+  return unwrap(
+    await api.POST("/api/v1/org-import/preview", {
+      body: { file: "" },
+      bodySerializer: () => form,
+    }),
+  );
+}
+
+/**
+ * Applies the plan the fingerprint names. When the file or the organization no longer give that plan, the server
+ * refuses with a "plan changed" conflict and the file is previewed again, so the user sees what would apply now; any
+ * other refusal is raised as an `ApiError` with its reason.
+ */
+export async function applyOrgImport({
+  file,
+  fingerprint,
+  decisions,
+  heads,
+}: ApplyInput): Promise<ApplyOutcome> {
+  const form = formOf({
+    file,
+    fingerprint,
+    decisions: JSON.stringify(decisions),
+    heads: JSON.stringify(heads),
+  });
+  const result = await api.POST("/api/v1/org-import/apply", {
+    body: { file: "", fingerprint },
+    bodySerializer: () => form,
+  });
+  if (result.response.status === 409 && isPlanChanged(result.error)) {
+    return { recomputed: await previewOrgImport(file) };
+  }
+  return { applied: unwrap(result) };
+}
diff --git a/web/src/features/org-structure/AssignmentFields.tsx b/web/src/features/org-structure/AssignmentFields.tsx
new file mode 100644
index 0000000..c72910f
--- /dev/null
+++ b/web/src/features/org-structure/AssignmentFields.tsx
@@ -0,0 +1,177 @@
+import { PlusOutlined } from "@ant-design/icons";
+import {
+  Button,
+  Card,
+  ConfigProvider,
+  Flex,
+  Form,
+  Space,
+  Typography,
+} from "antd";
+import { LegalEntitySelect } from "./LegalEntitySelect";
+import { OrgUnitSelect } from "./OrgUnitSelect";
+import type { EmployeeInput, LegalEntity } from "./orgStructureApi";
+import { PositionSelect } from "./PositionSelect";
+
+interface AssignmentFieldsProps {
+  /** The position the employee holds now in a unit, when it is the one chosen there; it stays a choice though the unit's list no longer offers it. */
+  keptPosition: (
+    orgUnitId?: string,
+    positionId?: string,
+  ) => { id: string; name: string } | undefined;
+  /** The legal entities the employee holds now, listed by name wherever the search does not return them. */
+  knownEntities: readonly LegalEntity[];
+  /** Told when an assignment becomes the main one, which changes the form without a field event. */
+  onMadeMain: () => void;
+}
+
+interface AssignmentCardProps
+  extends Pick<AssignmentFieldsProps, "keptPosition" | "knownEntities"> {
+  /** Place of the assignment in the list. */
+  index: number;
+  onRemove: () => void;
+  onMakeMain: () => void;
+}
+
+/** One secondary assignment: its unit, its position from those the unit allows, its legal entities, and the two things that can be done with it. */
+function AssignmentCard({
+  index,
+  keptPosition,
+  knownEntities,
+  onRemove,
+  onMakeMain,
+}: AssignmentCardProps) {
+  const orgUnitId: string | undefined = Form.useWatch([
+    "assignments",
+    index,
+    "orgUnitId",
+  ]);
+  const positionId: string | undefined = Form.useWatch([
+    "assignments",
+    index,
+    "positionId",
+  ]);
+  const label = `Совмещение ${index + 1}`;
+
+  return (
+    <Card
+      size="small"
+      title={label}
+      extra={
+        <Space>
+          <Button
+            type="link"
+            aria-label={`Сделать основным: ${label}`}
+            onClick={onMakeMain}
+          >
+            Сделать основным
+          </Button>
+          <Button
+            type="link"
+            aria-label={`Убрать: ${label}`}
+            onClick={onRemove}
+          >
+            Убрать
+          </Button>
+        </Space>
+      }
+    >
+      <ConfigProvider theme={{ components: { Form: { itemMarginBottom: 0 } } }}>
+        <Flex vertical gap="middle">
+          <Form.Item
+            name={[index, "orgUnitId"]}
+            label="Подразделение"
+            rules={[{ required: true, message: "Выберите подразделение" }]}
+          >
+            <OrgUnitSelect
+              isActiveRequired
+              placeholder="Выберите подразделение"
+            />
+          </Form.Item>
+          <Form.Item
+            name={[index, "positionId"]}
+            label="Должность"
+            rules={[{ required: true, message: "Выберите должность" }]}
+          >
+            <PositionSelect
+              orgUnitId={orgUnitId}
+              current={keptPosition(orgUnitId, positionId)}
+            />
+          </Form.Item>
+          <Form.Item name={[index, "legalEntityIds"]} label="Юридические лица">
+            <LegalEntitySelect known={knownEntities} />
+          </Form.Item>
+        </Flex>
+      </ConfigProvider>
+    </Card>
+  );
+}
+
+/**
+ * The secondary assignments of an employee, added, changed and removed in the form. «Сделать основным» swaps an assignment with the
+ * main one, so the employee keeps both and a single save moves the main assignment.
+ */
+export function AssignmentFields({
+  keptPosition,
+  knownEntities,
+  onMadeMain,
+}: AssignmentFieldsProps) {
+  const form = Form.useFormInstance<EmployeeInput>();
+
+  function makeMain(index: number) {
+    const assignments: EmployeeInput["assignments"] =
+      form.getFieldValue("assignments") ?? [];
+    const chosen = assignments[index];
+    if (!chosen) return;
+    const main = {
+      orgUnitId: form.getFieldValue("orgUnitId"),
+      positionId: form.getFieldValue("positionId"),
+      legalEntityIds: form.getFieldValue("legalEntityIds") ?? [],
+    };
+    form.setFieldsValue({
+      ...chosen,
+      assignments: assignments.map((assignment, place) =>
+        place === index ? main : assignment,
+      ),
+    });
+    onMadeMain();
+  }
+
+  return (
+    <Flex vertical gap="small">
+      <Typography.Title level={5} style={{ margin: 0 }}>
+        Совмещения
+      </Typography.Title>
+      <Form.List name="assignments">
+        {(fields, { add, remove }) => (
+          <Flex vertical gap="middle">
+            {fields.length === 0 && (
+              <Typography.Text type="secondary">
+                Совмещений нет. Добавьте подразделение и должность, если
+                сотрудник работает ещё и там.
+              </Typography.Text>
+            )}
+            {fields.map((field) => (
+              <AssignmentCard
+                key={field.key}
+                index={field.name}
+                keptPosition={keptPosition}
+                knownEntities={knownEntities}
+                onRemove={() => remove(field.name)}
+                onMakeMain={() => makeMain(field.name)}
+              />
+            ))}
+            <div>
+              <Button
+                icon={<PlusOutlined />}
+                onClick={() => add({ legalEntityIds: [] })}
+              >
+                Добавить совмещение
+              </Button>
+            </div>
+          </Flex>
+        )}
+      </Form.List>
+    </Flex>
+  );
+}
diff --git a/web/src/features/org-structure/EmployeeAssignments.test.tsx b/web/src/features/org-structure/EmployeeAssignments.test.tsx
new file mode 100644
index 0000000..4fb3fe9
--- /dev/null
+++ b/web/src/features/org-structure/EmployeeAssignments.test.tsx
@@ -0,0 +1,253 @@
+import { render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { queryClient } from "../../api/queryClient";
+import { Providers } from "../../app/Providers";
+import { fakeApi } from "../../test/fakeApi";
+import { LONG_FLOW_TIMEOUT } from "../../test/timeouts";
+import { EmployeeForm } from "./EmployeeForm";
+
+const ALPHA = { id: "le1", name: "ООО Альфа" };
+
+const unit = (id: string, name: string) => ({
+  id,
+  name,
+  parentId: null,
+  headEmployeeId: null,
+  isActive: true,
+  version: 1,
+});
+
+const allowed = (unitId: string, positionId: string, name: string) => ({
+  positionId,
+  name,
+  isActive: true,
+  orgUnitId: unitId,
+  orgUnitName: unitId,
+});
+
+const SECONDARY = {
+  orgUnitId: "support",
+  positionId: "operator",
+  legalEntityIds: [] as string[],
+};
+
+function serve() {
+  fakeApi.on("GET /api/v1/auth/me", () =>
+    Response.json({ id: "a", email: "a@test.local", roles: ["GlobalAdmin"] }),
+  );
+  fakeApi.on("GET /api/v1/org-units/tree", () =>
+    Response.json([unit("sales", "Продажи"), unit("support", "Поддержка")]),
+  );
+  fakeApi.on("GET /api/v1/org-units/sales/positions", () =>
+    Response.json([allowed("sales", "engineer", "Инженер")]),
+  );
+  fakeApi.on("GET /api/v1/org-units/support/positions", () =>
+    Response.json([allowed("support", "operator", "Оператор")]),
+  );
+  fakeApi.on("GET /api/v1/legal-entities", () =>
+    Response.json({ items: [ALPHA], total: 1, page: 1, pageSize: 20 }),
+  );
+}
+
+async function openForm(withSecondary: boolean) {
+  serve();
+  const onSubmit = vi.fn().mockResolvedValue(undefined);
+  render(
+    <Providers>
+      <EmployeeForm
+        initialValues={{
+          lastName: "Иванов",
+          firstName: "Иван",
+          orgUnitId: "sales",
+          positionId: "engineer",
+          legalEntityIds: [ALPHA.id],
+          assignments: withSecondary ? [SECONDARY] : [],
+        }}
+        position={{ id: "engineer", name: "Инженер" }}
+        saved={{
+          legalEntities: [ALPHA],
+          assignments: withSecondary
+            ? [
+                {
+                  orgUnitId: "support",
+                  orgUnitName: "Поддержка",
+                  positionId: "operator",
+                  position: "Оператор",
+                  legalEntities: [],
+                  isSecondary: true,
+                },
+              ]
+            : [],
+        }}
+        submitLabel="Сохранить"
+        onSubmit={onSubmit}
+        onCancel={() => undefined}
+      />
+    </Providers>,
+  );
+  const user = userEvent.setup();
+  await screen.findByText("Инженер");
+  return { user, onSubmit };
+}
+
+async function save(
+  user: ReturnType<typeof userEvent.setup>,
+  onSubmit: ReturnType<typeof vi.fn>,
+) {
+  await user.click(screen.getByRole("button", { name: "Сохранить" }));
+  await waitFor(() => expect(onSubmit).toHaveBeenCalledOnce());
+  return onSubmit.mock.calls[0]?.[0];
+}
+
+beforeEach(() => {
+  queryClient.clear();
+});
+
+describe("the assignments in the employee form (AC-1, AC-2, AC-3)", {
+  timeout: LONG_FLOW_TIMEOUT,
+}, () => {
+  it("says there are no secondary assignments and saves an empty list", async () => {
+    const { user, onSubmit } = await openForm(false);
+
+    expect(screen.getByText(/Совмещений нет/)).toBeInTheDocument();
+
+    expect(await save(user, onSubmit)).toMatchObject({
+      legalEntityIds: [ALPHA.id],
+      assignments: [],
+    });
+  });
+
+  it("saves the secondary assignments the employee holds, unchanged", async () => {
+    const { user, onSubmit } = await openForm(true);
+
+    expect(screen.getByText("Совмещение 1")).toBeInTheDocument();
+
+    expect(await save(user, onSubmit)).toMatchObject({
+      orgUnitId: "sales",
+      positionId: "engineer",
+      assignments: [SECONDARY],
+    });
+  });
+
+  it("removes a secondary assignment from what is saved", async () => {
+    const { user, onSubmit } = await openForm(true);
+
+    await user.click(
+      screen.getByRole("button", { name: "Убрать: Совмещение 1" }),
+    );
+
+    expect(screen.queryByText("Совмещение 1")).not.toBeInTheDocument();
+    expect(await save(user, onSubmit)).toMatchObject({ assignments: [] });
+  });
+
+  it("swaps a secondary assignment with the main one in one save (AC-3)", async () => {
+    const { user, onSubmit } = await openForm(true);
+
+    await user.click(
+      screen.getByRole("button", { name: "Сделать основным: Совмещение 1" }),
+    );
+
+    expect(await save(user, onSubmit)).toMatchObject({
