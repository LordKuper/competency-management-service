diff --git a/web/src/features/org-import/HeadsStep.tsx b/web/src/features/org-import/HeadsStep.tsx
new file mode 100644
index 0000000..6da2202
--- /dev/null
+++ b/web/src/features/org-import/HeadsStep.tsx
@@ -0,0 +1,210 @@
+import {
+  Alert,
+  Button,
+  Flex,
+  Radio,
+  Select,
+  Table,
+  type TableColumnsType,
+  Tag,
+  Typography,
+} from "antd";
+import { useMemo, useState } from "react";
+import { ApiError } from "../../api/ApiError";
+import { describeApiError } from "../../app/apiErrors";
+import { ActionBar, CompactAlert } from "../desk/ScenarioContext";
+import { type HeadChoices, type HeadRow, headRows } from "./importHeads";
+import type { KeptIds } from "./importPlan";
+import type { OrgImportPlan } from "./orgImportApi";
+
+const PAGE_SIZE = 50;
+const NO_HEAD = "";
+const ALL = "all";
+const ATTENTION = "attention";
+
+const pagination = {
+  pageSize: PAGE_SIZE,
+  hideOnSinglePage: true,
+  showSizeChanger: false,
+} as const;
+
+interface HeadsStepProps {
+  plan: OrgImportPlan;
+  kept: KeptIds;
+  choices: HeadChoices;
+  /** Sets the head of a unit by its key; null leaves the unit without a head. */
+  onChoose: (unitKey: string, employeeKey: string | null) => void;
+  /** The apply is in flight: the choices stay as they are until it ends. */
+  isApplying: boolean;
+  /** Why the last apply was refused, other than a changed plan. */
+  failure: unknown;
+  onBack: () => void;
+  onApply: () => void;
+}
+
+/** Why an apply was refused, in the server's words: a rule of the organization, or choices it could not read. */
+function failureText(failure: unknown): string {
+  if (failure instanceof ApiError && failure.status === 400) {
+    const reasons = [
+      ...(failure.errors?.decisions ?? []),
+      ...(failure.errors?.heads ?? []),
+    ];
+    return reasons.length > 0 ? reasons.join(" ") : describeApiError(failure);
+  }
+  return describeApiError(failure);
+}
+
+/**
+ * Step 4: the head of every unit of the file that has candidates or a head now, chosen from the employees who work in
+ * the unit after the apply, which the decisions about the missing employees decide. The defaults follow those decisions.
+ */
+export function HeadsStep({
+  plan,
+  kept,
+  choices,
+  onChoose,
+  isApplying,
+  failure,
+  onBack,
+  onApply,
+}: HeadsStepProps) {
+  const [filter, setFilter] = useState(ALL);
+  const rows = useMemo(
+    () => headRows(plan, kept, choices),
+    [plan, kept, choices],
+  );
+  const attention = useMemo(
+    () => rows.filter((row) => row.needsAttention),
+    [rows],
+  );
+  const shown = filter === ATTENTION ? attention : rows;
+
+  const columns: TableColumnsType<HeadRow> = [
+    {
+      title: "Подразделение",
+      key: "unit",
+      render: (_value, row) => (
+        <Flex vertical gap="var(--ant-margin-xxs)" align="flex-start">
+          <span>{row.unit.path}</span>
+          {row.unit.unitId === null && <Tag>Новое</Tag>}
+        </Flex>
+      ),
+    },
+    {
+      title: "Сейчас",
+      key: "current",
+      width: "20%",
+      render: (_value, row) =>
+        row.currentHeadName === null ? (
+          "—"
+        ) : (
+          <Flex vertical gap="var(--ant-margin-xxs)">
+            <span>{row.currentHeadName}</span>
+            {!row.isCurrentHeadStaying && (
+              <Typography.Text type="secondary">
+                Не остаётся в подразделении
+              </Typography.Text>
+            )}
+          </Flex>
+        ),
+    },
+    {
+      title: "Руководитель",
+      key: "head",
+      width: "30%",
+      render: (_value, row) => (
+        <Select<string>
+          aria-label={`Руководитель: ${row.unit.path}`}
+          style={{ width: "100%" }}
+          disabled={isApplying}
+          showSearch
+          optionFilterProp="label"
+          status={row.isUndecided ? "warning" : undefined}
+          placeholder="Выберите руководителя"
+          value={row.isUndecided ? undefined : (row.chosen ?? NO_HEAD)}
+          options={[
+            { value: NO_HEAD, label: "Без руководителя" },
+            ...row.options.map(({ key, fullName }) => ({
+              value: key,
+              label: fullName,
+            })),
+          ]}
+          onChange={(value) =>
+            onChoose(row.unit.key, value === NO_HEAD ? null : value)
+          }
+        />
+      ),
+    },
+    {
+      title: "Замечание",
+      key: "remark",
+      render: (_value, row) =>
+        (row.isUndecided || row.mismatch) && (
+          <Flex vertical gap="var(--ant-margin-xxs)" align="flex-start">
+            {row.isUndecided && (
+              <Tag color="warning">
+                Несколько кандидатов — выберите руководителя
+              </Tag>
+            )}
+            {row.mismatch && <span>{row.mismatch}</span>}
+          </Flex>
+        ),
+    },
+  ];
+
+  return (
+    <Flex vertical gap="middle">
+      {rows.length === 0 ? (
+        <CompactAlert type="info" lead="Руководителей назначать не нужно." />
+      ) : (
+        <Flex vertical gap="small">
+          <Flex justify="space-between" align="center" gap="small" wrap>
+            <Typography.Title level={4} style={{ margin: 0 }}>
+              {`Подразделений с руководителем: ${rows.length}`}
+            </Typography.Title>
+            <Radio.Group
+              optionType="button"
+              value={filter}
+              options={[
+                { value: ALL, label: `Все (${rows.length})` },
+                {
+                  value: ATTENTION,
+                  label: `Требуют внимания (${attention.length})`,
+                },
+              ]}
+              onChange={(event) => setFilter(event.target.value)}
+            />
+          </Flex>
+          <Table<HeadRow>
+            size="small"
+            className="desk-table"
+            rowKey={(row) => row.unit.key}
+            columns={columns}
+            dataSource={shown}
+            pagination={pagination}
+            locale={{ emptyText: "Нет подразделений, требующих внимания." }}
+          />
+        </Flex>
+      )}
+      {failure != null && (
+        <Alert
+          type="error"
+          showIcon
+          title="Импорт не применён"
+          description={failureText(failure)}
+        />
+      )}
+      <ActionBar
+        start={
+          <Button disabled={isApplying} onClick={onBack}>
+            Назад
+          </Button>
+        }
+      >
+        <Button type="primary" loading={isApplying} onClick={onApply}>
+          Применить
+        </Button>
+      </ActionBar>
+    </Flex>
+  );
+}
diff --git a/web/src/features/org-import/MissingStep.tsx b/web/src/features/org-import/MissingStep.tsx
new file mode 100644
index 0000000..24da5ba
--- /dev/null
+++ b/web/src/features/org-import/MissingStep.tsx
@@ -0,0 +1,233 @@
+import {
+  Button,
+  Flex,
+  Radio,
+  Table,
+  type TableColumnsType,
+  Tag,
+  Typography,
+} from "antd";
+import { type ReactNode, useMemo } from "react";
+import { ActionBar, CompactAlert } from "../desk/ScenarioContext";
+import { isEmployeeKept, type KeptIds, unitBlocks } from "./importPlan";
+import type {
+  MissingEmployee,
+  MissingUnit,
+  OrgImportPlan,
+} from "./orgImportApi";
+import "./orgImport.css";
+
+const PAGE_SIZE = 50;
+const NO_UNITS = "—";
+const ACT = "act";
+const KEEP = "keep";
+
+const UNIT_OPTIONS = [
+  { value: ACT, label: "Деактивировать" },
+  { value: KEEP, label: "Оставить" },
+];
+const EMPLOYEE_OPTIONS = [
+  { value: ACT, label: "Уволить" },
+  { value: KEEP, label: "Оставить" },
+];
+
+const pagination = {
+  pageSize: PAGE_SIZE,
+  hideOnSinglePage: true,
+  showSizeChanger: false,
+} as const;
+
+interface MissingStepProps {
+  plan: OrgImportPlan;
+  kept: KeptIds;
+  /** Sets the decision of the given entities: kept, or deactivated and dismissed. */
+  onDecide: (ids: readonly string[], isKept: boolean) => void;
+  onBack: () => void;
+  onNext: () => void;
+}
+
+/**
+ * Step 3: the units and employees the system has and the file does not, each deactivated or dismissed unless kept. A
+ * decision the organization's rules refuse is marked before the apply, and the next step stays off while one is.
+ */
+export function MissingStep({
+  plan,
+  kept,
+  onDecide,
+  onBack,
+  onNext,
+}: MissingStepProps) {
+  const blocks = useMemo(() => unitBlocks(plan, kept), [plan, kept]);
+  const unitPaths = useMemo(
+    () => new Map(plan.missingUnits.map((unit) => [unit.id, unit.path])),
+    [plan.missingUnits],
+  );
+  const { missingUnits, missingEmployees } = plan;
+
+  const unitColumns: TableColumnsType<MissingUnit> = [
+    { title: "Подразделение", dataIndex: "path" },
+    {
+      title: "Решение",
+      key: "decision",
+      width: "30%",
+      render: (_value, unit) => (
+        <Radio.Group
+          optionType="button"
+          options={UNIT_OPTIONS}
+          value={kept.has(unit.id) ? KEEP : ACT}
+          onChange={(event) => onDecide([unit.id], event.target.value === KEEP)}
+        />
+      ),
+    },
+    {
+      title: "Замечание",
+      key: "remark",
+      render: (_value, unit) => {
+        const reason = blocks.get(unit.id);
+        return (
+          reason && (
+            <Flex vertical gap="var(--ant-margin-xxs)" align="flex-start">
+              <Tag color="warning">Нельзя применить</Tag>
+              <span>{reason}</span>
+            </Flex>
+          )
+        );
+      },
+    },
+  ];
+
+  const employeeColumns: TableColumnsType<MissingEmployee> = [
+    { title: "Сотрудник", dataIndex: "fullName" },
+    {
+      title: "В отсутствующих подразделениях",
+      key: "units",
+      render: (_value, employee) => {
+        const names = [...new Set(employee.orgUnitIds)]
+          .map((id) => unitPaths.get(id))
+          .filter((path) => path !== undefined);
+        return names.length > 0 ? names.join("; ") : NO_UNITS;
+      },
+    },
+    {
+      title: "Решение",
+      key: "decision",
+      width: "30%",
+      render: (_value, employee) => (
+        <Radio.Group
+          optionType="button"
+          disabled={employee.isLastActiveAdministrator}
+          options={EMPLOYEE_OPTIONS}
+          value={isEmployeeKept(employee, kept) ? KEEP : ACT}
+          onChange={(event) =>
+            onDecide([employee.id], event.target.value === KEEP)
+          }
+        />
+      ),
+    },
+    {
+      title: "Замечание",
+      key: "remark",
+      render: (_value, employee) =>
+        employee.isLastActiveAdministrator && (
+          <Flex vertical gap="var(--ant-margin-xxs)" align="flex-start">
+            <Tag color="warning">Последний администратор</Tag>
+            <span>
+              Уволить нельзя: это последний активный глобальный администратор.
+            </span>
+          </Flex>
+        ),
+    },
+  ];
+
+  return (
+    <Flex vertical gap="middle">
+      {missingUnits.length === 0 && missingEmployees.length === 0 && (
+        <CompactAlert
+          type="info"
+          lead="Решений не требуется."
+          text="Все действующие подразделения и работающие сотрудники системы есть в файле."
+        />
+      )}
+      {missingUnits.length > 0 && (
+        <Section
+          title={`Подразделений нет в файле: ${missingUnits.length}`}
+          actLabel="Деактивировать все"
+          onAll={(isKept) =>
+            onDecide(
+              missingUnits.map((unit) => unit.id),
+              isKept,
+            )
+          }
+        >
+          <Table<MissingUnit>
+            size="small"
+            className="desk-table"
+            rowKey="id"
+            columns={unitColumns}
+            dataSource={[...missingUnits]}
+            pagination={pagination}
+            rowClassName={(unit) =>
+              blocks.has(unit.id) ? "import-row-blocked" : ""
+            }
+          />
+        </Section>
+      )}
+      {missingEmployees.length > 0 && (
+        <Section
+          title={`Сотрудников нет в файле: ${missingEmployees.length}`}
+          actLabel="Уволить всех"
+          onAll={(isKept) =>
+            onDecide(
+              missingEmployees.map((employee) => employee.id),
+              isKept,
+            )
+          }
+        >
+          <Table<MissingEmployee>
+            size="small"
+            className="desk-table"
+            rowKey="id"
+            columns={employeeColumns}
+            dataSource={[...missingEmployees]}
+            pagination={pagination}
+          />
+        </Section>
+      )}
+      <ActionBar start={<Button onClick={onBack}>Назад</Button>}>
+        {blocks.size > 0 && (
+          <Typography.Text type="secondary">
+            {`Применить нельзя: исправьте решения в отмеченных подразделениях (${blocks.size}).`}
+          </Typography.Text>
+        )}
+        <Button type="primary" disabled={blocks.size > 0} onClick={onNext}>
+          Далее
+        </Button>
+      </ActionBar>
+    </Flex>
+  );
+}
+
+interface SectionProps {
+  title: string;
+  /** The label of the button that applies the default decision to the whole group. */
+  actLabel: string;
+  onAll: (isKept: boolean) => void;
+  children: ReactNode;
+}
+
+function Section({ title, actLabel, onAll, children }: SectionProps) {
+  return (
+    <Flex vertical gap="small">
+      <Flex justify="space-between" align="center" gap="small" wrap>
+        <Typography.Title level={4} style={{ margin: 0 }}>
+          {title}
+        </Typography.Title>
+        <Flex gap="small" wrap>
+          <Button onClick={() => onAll(false)}>{actLabel}</Button>
+          <Button onClick={() => onAll(true)}>Оставить все</Button>
+        </Flex>
+      </Flex>
+      {children}
+    </Flex>
+  );
+}
