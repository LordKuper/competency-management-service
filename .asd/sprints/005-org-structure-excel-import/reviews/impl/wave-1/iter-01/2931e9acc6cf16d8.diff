+import { describe, expect, it } from "vitest";
+import { headUnit, missingEmployee, planOf } from "../../test/orgImportPlan";
+import { choicesStillListed, headDecisionsOf, headRows } from "./importHeads";
+
+const NAMES = [
+  { key: "ann", fullName: "Анна" },
+  { key: "boris", fullName: "Борис" },
+  { key: "e1", fullName: "Старый руководитель" },
+];
+
+describe("headRows", () => {
+  it("takes the only candidate as the head of a unit with none now (AC-31)", () => {
+    const plan = planOf({
+      heads: {
+        units: [
+          headUnit("u", { candidates: ["ann"], employees: ["ann", "boris"] }),
+        ],
+        employees: NAMES,
+      },
+    });
+
+    const [row] = headRows(plan, new Set(), new Map());
+
+    expect(row?.chosen).toBe("ann");
+    expect(row?.isUndecided).toBe(false);
+    expect(row?.options.map((option) => option.fullName)).toEqual([
+      "Анна",
+      "Борис",
+    ]);
+  });
+
+  it("leaves a unit with several candidates undecided and its head empty", () => {
+    const plan = planOf({
+      heads: {
+        units: [
+          headUnit("u", {
+            candidates: ["ann", "boris"],
+            employees: ["ann", "boris"],
+          }),
+        ],
+        employees: NAMES,
+      },
+    });
+
+    const [row] = headRows(plan, new Set(), new Map());
+
+    expect(row?.chosen).toBeNull();
+    expect(row?.isUndecided).toBe(true);
+    expect(row?.needsAttention).toBe(true);
+  });
+
+  it("keeps the current head who stays over the only candidate", () => {
+    const plan = planOf({
+      heads: {
+        units: [
+          headUnit("u", {
+            unitId: "unit-1",
+            currentHead: "boris",
+            currentHeadStays: true,
+            candidates: ["ann"],
+            employees: ["ann", "boris"],
+          }),
+        ],
+        employees: NAMES,
+      },
+    });
+
+    const [row] = headRows(plan, new Set(), new Map());
+
+    expect(row?.chosen).toBe("boris");
+    expect(row?.isCurrentHeadStaying).toBe(true);
+    expect(row?.mismatch).toContain("Анна");
+    expect(row?.needsAttention).toBe(true);
+  });
+
+  it("keeps a current head the file does not name only while the decisions keep them in the unit", () => {
+    const plan = planOf({
+      missingEmployees: [missingEmployee("e1", ["unit-1"])],
+      heads: {
+        units: [
+          headUnit("u", {
+            unitId: "unit-1",
+            currentHead: "e1",
+            currentHeadStays: false,
+            candidates: ["ann"],
+            employees: ["ann"],
+          }),
+        ],
+        employees: NAMES,
+      },
+    });
+
+    const [kept] = headRows(plan, new Set(["e1"]), new Map());
+    const [dismissed] = headRows(plan, new Set(), new Map());
+
+    expect(kept?.chosen).toBe("e1");
+    expect(kept?.options.map((option) => option.key)).toContain("e1");
+    expect(dismissed?.chosen).toBe("ann");
+    expect(dismissed?.options.map((option) => option.key)).not.toContain("e1");
+  });
+
+  it("honours the choice of the user, null included, while it is still allowed", () => {
+    const plan = planOf({
+      heads: {
+        units: [
+          headUnit("u", {
+            candidates: ["ann", "boris"],
+            employees: ["ann", "boris"],
+          }),
+        ],
+        employees: NAMES,
+      },
+    });
+
+    expect(
+      headRows(plan, new Set(), new Map([["u", "boris"]]))[0]?.chosen,
+    ).toBe("boris");
+    expect(
+      headRows(plan, new Set(), new Map([["u", null]]))[0]?.chosen,
+    ).toBeNull();
+    expect(
+      headRows(plan, new Set(), new Map([["u", "boris"]]))[0]?.isUndecided,
+    ).toBe(false);
+  });
+
+  it("drops a choice that names an employee who no longer works in the unit", () => {
+    const plan = planOf({
+      heads: {
+        units: [headUnit("u", { candidates: ["ann"], employees: ["ann"] })],
+        employees: NAMES,
+      },
+    });
+
+    expect(
+      headRows(plan, new Set(), new Map([["u", "boris"]]))[0]?.chosen,
+    ).toBe("ann");
+  });
+
+  it("names the current head by the missing employee's name when the file does not name them", () => {
+    const plan = planOf({
+      missingEmployees: [missingEmployee("e1", ["unit-1"])],
+      heads: {
+        units: [
+          headUnit("u", { unitId: "unit-1", currentHead: "e1", employees: [] }),
+        ],
+        employees: [],
+      },
+    });
+
+    expect(headRows(plan, new Set(), new Map())[0]?.currentHeadName).toBe(
+      "Сотрудник e1",
+    );
+  });
+});
+
+describe("headDecisionsOf", () => {
+  it("states a head for every unit of the head step (AC-31)", () => {
+    const plan = planOf({
+      heads: {
+        units: [
+          headUnit("one", { candidates: ["ann"], employees: ["ann"] }),
+          headUnit("two", {
+            candidates: ["ann", "boris"],
+            employees: ["ann", "boris"],
+          }),
+        ],
+        employees: NAMES,
+      },
+    });
+
+    expect(headDecisionsOf(plan, new Set(), new Map())).toEqual([
+      { unit: "one", employee: "ann" },
+      { unit: "two", employee: null },
+    ]);
+  });
+});
+
+describe("choicesStillListed", () => {
+  it("keeps the choices of the units the new plan still lists", () => {
+    const plan = planOf({
+      heads: { units: [headUnit("kept")], employees: [] },
+    });
+
+    const choices = choicesStillListed(
+      plan,
+      new Map([
+        ["kept", "ann"],
+        ["gone", null],
+      ]),
+    );
+
+    expect([...choices]).toEqual([["kept", "ann"]]);
+  });
+});
diff --git a/web/src/features/org-import/importHeads.ts b/web/src/features/org-import/importHeads.ts
new file mode 100644
index 0000000..73ca809
--- /dev/null
+++ b/web/src/features/org-import/importHeads.ts
@@ -0,0 +1,124 @@
+import { isEmployeeKept, type KeptIds } from "./importPlan";
+import type {
+  ImportHeadDecision,
+  ImportHeadUnit,
+  OrgImportPlan,
+} from "./orgImportApi";
+
+/** The heads the user chose, by the key of the unit; null is «Без руководителя». A unit without an entry takes the suggested head. */
+export type HeadChoices = ReadonlyMap<string, string | null>;
+
+/** An employee who works in a unit after the apply. */
+export interface HeadOption {
+  key: string;
+  fullName: string;
+}
+
+/** One unit of the head step with the head it gets as things stand. */
+export interface HeadRow {
+  unit: ImportHeadUnit;
+  /** Who heads the unit now, by name. */
+  currentHeadName: string | null;
+  /** Whether the current head works in the unit after the apply. */
+  isCurrentHeadStaying: boolean;
+  /** Employees who work in the unit after the apply: the file's, and the missing ones the decisions keep. */
+  options: readonly HeadOption[];
+  /** The head the unit gets; null leaves it without one. */
+  chosen: string | null;
+  /** Several candidates and nobody preselected or chosen yet. */
+  isUndecided: boolean;
+  /** The current head stays but is not among the recognised candidates; names the candidates. */
+  mismatch: string | null;
+  /** Several candidates, or a mismatch: the rows the filter «Требуют внимания» keeps. */
+  needsAttention: boolean;
+}
+
+/** The heads a unit may have after the apply, as lists of employee keys, by unit. */
+function keptWorkers(plan: OrgImportPlan, kept: KeptIds) {
+  const byUnit = new Map<string, string[]>();
+  for (const employee of plan.missingEmployees) {
+    if (!isEmployeeKept(employee, kept)) continue;
+    for (const unitId of new Set(employee.orgUnitIds)) {
+      byUnit.set(unitId, [...(byUnit.get(unitId) ?? []), employee.id]);
+    }
+  }
+  return byUnit;
+}
+
+/**
+ * Every unit of the head step with its head: the user's choice while it is still allowed, else the current head when he
+ * stays, else the only candidate, else nobody. Computed from the decisions about the missing entities, so a change to
+ * them moves the defaults and drops a choice that is no longer allowed.
+ */
+export function headRows(
+  plan: OrgImportPlan,
+  kept: KeptIds,
+  choices: HeadChoices,
+): HeadRow[] {
+  const names = new Map([
+    ...plan.missingEmployees.map(({ id, fullName }) => [id, fullName] as const),
+    ...plan.heads.employees.map(
+      ({ key, fullName }) => [key, fullName] as const,
+    ),
+  ]);
+  const nameOf = (key: string) => names.get(key) ?? key;
+  const keptByUnit = keptWorkers(plan, kept);
+
+  return plan.heads.units.map((unit) => {
+    const stayingMissing = unit.unitId
+      ? (keptByUnit.get(unit.unitId) ?? [])
+      : [];
+    const keys = [...new Set([...unit.employees, ...stayingMissing])];
+    const { currentHead, candidates } = unit;
+    const stayingHead =
+      currentHead !== null &&
+      (unit.currentHeadStays || keys.includes(currentHead))
+        ? currentHead
+        : null;
+    const suggested =
+      stayingHead ?? (candidates.length === 1 ? (candidates[0] ?? null) : null);
+    const choice = choices.get(unit.key);
+    const explicit =
+      choice !== undefined && (choice === null || keys.includes(choice))
+        ? choice
+        : undefined;
+    const mismatch =
+      stayingHead !== null &&
+      candidates.length > 0 &&
+      !candidates.includes(stayingHead)
+        ? `Действующий руководитель не распознан по должности. Распознаны: ${candidates.map(nameOf).join(", ")}.`
+        : null;
+    return {
+      unit,
+      currentHeadName: currentHead === null ? null : nameOf(currentHead),
+      isCurrentHeadStaying: stayingHead !== null,
+      options: keys.map((key) => ({ key, fullName: nameOf(key) })),
+      chosen: explicit === undefined ? suggested : explicit,
+      isUndecided:
+        explicit === undefined && suggested === null && candidates.length > 1,
+      mismatch,
+      needsAttention: candidates.length > 1 || mismatch !== null,
+    };
+  });
+}
+
+/** The choices for the units a new plan still lists. */
+export function choicesStillListed(
+  plan: OrgImportPlan,
+  choices: HeadChoices,
+): HeadChoices {
+  const listed = new Set(plan.heads.units.map(({ key }) => key));
+  return new Map([...choices].filter(([unitKey]) => listed.has(unitKey)));
+}
+
+/** One explicit head for every unit of the head step, so the server's defaults never decide anything. */
+export function headDecisionsOf(
+  plan: OrgImportPlan,
+  kept: KeptIds,
+  choices: HeadChoices,
+): ImportHeadDecision[] {
+  return headRows(plan, kept, choices).map(({ unit, chosen }) => ({
+    unit: unit.key,
+    employee: chosen,
+  }));
+}
diff --git a/web/src/features/org-import/importPlan.test.ts b/web/src/features/org-import/importPlan.test.ts
new file mode 100644
index 0000000..b6a6060
--- /dev/null
+++ b/web/src/features/org-import/importPlan.test.ts
@@ -0,0 +1,143 @@
+import { describe, expect, it } from "vitest";
+import { missingEmployee, missingUnit, planOf } from "../../test/orgImportPlan";
+import {
+  decisionsOf,
+  isEmployeeKept,
+  keptStillMissing,
+  unitBlocks,
+} from "./importPlan";
+
+describe("isEmployeeKept", () => {
+  it("keeps an employee the user kept", () => {
+    expect(isEmployeeKept(missingEmployee("e1"), new Set(["e1"]))).toBe(true);
+  });
+
+  it("dismisses an employee the user did not keep", () => {
+    expect(isEmployeeKept(missingEmployee("e1"), new Set())).toBe(false);
+  });
+
+  it("keeps the last active administrator whatever was chosen (AC-17)", () => {
+    expect(isEmployeeKept(missingEmployee("e1", [], true), new Set())).toBe(
+      true,
+    );
+  });
+});
+
+describe("keptStillMissing", () => {
+  it("drops the kept ids the new plan no longer lists", () => {
+    const plan = planOf({
+      missingUnits: [missingUnit("u1")],
+      missingEmployees: [missingEmployee("e1")],
+    });
+
+    expect(keptStillMissing(plan, new Set(["u1", "e1", "gone"]))).toEqual(
+      new Set(["u1", "e1"]),
+    );
+  });
+
+  it("keeps nothing when the new plan lists nothing missing", () => {
+    expect(keptStillMissing(planOf(), new Set(["u1"]))).toEqual(new Set());
+  });
+});
+
+describe("decisionsOf", () => {
+  it("states one decision for every missing unit and employee (AC-18)", () => {
+    const plan = planOf({
+      missingUnits: [missingUnit("u1"), missingUnit("u2")],
+      missingEmployees: [
+        missingEmployee("e1"),
+        missingEmployee("e2"),
+        missingEmployee("e3", [], true),
+      ],
+    });
+
+    expect(decisionsOf(plan, new Set(["u2", "e2"]))).toEqual([
+      { id: "u1", decision: "deactivate" },
+      { id: "u2", decision: "keep" },
+      { id: "e1", decision: "dismiss" },
+      { id: "e2", decision: "keep" },
+      { id: "e3", decision: "keep" },
+    ]);
+  });
+
+  it("states nothing for a plan with nothing missing", () => {
+    expect(decisionsOf(planOf(), new Set())).toEqual([]);
+  });
+});
+
+describe("unitBlocks", () => {
+  it("blocks deactivating a unit whose employee stays (AC-18)", () => {
+    const plan = planOf({
+      missingUnits: [missingUnit("u1")],
+      missingEmployees: [missingEmployee("e1", ["u1"])],
+    });
+
+    const blocks = unitBlocks(plan, new Set(["e1"]));
+
+    expect(blocks.get("u1")).toContain("работающие сотрудники (1)");
+  });
+
+  it("counts an employee once however many assignments they keep in the unit", () => {
+    const plan = planOf({
+      missingUnits: [missingUnit("u1")],
+      missingEmployees: [missingEmployee("e1", ["u1", "u1"])],
+    });
+
+    expect(unitBlocks(plan, new Set(["e1"])).get("u1")).toContain("(1)");
+  });
+
+  it("does not block when the employee of the unit is dismissed", () => {
+    const plan = planOf({
+      missingUnits: [missingUnit("u1")],
+      missingEmployees: [missingEmployee("e1", ["u1"])],
+    });
+
+    expect(unitBlocks(plan, new Set()).size).toBe(0);
+  });
+
+  it("blocks for the last active administrator, who stays whatever was chosen", () => {
+    const plan = planOf({
+      missingUnits: [missingUnit("u1")],
+      missingEmployees: [missingEmployee("e1", ["u1"], true)],
+    });
+
+    expect(unitBlocks(plan, new Set()).has("u1")).toBe(true);
+  });
+
+  it("blocks deactivating a unit whose child stays active", () => {
+    const plan = planOf({
+      missingUnits: [missingUnit("parent"), missingUnit("child", "parent")],
+    });
+
+    const blocks = unitBlocks(plan, new Set(["child"]));
+
+    expect(blocks.get("parent")).toContain("дочерние подразделения (1)");
+    expect(blocks.has("child")).toBe(false);
+  });
+
+  it("does not block a unit that is kept, nor a unit whose child goes too", () => {
+    const plan = planOf({
+      missingUnits: [missingUnit("parent"), missingUnit("child", "parent")],
+      missingEmployees: [missingEmployee("e1", ["parent"])],
+    });
+
+    expect(unitBlocks(plan, new Set(["parent", "e1"])).has("parent")).toBe(
+      false,
+    );
+    expect(
+      unitBlocks(planOf({ missingUnits: plan.missingUnits }), new Set()).size,
+    ).toBe(0);
+  });
+
+  it("gives both reasons when an employee and a child stay", () => {
+    const plan = planOf({
+      missingUnits: [missingUnit("parent"), missingUnit("child", "parent")],
+      missingEmployees: [missingEmployee("e1", ["parent"])],
+    });
+
+    const reason = unitBlocks(plan, new Set(["child", "e1"])).get("parent");
+
+    expect(reason).toContain("работающие сотрудники");
+    expect(reason).toContain("дочерние подразделения");
+  });
+});
diff --git a/web/src/features/org-import/importPlan.ts b/web/src/features/org-import/importPlan.ts
new file mode 100644
index 0000000..9cff870
--- /dev/null
+++ b/web/src/features/org-import/importPlan.ts
@@ -0,0 +1,125 @@
+import type {
+  ImportDecision,
+  MissingEmployee,
+  OrgImportPlan,
+  OrgImportResult,
+} from "./orgImportApi";
+
+/** The groups of changes a plan lists and an applied import counts, in the order the wizard shows them. */
+export const CHANGE_GROUPS: ReadonlyArray<{
+  key: keyof OrgImportPlan & keyof OrgImportResult;
+  title: string;
+}> = [
+  { key: "newUnits", title: "Новые подразделения" },
+  { key: "activatedUnits", title: "Активируемые подразделения" },
+  { key: "newPositions", title: "Новые должности" },
+  { key: "reactivatedPositions", title: "Возвращаемые в работу должности" },
+  { key: "newLegalEntities", title: "Новые юридические лица" },
+  { key: "newEmployees", title: "Новые сотрудники" },
+  { key: "rehiredEmployees", title: "Возврат на работу" },
+  { key: "transfers", title: "Переводы: смена основного назначения" },
+  { key: "addedAssignments", title: "Добавленные совмещения" },
+  { key: "removedAssignments", title: "Снятые совмещения" },
+  {
+    key: "changedLegalEntities",
+    title: "Изменения юридических лиц назначений",
+  },
+  {
+    key: "unitPositionsAdded",
+    title: "Должности, добавляемые в перечни подразделений",
+  },
+  {
+    key: "unitPositionsRemoved",
+    title: "Должности, исключаемые из перечней подразделений",
+  },
+];
+
+/** The groups only an applied import counts: what the decisions about the missing units and employees and the chosen heads did. */
+export const DECISION_GROUPS: ReadonlyArray<{
+  key: keyof OrgImportResult;
+  title: string;
+}> = [
+  { key: "deactivatedUnits", title: "Деактивированные подразделения" },
+  { key: "dismissedEmployees", title: "Уволенные сотрудники" },
+  { key: "assignedHeads", title: "Назначенные руководители" },
+];
+
+/** The ids of the missing units and employees the user decided to keep; every other one is deactivated or dismissed. */
+export type KeptIds = ReadonlySet<string>;
+
+/** A last active administrator cannot be dismissed, so that employee stays whatever was chosen. */
+export function isEmployeeKept(
+  employee: MissingEmployee,
+  kept: KeptIds,
+): boolean {
+  return employee.isLastActiveAdministrator || kept.has(employee.id);
+}
+
+/** The ids of the kept entities that the new plan still lists as missing. */
+export function keptStillMissing(plan: OrgImportPlan, kept: KeptIds): KeptIds {
+  const missing = new Set([
+    ...plan.missingUnits.map((unit) => unit.id),
+    ...plan.missingEmployees.map((employee) => employee.id),
+  ]);
+  return new Set([...kept].filter((id) => missing.has(id)));
+}
+
+/** One explicit decision for every missing unit and employee, so the server's defaults never decide anything. */
+export function decisionsOf(
+  plan: OrgImportPlan,
+  kept: KeptIds,
+): ImportDecision[] {
+  return [
+    ...plan.missingUnits.map(({ id }) => ({
+      id,
+      decision: kept.has(id) ? ("keep" as const) : ("deactivate" as const),
+    })),
+    ...plan.missingEmployees.map((employee) => ({
+      id: employee.id,
+      decision: isEmployeeKept(employee, kept)
+        ? ("keep" as const)
+        : ("dismiss" as const),
+    })),
+  ];
+}
+
+function count(counts: Map<string, number>, id: string) {
+  counts.set(id, (counts.get(id) ?? 0) + 1);
+}
+
+/**
+ * The deactivated units whose decision the server would refuse, with the reason: a working employee who stays in the
+ * unit, or an active child unit that stays. Mirrors the server's check, so the wizard shows it before the apply.
+ */
+export function unitBlocks(
+  plan: OrgImportPlan,
+  kept: KeptIds,
+): ReadonlyMap<string, string> {
+  const stayingEmployees = new Map<string, number>();
+  for (const employee of plan.missingEmployees) {
+    if (!isEmployeeKept(employee, kept)) continue;
+    for (const unitId of new Set(employee.orgUnitIds)) {
+      count(stayingEmployees, unitId);
+    }
+  }
+  const stayingChildren = new Map<string, number>();
+  for (const unit of plan.missingUnits) {
+    if (kept.has(unit.id) && unit.parentId)
+      count(stayingChildren, unit.parentId);
+  }
+
+  const blocks = new Map<string, string>();
+  for (const unit of plan.missingUnits) {
+    if (kept.has(unit.id)) continue;
+    const reasons = [
+      stayingEmployees.has(unit.id)
+        ? `В подразделении остаются работающие сотрудники (${stayingEmployees.get(unit.id)}): оставьте подразделение или уволите сотрудников.`
+        : null,
+      stayingChildren.has(unit.id)
+        ? `Остаются активные дочерние подразделения (${stayingChildren.get(unit.id)}): оставьте подразделение или деактивируйте дочерние.`
+        : null,
+    ].filter((reason) => reason !== null);
+    if (reasons.length > 0) blocks.set(unit.id, reasons.join(" "));
+  }
+  return blocks;
+}
