+    await transferTo(user, "Поддержка");
+
+    await user.click(screen.getByRole("combobox", { name: "Должность" }));
+    await user.keyboard(FORMER.name);
+    await user.click(
+      await screen.findByText(`Добавить должность «${FORMER.name}»`),
+    );
+    await waitFor(() =>
+      expect(
