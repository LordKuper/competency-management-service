+
+        async Task<string[]> Listed(string filter) =>
+            (await org.Admin.GetAsync($"/api/v1/career/{kind}?q={Uri.EscapeDataString(prefix)}&pageSize=200{filter}")).Expect(HttpStatusCode.OK).ItemNames();
