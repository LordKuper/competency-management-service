+) {
+  return Response.json({
+    entries: options.entries ?? [],
+    hiddenEntryCount: options.hiddenEntryCount ?? 0,
+    blockers: options.blockers ?? [],
+    moreCount: options.moreCount ?? 0,
+    cascadeTag,
+  });
+}
