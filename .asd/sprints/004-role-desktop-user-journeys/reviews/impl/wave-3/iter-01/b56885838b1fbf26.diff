+  return (
+    <>
+      <button type="button" onClick={() => void publish(TARGET, "approve")}>
+        утвердить
+      </button>
+      <button type="button" onClick={() => void offerApproval(TARGET, "Draft")}>
+        предложить
+      </button>
+      <button
+        type="button"
+        onClick={() => void offerApproval(TARGET, "Active")}
+      >
+        предложить действующей
+      </button>
+    </>
+  );
