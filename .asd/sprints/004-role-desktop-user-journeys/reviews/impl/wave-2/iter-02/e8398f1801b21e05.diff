+    await waitFor(() =>
+      expect(checkboxOf(screen, SAVED_COMPETENCY.name)).toBeChecked(),
+    );
+    await user.click(checkboxOf(screen, SAVED_COMPETENCY.name));
+    await user.click(
+      await screen.findByRole("button", { name: "Создать блок" }),
