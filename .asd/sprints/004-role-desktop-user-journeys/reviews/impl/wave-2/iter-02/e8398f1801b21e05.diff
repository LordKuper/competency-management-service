+  superiorApprover: null,
+  hr: null,
+  actions: ["Edit"],
+} as unknown as MatrixVersion;
+
+function competency({ id, name }: { id: string; name: string }) {
+  return {
+    id,
+    name,
+    description: null,
+    directionId: null,
+    directionName: null,
+    scaleId: "s1",
+    scaleName: "Шкала",
