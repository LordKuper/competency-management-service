+    };
+
+    private static string StepOf(ApprovalStep step) => step == ApprovalStep.Superior ? "шаг 1, вышестоящий руководитель" : "шаг 2, HR";
+
+    private static string KindWord(CatalogEntryKind kind) => kind switch
+    {
+        CatalogEntryKind.Direction => "область",
+        CatalogEntryKind.Track => "трек",
+        CatalogEntryKind.Competency => "компетенция",
+        CatalogEntryKind.Scale => "шкала",
+        CatalogEntryKind.Block => "общий блок",
+        _ => throw new UnreachableException($"No draft letter names entries of kind {kind}."),
+    };
+
+    private static string ReturnedWith(bool hasChanges, bool hasComment) => (hasChanges, hasComment) switch
+    {
+        (true, true) => "с правками и комментарием согласующего",
+        (true, false) => "с правками",
+        _ => "с комментарием",
+    };
+
+    private async Task AwaitingAsync(MatrixVersion version, ApprovalStep step, Guid approverId, string happened, CancellationToken cancellationToken)
+    {
+        if (approverId == actor.UserId)
+        {
+            return;
+        }
+
+        Enqueue(approverId, AwaitingKind, AwaitingSubject, $"""
+            Здравствуйте!
+
+            Что ждёт вас: {await VersionTextAsync(version, cancellationToken)} ждёт вашего согласования — {StepOf(step)}.
+            От кого: {await ActorNameAsync(HeadWord, cancellationToken)} ({happened}).
+
+            Открыть версию и принять решение:
+            {Link(ReviewRoute, version.Id.ToString())}
+
+            {SignInLine} эта версия.
+
+            {AutomaticLine}
+            """);
+    }
+
+    private async Task ReturnedAsync(MatrixVersion version, bool hasChanges, bool hasComment, CancellationToken cancellationToken)
+    {
+        if (await employees.FindUnitAsync(version.Matrix.OrgUnitId, cancellationToken) is not { } unit
+            || await roles.HeadAccountAsync(unit, cancellationToken) is not { } headId
+            || headId == actor.UserId)
+        {
+            return;
+        }
+
+        Enqueue(headId, ReturnedKind, ReturnedSubject, $"""
+            Здравствуйте!
+
+            Что ждёт вас: {await VersionTextAsync(version, cancellationToken)} возвращена вам — {ReturnedWith(hasChanges, hasComment)}. Решите, принять правки, доработать версию или откатить правки.
+            От кого: {await ActorNameAsync(ApproverWord, cancellationToken)} ({StepOf(version.Step ?? ApprovalStep.Hr)}).
+
+            Открыть версию:
+            {Link(ReworkRoute, version.Id.ToString())}
+
+            {SignInLine} эта версия.
+
+            {AutomaticLine}
+            """);
+    }
+
+    private async Task<string> VersionTextAsync(MatrixVersion version, CancellationToken cancellationToken)
+    {
+        var matrix = version.Matrix;
+        var matrixName = matrix.PositionId is { } positionId
+            ? (await store.PositionNamesAsync([positionId], cancellationToken)).GetValueOrDefault(positionId)
+            : await context.Set<CareerTrack>()
+                .Where(track => track.Id == matrix.TrackId)
+                .Select(track => track.Name)
+                .FirstAsync(cancellationToken);
+        var unitNames = await store.UnitNamesAsync([matrix.OrgUnitId], cancellationToken);
+        return $"версия матрицы «{matrixName}» подразделения «{unitNames.GetValueOrDefault(matrix.OrgUnitId)}» (версия {version.Number})";
+    }
+
+    /// <summary>
+    /// The full name of the employee the acting account is bound to, or else the given word for the actor, never the account e-mail.
+    /// </summary>
+    private async Task<string> ActorNameAsync(string fallback, CancellationToken cancellationToken) =>
+        await users.FindAsync(actor.UserId ?? Guid.Empty, cancellationToken) is { EmployeeId: { } employeeId }
+        && await employees.FindAsync(employeeId, cancellationToken) is { } employee
+            ? employee.FullName
+            : fallback;
+
+    private string Link(string route, string path) => $"{app.Value.PublicBaseUrl.AbsoluteUri.TrimEnd('/')}/{route}/{path}";
+
+    private void Enqueue(Guid recipientId, string kind, string subject, string body) =>
+        queue.Enqueue(new CareerMailQueue.Letter(recipientId, kind, subject, body, actor.UserId?.ToString(), actor.Role, actor.RequestId));
+}
diff --git a/src/Competency.CareerFramework/CareerMailQueue.cs b/src/Competency.CareerFramework/CareerMailQueue.cs
new file mode 100644
index 0000000..295840a
--- /dev/null
+++ b/src/Competency.CareerFramework/CareerMailQueue.cs
@@ -0,0 +1,108 @@
+using System.Threading.Channels;
+using Competency.OrgStructure;
+using Competency.Platform;
+using Competency.UserManagement;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Hosting;
+using Microsoft.Extensions.Logging;
+
+namespace Competency.CareerFramework;
+
+/// <summary>
+/// Sends the career reminders outside the actions that cause them, so an action never waits on the mail server and a failed send never
+/// undoes it. Letters wait in memory, one sent at a time: they are lost when the process stops, and a full queue drops new ones, because
+/// a reminder only points at what the desk already shows. A letter goes only to an account that can act and is bound to no dismissed employee,
+/// as they stand when it is sent.
+/// </summary>
+internal sealed class CareerMailQueue(
+    IServiceScopeFactory scopeFactory,
+    MailSender sender,
+    IAuditWriter audit,
+    ILogger<CareerMailQueue> logger) : BackgroundService
+{
+    private const int Capacity = 1000;
+    private const string SendFailedAction = "Mail.SendFailed";
+    private const string RecipientEntityType = "AppUser";
+
+    private readonly Channel<Letter> letters = Channel.CreateBounded<Letter>(
+        new BoundedChannelOptions(Capacity) { FullMode = BoundedChannelFullMode.DropWrite, SingleReader = true },
+        letter => logger.LogWarning("A career reminder of kind {Kind} was dropped: the queue is full.", letter.Kind));
+
+    /// <summary>
+    /// Queues a ready letter without waiting; it never fails.
+    /// </summary>
+    /// <param name="letter">The letter.</param>
+    public void Enqueue(Letter letter) => letters.Writer.TryWrite(letter);
+
+    /// <inheritdoc />
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        await foreach (var letter in letters.Reader.ReadAllAsync(stoppingToken))
+        {
+            try
+            {
+                await SendAsync(letter, stoppingToken);
+            }
+            catch (Exception exception) when (!stoppingToken.IsCancellationRequested)
+            {
+                logger.LogError("A career reminder of kind {Kind} failed: {ExceptionType}", letter.Kind, exception.GetType().FullName);
+            }
+        }
+    }
+
+    private async Task SendAsync(Letter letter, CancellationToken cancellationToken)
+    {
+        await using var scope = scopeFactory.CreateAsyncScope();
+        if (await AddressAsync(letter.RecipientId, scope.ServiceProvider, cancellationToken) is not { } address
+            || await sender.SendAsync(address, letter.Subject, letter.Body, cancellationToken))
+        {
+            return;
+        }
+
+        await audit.WriteAsync(
+            new AuditEntry(
+                SendFailedAction,
+                RecipientEntityType,
+                letter.RecipientId.ToString(),
+                Reason: letter.Kind,
+                Actor: letter.ActorId,
+                Role: letter.ActorRole,
+                RequestId: letter.RequestId),
+            cancellationToken);
+    }
+
+    /// <summary>
+    /// The recipient's address, when the account can act and the employee it is bound to, if any, still works.
+    /// </summary>
+    private static async Task<string?> AddressAsync(Guid recipientId, IServiceProvider services, CancellationToken cancellationToken)
+    {
+        if (await services.GetRequiredService<IUserDirectory>().FindAsync(recipientId, cancellationToken) is not { IsActive: true } account)
+        {
+            return null;
+        }
+
+        return account.EmployeeId is { } employeeId
+            && await services.GetRequiredService<IEmployeeDirectory>().FindAsync(employeeId, cancellationToken) is not { IsActive: true }
+            ? null
+            : account.Email;
+    }
+
+    /// <summary>
+    /// One reminder ready to send, and who caused it, for the journal entry of a failed send.
+    /// </summary>
+    /// <param name="RecipientId">The recipient's account.</param>
+    /// <param name="Kind">The kind of reminder, journaled as the reason of a failed send.</param>
+    /// <param name="Subject">The subject line.</param>
+    /// <param name="Body">The plain-text body.</param>
+    /// <param name="ActorId">The account whose action caused the reminder.</param>
+    /// <param name="ActorRole">That account's role.</param>
+    /// <param name="RequestId">The request of that action.</param>
+    public sealed record Letter(
+        Guid RecipientId,
+        string Kind,
+        string Subject,
+        string Body,
+        string? ActorId,
+        string? ActorRole,
+        string? RequestId);
+}
