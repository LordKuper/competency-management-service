diff --git a/src/Competency.Platform/IDeskSource.cs b/src/Competency.Platform/IDeskSource.cs
new file mode 100644
index 0000000..e99cadf
--- /dev/null
+++ b/src/Competency.Platform/IDeskSource.cs
@@ -0,0 +1,18 @@
+namespace Competency.Platform;
+
+/// <summary>
+/// One module's contribution to the signed-in user's desk: what the module's data expects of the user, or tells them for reference,
+/// and which desk scenarios its data already allows.
+/// The desk merges the findings of every source, so a module states facts about its own data and never knows about the others.
+/// Implementations are scoped to a request and limit what they report to what the user's roles may see, by the module's own rights.
+/// </summary>
+public interface IDeskSource
+{
+    /// <summary>
+    /// Works out the findings for the user of <see cref="ICurrentActor"/> from the current data, with the scenario prerequisites the same
+    /// data shows, so that knowing them costs no extra read.
+    /// </summary>
+    /// <param name="cancellationToken">Cancels the lookup.</param>
+    /// <returns>The source's findings and the prerequisites it knows to hold.</returns>
+    Task<DeskReport> FindAsync(CancellationToken cancellationToken);
+}
diff --git a/src/Competency.Platform/IHrAssignments.cs b/src/Competency.Platform/IHrAssignments.cs
new file mode 100644
index 0000000..0b962d2
--- /dev/null
+++ b/src/Competency.Platform/IHrAssignments.cs
@@ -0,0 +1,26 @@
+namespace Competency.Platform;
+
+/// <summary>
+/// The units an employee is assigned to as their responsible HR, for the modules that cannot reference the one that keeps the assignments:
+/// a leaving employee loses them, and an account keeps the HR role while its employee holds any.
+/// Implementations are scoped to a request, because they share its database context.
+/// </summary>
+public interface IHrAssignments
+{
+    /// <summary>
+    /// Names the units of any status the employee is assigned to as responsible HR.
+    /// </summary>
+    /// <param name="employeeId">The employee.</param>
+    /// <param name="cancellationToken">Cancels the lookup.</param>
+    /// <returns>The unit names in alphabetical order; empty when the employee has no assignment.</returns>
+    Task<IReadOnlyList<string>> UnitNamesAsync(Guid employeeId, CancellationToken cancellationToken);
+
+    /// <summary>
+    /// Removes every assignment of the employee. The removal is only tracked on the shared database context: the caller saves it in its own
+    /// transaction, under the tree lock, and each removed assignment is journaled.
+    /// </summary>
+    /// <param name="employeeId">The employee.</param>
+    /// <param name="cancellationToken">Cancels the lookup.</param>
+    /// <returns>A task that completes when the removal is tracked.</returns>
+    Task RemoveAsync(Guid employeeId, CancellationToken cancellationToken);
+}
