@@ -0,0 +1,22 @@
+using Competency.Platform;
+
+namespace Competency.OrgStructure;
+
+/// <summary>
+/// How desk findings of every module name the records of the organization structure, so that findings about one record meet in one desk item
+/// and show it the same way.
+/// </summary>
+public static class OrgDeskObjects
+{
+    /// <summary>
+    /// A unit as the desk shows it: its name, placed by the names of the units above it from the root down.
+    /// </summary>
+    /// <param name="snapshot">The organization snapshot the unit is from.</param>
+    /// <param name="unit">The unit.</param>
+    /// <returns>The desk object of the unit.</returns>
+    public static DeskObject UnitDeskObject(this OrgSnapshot snapshot, OrgUnitStatus unit) => new(
+        DeskObjectType.OrgUnit,
+        unit.Id,
+        unit.Name,
+        [.. snapshot.Ancestry(unit.Id).Skip(1).Reverse().Select(ancestor => ancestor.Name)]);
+}
diff --git a/src/Competency.OrgStructure/OrgSnapshot.cs b/src/Competency.OrgStructure/OrgSnapshot.cs
new file mode 100644
index 0000000..8349437
--- /dev/null
+++ b/src/Competency.OrgStructure/OrgSnapshot.cs
@@ -0,0 +1,101 @@
+namespace Competency.OrgStructure;
+
+/// <summary>
+/// The whole organization structure read at once, with the module's own tree and position rules, so that callers checking many
+/// units at a time neither query per unit nor repeat the rules. A class rather than a record, because the child index it builds
+/// from <see cref="Units"/> would go stale in a copy made with different units.
+/// </summary>
+public sealed class OrgSnapshot
+{
+    private readonly ILookup<Guid?, OrgUnitStatus> children;
+
+    /// <summary>
+    /// Creates a snapshot from the rows read.
+    /// </summary>
+    /// <param name="units">Every unit, active or not, by identifier.</param>
+    /// <param name="unitPositionIds">The positions on each unit's own list, by unit identifier.</param>
+    /// <param name="positions">Every catalogue position, active or not, by identifier.</param>
+    /// <param name="workingEmployeeCounts">The number of working employees, by unit and position; pairs without any are absent.</param>
+    public OrgSnapshot(
+        IReadOnlyDictionary<Guid, OrgUnitStatus> units,
+        ILookup<Guid, Guid> unitPositionIds,
+        IReadOnlyDictionary<Guid, PositionStatus> positions,
+        IReadOnlyDictionary<(Guid OrgUnitId, Guid PositionId), int> workingEmployeeCounts)
+    {
+        Units = units;
+        UnitPositionIds = unitPositionIds;
+        Positions = positions;
+        WorkingEmployeeCounts = workingEmployeeCounts;
+        children = units.Values.ToLookup(unit => unit.ParentId);
+    }
+
+    /// <summary>
+    /// Every unit, active or not, by identifier.
+    /// </summary>
+    public IReadOnlyDictionary<Guid, OrgUnitStatus> Units { get; }
+
+    /// <summary>
+    /// The positions on each unit's own list, without those it inherits; empty for a unit with no list of its own.
+    /// </summary>
+    public ILookup<Guid, Guid> UnitPositionIds { get; }
+
+    /// <summary>
+    /// Every catalogue position, active or not, by identifier.
+    /// </summary>
+    public IReadOnlyDictionary<Guid, PositionStatus> Positions { get; }
+
+    /// <summary>
+    /// The number of working employees, by unit and position; pairs without any are absent.
+    /// </summary>
+    public IReadOnlyDictionary<(Guid OrgUnitId, Guid PositionId), int> WorkingEmployeeCounts { get; }
+
+    /// <summary>
+    /// A unit and every unit above it, for rules that apply to the nearest unit up the tree that meets a condition.
+    /// </summary>
+    /// <param name="unitId">The unit the chain starts from.</param>
+    /// <returns>The unit first, then its parent and so on up to the root; empty when the unit does not exist.</returns>
+    public IReadOnlyList<OrgUnitStatus> Ancestry(Guid unitId)
+    {
+        var chain = new List<OrgUnitStatus>();
+        var seen = new HashSet<Guid>();
+        Guid? id = unitId;
+        while (id is { } current && seen.Add(current) && Units.TryGetValue(current, out var unit))
+        {
+            chain.Add(unit);
+            id = unit.ParentId;
+        }
+
+        return chain;
+    }
+
+    /// <summary>
+    /// A unit and every unit below it, for rules a unit passes down to the units under it.
+    /// </summary>
+    /// <param name="unitId">The top of the subtree.</param>
+    /// <returns>The units of the subtree, active or not, top first; empty when the unit does not exist.</returns>
+    public IReadOnlyList<OrgUnitStatus> Subtree(Guid unitId)
+    {
+        if (!Units.TryGetValue(unitId, out var top))
+        {
+            return [];
+        }
+
+        var subtree = new List<OrgUnitStatus> { top };
+        var seen = new HashSet<Guid> { unitId };
+        for (var index = 0; index < subtree.Count; index++)
+        {
+            subtree.AddRange(children[subtree[index].Id].Where(child => seen.Add(child.Id)));
+        }
+
+        return subtree;
+    }
+
+    /// <summary>
+    /// The positions an employee of the unit may hold: those on its own list and on the lists of the units above it.
+    /// Whether each is still active is for the caller to check in <see cref="Positions"/>.
+    /// </summary>
+    /// <param name="unitId">The unit.</param>
+    /// <returns>The position identifiers; empty when the unit does not exist.</returns>
+    public IReadOnlySet<Guid> AvailablePositionIds(Guid unitId) =>
+        Ancestry(unitId).SelectMany(unit => UnitPositionIds[unit.Id]).ToHashSet();
+}
diff --git a/src/Competency.OrgStructure/OrgStructureDeskSource.cs b/src/Competency.OrgStructure/OrgStructureDeskSource.cs
new file mode 100644
index 0000000..37f00c1
--- /dev/null
+++ b/src/Competency.OrgStructure/OrgStructureDeskSource.cs
@@ -0,0 +1,150 @@
+using Competency.Platform;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.OrgStructure;
+
+/// <summary>
+/// What the organization structure expects of a global administrator, who alone may change it: units without a head or without positions,
+/// employees whose position their unit does not offer, positions out of use and empty units. Every user gets its prerequisites, other users nothing else.
+/// </summary>
+internal sealed class OrgStructureDeskSource(ICurrentActor actor, IEmployeeDirectory directory, AppDbContext context) : IDeskSource
+{
+    /// <inheritdoc />
+    public async Task<DeskReport> FindAsync(CancellationToken cancellationToken)
+    {
+        var snapshot = await directory.FindOrgSnapshotAsync(cancellationToken);
+        var prerequisites = Prerequisites(snapshot);
+        if (!actor.IsGlobalAdmin())
+        {
+            return new DeskReport([], prerequisites);
+        }
+
+        return new DeskReport(
+            [
+                .. UnitFindings(snapshot),
+                .. PositionFindings(snapshot),
+                .. await EmployeeFindingsAsync(snapshot, cancellationToken),
+            ],
+            prerequisites);
+    }
+
+    /// <summary>
+    /// Whether there is an active unit, an active position and a working employee.
+    /// Every signed-in user reads the tree, the catalogue and the working employees, so the facts reveal nothing.
+    /// </summary>
+    private static List<DeskPrerequisite> Prerequisites(OrgSnapshot snapshot)
+    {
+        var prerequisites = new List<DeskPrerequisite>();
+        if (snapshot.Units.Values.Any(unit => unit.IsActive))
+        {
+            prerequisites.Add(DeskPrerequisite.ActiveUnit);
+        }
+
+        if (snapshot.Positions.Values.Any(position => position.IsActive))
+        {
+            prerequisites.Add(DeskPrerequisite.ActivePosition);
+        }
+
+        if (snapshot.WorkingEmployeeCounts.Count > 0)
+        {
+            prerequisites.Add(DeskPrerequisite.WorkingEmployee);
+        }
+
+        return prerequisites;
+    }
+
+    /// <summary>
+    /// Units without a head; units whose employees can hold no position, because neither the unit nor any unit above it lists one;
+    /// and units with neither working employees nor active units under them, which can be deactivated.
+    /// </summary>
+    private static IEnumerable<DeskFinding> UnitFindings(OrgSnapshot snapshot)
+    {
+        var employeeCounts = snapshot.WorkingEmployeeCounts
+            .GroupBy(pair => pair.Key.OrgUnitId)
+            .ToDictionary(group => group.Key, group => group.Sum(pair => pair.Value));
+        var parentsOfActive = snapshot.Units.Values.Where(unit => unit.IsActive).Select(unit => unit.ParentId).ToHashSet();
+        foreach (var unit in snapshot.Units.Values.Where(unit => unit.IsActive))
+        {
+            var unitObject = snapshot.UnitDeskObject(unit);
+            var employeeCount = employeeCounts.GetValueOrDefault(unit.Id);
+            if (unit.HeadEmployeeId is null)
+            {
+                yield return new DeskFinding(DeskKind.UnitWithoutHead, unitObject, IsAction: true);
+            }
+
+            if (employeeCount > 0 && snapshot.AvailablePositionIds(unit.Id).Count == 0)
+            {
+                yield return new DeskFinding(DeskKind.UnitWithoutPositions, unitObject, IsAction: true, Details: new DeskDetails(EmployeeCount: employeeCount));
+            }
+
+            if (employeeCount == 0 && !parentsOfActive.Contains(unit.Id))
+            {
+                yield return new DeskFinding(DeskKind.EmptyUnit, unitObject, IsAction: false);
+            }
+        }
+    }
+
+    /// <summary>
+    /// Inactive positions working employees still hold, and active positions on no unit's list that no working employee holds.
+    /// </summary>
+    private static IEnumerable<DeskFinding> PositionFindings(OrgSnapshot snapshot)
+    {
+        var employeeCounts = snapshot.WorkingEmployeeCounts
+            .GroupBy(pair => pair.Key.PositionId)
+            .ToDictionary(group => group.Key, group => group.Sum(pair => pair.Value));
+        var listed = snapshot.UnitPositionIds.SelectMany(list => list).ToHashSet();
+        foreach (var position in snapshot.Positions.Values)
+        {
+            var positionObject = new DeskObject(DeskObjectType.Position, position.Id, position.Name);
+            var employeeCount = employeeCounts.GetValueOrDefault(position.Id);
+            if (!position.IsActive && employeeCount > 0)
+            {
+                yield return new DeskFinding(DeskKind.InactivePositionInUse, positionObject, IsAction: false, Details: new DeskDetails(EmployeeCount: employeeCount));
+            }
+
+            if (position.IsActive && employeeCount == 0 && !listed.Contains(position.Id))
+            {
+                yield return new DeskFinding(DeskKind.UnusedPosition, positionObject, IsAction: false);
+            }
+        }
+    }
+
+    /// <summary>
+    /// Working employees whose position is not among those their unit offers. The snapshot tells which unit and position pairs are wrong,
+    /// so only the employees of those units are read.
+    /// </summary>
+    private async Task<IEnumerable<DeskFinding>> EmployeeFindingsAsync(OrgSnapshot snapshot, CancellationToken cancellationToken)
+    {
+        var wrongPairs = snapshot.WorkingEmployeeCounts.Keys
+            .Where(pair => !snapshot.AvailablePositionIds(pair.OrgUnitId).Contains(pair.PositionId))
+            .ToHashSet();
+        if (wrongPairs.Count == 0)
+        {
+            return [];
+        }
+
+        var unitIds = wrongPairs.Select(pair => pair.OrgUnitId).Distinct().ToArray();
+        var employees = await context
+            .Set<Employee>()
+            .AsNoTracking()
+            .Where(employee => employee.IsActive && unitIds.Contains(employee.OrgUnitId))
+            .Select(employee => new { employee.Id, employee.FullName, employee.OrgUnitId, employee.PositionId })
+            .ToListAsync(cancellationToken);
+        return employees
+            .Where(employee => wrongPairs.Contains((employee.OrgUnitId, employee.PositionId)))
+            .Select(employee =>
+            {
+                var unit = snapshot.Units[employee.OrgUnitId];
+                var position = snapshot.Positions[employee.PositionId];
+                return new DeskFinding(
+                    DeskKind.PositionOutsideList,
+                    new DeskObject(DeskObjectType.Employee, employee.Id, employee.FullName, [unit.Name]),
+                    IsAction: true,
+                    Details: new DeskDetails(Entries:
+                    [
+                        new DeskObject(DeskObjectType.Position, position.Id, position.Name),
+                        new DeskObject(DeskObjectType.OrgUnit, unit.Id, unit.Name),
+                    ]));
+            });
+    }
+}
