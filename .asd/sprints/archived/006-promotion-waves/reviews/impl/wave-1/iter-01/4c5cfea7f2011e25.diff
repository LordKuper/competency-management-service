+using System.Text.Json.Serialization;
+
+namespace Competency.Promotion;
+
+/// <summary>
+/// What the signed-in user is to an application; one user can be several, except that its candidate is only ever its candidate.
+/// </summary>
+[Flags]
+[JsonConverter(typeof(JsonStringEnumConverter<ApplicationRole>))]
+internal enum ApplicationRole
+{
+    /// <summary>
+    /// Nothing: the application is not theirs to see.
+    /// </summary>
+    None = 0,
+
+    /// <summary>
+    /// The employee who filed it.
+    /// </summary>
+    Candidate = 1,
+
+    /// <summary>
+    /// A global administrator.
+    /// </summary>
+    Administrator = 2,
+
+    /// <summary>
+    /// The account that announced the wave.
+    /// </summary>
+    Author = 4,
+
+    /// <summary>
+    /// The responsible HR of the unit of the target.
+    /// </summary>
+    ResponsibleHr = 8,
+
+    /// <summary>
+    /// The head of the unit of the target.
+    /// </summary>
+    Head = 16,
+
+    /// <summary>
+    /// A member of the commission of the unit of the target, who acts; the responsible HR and the head are members.
+    /// </summary>
+    Member = 32,
+
+    /// <summary>
+    /// The chair of the commission of the unit of the target, who acts; the chair is a member.
+    /// </summary>
+    Chair = 64,
+}
diff --git a/src/Competency.Promotion/ApplicationRules.cs b/src/Competency.Promotion/ApplicationRules.cs
new file mode 100644
index 00000000..b77aa4c9
--- /dev/null
+++ b/src/Competency.Promotion/ApplicationRules.cs
@@ -0,0 +1,230 @@
+using Competency.CareerFramework;
+using Competency.OrgStructure;
+using Competency.Platform;
+using Competency.UserManagement;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.Promotion;
+
+/// <summary>
+/// Checks what a candidate puts in an application: a target the wave offers and the candidate may aim at, scores on the scale of its version and raters who can rate. A draft
+/// may leave scores and raters out; the check made when the application is filed wants a score for every competency and enough raters.
+/// A caller holds the promotion locks first. Scoped to a request, because it shares the request's database context.
+/// </summary>
+internal sealed class ApplicationRules(AppDbContext context, ICareerModel career, IEmployeeDirectory employees, IUserDirectory users, RaterExclusions exclusions)
+{
+    /// <summary>
+    /// The raters a filed application needs, at the least.
+    /// </summary>
+    public const int MinRaters = 5;
+
+    /// <summary>
+    /// The raters from units other than the candidate's own a filed application needs, at the least.
+    /// </summary>
+    public const int MinRatersOutsideUnit = 2;
+
+    private const string MatrixField = "matrixId";
+    private const string LevelField = "levelId";
+    private const string ScoresField = "selfScores";
+    private const string RatersField = "raters";
+
+    /// <summary>
+    /// Checks the content of an application against the wave.
+    /// </summary>
+    /// <param name="wave">The wave.</param>
+    /// <param name="request">The content.</param>
+    /// <param name="candidate">The candidate.</param>
+    /// <param name="isComplete">Whether the content must be complete, as it must when the application is filed.</param>
+    /// <param name="applicationId">The application being edited, whose raters already listed stay whatever the exclusion list says; null for a new one.</param>
+    /// <param name="cancellationToken">Cancels the lookups.</param>
+    /// <returns>The target when the request names one the wave offers, and the problems found by field name; the content is valid when there are none.</returns>
+    public async Task<(ResolvedTarget? Target, Dictionary<string, string[]> Errors)> CheckAsync(
+        PromotionWave wave,
+        ApplicationRequest request,
+        EmployeeStatus candidate,
+        bool isComplete,
+        Guid? applicationId,
+        CancellationToken cancellationToken)
+    {
+        var errors = new Dictionary<string, string[]>();
+        var matrix = await context.Set<PromotionWaveMatrix>()
+            .AsNoTracking()
+            .FirstOrDefaultAsync(bound => bound.WaveId == wave.Id && bound.OrgUnitId == request.OrgUnitId && bound.MatrixId == request.MatrixId, cancellationToken);
+        if (matrix is null || await career.VersionAsync(matrix.VersionId, cancellationToken) is not { } version)
+        {
+            errors[MatrixField] = ["Выберите подразделение и трек из предложенных"];
+            return (null, errors);
+        }
+
+        var level = version.Levels.FirstOrDefault(candidateLevel => candidateLevel.Id == request.LevelId);
+        if (level is null || !(await AllowedLevelIdsAsync(matrix, version, candidate, cancellationToken)).Contains(level.Id))
+        {
+            errors[LevelField] = ["Выберите уровень из предложенных"];
+        }
+
+        var scores = request.SelfScores.Select(score => (score.CompetencyId, (int?)score.Score)).ToList();
+        await AddContentProblemsAsync(errors, version, scores, request.Raters, candidate, isComplete, applicationId, cancellationToken);
+        return (errors.ContainsKey(LevelField) ? null : new ResolvedTarget(matrix, version, level!), errors);
+    }
+
+    /// <summary>
+    /// Finds the levels of a bound matrix the candidate may aim at: on the track of their position only the next level, on any other track every level.
+    /// </summary>
+    /// <param name="matrix">The matrix the wave bound for a unit.</param>
+    /// <param name="version">The bound version of that matrix.</param>
+    /// <param name="candidate">The candidate.</param>
+    /// <param name="cancellationToken">Cancels the lookup.</param>
+    /// <returns>The identifiers of the allowed levels, in the order of the version.</returns>
+    public async Task<IReadOnlyList<Guid>> AllowedLevelIdsAsync(PromotionWaveMatrix matrix, CareerVersion version, EmployeeStatus candidate, CancellationToken cancellationToken)
+    {
+        var bound = new PublishedTrackMatrix(matrix.OrgUnitId, matrix.MatrixId, matrix.VersionId, VersionNumber: 0, matrix.TrackId, matrix.TrackName, version.Levels);
+        return (await career.AllowedTargetLevelsAsync(candidate.PositionId, [bound], cancellationToken))[matrix.MatrixId];
+    }
+
+    /// <summary>
+    /// Checks a draft that is being filed: the whole content it holds must be complete.
+    /// </summary>
+    /// <param name="application">The draft.</param>
+    /// <param name="candidate">The candidate.</param>
+    /// <param name="cancellationToken">Cancels the lookups.</param>
+    /// <returns>The problems found by field name; the application may be filed when there are none.</returns>
+    public async Task<Dictionary<string, string[]>> CheckFiledAsync(PromotionApplication application, EmployeeStatus candidate, CancellationToken cancellationToken)
+    {
+        var errors = new Dictionary<string, string[]>();
+        var version = (await career.VersionAsync(application.VersionId, cancellationToken))!;
+        var scores = await context.Set<PromotionSelfScore>()
+            .AsNoTracking()
+            .Where(score => score.ApplicationId == application.Id)
+            .Select(score => new { score.CompetencyId, score.Score })
+            .ToListAsync(cancellationToken);
+        var raters = await context.Set<PromotionRater>()
+            .AsNoTracking()
+            .Where(rater => rater.ApplicationId == application.Id)
+            .Select(rater => new RaterInput(rater.EmployeeId, rater.Email))
+            .ToListAsync(cancellationToken);
+        await AddContentProblemsAsync(errors, version, [.. scores.Select(score => (score.CompetencyId, (int?)score.Score))], raters, candidate, isComplete: true, application.Id, cancellationToken);
+        return errors;
+    }
+
+    /// <summary>
+    /// Says why employees cannot be the raters of a candidate: they must exist, work, not be the candidate and not have a blocked account, and one
+    /// without an account needs an address that is free. A complete list also has at least five raters, at least two of them from other units than the candidate's own. An employee on the exclusion list
+    /// cannot be added, but one already on the application's list stays.
+    /// </summary>
+    /// <param name="candidate">The candidate.</param>
+    /// <param name="raters">The proposed raters.</param>
+    /// <param name="isComplete">Whether the list must meet the minimums and every rater without an account must have an address.</param>
+    /// <param name="applicationId">The application whose list is being replaced; null for a new one.</param>
+    /// <param name="cancellationToken">Cancels the lookups.</param>
+    /// <returns>One line per problem, addressed to the user; empty when the raters are fine.</returns>
+    public async Task<List<string>> RaterProblemsAsync(
+        EmployeeStatus candidate,
+        IReadOnlyCollection<RaterInput> raters,
+        bool isComplete,
+        Guid? applicationId,
+        CancellationToken cancellationToken)
+    {
+        var listed = raters.GroupBy(rater => rater.EmployeeId).Select(group => group.First()).ToList();
+        var ids = listed.Select(rater => rater.EmployeeId).ToList();
+        var people = await employees.FindManyAsync(ids, cancellationToken);
+        var accounts = await users.FindByEmployeeIdsAsync(ids, cancellationToken);
+        List<string> problems = [];
+        if (ids.Contains(candidate.Id))
+        {
+            problems.Add("Кандидат не может оценивать себя");
+        }
+
+        problems.AddRange(await ExclusionProblemsAsync(people, applicationId, cancellationToken));
+
+        foreach (var rater in listed.Where(rater => rater.EmployeeId != candidate.Id))
+        {
+            problems.AddRange(await RaterProblemsAsync(rater, people, accounts, isComplete, cancellationToken));
+        }
+
+        if (listed.Where(rater => !accounts.ContainsKey(rater.EmployeeId) && !string.IsNullOrWhiteSpace(rater.Email))
+            .GroupBy(rater => rater.Email!.Trim(), StringComparer.OrdinalIgnoreCase)
+            .Any(group => group.Count() > 1))
+        {
+            problems.Add("У разных оценивающих не может быть одной и той же почты");
+        }
+
+        if (isComplete && ids.Count < MinRaters)
+        {
+            problems.Add($"Укажите не меньше {MinRaters} оценивающих");
+        }
+
+        if (isComplete && people.Values.Count(person => person.OrgUnitId != candidate.OrgUnitId) < MinRatersOutsideUnit)
+        {
+            problems.Add($"Не меньше {MinRatersOutsideUnit} оценивающих должны быть из других подразделений");
+        }
+
+        return problems;
+    }
+
+    /// <summary>
+    /// Says which employees cannot be added to the list of an application because the exclusion list names them or their position.
+    /// </summary>
+    /// <param name="people">The proposed raters that exist.</param>
+    /// <param name="applicationId">The application whose list is being replaced; null for a new one.</param>
+    /// <param name="cancellationToken">Cancels the lookups.</param>
+    /// <returns>One line per employee who cannot be added; empty when none is excluded or newly added.</returns>
+    public async Task<List<string>> ExclusionProblemsAsync(IReadOnlyDictionary<Guid, EmployeeStatus> people, Guid? applicationId, CancellationToken cancellationToken)
+    {
+        var listed = applicationId is { } id
+            ? await context.Set<PromotionRater>().AsNoTracking().Where(rater => rater.ApplicationId == id).Select(rater => rater.EmployeeId).ToListAsync(cancellationToken)
+            : [];
+        var excluded = await exclusions.AmongAsync(people.Values.Where(person => !listed.Contains(person.Id)), cancellationToken);
+        return [.. people.Values.Where(person => excluded.Contains(person.Id)).Select(person => $"Указание сотрудника «{person.FullName}» запрещено")];
+    }
+
+    private async Task AddContentProblemsAsync(
+        Dictionary<string, string[]> errors,
+        CareerVersion version,
+        IReadOnlyCollection<(Guid CompetencyId, int? Score)> scores,
+        IReadOnlyCollection<RaterInput> raters,
+        EmployeeStatus candidate,
+        bool isComplete,
+        Guid? applicationId,
+        CancellationToken cancellationToken)
+    {
+        if (ScoreRules.Problems(version, scores, allowNotObserved: false, requireAll: isComplete) is { Count: > 0 } scoreProblems)
+        {
+            errors[ScoresField] = [.. scoreProblems];
+        }
+
+        if (await RaterProblemsAsync(candidate, raters, isComplete, applicationId, cancellationToken) is { Count: > 0 } raterProblems)
+        {
+            errors[RatersField] = [.. raterProblems];
+        }
+    }
+
+    private async Task<List<string>> RaterProblemsAsync(
+        RaterInput rater,
+        IReadOnlyDictionary<Guid, EmployeeStatus> people,
+        IReadOnlyDictionary<Guid, UserStatus> accounts,
+        bool isComplete,
+        CancellationToken cancellationToken)
+    {
+        if (!people.TryGetValue(rater.EmployeeId, out var person))
+        {
+            return ["Сотрудник не найден"];
+        }
+
+        if (!person.IsActive)
+        {
+            return [$"Сотрудник «{person.FullName}» не работает"];
+        }
+
+        if (accounts.TryGetValue(rater.EmployeeId, out var account))
+        {
+            return account.IsBlocked ? [$"У сотрудника «{person.FullName}» заблокирована учётная запись"] : [];
+        }
+
+        if (string.IsNullOrWhiteSpace(rater.Email))
+        {
+            return isComplete ? [$"Укажите электронную почту сотрудника «{person.FullName}»: у него нет учётной записи"] : [];
+        }
+
+        return await users.EmailProblemAsync(rater.Email, cancellationToken) is { } problem ? [$"Почта сотрудника «{person.FullName}»: {problem}"] : [];
+    }
+}
diff --git a/src/Competency.Promotion/ApplicationStageEndpoints.cs b/src/Competency.Promotion/ApplicationStageEndpoints.cs
new file mode 100644
index 00000000..87834c71
--- /dev/null
+++ b/src/Competency.Promotion/ApplicationStageEndpoints.cs
@@ -0,0 +1,439 @@
+using Competency.CareerFramework;
+using Competency.OrgStructure;
+using Competency.Platform;
+using Competency.UserManagement;
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Http.HttpResults;
+using Microsoft.AspNetCore.Routing;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.Promotion;
+
+/// <summary>
+/// The parts of an application filled in around the stages: the responsible HR of the unit of the target enters the dates for the formal check from
+/// the moment the application is filed until that stage ends, the candidate lists the raters in the draft and the head of that unit corrects them
+/// over the same period, the head or the responsible HR confirms the address of a rater without an account, the candidate adds artifacts in the draft
+/// and while they are collected, sends the application to the commission when it owes artifacts, and marks the feedback as received. Each change takes the promotion locks and the rows of the wave and the application.
+/// </summary>
+internal static class ApplicationStageEndpoints
+{
+    private const string Route = "/api/v1/promotion/applications/{id:guid}";
+    private const string Tag = "Promotion";
+    private const string DateField = "hiredOrPromotedOn";
+    private const string FutureDateMessage = "Дата не позже сегодняшнего дня";
+    private const string FormalClosedMessage = "Даты вносятся с отправки заявки до конца этапа «Формальная проверка»";
+    private const string ArtifactsClosedMessage = "Артефакты добавляют в черновике и на этапе «Сбор артефактов» до отправки на рассмотрение";
+    private const string SendClosedMessage = "Заявку можно отправить на рассмотрение на этапе «Сбор артефактов», пока она ещё не у комиссии";
+    private const string NoChairMessage = "У комиссии подразделения нет председателя, заявку пока нельзя отправить";
+    private const string FeedbackClosedMessage = "Отметку можно поставить после публикации результатов, на этапе «Обратная связь»";
+    private const string RatersClosedMessage = "Список оценивающих меняет кандидат в черновике, а руководитель — с отправки заявки до конца этапа «Формальная проверка»";
+    private const string EmailClosedMessage = "Почту подтверждают с отправки заявки до конца этапа «Формальная проверка»";
+    private const string RaterNotFoundMessage = "Этого сотрудника нет среди оценивающих";
+    private const string RaterHasAccountMessage = "У сотрудника есть учётная запись, почта не нужна";
+    private const string EmailRepeatedMessage = "У другого оценивающего этой заявки уже указана такая почта";
+
+    private static readonly ApplicationStatus[] ArtifactStatuses = [ApplicationStatus.Admitted, ApplicationStatus.UnderReview, ApplicationStatus.Decided];
+
+    public static void Map(IEndpointRouteBuilder endpoints)
+    {
+        var group = endpoints.MapGroup(Route)
+            .WithTags(Tag)
+            .RequireAuthorization(AuthorizationPolicies.Authenticated)
+            .ProducesProblem(StatusCodes.Status401Unauthorized)
+            .ProducesProblem(StatusCodes.Status403Forbidden)
+            .ProducesProblem(StatusCodes.Status404NotFound)
+            .ProducesProblem(StatusCodes.Status409Conflict);
+
+        group.MapPut("/formal", UpdateFormalAsync).WithName("UpdatePromotionApplicationFormal").ProducesETag();
+        group.MapPut("/raters", UpdateRatersAsync).WithName("UpdatePromotionApplicationRaters").ProducesETag();
+        group.MapPut("/raters/{employeeId:guid}/email", UpdateRaterEmailAsync).WithName("UpdatePromotionRaterEmail").ProducesETag();
+        group.MapPut("/artifacts", UpdateArtifactsAsync).WithName("UpdatePromotionApplicationArtifacts").ProducesETag();
+        group.MapPost("/send-to-review", SendToReviewAsync).WithName("SendPromotionApplicationToReview").ProducesETag();
+        group.MapPost("/feedback", MarkFeedbackAsync).WithName("MarkPromotionFeedbackReceived").ProducesETag();
+    }
+
+    /// <summary>
+    /// Enters the date of hiring or of the last promotion and whether the interval is ignored, for the responsible HR of the unit of the target from
+    /// the moment the application is filed until the formal check stage ends. The answer carries the result the check would give now.
+    /// </summary>
+    private static async Task<Results<Ok<ApplicationResponse>, NotFound, ValidationProblem, ProblemHttpResult>> UpdateFormalAsync(
+        Guid id,
+        FormalRequest request,
+        IfMatch ifMatch,
+        AppDbContext context,
+        PromotionLocks locks,
+        PromotionCalendar calendar,
+        ApplicationAccess access,
+        ApplicationReader reader,
+        ICurrentActor actor,
+        TimeProvider time,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        if (request.HiredOrPromotedOn > calendar.Today)
+        {
+            return Rejection.Invalid(DateField, FutureDateMessage);
+        }
+
+        await using var transaction = await locks.BeginSharedAsync(cancellationToken);
+        if (await locks.FindApplicationForUpdateAsync(id, cancellationToken) is not var (wave, application))
+        {
+            return TypedResults.NotFound();
+        }
+
+        var roles = (await access.ViewerAsync(wave, [application.OrgUnitId], cancellationToken)).RolesOf(application);
+        if (roles == ApplicationRole.None)
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (!roles.HasFlag(ApplicationRole.ResponsibleHr))
+        {
+            return Rejection.Forbidden();
+        }
+
+        if (!IsListOpen(calendar.StageOf(wave), application))
+        {
+            return Rejection.Conflict(FormalClosedMessage);
+        }
+
+        ifMatch.ApplyTo(context, application);
+        application.HiredOrPromotedOn = request.HiredOrPromotedOn;
+        if (request.IgnoreInterval != application.IgnoreInterval)
+        {
+            application.IgnoreInterval = request.IgnoreInterval;
+            application.IgnoreIntervalBy = request.IgnoreInterval ? actor.UserId : null;
+            application.IgnoreIntervalAt = request.IgnoreInterval ? time.GetUtcNow() : null;
+        }
+
+        await context.SaveChangesAsync(cancellationToken);
+        await transaction.CommitAsync(cancellationToken);
+
+        response.SetETag(application.Version);
+        return TypedResults.Ok(await reader.DescribeAsync(application, wave, roles, cancellationToken));
+    }
+
+    /// <summary>
+    /// Replaces the raters of an application: by the candidate in the draft, by the head of the unit of the target from the moment the application is
+    /// filed until the formal check stage ends, when the list becomes final. A draft may hold fewer raters than the minimum, a filed application may not.
+    /// An address the head enters or changes is confirmed by that.
+    /// </summary>
+    private static async Task<Results<Ok<ApplicationResponse>, NotFound, ValidationProblem, ProblemHttpResult>> UpdateRatersAsync(
+        Guid id,
+        RatersRequest request,
+        IfMatch ifMatch,
+        AppDbContext context,
+        PromotionLocks locks,
+        PromotionCalendar calendar,
+        ApplicationAccess access,
+        ApplicationRules rules,
+        ApplicationReader reader,
+        IEmployeeDirectory employees,
+        IUserDirectory users,
+        ICurrentActor actor,
+        TimeProvider time,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        var shapeErrors = request.Validate();
+        if (shapeErrors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(shapeErrors);
+        }
+
+        await using var transaction = await locks.BeginSharedAsync(cancellationToken);
+        if (await locks.FindApplicationForUpdateAsync(id, cancellationToken) is not var (wave, application))
+        {
+            return TypedResults.NotFound();
+        }
+
+        var roles = (await access.ViewerAsync(wave, [application.OrgUnitId], cancellationToken)).RolesOf(application);
+        if (roles == ApplicationRole.None)
+        {
+            return TypedResults.NotFound();
+        }
+
+        var isCandidate = roles == ApplicationRole.Candidate;
+        if (!isCandidate && !roles.HasFlag(ApplicationRole.Head))
+        {
+            return Rejection.Forbidden();
+        }
+
+        var stage = calendar.StageOf(wave);
+        if (isCandidate ? stage != PromotionStage.Submission || application.Status != ApplicationStatus.Draft : !IsListOpen(stage, application))
+        {
+            return Rejection.Conflict(RatersClosedMessage);
+        }
+
+        ifMatch.ApplyTo(context, application);
+        var candidate = (await employees.FindAsync(application.EmployeeId, cancellationToken))!;
+        if (await rules.RaterProblemsAsync(candidate, request.Raters, isComplete: !isCandidate, application.Id, cancellationToken) is { Count: > 0 } problems)
+        {
+            return TypedResults.ValidationProblem(new Dictionary<string, string[]> { ["raters"] = [.. problems] });
+        }
+
+        var edit = new RaterEdit(request.Raters, isCandidate ? RaterSource.Candidate : RaterSource.Head, isCandidate ? null : actor.UserId, time.GetUtcNow());
+        await ApplicationContent.ReplaceRatersAsync(context, users, application.Id, edit, cancellationToken);
+        context.Entry(application).Property(entry => entry.Version).IsModified = true;
+        await context.SaveChangesAsync(cancellationToken);
+        await transaction.CommitAsync(cancellationToken);
+
+        response.SetETag(application.Version);
+        return TypedResults.Ok(await reader.DescribeAsync(application, wave, roles, cancellationToken));
+    }
+
+    /// <summary>
+    /// Enters or confirms the address of a rater who has no account, for the head of the unit of the target and for the responsible HR, from the moment
+    /// the application is filed until the formal check stage ends. The invitation goes only to a confirmed address.
+    /// </summary>
+    private static async Task<Results<Ok<ApplicationResponse>, NotFound, ValidationProblem, ProblemHttpResult>> UpdateRaterEmailAsync(
+        Guid id,
+        Guid employeeId,
+        RaterEmailRequest request,
+        IfMatch ifMatch,
+        AppDbContext context,
+        PromotionLocks locks,
+        PromotionCalendar calendar,
+        ApplicationAccess access,
+        ApplicationRules rules,
+        ApplicationReader reader,
+        IEmployeeDirectory employees,
+        IUserDirectory users,
+        ICurrentActor actor,
+        TimeProvider time,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        await using var transaction = await locks.BeginSharedAsync(cancellationToken);
+        if (await locks.FindApplicationForUpdateAsync(id, cancellationToken) is not var (wave, application))
+        {
+            return TypedResults.NotFound();
+        }
+
+        var roles = (await access.ViewerAsync(wave, [application.OrgUnitId], cancellationToken)).RolesOf(application);
+        if (roles == ApplicationRole.None)
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (!roles.HasFlag(ApplicationRole.Head) && !roles.HasFlag(ApplicationRole.ResponsibleHr))
+        {
+            return Rejection.Forbidden();
+        }
+
+        if (!IsListOpen(calendar.StageOf(wave), application))
+        {
+            return Rejection.Conflict(EmailClosedMessage);
+        }
+
+        var raters = await context.Set<PromotionRater>().Where(rater => rater.ApplicationId == id).ToListAsync(cancellationToken);
+        if (raters.FirstOrDefault(item => item.EmployeeId == employeeId) is not { } rater)
+        {
+            return Rejection.Invalid("employeeId", RaterNotFoundMessage);
+        }
+
+        var email = request.Email?.Trim() ?? string.Empty;
+        if ((await users.FindByEmployeeIdsAsync([employeeId], cancellationToken)).ContainsKey(employeeId))
+        {
+            return Rejection.Conflict(RaterHasAccountMessage);
+        }
+
+        if (await users.EmailProblemAsync(email, cancellationToken) is { } problem)
+        {
+            return Rejection.Invalid("email", problem);
+        }
+
+        if (raters.Any(other => other.EmployeeId != employeeId && string.Equals(other.Email, email, StringComparison.OrdinalIgnoreCase)))
+        {
+            return Rejection.Invalid("email", EmailRepeatedMessage);
+        }
+
+        if (await employees.FindAsync(employeeId, cancellationToken) is { } person
+            && await rules.ExclusionProblemsAsync(new Dictionary<Guid, EmployeeStatus> { [employeeId] = person }, applicationId: null, cancellationToken) is { Count: > 0 } exclusion)
+        {
+            return Rejection.Invalid("employeeId", exclusion[0]);
+        }
+
+        ifMatch.ApplyTo(context, application);
+        rater.Email = email;
+        rater.EmailConfirmedBy = actor.UserId;
+        rater.EmailConfirmedAt = time.GetUtcNow();
+        context.Entry(application).Property(entry => entry.Version).IsModified = true;
+        await context.SaveChangesAsync(cancellationToken);
+        await transaction.CommitAsync(cancellationToken);
+
+        response.SetETag(application.Version);
+        return TypedResults.Ok(await reader.DescribeAsync(application, wave, roles, cancellationToken));
+    }
+
+    /// <summary>
+    /// Replaces the artifacts of an application in the draft and while they are collected, until the candidate sends the application to the commission;
+    /// the candidate gives them for any competency of the version.
+    /// </summary>
+    private static async Task<Results<Ok<ApplicationResponse>, NotFound, ValidationProblem, ProblemHttpResult>> UpdateArtifactsAsync(
+        Guid id,
+        ArtifactsRequest request,
+        IfMatch ifMatch,
+        AppDbContext context,
+        PromotionLocks locks,
+        PromotionCalendar calendar,
+        ApplicationAccess access,
+        ICareerModel career,
+        ApplicationReader reader,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        var shapeErrors = request.Validate();
+        if (shapeErrors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(shapeErrors);
+        }
+
+        await using var transaction = await locks.BeginSharedAsync(cancellationToken);
+        if (await locks.FindApplicationForUpdateAsync(id, cancellationToken) is not var (wave, application))
+        {
+            return TypedResults.NotFound();
+        }
+
+        var roles = (await access.ViewerAsync(wave, [application.OrgUnitId], cancellationToken)).RolesOf(application);
+        if (roles == ApplicationRole.None)
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (roles != ApplicationRole.Candidate)
+        {
+            return Rejection.Forbidden();
+        }
+
+        var stage = calendar.StageOf(wave);
+        var isDraft = stage == PromotionStage.Submission && application.Status == ApplicationStatus.Draft;
+        var isCollecting = stage == PromotionStage.Artifacts && ArtifactStatuses.Contains(application.Status) && !application.IsSentToReview;
+        if (!isDraft && !isCollecting)
+        {
+            return Rejection.Conflict(ArtifactsClosedMessage);
+        }
+
+        ifMatch.ApplyTo(context, application);
+        var version = (await career.VersionAsync(application.VersionId, cancellationToken))!;
+        if (request.Artifacts.Any(artifact => version.Competencies.All(competency => competency.Id != artifact.CompetencyId)))
+        {
+            return Rejection.Invalid("artifacts", "Среди компетенций есть не входящая в матрицу");
+        }
+
+        await ApplicationContent.ReplaceArtifactsAsync(context, application.Id, request.Artifacts, cancellationToken);
+        context.Entry(application).Property(entry => entry.Version).IsModified = true;
+        await context.SaveChangesAsync(cancellationToken);
+        await transaction.CommitAsync(cancellationToken);
+
+        response.SetETag(application.Version);
+        return TypedResults.Ok(await reader.DescribeAsync(application, wave, roles, cancellationToken));
+    }
+
+    /// <summary>
+    /// Sends the application of a candidate who owes artifacts to the commission while the artifacts are collected, with whatever artifacts are given.
+    /// The answer names the competencies still without an artifact, so the candidate was shown them before sending.
+    /// </summary>
+    private static async Task<Results<Ok<ApplicationResponse>, NotFound, ProblemHttpResult>> SendToReviewAsync(
+        Guid id,
+        IfMatch ifMatch,
+        AppDbContext context,
+        PromotionLocks locks,
+        PromotionCalendar calendar,
+        ApplicationAccess access,
+        StageActions actions,
+        ApplicationReader reader,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        await using var transaction = await locks.BeginSharedAsync(cancellationToken);
+        if (await locks.FindApplicationForUpdateAsync(id, cancellationToken) is not var (wave, application))
+        {
+            return TypedResults.NotFound();
+        }
+
+        var roles = (await access.ViewerAsync(wave, [application.OrgUnitId], cancellationToken)).RolesOf(application);
+        if (roles == ApplicationRole.None)
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (roles != ApplicationRole.Candidate)
+        {
+            return Rejection.Forbidden();
+        }
+
+        if (calendar.StageOf(wave) != PromotionStage.Artifacts || application.Status != ApplicationStatus.Admitted || application.MeetsAfterRating != false)
+        {
+            return Rejection.Conflict(SendClosedMessage);
+        }
+
+        ifMatch.ApplyTo(context, application);
+        if (!await actions.SendToReviewAsync(application, cancellationToken))
+        {
+            return Rejection.Conflict(NoChairMessage);
+        }
+
+        await context.SaveChangesAsync(cancellationToken);
+        await transaction.CommitAsync(cancellationToken);
+
+        response.SetETag(application.Version);
+        return TypedResults.Ok(await reader.DescribeAsync(application, wave, roles, cancellationToken));
+    }
+
+    /// <summary>
+    /// Marks that the candidate received the feedback, which they may do from the publication of the results until the wave ends. Marking again changes nothing.
+    /// </summary>
+    private static async Task<Results<Ok<ApplicationResponse>, NotFound, ProblemHttpResult>> MarkFeedbackAsync(
+        Guid id,
+        IfMatch ifMatch,
+        AppDbContext context,
+        PromotionLocks locks,
+        PromotionCalendar calendar,
+        ApplicationAccess access,
+        ApplicationReader reader,
+        TimeProvider time,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        await using var transaction = await locks.BeginSharedAsync(cancellationToken);
+        if (await locks.FindApplicationForUpdateAsync(id, cancellationToken) is not var (wave, application))
+        {
+            return TypedResults.NotFound();
+        }
+
+        var roles = (await access.ViewerAsync(wave, [application.OrgUnitId], cancellationToken)).RolesOf(application);
+        if (roles == ApplicationRole.None)
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (roles != ApplicationRole.Candidate)
+        {
+            return Rejection.Forbidden();
+        }
+
+        if (calendar.StageOf(wave) != PromotionStage.Feedback || application.Status is not (ApplicationStatus.Decided or ApplicationStatus.NoDecision))
+        {
+            return Rejection.Conflict(FeedbackClosedMessage);
+        }
+
+        ifMatch.ApplyTo(context, application);
+        application.FeedbackReceivedAt ??= time.GetUtcNow();
+        await context.SaveChangesAsync(cancellationToken);
+        await transaction.CommitAsync(cancellationToken);
+
+        response.SetETag(application.Version);
+        return TypedResults.Ok(await reader.DescribeAsync(application, wave, roles, cancellationToken));
+    }
+
+    /// <summary>
+    /// Whether the list of raters of a filed application may still be changed: from the moment it is filed until the formal check stage ends.
+    /// </summary>
+    /// <param name="stage">The stage the wave is in now.</param>
+    /// <param name="application">The application.</param>
+    /// <returns><see langword="true"/> while the list may change.</returns>
+    internal static bool IsListOpen(int stage, PromotionApplication application) =>
+        stage is PromotionStage.Submission or PromotionStage.FormalCheck && application.Status == ApplicationStatus.Submitted;
+}
