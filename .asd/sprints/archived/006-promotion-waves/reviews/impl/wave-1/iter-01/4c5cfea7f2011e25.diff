+      key: "artifacts",
+      render: (_, competency) => {
+        const count = artifactCountOf(items, competency.id);
+        const isOpen = openIds.includes(competency.id);
+        return (
+          <Flex align="center" gap="small" wrap>
+            {count > 0 && <Tag color="success">Приложено {count}</Tag>}
