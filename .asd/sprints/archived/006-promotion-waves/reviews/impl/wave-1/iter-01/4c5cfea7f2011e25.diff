@@ -0,0 +1,83 @@
+import {
+  keepPreviousData,
+  useMutation,
+  useQuery,
+  useQueryClient,
+} from "@tanstack/react-query";
+import { Skeleton } from "antd";
+import { useState } from "react";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import { useDebouncedValue } from "../../app/useDebouncedValue";
+import { positionListQuery } from "../positions/positionsApi";
+import { ExclusionsView } from "./ExclusionsView";
+import {
+  addExcludedEmployee,
+  addExcludedPosition,
+  promotionQueryKey,
+  raterExclusionsQuery,
+  removeExcludedEmployee,
+  removeExcludedPosition,
+} from "./promotionApi";
+import { useEmployeeOptions } from "./useEmployeeOptions";
+
+const POSITION_OPTIONS_PAGE_SIZE = 20;
+
+/** The lists of people and positions that cannot be named as raters, read and changed one entry at a time. */
+export function ExclusionsPanel() {
+  const queryClient = useQueryClient();
+  const { data, error, isPending, refetch } = useQuery(raterExclusionsQuery);
+  const employees = useEmployeeOptions("exclusion-picker");
+  const [positionSearch, setPositionSearch] = useState("");
+  const positionText = useDebouncedValue(positionSearch.trim());
+  const found = useQuery({
+    ...positionListQuery({
+      q: positionText || undefined,
+      isActive: true,
+      page: 1,
+      pageSize: POSITION_OPTIONS_PAGE_SIZE,
+    }),
+    placeholderData: keepPreviousData,
+  });
+  const change = useMutation({
+    mutationFn: (apply: () => Promise<unknown>) => apply(),
+    onSettled: () =>
+      queryClient.invalidateQueries({ queryKey: promotionQueryKey }),
+  });
+  if (isPending) return <Skeleton active />;
+  if (error) {
+    return (
+      <ErrorAlert
+        title="Не удалось загрузить списки запрета"
+        error={error}
+        onRetry={() => void refetch()}
+      />
+    );
+  }
+  return (
+    <>
+      {change.isError && (
+        <ErrorAlert title="Список не изменён" error={change.error} />
+      )}
+      <ExclusionsView
+        exclusions={data}
+        employees={employees.candidates}
+        isSearchingEmployees={employees.isSearching}
+        onSearchEmployees={employees.onSearch}
+        positions={found.data?.items ?? []}
+        isSearchingPositions={
+          found.isFetching || positionSearch.trim() !== positionText
+        }
+        onSearchPositions={setPositionSearch}
+        isBusy={change.isPending}
+        onAddEmployee={(id) => change.mutate(() => addExcludedEmployee(id))}
+        onRemoveEmployee={(id) =>
+          change.mutate(() => removeExcludedEmployee(id))
+        }
+        onAddPosition={(id) => change.mutate(() => addExcludedPosition(id))}
+        onRemovePosition={(id) =>
+          change.mutate(() => removeExcludedPosition(id))
+        }
+      />
+    </>
+  );
+}
diff --git a/web/src/features/promotion/ExclusionsView.tsx b/web/src/features/promotion/ExclusionsView.tsx
new file mode 100644
index 00000000..0e4a3c64
--- /dev/null
+++ b/web/src/features/promotion/ExclusionsView.tsx
@@ -0,0 +1,206 @@
+import {
+  Button,
+  Col,
+  Flex,
+  Row,
+  Select,
+  Table,
+  type TableColumnsType,
+  Typography,
+} from "antd";
+import type { EmployeeOption } from "./CommissionView";
+import { Panel } from "./Panel";
+import type { RaterExclusions } from "./promotionApi";
+
+type ExcludedEmployee = RaterExclusions["employees"][number];
+type ExcludedPosition = RaterExclusions["positions"][number];
+
+/** A position the search offers to forbid. */
+export interface PositionOption {
+  id: string;
+  name: string;
+}
+
+interface ExclusionsViewProps {
+  exclusions: RaterExclusions;
+  /** Employees the last search found. */
+  employees: readonly EmployeeOption[];
+  isSearchingEmployees: boolean;
+  onSearchEmployees: (text: string) => void;
+  /** Positions the last search found. */
+  positions: readonly PositionOption[];
+  isSearchingPositions: boolean;
+  onSearchPositions: (text: string) => void;
+  /** Whether a change is on its way, which locks the lists until the server answers. */
+  isBusy: boolean;
+  onAddEmployee: (employeeId: string) => void;
+  onRemoveEmployee: (employeeId: string) => void;
+  onAddPosition: (positionId: string) => void;
+  onRemovePosition: (positionId: string) => void;
+}
+
+interface AddSelectProps {
+  label: string;
+  placeholder: string;
+  options: readonly { value: string; label: string; detail?: string }[];
+  isSearching: boolean;
+  isBusy: boolean;
+  onSearch: (text: string) => void;
+  onAdd: (id: string) => void;
+}
+
+function AddSelect({
+  label,
+  placeholder,
+  options,
+  isSearching,
+  isBusy,
+  onSearch,
+  onAdd,
+}: AddSelectProps) {
+  return (
+    <Select<string | null>
+      showSearch={{ filterOption: false, onSearch }}
+      aria-label={label}
+      placeholder={placeholder}
+      value={null}
+      options={[...options]}
+      loading={isSearching}
+      disabled={isBusy}
+      optionRender={(option) => (
+        <Flex vertical>
+          <span>{option.label}</span>
+          <Typography.Text type="secondary">
+            {options.find((item) => item.value === option.value)?.detail}
+          </Typography.Text>
+        </Flex>
+      )}
+      notFoundContent="Ничего не найдено. Измените запрос."
+      onSelect={(id) => {
+        onSearch("");
+        if (id !== null) onAdd(id);
+      }}
+    />
+  );
+}
+
+/** The employees and the positions the administrator forbids to name as raters: each list has a search to add to it and a table to take from it. */
+export function ExclusionsView({
+  exclusions,
+  employees,
+  isSearchingEmployees,
+  onSearchEmployees,
+  positions,
+  isSearchingPositions,
+  onSearchPositions,
+  isBusy,
+  onAddEmployee,
+  onRemoveEmployee,
+  onAddPosition,
+  onRemovePosition,
+}: ExclusionsViewProps) {
+  const forbiddenEmployees = new Set(exclusions.employees.map(({ id }) => id));
+  const forbiddenPositions = new Set(exclusions.positions.map(({ id }) => id));
+  const employeeColumns: TableColumnsType<ExcludedEmployee> = [
+    { title: "Сотрудник", dataIndex: "fullName" },
+    { title: "Подразделение", dataIndex: "unitName" },
+    {
+      title: "Действия",
+      key: "actions",
+      render: (_, employee) => (
+        <Button
+          type="link"
+          disabled={isBusy}
+          aria-label={`Убрать из запрета: ${employee.fullName}`}
+          onClick={() => onRemoveEmployee(employee.id)}
+        >
+          Убрать
+        </Button>
+      ),
+    },
+  ];
+  const positionColumns: TableColumnsType<ExcludedPosition> = [
+    { title: "Должность", dataIndex: "name" },
+    { title: "Сотрудников", dataIndex: "employeeCount", align: "right" },
+    {
+      title: "Действия",
+      key: "actions",
+      render: (_, position) => (
+        <Button
+          type="link"
+          disabled={isBusy}
+          aria-label={`Убрать из запрета: ${position.name}`}
+          onClick={() => onRemovePosition(position.id)}
+        >
+          Убрать
+        </Button>
+      ),
+    },
+  ];
+  return (
+    <Panel title="Кого нельзя указывать оценивающим" tour="settings-exclusions">
+      <Flex vertical gap="middle">
+        <Typography.Text type="secondary">
+          Этих сотрудников и всех на этих должностях нельзя включить в список
+          оценивающих и пригласить в систему. Кандидат, руководитель и HR увидят
+          в поиске, что указывать их запрещено.
+        </Typography.Text>
+        <Row gutter={[24, 24]}>
+          <Col xs={24} lg={12}>
+            <Flex vertical gap="small">
+              <AddSelect
+                label="Добавить сотрудника"
+                placeholder="Добавить сотрудника: начните вводить ФИО"
+                options={employees
+                  .filter(({ id }) => !forbiddenEmployees.has(id))
+                  .map((employee) => ({
+                    value: employee.id,
+                    label: employee.name,
+                    detail: employee.detail,
+                  }))}
+                isSearching={isSearchingEmployees}
+                isBusy={isBusy}
+                onSearch={onSearchEmployees}
+                onAdd={onAddEmployee}
+              />
+              <Table<ExcludedEmployee>
+                rowKey="id"
+                columns={employeeColumns}
+                dataSource={[...exclusions.employees]}
+                pagination={false}
+                scroll={{ x: "max-content" }}
+                locale={{ emptyText: "Сотрудников в запрете нет." }}
+              />
+            </Flex>
+          </Col>
+          <Col xs={24} lg={12}>
+            <Flex vertical gap="small">
+              <AddSelect
+                label="Добавить должность"
+                placeholder="Добавить должность: начните вводить название"
+                options={positions
+                  .filter(({ id }) => !forbiddenPositions.has(id))
+                  .map((position) => ({
+                    value: position.id,
+                    label: position.name,
+                  }))}
+                isSearching={isSearchingPositions}
+                isBusy={isBusy}
+                onSearch={onSearchPositions}
+                onAdd={onAddPosition}
+              />
+              <Table<ExcludedPosition>
+                rowKey="id"
+                columns={positionColumns}
+                dataSource={[...exclusions.positions]}
+                pagination={false}
+                scroll={{ x: "max-content" }}
+                locale={{ emptyText: "Должностей в запрете нет." }}
+              />
+            </Flex>
+          </Col>
+        </Row>
+      </Flex>
+    </Panel>
+  );
+}
diff --git a/web/src/features/promotion/FormalDialog.tsx b/web/src/features/promotion/FormalDialog.tsx
new file mode 100644
index 00000000..48d54e53
--- /dev/null
+++ b/web/src/features/promotion/FormalDialog.tsx
@@ -0,0 +1,172 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { App, Drawer, Form, Skeleton } from "antd";
+import { type ReactNode, useState } from "react";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import { useLeaveGuard } from "../../app/leaveGuard";
+import { ModalSavedContext } from "../../app/modalSaved";
+import { isStaleVersion, useEditBase } from "../../app/useEditBase";
+import { FormalView } from "./FormalView";
+import {
+  applicationQuery,
+  type FormalInput,
+  type PromotionApplication,
+  promotionQueryKey,
+  saveFormal,
+  saveRaterEmail,
+  settingsQuery,
+  type Versioned,
+  type Wave,
+  type WaveApplication,
+} from "./promotionApi";
+import { formatDate, STAGE } from "./promotionTexts";
+
+interface FormalDialogProps {
+  /** The row of the list the check was opened from. */
+  application: WaveApplication;
+  /** The session the application belongs to, whose dates the check names. */
+  wave: Wave;
+  /** Opens the next application of the list; omitted when there is none. */
+  onNext?: () => void;
+  onClose: () => void;
+}
+
+interface UnsavedDrawerProps {
+  title: ReactNode;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+/** The side panel of the application; closing it by the cross, Escape or the scrim asks for confirmation while a form in it is changed and not saved. */
+function UnsavedDrawer({ title, onClose, children }: UnsavedDrawerProps) {
+  const [isTouched, setIsTouched] = useState(false);
+  const { confirmLeave } = useLeaveGuard({ isUnsaved: isTouched });
+  return (
+    <Drawer
+      open
+      size="large"
+      title={title}
+      onClose={() => (isTouched ? confirmLeave(onClose) : onClose())}
+    >
+      <Form.Provider
+        onFormChange={(_, { changedFields }) => {
+          if (changedFields.some((field) => field.touched)) {
+            setIsTouched(true);
+          }
+        }}
+      >
+        <ModalSavedContext value={() => setIsTouched(false)}>
+          {children}
+        </ModalSavedContext>
+      </Form.Provider>
+    </Drawer>
+  );
+}
+
+/** Side panel with the data for the formal check of an application. Mount it only while it is shown, so every opening starts from the current record. */
+export function FormalDialog({
+  application,
+  wave,
+  onNext,
+  onClose,
+}: FormalDialogProps) {
+  const { data, error, isPending, refetch } = useQuery(
+    applicationQuery(application.id),
+  );
+  const settings = useQuery(settingsQuery);
+  const checkEndsOn = wave.endsOn[STAGE.formalCheck - 1];
+  return (
+    <UnsavedDrawer
+      title={`Формальная проверка${checkEndsOn ? ` · до ${formatDate(checkEndsOn)}` : ""}`}
+      onClose={onClose}
+    >
+      {isPending && <Skeleton active />}
+      {error && (
+        <ErrorAlert
+          title="Не удалось загрузить заявку"
+          error={error}
+          onRetry={() => void refetch()}
+        />
+      )}
+      {data && (
+        <FormalEditor
+          latest={data}
+          submittedAt={application.submittedAt}
+          minIntervalMonths={settings.data?.minIntervalMonths}
+          onNext={onNext}
+        />
+      )}
+    </UnsavedDrawer>
+  );
+}
+
+interface FormalEditorProps {
+  latest: Versioned<PromotionApplication>;
+  submittedAt: WaveApplication["submittedAt"];
+  minIntervalMonths?: number;
+  onNext?: () => void;
+}
+
+/** The check with the application it was opened with, which stays open after a save to show the result the data would give; it takes the reread record only after a save is refused for a stale version. */
+function FormalEditor({
+  latest,
+  submittedAt,
+  minIntervalMonths,
+  onNext,
+}: FormalEditorProps) {
+  const queryClient = useQueryClient();
+  const { message } = App.useApp();
+  const { base = latest, noteSaveFailure, rebase } = useEditBase(latest);
+  const settle = {
+    onError: noteSaveFailure,
+    onSettled: () =>
+      queryClient.invalidateQueries({ queryKey: promotionQueryKey }),
+  };
+  const save = useMutation({
+    mutationFn: (input: FormalInput) =>
+      saveFormal(base.id, base.version, input),
+    ...settle,
+    onSuccess: (saved) => {
+      rebase(saved);
+      message.success("Данные сохранены");
+    },
+  });
+  const confirmEmail = useMutation({
+    mutationFn: ({
+      employeeId,
+      email,
+    }: {
+      employeeId: string;
+      email: string;
+    }) => saveRaterEmail(base.id, base.version, employeeId, email),
+    ...settle,
+    onSuccess: (saved) => {
+      rebase(saved);
+      message.success("Почта подтверждена");
+    },
+  });
+  const canEnter =
+    base.roles.includes("ResponsibleHr") &&
+    base.stage <= STAGE.formalCheck &&
+    base.status === "Submitted";
+  return (
+    <>
+      {save.isError && (
+        <ErrorAlert title="Данные не сохранены" error={save.error} />
+      )}
+      {confirmEmail.isError && isStaleVersion(confirmEmail.error) && (
+        <ErrorAlert title="Почта не подтверждена" error={confirmEmail.error} />
+      )}
+      <FormalView
+        application={base}
+        submittedAt={submittedAt}
+        canEnter={canEnter}
+        minIntervalMonths={minIntervalMonths}
+        onNext={onNext}
+        onSubmit={save.mutateAsync}
+        onConfirmEmail={(employeeId, email) =>
+          confirmEmail.mutateAsync({ employeeId, email })
+        }
+      />
+    </>
+  );
+}
diff --git a/web/src/features/promotion/FormalView.tsx b/web/src/features/promotion/FormalView.tsx
new file mode 100644
index 00000000..fbb8f529
--- /dev/null
+++ b/web/src/features/promotion/FormalView.tsx
@@ -0,0 +1,304 @@
+import {
+  Alert,
+  Button,
+  Checkbox,
+  DatePicker,
+  Flex,
+  Form,
+  Tag,
+  Typography,
+} from "antd";
+import dayjs, { type Dayjs } from "dayjs";
+import type { ReactNode } from "react";
+import { useFormSubmit } from "../../app/useFormSubmit";
+import { EDUCATION_LABELS } from "../career/matrixLabels";
+import type {
+  FormalInput,
+  PromotionApplication,
+  WaveApplication,
+} from "./promotionApi";
+import {
+  FORMAL_CHECK_FAILED,
+  FORMAL_CHECK_PASSED,
+  FORMAL_FAILURE_TEXTS,
+  formatDate,
+  monthsBetween,
+  NO_VALUE,
+  STAGE,
+} from "./promotionTexts";
+import { RaterEmailsView } from "./RaterEmailsView";
+
+const DATE_FORMAT = "DD.MM.YYYY";
+const ISO_DATE = "YYYY-MM-DD";
+const FORMAL_FORM_ID = "promotion-formal";
+
+type Failure = PromotionApplication["warnings"][number];
+
+interface FormalFormValues {
+  hiredOrPromotedOn: Dayjs;
+  ignoreInterval: boolean;
+}
+
+interface FormalViewProps {
+  application: PromotionApplication;
+  /** When the application was filed. */
+  submittedAt?: WaveApplication["submittedAt"];
+  /** Whether the viewer enters the date now. */
+  canEnter: boolean;
+  /** Months that must pass since the date; the interval warning shows while typing only when it is known. */
+  minIntervalMonths?: number;
+  /** Saves the date; a refusal that names the date is shown under it, any other one is shown by the caller. */
+  onSubmit: (input: FormalInput) => Promise<unknown>;
+  /** Enters and confirms the address of a rater without an account; a refusal is shown by the row. */
+  onConfirmEmail: (employeeId: string, email: string) => Promise<unknown>;
+  /** Opens the next application of the list; omitted when there is none. */
+  onNext?: () => void;
+}
+
+function Criterion({ text, tag }: { text: string; tag?: ReactNode }) {
+  return (
+    <Flex
+      justify="space-between"
+      align="center"
+      gap="middle"
+      wrap
+      style={{ paddingBlock: "var(--ant-padding-xs)" }}
+    >
+      <span>{text}</span>
+      {tag}
+    </Flex>
+  );
+}
+
+function intervalTag(
+  failures: readonly Failure[],
+  formal: PromotionApplication["formal"],
+) {
+  if (failures.includes("MissingDate")) {
+    return <Tag color="warning">Нет даты</Tag>;
+  }
+  if (failures.includes("IntervalNotPassed")) {
+    return <Tag color="error">Не выполнено</Tag>;
+  }
+  return formal?.ignoreInterval ? (
+    <Tag>Не учитывается</Tag>
+  ) : (
+    <Tag color="success">Выполнено</Tag>
+  );
+}
+
+/** The formal check of one application: the candidate and target, what the check would find now, and for the responsible HR the date entry with the interval warning, the criteria and the addresses of the raters. */
+export function FormalView({
+  application,
+  submittedAt,
+  canEnter,
+  minIntervalMonths,
+  onSubmit,
+  onConfirmEmail,
+  onNext,
+}: FormalViewProps) {
+  const { target, formal, status, formalCheck, raters } = application;
+  const failures = formalCheck?.failures ?? application.warnings;
+  const { resultsPublishedOn } = application.session;
+  const checkEndsOn = application.session.endsOn[STAGE.formalCheck - 1];
+  const hiredOn = formal?.hiredOrPromotedOn;
+  const fixedNote = checkEndsOn
+    ? ` Итог пересчитывается при каждом сохранении и фиксируется ${formatDate(checkEndsOn)}.`
+    : "";
+  return (
+    <Flex vertical gap="large">
+      <Flex vertical>
+        <Typography.Title level={2} style={{ margin: 0 }}>
+          {application.candidateName}
+        </Typography.Title>
+        <Typography.Text type="secondary">
+          {target.trackName} · {target.levelName}
+          {submittedAt && ` · подана ${formatDate(submittedAt)}`}
+        </Typography.Text>
+      </Flex>
+      {formalCheck ? (
+        <Alert
+          type={formalCheck.isPassed ? "success" : "warning"}
+          showIcon
+          title={
+            formalCheck.isPassed ? FORMAL_CHECK_PASSED : FORMAL_CHECK_FAILED
+          }
+          description={
+            formalCheck.isPassed
+              ? fixedNote.trim() || undefined
+              : `${formalCheck.failures
+                  .map((failure) => FORMAL_FAILURE_TEXTS[failure])
+                  .join("; ")}.${fixedNote}`
+          }
+        />
+      ) : (
+        application.warnings
+          .filter((warning) => !(canEnter && warning === "IntervalNotPassed"))
+          .map((warning) => (
+            <Alert
+              key={warning}
+              type="warning"
+              showIcon
+              title={FORMAL_FAILURE_TEXTS[warning]}
+            />
+          ))
+      )}
+      {status === "FormalRejected" && (
+        <Alert
+          type="error"
+          showIcon
+          title="Отклонена по формальным признакам"
+          description={application.formalFailures
+            .map((failure) => FORMAL_FAILURE_TEXTS[failure])
+            .join("; ")}
+        />
+      )}
+      <Flex vertical gap="small">
+        <Typography.Title level={3} style={{ margin: 0 }}>
+          Данные кандидата
+        </Typography.Title>
+        {canEnter ? (
+          <FormalForm
+            key={`${formal?.hiredOrPromotedOn}|${formal?.ignoreInterval}`}
+            formal={formal}
+            minIntervalMonths={minIntervalMonths}
+            onSubmit={onSubmit}
+            onNext={onNext}
+          />
+        ) : (
+          <>
+            <Flex vertical>
+              <Typography.Text type="secondary">
+                Дата приёма на работу или последнего перехода
+              </Typography.Text>
+              <span>
+                {formal?.hiredOrPromotedOn
+                  ? formatDate(formal.hiredOrPromotedOn)
+                  : "Не внесена"}
+              </span>
+            </Flex>
+            {formal?.ignoreInterval && (
+              <Typography.Text type="secondary">
+                Интервал не учитывается
+              </Typography.Text>
+            )}
+            {onNext && (
+              <Flex>
+                <Button onClick={onNext}>Следующая заявка</Button>
+              </Flex>
+            )}
+          </>
+        )}
+      </Flex>
+      <Flex vertical>
+        <Typography.Title level={3} style={{ margin: 0 }}>
+          Критерии
+        </Typography.Title>
+        <Criterion
+          text={`Интервал с последнего перехода на дату публикации решений ${formatDate(resultsPublishedOn)}${hiredOn ? `: ${monthsBetween(hiredOn, resultsPublishedOn)} мес.` : ""}${minIntervalMonths === undefined ? "" : `, нужно не меньше ${minIntervalMonths} мес.`}`}
+          tag={intervalTag(failures, formal)}
+        />
+        <Criterion
+          text={`Образование: ${application.education ? EDUCATION_LABELS[application.education] : NO_VALUE}`}
+          tag={
+            failures.includes("EducationBelowRequired") ? (
+              <Tag color="error">Не выполнено</Tag>
+            ) : (
+              <Tag color="success">Выполнено</Tag>
+            )
+          }
+        />
+        {raters && <Criterion text={`Оценивающих: ${raters.length}`} />}
+      </Flex>
+      {raters?.some((rater) => !rater.hasAccount) && (
+        <RaterEmailsView
+          key={raters.map((rater) => rater.employeeId).join("|")}
+          raters={raters}
+          canEdit={canEnter}
+          onConfirm={onConfirmEmail}
+        />
+      )}
+    </Flex>
+  );
+}
+
+interface FormalFormProps {
+  formal: PromotionApplication["formal"];
+  minIntervalMonths?: number;
+  onSubmit: (input: FormalInput) => Promise<unknown>;
+  onNext?: () => void;
+}
+
+function FormalForm({
+  formal,
+  minIntervalMonths,
+  onSubmit,
+  onNext,
+}: FormalFormProps) {
+  const [form] = Form.useForm<FormalFormValues>();
+  const { isSubmitting, submit } = useFormSubmit(form, (values) =>
+    onSubmit({
+      hiredOrPromotedOn: values.hiredOrPromotedOn.format(ISO_DATE),
+      ignoreInterval: values.ignoreInterval,
+    }),
+  );
+  const date = Form.useWatch("hiredOrPromotedOn", form);
+  const isIgnored = Form.useWatch("ignoreInterval", form);
+  const isIntervalShort =
+    date?.add(minIntervalMonths ?? 0, "month").isAfter(dayjs(), "day") === true;
+
+  return (
+    <Form
+      id={FORMAL_FORM_ID}
+      form={form}
+      name={FORMAL_FORM_ID}
+      layout="vertical"
+      disabled={isSubmitting}
+      initialValues={{
+        hiredOrPromotedOn: formal?.hiredOrPromotedOn
+          ? dayjs(formal.hiredOrPromotedOn)
+          : undefined,
+        ignoreInterval: formal?.ignoreInterval ?? false,
+      }}
+      onFinish={submit}
+    >
+      <Form.Item
+        name="hiredOrPromotedOn"
+        label="Дата приёма на работу или последнего перехода"
+        rules={[{ required: true, message: "Укажите дату" }]}
+      >
+        <DatePicker
+          format={DATE_FORMAT}
+          disabledDate={(day) => day.isAfter(dayjs(), "day")}
+        />
+      </Form.Item>
+      {isIntervalShort && (
+        <Form.Item>
+          <Alert
+            type="warning"
+            showIcon
+            title={FORMAL_FAILURE_TEXTS.IntervalNotPassed}
+            description={
+              isIgnored
+                ? "Интервал не будет учтён при проверке."
+                : "Чтобы допустить заявку, отметьте «Игнорировать проверку интервала»."
+            }
+          />
+        </Form.Item>
+      )}
+      <Form.Item name="ignoreInterval" valuePropName="checked">
+        <Checkbox>Игнорировать проверку интервала</Checkbox>
+      </Form.Item>
+      <Flex gap="small" wrap>
+        <Button type="primary" htmlType="submit" loading={isSubmitting}>
+          Сохранить
+        </Button>
+        {onNext && (
+          <Button disabled={isSubmitting} onClick={onNext}>
+            Следующая заявка
+          </Button>
+        )}
+      </Flex>
+    </Form>
+  );
+}
