+    private static bool IsWebAddress(string line) =>
+        !line.Any(char.IsWhiteSpace)
+        && Uri.TryCreate(line, UriKind.Absolute, out var address)
+        && (address.Scheme == Uri.UriSchemeHttp || address.Scheme == Uri.UriSchemeHttps);
 }
