+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { Flex, Skeleton, Typography } from "antd";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import { contentMaxWidth } from "../../app/theme";
+import { useEditBase } from "../../app/useEditBase";
+import { CommissionsSection } from "./CommissionsPage";
+import { ExclusionsPanel } from "./ExclusionsPanel";
+import {
+  type PromotionSettings,
+  promotionQueryKey,
+  type SettingsInput,
+  saveSettings,
+  settingsQuery,
+  type Versioned,
+} from "./promotionApi";
+import { SettingsView } from "./SettingsView";
+
+/** The promotion settings screen of global administrators. */
+export function SettingsPage() {
+  const { data, error, isPending, refetch } = useQuery(settingsQuery);
+  return (
+    <Flex
+      vertical
+      gap="large"
+      style={{ maxWidth: contentMaxWidth, marginInline: "auto" }}
+    >
+      <Typography.Title level={1} style={{ margin: 0 }}>
+        Настройки карьерных сессий
+      </Typography.Title>
+      {isPending && <Skeleton active />}
+      {error && (
+        <ErrorAlert
+          title="Не удалось загрузить настройки"
+          error={error}
+          onRetry={() => void refetch()}
+        />
+      )}
+      {data && <SettingsEditor latest={data} />}
+      <ExclusionsPanel />
+      <CommissionsSection />
+    </Flex>
+  );
+}
+
+/** The form with the settings it was opened with; it takes the reread ones only after a save is refused for a stale version. */
+function SettingsEditor({ latest }: { latest: Versioned<PromotionSettings> }) {
+  const queryClient = useQueryClient();
+  const { base = latest, noteSaveFailure, rebase } = useEditBase(latest);
+  const save = useMutation({
+    mutationFn: (input: SettingsInput) => saveSettings(base.version, input),
+    onSuccess: rebase,
+    onError: noteSaveFailure,
+    onSettled: () =>
+      queryClient.invalidateQueries({ queryKey: promotionQueryKey }),
+  });
+  return (
+    <>
+      {save.isError && (
+        <ErrorAlert title="Настройки не сохранены" error={save.error} />
+      )}
+      <SettingsView
+        key={base.version}
+        settings={base}
+        onSubmit={save.mutateAsync}
+      />
+    </>
+  );
+}
diff --git a/web/src/features/promotion/SettingsView.tsx b/web/src/features/promotion/SettingsView.tsx
new file mode 100644
index 00000000..8f67f49c
--- /dev/null
+++ b/web/src/features/promotion/SettingsView.tsx
@@ -0,0 +1,89 @@
+import {
+  App,
+  Button,
+  Col,
+  Flex,
+  Form,
+  InputNumber,
+  Row,
+  Typography,
+} from "antd";
+import { useState } from "react";
+import { useLeaveGuard } from "../../app/leaveGuard";
+import { useFormSubmit } from "../../app/useFormSubmit";
+import { Panel } from "./Panel";
+import type { PromotionSettings, SettingsInput } from "./promotionApi";
+import { STAGE_TITLES } from "./promotionTexts";
+
+/** Largest interval in months and stage length in working days the fields offer, as the server accepts them; the OpenAPI document does not carry the limits. */
+const MAX_INTERVAL_MONTHS = 120;
+const MAX_STAGE_DAYS = 260;
+
+interface SettingsViewProps {
+  settings: PromotionSettings;
+  /** Saves the settings; a refusal that names fields is shown under them, any other one is shown by the caller. */
+  onSubmit: (input: SettingsInput) => Promise<unknown>;
+}
+
+/** The default rules of career sessions: the interval between career transitions and the default length of every stage. */
+export function SettingsView({ settings, onSubmit }: SettingsViewProps) {
+  const { message } = App.useApp();
+  const [form] = Form.useForm<SettingsInput>();
+  const [isDirty, setIsDirty] = useState(false);
+  const { isSubmitting, submit } = useFormSubmit(form, async (values) => {
+    await onSubmit(values);
+    setIsDirty(false);
+    message.success("Настройки сохранены");
+  });
+  useLeaveGuard({ isUnsaved: isDirty, isSaving: isSubmitting });
+
+  return (
+    <Panel title="Правила по умолчанию" tour="settings-defaults">
+      <Form
+        form={form}
+        name="promotion-settings"
+        layout="vertical"
+        disabled={isSubmitting}
+        initialValues={settings}
+        onFinish={submit}
+        onValuesChange={() => setIsDirty(form.isFieldsTouched())}
+      >
+        <Form.Item
+          name="minIntervalMonths"
+          label="Минимальный интервал между карьерными переходами, месяцев"
+          rules={[{ required: true, message: "Укажите число месяцев" }]}
+        >
+          <InputNumber min={0} max={MAX_INTERVAL_MONTHS} precision={0} />
+        </Form.Item>
+        <Typography.Text>
+          Длительность этапов новой сессии, рабочих дней
+        </Typography.Text>
+        <Row gutter={[16, 0]}>
+          {STAGE_TITLES.map((title, index) => (
+            <Col key={title} xs={24} md={12} lg={8}>
+              <Form.Item
+                name={["stageDurationsDays", index]}
+                label={`${index + 1}. ${title}`}
+                rules={[
+                  { required: true, message: "Укажите число рабочих дней" },
+                ]}
+              >
+                <InputNumber min={1} max={MAX_STAGE_DAYS} precision={0} />
+              </Form.Item>
+            </Col>
+          ))}
+        </Row>
+        <Typography.Paragraph type="secondary">
+          Суббота и воскресенье не считаются. Результаты публикуются в конце
+          этапа 5. Приём заявок начинается не раньше чем через 7 дней после
+          объявления.
+        </Typography.Paragraph>
+        <Flex>
+          <Button type="primary" htmlType="submit" loading={isSubmitting}>
+            Сохранить настройки
+          </Button>
+        </Flex>
+      </Form>
+    </Panel>
+  );
+}
