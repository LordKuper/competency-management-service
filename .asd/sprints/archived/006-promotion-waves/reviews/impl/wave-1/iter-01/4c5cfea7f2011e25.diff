@@ -0,0 +1,115 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { App, Skeleton } from "antd";
+import { AppModal } from "../../app/AppModal";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import { useEditBase } from "../../app/useEditBase";
+import {
+  promotionQueryKey,
+  type RollbackInput,
+  rollbackPreview,
+  rollbackWave,
+  type Versioned,
+  type Wave,
+  waveQuery,
+} from "./promotionApi";
+import { STAGE_TITLES } from "./promotionTexts";
+import { RollbackView } from "./RollbackView";
+
+interface RollbackDialogProps {
+  waveId: string;
+  /** Default length of every stage in working days. */
+  durations: readonly number[];
+  /** Called with the wave as the return left it. */
+  onRolledBack: (wave: Versioned<Wave>) => void;
+  onClose: () => void;
+}
+
+/** Dialog of sending a wave back to a stage that has passed. Mount it only while it is shown, so every opening starts from the current wave. */
+export function RollbackDialog({
+  waveId,
+  durations,
+  onRolledBack,
+  onClose,
+}: RollbackDialogProps) {
+  const { data, error, isPending, refetch } = useQuery(waveQuery(waveId));
+  return (
+    <AppModal
+      open
+      title="Откатить карьерную сессию"
+      onCancel={onClose}
+      footer={null}
+    >
+      {isPending && <Skeleton active />}
+      {error && (
+        <ErrorAlert
+          title="Не удалось загрузить карьерную сессию"
+          error={error}
+          onRetry={() => void refetch()}
+        />
+      )}
+      {data && (
+        <RollbackEditor
+          latest={data}
+          durations={durations}
+          onRolledBack={onRolledBack}
+        />
+      )}
+    </AppModal>
+  );
+}
+
+interface RollbackEditorProps {
+  latest: Versioned<Wave>;
+  durations: readonly number[];
+  onRolledBack: (wave: Versioned<Wave>) => void;
+}
+
+/** The return with the wave it was opened with; it takes the reread one only after a save is refused for a stale version. */
+function RollbackEditor({
+  latest,
+  durations,
+  onRolledBack,
+}: RollbackEditorProps) {
+  const queryClient = useQueryClient();
+  const { message } = App.useApp();
+  const { base = latest, noteSaveFailure } = useEditBase(latest);
+  const preview = useMutation({
+    mutationFn: (input: RollbackInput) => rollbackPreview(base.id, input.stage),
+  });
+  const rollback = useMutation({
+    mutationFn: (input: RollbackInput) =>
+      rollbackWave(base.id, base.version, input),
+    onSuccess: (saved, input) => {
+      message.success(
+        `Карьерная сессия откачена на этап «${STAGE_TITLES[input.stage - 1]}»`,
+      );
+      onRolledBack(saved);
+    },
+    onError: noteSaveFailure,
+    onSettled: () =>
+      queryClient.invalidateQueries({ queryKey: promotionQueryKey }),
+  });
+  return (
+    <>
+      {preview.isError && (
+        <ErrorAlert
+          title="Не удалось узнать последствия отката"
+          error={preview.error}
+        />
+      )}
+      {rollback.isError && (
+        <ErrorAlert
+          title="Карьерная сессия не откачена"
+          error={rollback.error}
+        />
+      )}
+      <RollbackView
+        key={base.version}
+        wave={base}
+        durations={durations}
+        onPreview={preview.mutateAsync}
+        onSubmit={rollback.mutateAsync}
+      />
+    </>
+  );
+}
diff --git a/web/src/features/promotion/RollbackView.tsx b/web/src/features/promotion/RollbackView.tsx
new file mode 100644
index 00000000..d03f7c55
--- /dev/null
+++ b/web/src/features/promotion/RollbackView.tsx
@@ -0,0 +1,199 @@
+import {
+  Alert,
+  Button,
+  Col,
+  DatePicker,
+  Flex,
+  Form,
+  Row,
+  Select,
+  Typography,
+} from "antd";
+import dayjs, { type Dayjs } from "dayjs";
+import { useState } from "react";
+import { showFieldErrors } from "../../app/apiErrors";
+import type { RollbackInput, RollbackPreview, Wave } from "./promotionApi";
+import {
+  rollbackConsequences,
+  STAGE_COUNT,
+  STAGE_TITLES,
+} from "./promotionTexts";
+import { rollbackEndDates } from "./stageDates";
+
+const DATE_FORMAT = "DD.MM.YYYY";
+const ISO_DATE = "YYYY-MM-DD";
+
+interface RollbackFormValues {
+  stage: number;
+  endsOn: Dayjs[];
+}
+
+interface RollbackViewProps {
+  /** The wave being sent back; it has passed at least one stage. */
+  wave: Wave;
+  /** Default length of every stage in working days, which fills the new end dates when a stage is chosen. */
+  durations: readonly number[];
+  /** Finds what the return would reset; a refusal that names fields is shown under them, any other one is shown by the caller. */
+  onPreview: (input: RollbackInput) => Promise<RollbackPreview>;
+  /** Makes the return; a refusal that names fields is shown under them, any other one is shown by the caller. */
+  onSubmit: (input: RollbackInput) => Promise<unknown>;
+}
+
+interface Confirmation {
+  input: RollbackInput;
+  preview: RollbackPreview;
+}
+
+function isBeforeToday(day: Dayjs): boolean {
+  return day.isBefore(dayjs(), "day");
+}
+
+/** Sending a wave back to a stage that has passed: the stage and the new end dates, then the list of what resets and a confirmation. */
+export function RollbackView({
+  wave,
+  durations,
+  onPreview,
+  onSubmit,
+}: RollbackViewProps) {
+  const [form] = Form.useForm<RollbackFormValues>();
+  const [confirmation, setConfirmation] = useState<Confirmation>();
+  const [isBusy, setIsBusy] = useState(false);
+  const stage = Form.useWatch("stage", form);
+
+  async function attempt(action: () => Promise<unknown>) {
+    setIsBusy(true);
+    try {
+      await action();
+    } catch (error) {
+      setConfirmation(undefined);
+      showFieldErrors(form, error);
+    } finally {
+      setIsBusy(false);
+    }
+  }
+
+  function inputOfForm(): RollbackInput {
+    return {
+      stage: form.getFieldValue("stage"),
+      endsOn: form
+        .getFieldValue("endsOn")
+        .map((date: Dayjs) => date.format(ISO_DATE)),
+    };
+  }
+
+  function showConsequences() {
+    const input = inputOfForm();
+    return attempt(async () =>
+      setConfirmation({ input, preview: await onPreview(input) }),
+    );
+  }
+
+  return (
+    <Flex vertical gap="middle">
+      <Form
+        form={form}
+        name="promotion-rollback"
+        layout="vertical"
+        disabled={isBusy || confirmation !== undefined}
+        onFinish={showConsequences}
+        onValuesChange={(changed) => {
+          if (changed.stage && durations.length >= STAGE_COUNT) {
+            form.setFieldValue(
+              "endsOn",
+              rollbackEndDates(changed.stage, wave.endsOn, durations),
+            );
+          }
+        }}
+      >
+        <Form.Item
+          name="stage"
+          label="Этап, на который откатить карьерную сессию"
+          rules={[{ required: true, message: "Выберите этап" }]}
+        >
+          <Select
+            placeholder="Выберите этап"
+            options={STAGE_TITLES.slice(0, wave.stage - 1).map(
+              (title, index) => ({
+                value: index + 1,
+                label: `${index + 1}. ${title}`,
+              }),
+            )}
+          />
+        </Form.Item>
+        {stage !== undefined && (
+          <Row gutter={16}>
+            {STAGE_TITLES.map((title, index) =>
+              index + 1 < stage ? null : (
+                <Col key={title} xs={24} md={12}>
+                  <Form.Item
+                    name={["endsOn", index]}
+                    label={`Завершение этапа «${title}»`}
+                    rules={[{ required: true, message: "Укажите дату" }]}
+                  >
+                    <DatePicker
+                      format={DATE_FORMAT}
+                      disabledDate={isBeforeToday}
+                    />
+                  </Form.Item>
+                </Col>
+              ),
+            )}
+          </Row>
+        )}
+        {!confirmation && (
+          <Button type="primary" htmlType="submit" loading={isBusy}>
+            Показать последствия
+          </Button>
+        )}
+      </Form>
+      {confirmation && (
+        <>
+          <Alert
+            type="warning"
+            showIcon
+            title={`Откатить карьерную сессию на этап «${STAGE_TITLES[confirmation.input.stage - 1]}»?`}
+            description={
+              <RollbackConsequences preview={confirmation.preview} />
+            }
+          />
+          <Flex gap="small">
+            <Button
+              danger
+              type="primary"
+              loading={isBusy}
+              onClick={() => void attempt(() => onSubmit(confirmation.input))}
+            >
+              Откатить
+            </Button>
+            <Button
+              disabled={isBusy}
+              onClick={() => setConfirmation(undefined)}
+            >
+              Назад
+            </Button>
+          </Flex>
+        </>
+      )}
+    </Flex>
+  );
+}
+
+/** What stays and what resets or is computed again when a wave is sent back, with the number of applications. */
+function RollbackConsequences({ preview }: { preview: RollbackPreview }) {
+  const lines = rollbackConsequences(preview);
+  return (
+    <Flex vertical gap="small">
+      <Typography.Text>
+        Всё введённое сохранится: заявки, оценки, артефакты, итоговые баллы и
+        решения.
+      </Typography.Text>
+      {lines.length > 0 && (
+        <ul style={{ margin: 0 }}>
+          {lines.map((line) => (
+            <li key={line}>{line}</li>
+          ))}
+        </ul>
+      )}
+    </Flex>
+  );
+}
diff --git a/web/src/features/promotion/ScaleChoice.tsx b/web/src/features/promotion/ScaleChoice.tsx
new file mode 100644
index 00000000..c2f50473
--- /dev/null
+++ b/web/src/features/promotion/ScaleChoice.tsx
@@ -0,0 +1,143 @@
+import { Button, Flex, Segmented, Tooltip, Typography } from "antd";
+import { scalePointLabel } from "./promotionTexts";
+
+/** One point of the scale of a competency. */
+export interface ScalePointItem {
+  score: number;
+  label: string;
+}
+
+/** The answer of a rater who did not see the competency at work. */
+export const NOT_OBSERVED = "notObserved";
+
+/** A score on the scale, or «Не наблюдал» where the form allows it. */
+export type ScaleAnswer = number | typeof NOT_OBSERVED;
+
+interface ScaleOption {
+  value: ScaleAnswer;
+  label: string;
+  title?: string;
+}
+
+const NOT_OBSERVED_OPTION: ScaleOption = {
+  value: NOT_OBSERVED,
+  label: "Не наблюдал",
+};
+
+const TOOLTIP_WIDTH = "calc(var(--ant-control-height) * 10)";
+
+interface ScaleHelpProps {
+  /** The competency the scale belongs to. */
+  name: string;
+  points: readonly ScalePointItem[];
+  /** The score to mark as the current one. */
+  current?: number | null;
+}
+
+/** The round «?» next to a score: shows the levels of that competency's scale with the current one marked, on hover, focus and click. */
+export function ScaleHelp({ name, points, current }: ScaleHelpProps) {
+  return (
+    <Tooltip
+      trigger={["hover", "focus", "click"]}
+      placement="bottomLeft"
+      styles={{ container: { width: TOOLTIP_WIDTH } }}
+      title={
+        <Flex vertical>
+          <Typography.Text strong style={{ color: "inherit" }}>
+            {name}
+          </Typography.Text>
+          {points.map((point) => (
+            <span
+              key={point.score}
+              style={{ fontWeight: point.score === current ? 700 : 400 }}
+            >
+              {point.score === current ? "● " : ""}
+              {scalePointLabel(point)}
+            </span>
+          ))}
+        </Flex>
+      }
+    >
+      <Button
+        shape="circle"
+        size="small"
+        aria-label={`Шкала компетенции: ${name}`}
+      >
+        ?
+      </Button>
+    </Tooltip>
+  );
+}
+
+interface ScaleChoiceProps {
+  /** The competency the scale belongs to. */
+  name: string;
+  /** The points of that competency's scale and no others. */
+  points: readonly ScalePointItem[];
+  /** Offers «Не наблюдал» beside the points. */
+  hasNotObserved?: boolean;
+  disabled?: boolean;
+  /** Supplied by the surrounding form item. */
+  value?: ScaleAnswer;
+  onChange?: (value: ScaleAnswer) => void;
+}
+
+/** The choice of a score as a segmented control limited to the scale points of one competency, with the «?» that explains them. */
+export function ScaleChoice({
+  name,
+  points,
+  hasNotObserved = false,
+  disabled,
+  value,
+  onChange,
+}: ScaleChoiceProps) {
+  const options: ScaleOption[] = [
+    ...points.map((point) => ({
+      value: point.score,
+      label: String(point.score),
+      title: scalePointLabel(point),
+    })),
+    ...(hasNotObserved ? [NOT_OBSERVED_OPTION] : []),
+  ];
+  return (
+    <Flex align="center" gap="small">
+      <Segmented<ScaleAnswer>
+        aria-label={name}
+        disabled={disabled}
+        value={value}
+        options={options}
+        onChange={onChange}
+      />
+      <ScaleHelp
+        name={name}
+        points={points}
+        current={typeof value === "number" ? value : null}
+      />
+    </Flex>
+  );
+}
+
+interface ScaleValueProps {
+  name: string;
+  points: readonly ScalePointItem[];
+  score: number | null;
+}
+
+/** A score already given, written «3 из 4» against the top of the scale, with the «?» that explains the levels. */
+export function ScaleValue({ name, points, score }: ScaleValueProps) {
+  const top = points.at(-1)?.score;
+  return (
+    <Flex align="center" gap="small">
+      <span>
+        {score === null
+          ? "—"
+          : top === undefined
+            ? score
+            : `${score} из ${top}`}
+      </span>
+      {points.length > 0 && (
+        <ScaleHelp name={name} points={points} current={score} />
+      )}
+    </Flex>
+  );
+}
