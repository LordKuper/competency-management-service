+  PATH_STEP,
+  {
+    target: "queue-list",
+    title: "Очередь",
+    description:
+      "Записи, которые ждут вашего решения. Выберите запись в списке, при необходимости отфильтруйте по виду.",
+  },
+  {
+    target: "queue-record",
+    title: "Открытая запись",
+    description:
+      "Здесь видно, что за запись, где она используется и что произойдёт после решения.",
+  },
+];
+
+const DRAFTS_STEPS: TourStep[] = [
+  {
+    title: "Утвердить черновые записи",
+    description:
+      "Новые записи каталога ждут утверждения: после него их можно использовать в матрицах.",
+  },
+  ...QUEUE_STEPS,
+];
+
+/** Marks hints as belonging to one step of the wizard on the screen. */
+const onStep = (wizardStep: number, steps: TourStep[]): TourStep[] =>
+  steps.map((step) => ({ ...step, wizardStep }));
+
+const WIZARD_STEPS: TourStep = {
+  target: "wizard-steps",
+  title: "Шаги мастера",
+  description:
+    "Пройденные шаги можно открыть снова, чтобы поправить введённое. Замечания к шагу отмечены рядом с его названием.",
+};
+
+const BUILDER_FOOTER: TourStep = {
+  target: "builder-footer",
+  title: "Сохранение шага",
+  description:
+    "«Сохранить и далее» записывает шаг в черновик версии и открывает следующий. «Сохранить и выйти» записывает шаг и возвращает на рабочий стол: продолжить можно оттуда. «Отменить правки» сбрасывает несохранённое, «Назад» возвращает на предыдущий шаг.",
+};
+
+const BUILDER_STEPS: TourStep[] = [
+  ...onStep(1, [
+    {
+      title: "Построить матрицу компетенций",
+      description:
+        "Мастер ведёт от выбора трека или должности до отправки матрицы на согласование: так подразделение получает требования к каждому уровню. Каждый шаг сохраняется в черновик версии, поэтому можно остановиться и продолжить позже с рабочего стола.",
+    },
+    {
+      title: "Шаги мастера",
+      description:
+        "1. Основа: трек или должность и подразделение. 2. Компетенции: общие блоки и отдельные компетенции. 3. Требования: балл каждой компетенции на каждом уровне. 4. Формула и пороги: вклад блоков в рейтинг кандидата и минимальный общий порог. 5. Проверка полноты: что мешает отправке. 6. Отправка на согласование.",
+    },
+    {
+      title: "Что получится",
+      description:
+        "Версия матрицы уйдёт на согласование вышестоящему руководителю и HR. После согласования матрица опубликуется, и по ней будут оценивать кандидатов на карьерный переход.",
+    },
+  ]),
+  PATH_STEP,
+  WIZARD_STEPS,
+  ...onStep(1, [
+    {
+      target: "scenario-form",
+      title: "Шаг 1. Основа матрицы",
+      description:
+        "«Основа матрицы»: «По треку» — требования к каждому уровню карьерного трека, «По должности» — одна колонка требований для должности, не связанной с треками. «Подразделение» — то, для которого строится матрица; доступны подразделения, которыми вы руководите. У уже созданной версии основа и подразделение не меняются.",
+    },
+    {
+      title: "Трек или должность",
+      description:
+        "«Трек» выберите из списка или добавьте кнопкой «Добавить трек»; ниже видны его уровни и должности. «Должность» выбирается из должностей подразделения, которые ещё не связаны с уровнями треков. Если матрица уже есть, продолжим с версии в работе или создадим новую на основе опубликованной.",
+    },
+    {
+      target: "scenario-actions",
+      title: "Сохранить и далее",
+      description:
+        "Создаёт черновик версии и открывает шаг 2. До этого момента в системе ничего не записано.",
+    },
+  ]),
+  ...onStep(2, [
+    {
+      title: "Шаг 2. Состав матрицы",
+      description:
+        "Выберите, какие компетенции войдут в матрицу: целыми общими блоками и по одной. Баллы и коэффициенты задаются на следующих шагах.",
+    },
+    {
+      title: "Блоки компетенций",
+      description:
+        "«Добавить общий блок» подключает блок из справочника, его состав здесь не правится. «Создать блок» делает новый блок для подразделения (кнопка есть у руководителя подразделения). «Убрать блок» убирает блок из версии. Строку блока можно раскрыть и увидеть его состав.",
+    },
+    {
+      title: "Компетенции вне блоков",
+      description:
+        "Найдите компетенцию в поиске и отметьте её; «Выбрано» показывает, сколько отмечено. «Создать компетенцию» добавляет новую черновую, она опубликуется вместе с матрицей. Компетенции подключённых блоков отмечены сами и повторно не выбираются.",
+    },
+    BUILDER_FOOTER,
+  ]),
+  ...onStep(3, [
+    {
+      title: "Шаг 3. Требования по уровням",
+      description:
+        "Для каждой компетенции задайте балл, который нужен на каждом уровне, и её тип.",
+    },
+    {
+      target: "matrix-grid",
+      title: "Таблица требований",
+      description:
+        "В строке — компетенция и её шкала, в колонке — уровень. Балл выбирается в клетке. «Тип» — «Критическая» или «Дополнительная»: критическая компетенция должна набрать требуемый балл, иначе кандидат не готов к уровню.",
+    },
+    BUILDER_FOOTER,
+  ]),
