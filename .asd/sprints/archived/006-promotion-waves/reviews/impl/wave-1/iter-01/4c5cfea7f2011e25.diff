+import { Card, Empty, Flex, Tag, Typography } from "antd";
+import { Link } from "react-router";
+import type { WaveApplication } from "./promotionApi";
+import {
+  APPLICATION_STATUS_TAGS,
+  DECISION_TAGS,
+  formatDate,
+} from "./promotionTexts";
+import { promotionPaths } from "./routes";
+
+interface MyApplicationsViewProps {
+  applications: readonly WaveApplication[];
+}
+
+/** The applications of the viewer, active and past, as cards with the status and the decision. */
+export function MyApplicationsView({ applications }: MyApplicationsViewProps) {
+  if (applications.length === 0) {
+    return (
+      <Empty
+        image={Empty.PRESENTED_IMAGE_SIMPLE}
+        description="Вы ещё не подавали заявок на карьерный переход."
+      />
+    );
+  }
+  return (
+    <Flex vertical gap="middle">
+      {applications.map((application) => {
+        const status = APPLICATION_STATUS_TAGS[application.status];
+        const decision = application.decision;
+        const isDraft = application.status === "Draft";
+        return (
+          <Card
+            key={application.id}
+            size="small"
+            title={`${application.target.unitName}: ${application.target.trackName}, ${application.target.levelName}`}
+            extra={
+              <Link
+                to={
+                  isDraft
+                    ? promotionPaths.apply(application.waveId)
+                    : promotionPaths.application(application.id)
+                }
+                aria-label={`${isDraft ? "Продолжить черновик" : "Открыть заявку"}: ${application.target.trackName}, ${application.target.levelName}, карьерная сессия с ${formatDate(application.waveStartsOn)}`}
+              >
+                {isDraft ? "Продолжить" : "Открыть"}
+              </Link>
+            }
+          >
+            <Flex align="center" gap="small" wrap>
+              <Tag color={status.color}>{status.label}</Tag>
+              {decision && (
+                <Tag color={DECISION_TAGS[decision].color}>
+                  {DECISION_TAGS[decision].label}
+                </Tag>
+              )}
+              <Typography.Text type="secondary">
+                {isDraft
+                  ? `Карьерная сессия с ${formatDate(application.waveStartsOn)}, не отправлена`
+                  : `Карьерная сессия с ${formatDate(application.waveStartsOn)}, подана ${formatDate(application.submittedAt)}`}
+              </Typography.Text>
+            </Flex>
+          </Card>
+        );
+      })}
+    </Flex>
+  );
+}
diff --git a/web/src/features/promotion/OpenWavesView.tsx b/web/src/features/promotion/OpenWavesView.tsx
new file mode 100644
index 00000000..3314dc75
--- /dev/null
+++ b/web/src/features/promotion/OpenWavesView.tsx
@@ -0,0 +1,123 @@
+import { Button, Card, Descriptions, Empty, Flex, Tag, Typography } from "antd";
+import { Link, useNavigate } from "react-router";
+import type { OpenWave } from "./promotionApi";
+import {
+  formatDate,
+  PUBLICATION_TITLE,
+  STAGE,
+  STAGE_TITLES,
+  stageLabel,
+} from "./promotionTexts";
+import { promotionPaths } from "./routes";
+
+interface OpenWavesViewProps {
+  waves: readonly OpenWave[];
+  /** The unfinished application of the viewer by the wave it was filed in. */
+  applicationIdByWave: ReadonlyMap<string, string>;
+  /** Whether the viewer can file an application: an account without an employee cannot. */
+  canApply: boolean;
+}
+
+function stageDates(wave: OpenWave) {
+  return STAGE_TITLES.flatMap((title, index) => {
+    const endsOn = wave.endsOn[index];
+    if (!endsOn) return [];
+    const stageRow = {
+      key: title,
+      label: title,
+      children:
+        index === 0
+          ? `${formatDate(wave.startsOn)} — ${formatDate(endsOn)}`
+          : `до ${formatDate(endsOn)}`,
+    };
+    return index + 1 === STAGE.review
+      ? [
+          stageRow,
+          {
+            key: PUBLICATION_TITLE,
+            label: PUBLICATION_TITLE,
+            children: formatDate(endsOn),
+          },
+        ]
+      : [stageRow];
+  });
+}
+
+/** The career sessions that are announced or take applications: the stages, and the units with the tracks and levels one can apply for. */
+export function OpenWavesView({
+  waves,
+  applicationIdByWave,
+  canApply,
+}: OpenWavesViewProps) {
+  const navigate = useNavigate();
+  if (waves.length === 0) {
+    return (
+      <Empty
+        image={Empty.PRESENTED_IMAGE_SIMPLE}
+        description="Сейчас нет карьерных сессий, в которые можно подать заявку. Когда HR объявит карьерную сессию, она появится здесь."
+      />
+    );
+  }
+  return (
+    <Flex vertical gap="middle">
+      {waves.map((wave) => {
+        const applicationId = applicationIdByWave.get(wave.id);
+        const isOpen = wave.stage === STAGE.submission;
+        return (
+          <Card
+            key={wave.id}
+            title={
+              <Flex align="center" gap="small" wrap>
+                <span>Карьерная сессия с {formatDate(wave.startsOn)}</span>
+                <Tag color={isOpen ? "processing" : "default"}>
+                  {stageLabel(wave.stage)}
+                </Tag>
+              </Flex>
+            }
+            extra={
+              applicationId ? (
+                <Link to={promotionPaths.application(applicationId)}>
+                  Моя заявка
+                </Link>
+              ) : (
+                isOpen &&
+                canApply && (
+                  <Button
+                    type="primary"
+                    onClick={() => void navigate(promotionPaths.apply(wave.id))}
+                  >
+                    Подать заявку
+                  </Button>
+                )
+              )
+            }
+          >
+            <Flex vertical gap="middle">
+              <Descriptions
+                size="small"
+                column={{ xs: 1, md: 2 }}
+                items={stageDates(wave)}
+              />
+              {wave.units.map((unit) => (
+                <Flex key={unit.id} vertical>
+                  <Typography.Text strong>{unit.name}</Typography.Text>
+                  {unit.targets.length === 0 && (
+                    <Typography.Text type="secondary">
+                      Матриц, на которые можно подать заявку, пока нет.
+                    </Typography.Text>
+                  )}
+                  {unit.targets.map((target) => (
+                    <Typography.Text key={target.matrixId} type="secondary">
+                      {target.trackName}:{" "}
+                      {target.levels.map((level) => level.name).join(", ")}
+                    </Typography.Text>
+                  ))}
+                </Flex>
+              ))}
+            </Flex>
+          </Card>
+        );
+      })}
+    </Flex>
+  );
+}
