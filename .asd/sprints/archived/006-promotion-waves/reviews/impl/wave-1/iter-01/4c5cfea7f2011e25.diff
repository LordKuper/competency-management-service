+++ b/web/src/features/promotion/RatersPage.tsx
@@ -0,0 +1,134 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { App, Breadcrumb, Col, Flex, Row, Skeleton, Typography } from "antd";
+import { Link, useParams } from "react-router";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import { contentMaxWidth } from "../../app/theme";
+import { isStaleVersion, useEditBase } from "../../app/useEditBase";
+import { DeadlineNote } from "./DeadlineNote";
+import { HeadCandidatesList } from "./HeadCandidatesList";
+import {
+  applicationQuery,
+  headCandidatesQuery,
+  type PromotionApplication,
+  promotionQueryKey,
+  type RaterEntry,
+  saveRaterEmail,
+  saveRaters,
+  type Versioned,
+} from "./promotionApi";
+import { STAGE } from "./promotionTexts";
+import { RatersView } from "./RatersView";
+import { promotionPaths } from "./routes";
+import { useRaterOptions } from "./useRaterOptions";
+
+/** The raters of a candidate, which the head of the unit of the target corrects. */
+export function RatersPage() {
+  const { applicationId } = useParams();
+  return (
+    <Flex
+      vertical
+      gap="large"
+      style={{ maxWidth: contentMaxWidth, marginInline: "auto" }}
+    >
+      <Breadcrumb
+        items={[
+          { title: <Link to={promotionPaths.home}>Карьерные переходы</Link> },
+          { title: "Оценивающие" },
+        ]}
+      />
+      <Typography.Title level={1} style={{ margin: 0 }}>
+        Оценивающие кандидатов
+      </Typography.Title>
+      {applicationId && <LoadedRaters id={applicationId} />}
+    </Flex>
+  );
+}
+
+function LoadedRaters({ id }: { id: string }) {
+  const { data, error, isPending, refetch } = useQuery(applicationQuery(id));
+  if (isPending) return <Skeleton active />;
+  if (error) {
+    return (
+      <ErrorAlert
+        title="Не удалось загрузить заявку"
+        error={error}
+        onRetry={() => void refetch()}
+      />
+    );
+  }
+  return <RatersEditor latest={data} />;
+}
+
+/** The list with the application it was opened with; it takes the reread one only after a save is refused for a stale version. */
+function RatersEditor({ latest }: { latest: Versioned<PromotionApplication> }) {
+  const queryClient = useQueryClient();
+  const { message } = App.useApp();
+  const { base = latest, noteSaveFailure, rebase } = useEditBase(latest);
+  const employees = useRaterOptions("rater-picker");
+  const candidates = useQuery(headCandidatesQuery(latest.waveId));
+  const save = useMutation({
+    mutationFn: (raters: RaterEntry[]) =>
+      saveRaters(base.id, base.version, raters),
+    onSuccess: (saved) => {
+      rebase(saved);
+      message.success("Список оценивающих сохранён");
+    },
+    onError: noteSaveFailure,
+    onSettled: () =>
+      queryClient.invalidateQueries({ queryKey: promotionQueryKey }),
+  });
+  const confirmEmail = useMutation({
+    mutationFn: ({
+      employeeId,
+      email,
+    }: {
+      employeeId: string;
+      email: string;
+    }) => saveRaterEmail(base.id, base.version, employeeId, email),
+    onSuccess: (saved) => {
+      rebase(saved);
+      message.success("Почта подтверждена");
+    },
+    onError: noteSaveFailure,
+    onSettled: () =>
+      queryClient.invalidateQueries({ queryKey: promotionQueryKey }),
+  });
+  return (
+    <Flex vertical gap="middle">
+      <DeadlineNote
+        session={base.session}
+        label="Списки можно менять до"
+        stage={STAGE.formalCheck}
+      />
+      {save.isError && (
+        <ErrorAlert title="Список не сохранён" error={save.error} />
+      )}
+      {confirmEmail.isError && isStaleVersion(confirmEmail.error) && (
+        <ErrorAlert title="Почта не подтверждена" error={confirmEmail.error} />
+      )}
+      <Row gutter={[24, 24]}>
+        <Col xs={24} lg={7}>
+          {candidates.data && (
+            <HeadCandidatesList
+              candidates={candidates.data.candidates}
+              currentId={base.id}
+            />
+          )}
+        </Col>
+        <Col xs={24} lg={17}>
+          <RatersView
+            key={base.version}
+            application={base}
+            candidates={employees.candidates}
+            isSearching={employees.isSearching}
+            onSearch={employees.onSearch}
+            onSubmit={save.mutateAsync}
+            onConfirmEmail={(employeeId, email) =>
+              confirmEmail.mutateAsync({ employeeId, email })
+            }
+          />
+        </Col>
+      </Row>
+    </Flex>
+  );
+}
diff --git a/web/src/features/promotion/RatersView.tsx b/web/src/features/promotion/RatersView.tsx
new file mode 100644
index 00000000..44b35990
--- /dev/null
+++ b/web/src/features/promotion/RatersView.tsx
@@ -0,0 +1,132 @@
+import { Alert, Button, Flex, Form, Typography } from "antd";
+import { useState } from "react";
+import { useLeaveGuard } from "../../app/leaveGuard";
+import { useFormSubmit } from "../../app/useFormSubmit";
+import type { EmployeeOption } from "./CommissionView";
+import { Panel } from "./Panel";
+import type { PromotionApplication, RaterEntry } from "./promotionApi";
+import { HEAD_RATERS_HINT, STAGE } from "./promotionTexts";
+import { RatersField } from "./RatersField";
+import { normalizedEmail } from "./raterEmail";
+
+interface RatersFormValues {
+  raters: RaterEntry[];
+}
+
+interface RatersViewProps {
+  application: PromotionApplication;
+  /** Employees the last search found. */
+  candidates: readonly EmployeeOption[];
+  isSearching: boolean;
+  onSearch: (text: string) => void;
+  /** Saves the list, which confirms the addresses it changes; a refusal that names fields is shown under them, any other one is shown by the caller. */
+  onSubmit: (raters: RaterEntry[]) => Promise<unknown>;
+  /** Confirms the saved address of a rater without an account; a refusal is shown by the row. */
+  onConfirmEmail: (employeeId: string, email: string) => Promise<unknown>;
+}
+
+function entriesOf(application: PromotionApplication): RaterEntry[] {
+  return (application.raters ?? []).map((rater) => ({
+    employeeId: rater.employeeId,
+    email: rater.email,
+  }));
+}
+
+/** The raters of a filed candidate, which the head of the target unit may add to or correct until the formal check ends, and the addresses of those without an account, which the head confirms. */
+export function RatersView({
+  application,
+  candidates,
+  isSearching,
+  onSearch,
+  onSubmit,
+  onConfirmEmail,
+}: RatersViewProps) {
+  const [form] = Form.useForm<RatersFormValues>();
+  const [isDirty, setIsDirty] = useState(false);
+  const [isConfirming, setIsConfirming] = useState(false);
+  const { isSubmitting, submit } = useFormSubmit(form, async (values) => {
+    await onSubmit(
+      (values.raters ?? []).map((rater) => ({
+        employeeId: rater.employeeId,
+        email: normalizedEmail(rater.email),
+      })),
+    );
+    setIsDirty(false);
+  });
+  useLeaveGuard({ isUnsaved: isDirty, isSaving: isSubmitting });
+  const isBusy = isSubmitting || isConfirming;
+  const canEdit =
+    application.roles.includes("Head") &&
+    application.stage <= STAGE.formalCheck &&
+    application.status === "Submitted";
+
+  async function confirmEmail(employeeId: string, email: string) {
+    setIsConfirming(true);
+    try {
+      await onConfirmEmail(employeeId, email);
+    } finally {
+      setIsConfirming(false);
+    }
+  }
+
+  return (
+    <Panel
+      title={`${application.candidateName}: оценивающие`}
+      tour="raters-form"
+      extra={
+        application.raterCounts && (
+          <Typography.Text type="secondary">
+            {application.raterCounts.total} из{" "}
+            {application.raterCounts.requiredTotal}, из других подразделений{" "}
+            {application.raterCounts.fromOtherUnits} из{" "}
+            {application.raterCounts.requiredFromOtherUnits}
+          </Typography.Text>
+        )
+      }
+    >
+      <Flex vertical gap="middle">
+        <Typography.Text type="secondary">
+          {HEAD_RATERS_HINT} В конце этапа «Формальная проверка» список
+          становится окончательным: тем, у кого нет учётной записи, сначала
+          уйдёт приглашение в систему, затем каждому оценивающему — одно письмо
+          со всеми, кого ему нужно оценить.
+        </Typography.Text>
+        {!canEdit && (
+          <Alert
+            type="info"
+            showIcon
+            title="Список оценивающих уже не меняется"
+          />
+        )}
+        <Form
+          form={form}
+          name="promotion-raters"
+          layout="vertical"
+          disabled={isBusy}
+          initialValues={{ raters: entriesOf(application) }}
+          onFinish={submit}
+          onValuesChange={() => setIsDirty(form.isFieldsTouched())}
+        >
+          <Form.Item name="raters">
+            <RatersField
+              saved={application.raters ?? []}
+              candidates={candidates}
+              excludedIds={[application.candidateEmployeeId]}
+              isSearching={isSearching}
+              isLocked={isBusy || !canEdit}
+              onSearch={onSearch}
+              onConfirmEmail={confirmEmail}
+              isConfirmLocked={isDirty}
+              hasSourceColumn
+            />
+          </Form.Item>
+          {canEdit && (
+            <Button type="primary" htmlType="submit" loading={isSubmitting}>
+              Сохранить список
+            </Button>
+          )}
+        </Form>
+      </Flex>
+    </Panel>
+  );
+}
diff --git a/web/src/features/promotion/RatingPage.tsx b/web/src/features/promotion/RatingPage.tsx
new file mode 100644
index 00000000..e3b4c892
