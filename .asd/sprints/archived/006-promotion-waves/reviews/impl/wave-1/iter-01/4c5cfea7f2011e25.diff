@@ -0,0 +1,25 @@
+import { useQuery } from "@tanstack/react-query";
+import { useCurrentUser } from "../auth/useCurrentUser";
+import {
+  myApplicationsQuery,
+  openWavesQuery,
+  unfinishedApplicationIdByWave,
+} from "../promotion/promotionApi";
+import { PromotionWavesView } from "./PromotionWavesView";
+
+/** Reads the open waves and the viewer's applications for the desk block; the block stays out of the way while loading and when either read fails. */
+export function PromotionWavesBlock() {
+  const { data: user } = useCurrentUser();
+  const waves = useQuery(openWavesQuery);
+  const mine = useQuery(myApplicationsQuery);
+  if (!waves.data || mine.isPending) {
+    return null;
+  }
+  return (
+    <PromotionWavesView
+      waves={waves.data}
+      applicationIdByWave={unfinishedApplicationIdByWave(mine.data ?? [])}
+      canApply={user?.employeeId != null}
+    />
+  );
+}
diff --git a/web/src/features/desk/PromotionWavesView.tsx b/web/src/features/desk/PromotionWavesView.tsx
new file mode 100644
index 00000000..3d2106b3
--- /dev/null
+++ b/web/src/features/desk/PromotionWavesView.tsx
@@ -0,0 +1,131 @@
+import { theme as antdTheme, Flex, Table, Tag, Typography } from "antd";
+import type { OpenWave } from "../promotion/promotionApi";
+import { formatDate, STAGE } from "../promotion/promotionTexts";
+import { promotionPaths } from "../promotion/routes";
+import { DeskPanel } from "./DeskGroups";
+import { LinkButton } from "./LinkButton";
+import "./scenario.css";
+
+interface PromotionWavesViewProps {
+  waves: readonly OpenWave[];
+  /** The unfinished application of the viewer by the wave it was filed in. */
+  applicationIdByWave: ReadonlyMap<string, string>;
+  /** Whether the viewer can file an application: an account without an employee cannot. */
+  canApply: boolean;
+}
+
+interface WaveRow {
+  wave: OpenWave;
+  tracks: string[];
+}
+
+function rowsOf(waves: readonly OpenWave[]): WaveRow[] {
+  return waves
+    .map((wave) => ({
+      wave,
+      tracks: [
+        ...new Set(
+          wave.units.flatMap((unit) =>
+            unit.targets.map((target) => target.trackName),
+          ),
+        ),
+      ],
+    }))
+    .filter((row) => row.tracks.length > 0);
+}
+
+function PeriodCell({ wave }: { wave: OpenWave }) {
+  const [deadline] = wave.endsOn;
+  if (wave.stage === STAGE.submission) {
+    return (
+      <Flex vertical align="start">
+        <Tag color="processing">Идёт приём заявок</Tag>
+        {deadline && <span>до {formatDate(deadline)}</span>}
+      </Flex>
+    );
+  }
+  return (
+    <Flex vertical align="start">
+      <Tag>Скоро начнётся</Tag>
+      <span>приём заявок с {formatDate(wave.startsOn)}</span>
+    </Flex>
+  );
+}
+
+/** The desk block of the career sessions one can apply to or that are announced: units and tracks, the deadline or the start of applications, and the way to apply or to read more. Nothing is drawn when no session offers a track. */
+export function PromotionWavesView({
+  waves,
+  applicationIdByWave,
+  canApply,
+}: PromotionWavesViewProps) {
+  const { token } = antdTheme.useToken();
+  const rows = rowsOf(waves);
+  if (rows.length === 0) {
+    return null;
+  }
+  return (
+    <Flex vertical gap={token.margin} data-tour="desk-waves">
+      <Typography.Title level={2} style={{ margin: 0 }}>
+        Карьерные сессии
+      </Typography.Title>
+      <DeskPanel>
+        <Table<WaveRow>
+          rowKey={(row) => row.wave.id}
+          dataSource={rows}
+          pagination={false}
+          tableLayout="fixed"
+          className="desk-table"
+          columns={[
+            {
+              key: "period",
+              title: "Приём заявок",
+              render: (_, row) => <PeriodCell wave={row.wave} />,
+            },
+            {
+              key: "session",
+              title: "Карьерная сессия",
+              render: (_, { wave, tracks }) => (
+                <Flex vertical gap="small" align="start">
+                  <Typography.Text type="secondary">
+                    Карьерная сессия с {formatDate(wave.startsOn)} ·{" "}
+                    {wave.units.map((unit) => unit.name).join(", ")}
+                  </Typography.Text>
+                  <Flex wrap gap="small">
+                    {tracks.map((track) => (
+                      <Tag key={track}>{track}</Tag>
+                    ))}
+                  </Flex>
+                </Flex>
+              ),
+            },
+            {
+              key: "action",
+              title: "Действия",
+              className: "desk-nowrap",
+              render: (_, { wave }) => {
+                if (wave.stage !== STAGE.submission) {
+                  return (
+                    <LinkButton to={promotionPaths.home}>Подробнее</LinkButton>
+                  );
+                }
+                if (!canApply) {
+                  return null;
+                }
+                const applicationId = applicationIdByWave.get(wave.id);
+                return applicationId ? (
+                  <LinkButton to={promotionPaths.application(applicationId)}>
+                    Моя заявка
+                  </LinkButton>
+                ) : (
+                  <LinkButton type="primary" to={promotionPaths.apply(wave.id)}>
+                    Подать заявку
+                  </LinkButton>
+                );
+              },
+            },
+          ]}
+        />
+      </DeskPanel>
+    </Flex>
+  );
+}
