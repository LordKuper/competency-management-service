@@ -0,0 +1,194 @@
+using Competency.CareerFramework;
+using Competency.OrgStructure;
+using Competency.Platform;
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Http.HttpResults;
+using Microsoft.AspNetCore.Routing;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.Promotion;
+
+/// <summary>
+/// What a wave offers about applications. A signed-in employee who can file applications reads the form of a target of a wave that takes them, with
+/// only the levels they may aim at and the education on their card. The applications of
+/// a wave are listed for those who run it, or have a role in the unit of the target: its author and global administrators see all of them, the
+/// responsible HR, the head and the members of a commission only those aimed at their own unit. A wave nobody may list is reported as not found.
+/// </summary>
+internal static class WaveApplicationEndpoints
+{
+    private const string Route = "/api/v1/promotion/waves/{waveId:guid}";
+    private const string Tag = "Promotion";
+    private const int SubmissionStage = 1;
+
+    private static readonly ApplicationStatus[] HeadStatuses =
+        [ApplicationStatus.Submitted, ApplicationStatus.Admitted, ApplicationStatus.UnderReview, ApplicationStatus.Decided, ApplicationStatus.NoDecision];
+
+    public static void Map(IEndpointRouteBuilder endpoints)
+    {
+        var group = endpoints.MapGroup(Route)
+            .WithTags(Tag)
+            .RequireAuthorization(AuthorizationPolicies.Authenticated)
+            .ProducesProblem(StatusCodes.Status401Unauthorized)
+            .ProducesProblem(StatusCodes.Status404NotFound);
+
+        group.MapGet("/applications", ListAsync).WithName("ListPromotionWaveApplications");
+        group.MapGet("/session", GetSessionAsync).WithName("GetPromotionSession");
+        group.MapGet("/head/candidates", ListHeadCandidatesAsync).WithName("ListPromotionHeadCandidates");
+        group.MapGet("/targets/{unitId:guid}/{matrixId:guid}", GetTargetAsync).WithName("GetPromotionTargetForm").ProducesProblem(StatusCodes.Status403Forbidden);
+    }
+
+    private static async Task<Results<Ok<ApplicationPageResponse>, NotFound, ValidationProblem>> ListAsync(
+        Guid waveId,
+        [AsParameters] ApplicationListQuery query,
+        AppDbContext context,
+        ApplicationAccess access,
+        ApplicationReader reader,
+        CancellationToken cancellationToken)
+    {
+        var errors = query.Validate();
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        var wave = await context.Set<PromotionWave>().AsNoTracking().FirstOrDefaultAsync(candidate => candidate.Id == waveId, cancellationToken);
+        if (wave is null)
+        {
+            return TypedResults.NotFound();
+        }
+
+        var unitIds = await context.Set<PromotionWaveUnit>().AsNoTracking().Where(member => member.WaveId == waveId).Select(member => member.OrgUnitId).ToListAsync(cancellationToken);
+        var viewer = await access.ViewerAsync(wave, unitIds, cancellationToken);
+        var applications = context.Set<PromotionApplication>().AsNoTracking().Where(application => application.WaveId == waveId);
+        if (viewer.WaveRoles == ApplicationRole.None)
+        {
+            var visibleUnitIds = viewer.UnitRoles.Where(unit => unit.Value != ApplicationRole.None).Select(unit => unit.Key).ToArray();
+            if (visibleUnitIds.Length == 0)
+            {
+                return TypedResults.NotFound();
+            }
+
+            applications = applications.Where(application => visibleUnitIds.Contains(application.OrgUnitId));
+        }
+
+        var seen = (await applications.OrderBy(application => application.CreatedAt).ThenBy(application => application.Id).ToListAsync(cancellationToken))
+            .Where(application => viewer.RolesOf(application) != ApplicationRole.None)
+            .ToList();
+        var rows = await reader.SummariesAsync(seen, new Dictionary<Guid, PromotionWave> { [wave.Id] = wave }, viewer, cancellationToken);
+        var search = query.Search?.Trim();
+        var searched = string.IsNullOrEmpty(search) ? rows : [.. rows.Where(row => row.CandidateName.Contains(search, StringComparison.OrdinalIgnoreCase))];
+        var counts = new ApplicationCountsResponse(
+            searched.Count,
+            searched.Count(row => row.NeedsFormalData),
+            [.. searched.GroupBy(row => row.Status).OrderBy(group => group.Key).Select(group => new ApplicationStatusCountResponse(group.Key, group.Count()))]);
+        var matching = searched.Where(row => (query.Status is null || row.Status == query.Status) && (query.NeedsFormalData != true || row.NeedsFormalData)).ToList();
+        return TypedResults.Ok(new ApplicationPageResponse(
+            [.. matching.Skip((query.Page - 1) * query.PageSize).Take(query.PageSize)],
+            matching.Count,
+            query.Page,
+            query.PageSize,
+            counts));
+    }
+
+    /// <summary>
+    /// Reads the dates of a session for everyone who has a part in it: a manager of the wave, a member of a commission of its units, a candidate or a rater.
+    /// </summary>
+    private static async Task<Results<Ok<SessionDatesResponse>, NotFound>> GetSessionAsync(
+        Guid waveId,
+        AppDbContext context,
+        ApplicationAccess access,
+        PromotionCalendar calendar,
+        CancellationToken cancellationToken)
+    {
+        var wave = await context.Set<PromotionWave>().AsNoTracking().FirstOrDefaultAsync(candidate => candidate.Id == waveId, cancellationToken);
+        if (wave is null)
+        {
+            return TypedResults.NotFound();
+        }
+
+        var unitIds = await context.Set<PromotionWaveUnit>().AsNoTracking().Where(member => member.WaveId == waveId).Select(member => member.OrgUnitId).ToListAsync(cancellationToken);
+        var viewer = await access.ViewerAsync(wave, unitIds, cancellationToken);
+        var hasPart = viewer.WaveRoles != ApplicationRole.None
+            || viewer.UnitRoles.Any(unit => unit.Value != ApplicationRole.None)
+            || (viewer.EmployeeId is { } employeeId
+                && await context.Set<PromotionApplication>().AnyAsync(
+                    application => application.WaveId == waveId
+                        && (application.EmployeeId == employeeId
+                            || context.Set<PromotionRater>().Any(rater => rater.ApplicationId == application.Id && rater.EmployeeId == employeeId)),
+                    cancellationToken));
+        return hasPart ? TypedResults.Ok(SessionDatesResponse.From(wave, calendar.StageOf(wave))) : TypedResults.NotFound();
+    }
+
+    /// <summary>
+    /// Lists the candidates of the units the signed-in user heads in a wave, with how complete the lists of their raters are; the units of a head are the
+    /// ones the commission roster names. Drafts, withdrawn and formally rejected applications are left out.
+    /// </summary>
+    private static async Task<Results<Ok<HeadCandidatesResponse>, NotFound>> ListHeadCandidatesAsync(
+        Guid waveId,
+        AppDbContext context,
+        ApplicationAccess access,
+        ApplicationReader reader,
+        PromotionCalendar calendar,
+        CancellationToken cancellationToken)
+    {
+        var wave = await context.Set<PromotionWave>().AsNoTracking().FirstOrDefaultAsync(candidate => candidate.Id == waveId, cancellationToken);
+        if (wave is null)
+        {
+            return TypedResults.NotFound();
+        }
+
+        var unitIds = await context.Set<PromotionWaveUnit>().AsNoTracking().Where(member => member.WaveId == waveId).Select(member => member.OrgUnitId).ToListAsync(cancellationToken);
+        var viewer = await access.ViewerAsync(wave, unitIds, cancellationToken);
+        var headed = viewer.UnitRoles.Where(unit => unit.Value.HasFlag(ApplicationRole.Head)).Select(unit => unit.Key).ToArray();
+        if (headed.Length == 0)
+        {
+            return TypedResults.NotFound();
+        }
+
+        var applications = await context.Set<PromotionApplication>()
+            .AsNoTracking()
+            .Where(application => application.WaveId == waveId && headed.Contains(application.OrgUnitId) && HeadStatuses.Contains(application.Status))
+            .ToListAsync(cancellationToken);
+        return TypedResults.Ok(new HeadCandidatesResponse(
+            SessionDatesResponse.From(wave, calendar.StageOf(wave)),
+            await reader.HeadCandidatesAsync(applications, wave, cancellationToken)));
+    }
+
+    private static async Task<Results<Ok<TargetFormResponse>, NotFound, ProblemHttpResult>> GetTargetAsync(
+        Guid waveId,
+        Guid unitId,
+        Guid matrixId,
+        AppDbContext context,
+        IEmployeeDirectory employees,
+        ICareerModel career,
+        ApplicationAccess access,
+        ApplicationRules rules,
+        PromotionCalendar calendar,
+        CancellationToken cancellationToken)
+    {
+        var wave = await context.Set<PromotionWave>().AsNoTracking().FirstOrDefaultAsync(candidate => candidate.Id == waveId, cancellationToken);
+        var matrix = await context.Set<PromotionWaveMatrix>().AsNoTracking().FirstOrDefaultAsync(bound => bound.WaveId == waveId && bound.OrgUnitId == unitId && bound.MatrixId == matrixId, cancellationToken);
+        if (wave is null || matrix is null || calendar.StageOf(wave) != SubmissionStage
+            || await career.VersionAsync(matrix.VersionId, cancellationToken) is not { } version
+            || await employees.FindUnitAsync(matrix.OrgUnitId, cancellationToken) is not { } unit)
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (await access.ActingCandidateAsync(cancellationToken) is not { } candidate)
+        {
+            return Rejection.Forbidden();
+        }
+
+        var allowed = await rules.AllowedLevelIdsAsync(matrix, version, candidate, cancellationToken);
+        return TypedResults.Ok(new TargetFormResponse(
+            matrix.MatrixId,
+            unit.Id,
+            unit.Name,
+            matrix.TrackName,
+            candidate.Education,
+            [.. version.Levels.Where(level => allowed.Contains(level.Id)).OrderBy(level => level.Order).Select(level => new TargetFormLevelResponse(level.Id, level.Name, level.RequiredEducation))],
+            [.. version.Competencies.Select(competency => TargetFormCompetencyResponse.Of(version, competency, withRequirements: true))]));
+    }
+}
diff --git a/src/Competency.Promotion/WaveDates.cs b/src/Competency.Promotion/WaveDates.cs
new file mode 100644
index 00000000..f0cec1e6
--- /dev/null
+++ b/src/Competency.Promotion/WaveDates.cs
@@ -0,0 +1,133 @@
+namespace Competency.Promotion;
+
+/// <summary>
+/// The rules for the dates of a wave: the first stage starts at least a week after the wave is announced; a date never falls on a day before the
+/// date of the previous stage, nor beyond the horizon; a wave being announced has no end date before today, while one being changed may keep or move
+/// a date into the past; once the wave has started its start date is fixed, and so is the end date of every stage that has finished. A wave going back
+/// to a stage that has passed keeps the end dates of the stages before it, and the stage it returns to and every later one end today or later.
+/// </summary>
+internal static class WaveDates
+{
+    /// <summary>
+    /// The days between the announcement of a wave and the start of its first stage, at the least.
+    /// </summary>
+    public const int MinLeadDays = 7;
+
+    private const int HorizonYears = 5;
+    private const string EndsField = "endsOn";
+    private const string StartField = "startsOn";
+    private const string BeforeTodayMessage = "Дата не раньше сегодняшнего дня";
+    private const string BeforePreviousMessage = "Дата не раньше даты завершения предыдущего этапа";
+    private const string FinishedMessage = "Этап завершён: его дату нельзя изменить";
+
+    /// <summary>
+    /// Checks the dates of a request against the rules.
+    /// </summary>
+    /// <param name="request">The request.</param>
+    /// <param name="wave">The wave being changed; null for a wave being announced.</param>
+    /// <param name="stage">The stage the wave is in, as <see cref="PromotionCalendar.StageOf"/> finds it; 0 for a wave being announced.</param>
+    /// <param name="announcedOn">The day the wave is or was announced.</param>
+    /// <param name="today">The current day.</param>
+    /// <returns>The problems found by field name, an end date by <c>endsOn[n]</c> with n counting from 0; empty when the dates are valid.</returns>
+    public static Dictionary<string, string[]> Validate(WaveRequest request, PromotionWave? wave, int stage, DateOnly announcedOn, DateOnly today)
+    {
+        var errors = new Dictionary<string, string[]>();
+        if (request.EndsOn is not { Length: PromotionWave.StageCount })
+        {
+            errors[EndsField] = [$"Укажите дату завершения каждого из {PromotionWave.StageCount} этапов"];
+            return errors;
+        }
+
+        var horizon = today.AddYears(HorizonYears);
+        if (wave is not null && stage >= 1)
+        {
+            if (request.StartsOn != wave.StartsOn)
+            {
+                errors[StartField] = ["Дату начала нельзя изменить после начала карьерной сессии"];
+            }
+        }
+        else if (StartProblem(request.StartsOn, announcedOn, horizon) is { } startProblem)
+        {
+            errors[StartField] = [startProblem];
+        }
+
+        var previous = request.StartsOn;
+        for (var index = 0; index < PromotionWave.StageCount; index++)
+        {
+            var date = request.EndsOn[index];
+            var problem = wave is not null && index + 1 < stage
+                ? date == wave.EndsOn[index] ? null : FinishedMessage
+                : EndProblem(date, previous, mustBeFuture: wave is null, today, horizon);
+            if (problem is not null)
+            {
+                errors[$"{EndsField}[{index}]"] = [problem];
+            }
+
+            previous = date;
+        }
+
+        return errors;
+    }
+
+    /// <summary>
+    /// Checks the dates of a request that takes a wave back to a stage that has passed against the rules.
+    /// </summary>
+    /// <param name="request">The request.</param>
+    /// <param name="wave">The wave.</param>
+    /// <param name="today">The current day.</param>
+    /// <returns>The problems found by field name, an end date by <c>endsOn[n]</c> with n counting from 0; empty when the dates are valid.</returns>
+    public static Dictionary<string, string[]> ValidateRollback(RollbackRequest request, PromotionWave wave, DateOnly today)
+    {
+        var errors = new Dictionary<string, string[]>();
+        if (request.EndsOn is not { Length: PromotionWave.StageCount })
+        {
+            errors[EndsField] = [$"Укажите дату завершения каждого из {PromotionWave.StageCount} этапов"];
+            return errors;
+        }
+
+        var horizon = today.AddYears(HorizonYears);
+        var previous = wave.StartsOn;
+        for (var index = 0; index < PromotionWave.StageCount; index++)
+        {
+            var date = request.EndsOn[index];
+            var problem = index + 1 < request.Stage
+                ? date == wave.EndsOn[index] ? null : FinishedMessage
+                : EndProblem(date, previous, mustBeFuture: true, today, horizon);
+            if (problem is not null)
+            {
+                errors[$"{EndsField}[{index}]"] = [problem];
+            }
+
+            previous = date;
+        }
+
+        return errors;
+    }
+
+    private static string? StartProblem(DateOnly date, DateOnly announcedOn, DateOnly horizon)
+    {
+        if (date < announcedOn.AddDays(MinLeadDays))
+        {
+            return $"Приём заявок начинается не раньше чем через {MinLeadDays} дней после объявления карьерной сессии";
+        }
+
+        return date > horizon ? HorizonMessage() : null;
+    }
+
+    private static string? EndProblem(DateOnly date, DateOnly previous, bool mustBeFuture, DateOnly today, DateOnly horizon)
+    {
+        if (mustBeFuture && date < today)
+        {
+            return BeforeTodayMessage;
+        }
+
+        if (date < previous)
+        {
+            return BeforePreviousMessage;
+        }
+
+        return date > horizon ? HorizonMessage() : null;
+    }
+
+    private static string HorizonMessage() => $"Дата не позже чем через {HorizonYears} лет";
+}
diff --git a/src/Competency.Promotion/WaveEndpoints.cs b/src/Competency.Promotion/WaveEndpoints.cs
new file mode 100644
index 00000000..4bf8da6c
--- /dev/null
+++ b/src/Competency.Promotion/WaveEndpoints.cs
@@ -0,0 +1,202 @@
+using Competency.Platform;
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Http.HttpResults;
+using Microsoft.AspNetCore.Routing;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.Promotion;
+
+/// <summary>
+/// The wave API. Global administrators and HR announce waves, within the units HR answer for, and read the waves they manage; the author and
+/// global administrators change a wave, with <c>If-Match</c>. Every change of a wave takes the exclusive promotion lock, because the units of
+/// unfinished waves must not repeat. Any signed-in user reads the open waves. A wave its reader may not see is reported as not found.
+/// </summary>
+internal static class WaveEndpoints
+{
+    private const string Route = "/api/v1/promotion/waves";
+    private const string Tag = "Promotion";
+    private const string UnitsField = "unitIds";
+    private const string FinishedMessage = "Карьерная сессия завершена: её нельзя изменить";
+    private const string UnitsFixedMessage = "После начала карьерной сессии подразделения менять нельзя";
+    private const string NoUnitsMessage = "Выберите хотя бы одно подразделение";
+
+    public static void Map(IEndpointRouteBuilder endpoints)
+    {
+        var group = endpoints.MapGroup(Route)
+            .WithTags(Tag)
+            .ProducesProblem(StatusCodes.Status401Unauthorized);
+
+        group.MapGet("/open", ListOpenAsync).WithName("ListOpenPromotionWaves")
+            .RequireAuthorization(AuthorizationPolicies.Authenticated);
+
+        var managers = group.MapGroup(string.Empty)
+            .RequireAuthorization(AuthorizationPolicies.GlobalAdminOrHr)
+            .ProducesProblem(StatusCodes.Status403Forbidden);
+
+        managers.MapGet(string.Empty, ListAsync).WithName("ListPromotionWaves");
+        managers.MapPost(string.Empty, CreateAsync).WithName("CreatePromotionWave").ProducesETag();
+        managers.MapGet("/{id:guid}", GetAsync).WithName("GetPromotionWave").ProducesETag()
+            .ProducesProblem(StatusCodes.Status404NotFound);
+        managers.MapPut("/{id:guid}", UpdateAsync).WithName("UpdatePromotionWave").ProducesETag()
+            .ProducesProblem(StatusCodes.Status404NotFound)
+            .ProducesProblem(StatusCodes.Status409Conflict);
+    }
+
+    private static async Task<Ok<IReadOnlyList<OpenWaveResponse>>> ListOpenAsync(OpenWaves open, CancellationToken cancellationToken) =>
+        TypedResults.Ok(await open.ReadAsync(cancellationToken));
+
+    private static async Task<Results<Ok<PageResponse<WaveResponse>>, ValidationProblem>> ListAsync(
+        [AsParameters] WaveListQuery query,
+        AppDbContext context,
+        WaveReader reader,
+        CancellationToken cancellationToken)
+    {
+        var errors = query.Validate();
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        var page = await (await reader.VisibleAsync(context.Set<PromotionWave>().AsNoTracking(), cancellationToken))
+            .OrderByDescending(wave => wave.StartsOn)
+            .ThenBy(wave => wave.Id)
+            .ToPageAsync(query.Page, query.PageSize, cancellationToken);
+        return TypedResults.Ok(new PageResponse<WaveResponse>(await reader.DescribeAsync([.. page.Items], cancellationToken), page.Total, page.Page, page.PageSize));
+    }
+
+    private static async Task<Results<Ok<WaveResponse>, NotFound>> GetAsync(
+        Guid id,
+        AppDbContext context,
+        WaveReader reader,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        var wave = await context.Set<PromotionWave>().AsNoTracking().FirstOrDefaultAsync(candidate => candidate.Id == id, cancellationToken);
+        if (wave is null || !await reader.CanSeeAsync(wave, cancellationToken))
+        {
+            return TypedResults.NotFound();
+        }
+
+        response.SetETag(wave.Version);
+        return TypedResults.Ok((await reader.DescribeAsync([wave], cancellationToken))[0]);
+    }
+
+    /// <summary>
+    /// Announces a wave. Its first stage starts at least a week from today and none of its stages ends in the past, each unit exists, works, is one the
+    /// author answers for, belongs to no unfinished wave and has a commission with a chair. The employees of its units are told by letter once it is saved.
+    /// </summary>
+    private static async Task<Results<Created<WaveResponse>, ValidationProblem>> CreateAsync(
+        WaveRequest request,
+        AppDbContext context,
+        PromotionLocks locks,
+        PromotionCalendar calendar,
+        WaveUnits waveUnits,
+        WaveReader reader,
+        PromotionMail mail,
+        ICurrentActor actor,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        if (request.UnitIds is not { Length: > 0 })
+        {
+            return Rejection.Invalid(UnitsField, NoUnitsMessage);
+        }
+
+        await using var transaction = await locks.BeginExclusiveAsync(cancellationToken);
+        var errors = WaveDates.Validate(request, wave: null, stage: 0, announcedOn: calendar.Today, calendar.Today);
+        var unitIds = request.UnitIds.Distinct().ToList();
+        if (await waveUnits.ProblemsAsync(unitIds, waveId: null, cancellationToken) is { Count: > 0 } problems)
+        {
+            errors[UnitsField] = [.. problems];
+        }
+
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        var wave = new PromotionWave { AuthorId = actor.UserId!.Value, StartsOn = request.StartsOn, EndsOn = [.. request.EndsOn] };
+        context.Add(wave);
+        context.AddRange(unitIds.Select(unitId => new PromotionWaveUnit { WaveId = wave.Id, OrgUnitId = unitId }));
+        await context.SaveChangesAsync(cancellationToken);
+        await transaction.CommitAsync(cancellationToken);
+
+        await mail.WaveAnnouncedAsync(wave, cancellationToken);
+
+        response.SetETag(wave.Version);
+        return TypedResults.Created($"{Route}/{wave.Id}", (await reader.DescribeAsync([wave], cancellationToken))[0]);
+    }
+
+    /// <summary>
+    /// Changes the dates and units of a wave. Before it starts everything may change; afterwards the start date, the units and the end dates
+    /// of finished stages stay, and the end dates of the running and later stages move freely, past days included. A wave that is over does not change.
+    /// </summary>
+    private static async Task<Results<Ok<WaveResponse>, NotFound, ValidationProblem, ProblemHttpResult>> UpdateAsync(
+        Guid id,
+        WaveRequest request,
+        IfMatch ifMatch,
+        AppDbContext context,
+        PromotionLocks locks,
+        PromotionCalendar calendar,
+        WaveUnits waveUnits,
+        WaveReader reader,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        if (request.UnitIds is not { Length: > 0 })
+        {
+            return Rejection.Invalid(UnitsField, NoUnitsMessage);
+        }
+
+        await using var transaction = await locks.BeginExclusiveAsync(cancellationToken);
+        if (await locks.FindWaveForUpdateAsync(id, cancellationToken) is not { } wave || !await reader.CanSeeAsync(wave, cancellationToken))
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (!reader.CanEdit(wave))
+        {
+            return Rejection.Forbidden();
+        }
+
+        var stage = calendar.StageOf(wave);
+        if (wave.IsFinished || stage == PromotionCalendar.AfterLastStage)
+        {
+            return Rejection.Conflict(FinishedMessage);
+        }
+
+        ifMatch.ApplyTo(context, wave);
+        var errors = WaveDates.Validate(request, wave, stage, calendar.DayOf(wave.CreatedAt), calendar.Today);
+        var stored = await context.Set<PromotionWaveUnit>().Where(member => member.WaveId == id).ToListAsync(cancellationToken);
+        var unitIds = request.UnitIds.Distinct().ToList();
+        var added = unitIds.Except(stored.Select(member => member.OrgUnitId)).ToList();
+        if (stage >= 1)
+        {
+            if (added.Count > 0 || stored.Any(member => !unitIds.Contains(member.OrgUnitId)))
+            {
+                errors[UnitsField] = [UnitsFixedMessage];
+            }
+        }
+        else if (await waveUnits.ProblemsAsync(added, id, cancellationToken) is { Count: > 0 } problems)
+        {
+            errors[UnitsField] = [.. problems];
+        }
+
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        wave.StartsOn = request.StartsOn;
+        wave.EndsOn = [.. request.EndsOn];
+        context.Entry(wave).Property(entry => entry.Version).IsModified = true;
+        context.RemoveRange(stored.Where(member => !unitIds.Contains(member.OrgUnitId)));
+        context.AddRange(added.Select(unitId => new PromotionWaveUnit { WaveId = id, OrgUnitId = unitId }));
+        await context.SaveChangesAsync(cancellationToken);
+        await transaction.CommitAsync(cancellationToken);
+
+        response.SetETag(wave.Version);
+        return TypedResults.Ok((await reader.DescribeAsync([wave], cancellationToken))[0]);
+    }
+}
diff --git a/src/Competency.Promotion/WaveListQuery.cs b/src/Competency.Promotion/WaveListQuery.cs
