index 00000000..6c1f4085
--- /dev/null
+++ b/web/src/features/promotion/useEmployeeOptions.ts
@@ -0,0 +1,45 @@
+import { keepPreviousData, useQuery } from "@tanstack/react-query";
+import { useState } from "react";
+import { api } from "../../api/client";
+import { unwrap } from "../../api/unwrap";
+import { useDebouncedValue } from "../../app/useDebouncedValue";
+import { employeesQueryKey } from "../org-structure/orgStructureApi";
+import type { EmployeeOption } from "./CommissionView";
+
+const OPTIONS_PAGE_SIZE = 20;
+
+/** Working employees matching the typed text, as a screen offers them to add to a list; `purpose` keeps the cache of one screen apart. */
+export function useEmployeeOptions(purpose: string) {
+  const [search, setSearch] = useState("");
+  const text = useDebouncedValue(search.trim());
+  const found = useQuery({
+    queryKey: [...employeesQueryKey, purpose, text],
+    queryFn: async () =>
+      unwrap(
+        await api.GET("/api/v1/employees", {
+          params: {
+            query: {
+              q: text || undefined,
+              isActive: true,
+              pageSize: OPTIONS_PAGE_SIZE,
+            },
+          },
+        }),
+      ),
+    placeholderData: keepPreviousData,
+  });
+  const candidates: EmployeeOption[] = (found.data?.items ?? []).map(
+    (employee) => ({
+      id: employee.id,
+      name: employee.fullName,
+      detail: `${employee.orgUnitName}, ${employee.position}`,
+      unitName: employee.orgUnitName,
+      hasAccount: employee.hasAccount,
+    }),
+  );
+  return {
+    candidates,
+    isSearching: found.isFetching || search.trim() !== text,
+    onSearch: setSearch,
+  };
+}
diff --git a/web/src/features/promotion/useRaterOptions.ts b/web/src/features/promotion/useRaterOptions.ts
new file mode 100644
index 00000000..b59947fb
--- /dev/null
+++ b/web/src/features/promotion/useRaterOptions.ts
@@ -0,0 +1,23 @@
+import { useQuery } from "@tanstack/react-query";
+import { excludedRatersQuery } from "./promotionApi";
+import { useEmployeeOptions } from "./useEmployeeOptions";
+
+/** Employees matching the typed text as a screen offers them to add as raters, with the ones the administrator forbids marked; they are offered only once the check of the found people is done. */
+export function useRaterOptions(purpose: string) {
+  const options = useEmployeeOptions(purpose);
+  const forbidden = useQuery(
+    excludedRatersQuery(options.candidates.map((candidate) => candidate.id)),
+  );
+  const isChecking = forbidden.isPending && forbidden.fetchStatus !== "idle";
+  const forbiddenIds = new Set(forbidden.data);
+  return {
+    candidates: isChecking
+      ? []
+      : options.candidates.map((candidate) => ({
+          ...candidate,
+          isForbidden: forbiddenIds.has(candidate.id),
+        })),
+    isSearching: options.isSearching || isChecking,
+    onSearch: options.onSearch,
+  };
+}
