diff --git a/src/Competency.Promotion/WaveRollback.cs b/src/Competency.Promotion/WaveRollback.cs
new file mode 100644
index 00000000..5f3bd658
--- /dev/null
+++ b/src/Competency.Promotion/WaveRollback.cs
@@ -0,0 +1,90 @@
+using Competency.Platform;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.Promotion;
+
+/// <summary>
+/// Takes a wave back to a stage that has passed. Everything people entered stays; what a later stage settled is reset, and the wave is marked as
+/// not having carried out the end actions of the stage it returns to and the ones after it, so they run again when those stages end. A caller
+/// holds the promotion locks first. Scoped to a request, because it shares the request's database context.
+/// </summary>
+internal sealed class WaveRollback(AppDbContext context, PromotionLocks locks, PromotionCalendar calendar)
+{
+    /// <summary>
+    /// Finds what going back to a stage would reset or compute again.
+    /// </summary>
+    /// <param name="wave">The wave.</param>
+    /// <param name="stage">The stage to go back to.</param>
+    /// <param name="cancellationToken">Cancels the lookups.</param>
+    /// <returns>The consequences, with the number of applications each touches.</returns>
+    public async Task<RollbackPreviewResponse> PreviewAsync(PromotionWave wave, int stage, CancellationToken cancellationToken)
+    {
+        var standing = await context.Set<PromotionApplication>()
+            .AsNoTracking()
+            .Where(application => application.WaveId == wave.Id && application.Status != ApplicationStatus.Withdrawn && application.Status != ApplicationStatus.Draft)
+            .Select(application => new { application.Status, application.MeetsAfterRating, application.IsSentToReview })
+            .ToListAsync(cancellationToken);
+        var effects = new List<RollbackEffect>();
+        if (stage <= PromotionStage.FormalCheck)
+        {
+            effects.Add(new RollbackEffect(
+                RollbackEffectKind.FormalAdmittedReset,
+                standing.Count(application => application.Status is not (ApplicationStatus.Submitted or ApplicationStatus.FormalRejected))));
+            effects.Add(new RollbackEffect(RollbackEffectKind.FormalRejectedReset, standing.Count(application => application.Status == ApplicationStatus.FormalRejected)));
+        }
+
+        if (stage <= PromotionStage.Review)
+        {
+            effects.Add(new RollbackEffect(RollbackEffectKind.NoDecisionCleared, standing.Count(application => application.Status == ApplicationStatus.NoDecision)));
+        }
+
+        if (stage <= PromotionStage.Rating)
+        {
+            effects.Add(new RollbackEffect(RollbackEffectKind.RatingRecalculated, standing.Count(application => application.MeetsAfterRating is not null)));
+        }
+
+        if (stage <= PromotionStage.Artifacts)
+        {
+            effects.Add(new RollbackEffect(
+                RollbackEffectKind.ArtifactsRecalculated,
+                standing.Count(application => PromotionApplication.ReviewedStatuses.Contains(application.Status)
+                    && (stage < PromotionStage.Artifacts || (application.MeetsAfterRating != true && !application.IsSentToReview)))));
+        }
+
+        if (stage < PromotionStage.Feedback && calendar.StageOf(wave) >= PromotionStage.Feedback)
+        {
+            effects.Add(new RollbackEffect(
+                RollbackEffectKind.ResultsHidden,
+                standing.Count(application => application.Status is ApplicationStatus.Decided or ApplicationStatus.NoDecision)));
+        }
+
+        return new RollbackPreviewResponse(
+            stage,
+            [.. effects.Where(effect => effect.Count > 0)],
+            [.. WaveStep.StagesWithEndLetters.Where(letterStage => letterStage >= stage && letterStage <= wave.ProcessedStage)],
+            stage <= PromotionStage.Rating && wave.RaterReminderSent);
+    }
+
+    /// <summary>
+    /// Takes the wave and its applications back to a stage, changing tracked rows and saving nothing, so the caller commits them in its
+    /// transaction. The wave must be locked.
+    /// </summary>
+    /// <param name="wave">The locked wave.</param>
+    /// <param name="request">The stage and the new dates, already checked.</param>
+    /// <param name="cancellationToken">Cancels the lookups.</param>
+    public async Task ApplyAsync(PromotionWave wave, RollbackRequest request, CancellationToken cancellationToken)
+    {
+        var applications = await locks.FindWaveApplicationsForUpdateAsync(wave.Id, cancellationToken);
+        foreach (var application in applications)
+        {
+            application.ReturnToStage(request.Stage);
+        }
+
+        wave.EndsOn = [.. request.EndsOn];
+        wave.ProcessedStage = Math.Min(wave.ProcessedStage, request.Stage - 1);
+        if (request.Stage <= PromotionStage.Rating)
+        {
+            wave.RaterReminderSent = false;
+        }
+    }
+}
diff --git a/src/Competency.Promotion/WaveRollbackEndpoints.cs b/src/Competency.Promotion/WaveRollbackEndpoints.cs
new file mode 100644
index 00000000..c4df50a2
--- /dev/null
+++ b/src/Competency.Promotion/WaveRollbackEndpoints.cs
@@ -0,0 +1,122 @@
+using Competency.Platform;
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Http.HttpResults;
+using Microsoft.AspNetCore.Routing;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.Promotion;
+
+/// <summary>
+/// Going back to a stage of a wave that has passed. Those who change the dates of a wave, its author and global administrators, ask what the return
+/// would reset and then make it, with <c>If-Match</c>; a wave that is over cannot be taken back. A wave its reader may not see is reported as not found.
+/// </summary>
+internal static class WaveRollbackEndpoints
+{
+    private const string Route = "/api/v1/promotion/waves/{id:guid}/rollback";
+    private const string Tag = "Promotion";
+    private const string StageField = "stage";
+    private const string FinishedMessage = "Карьерная сессия завершена: её нельзя откатить";
+    private const string StageMessage = "Выберите этап, который уже прошёл";
+
+    public static void Map(IEndpointRouteBuilder endpoints)
+    {
+        var group = endpoints.MapGroup(Route)
+            .WithTags(Tag)
+            .RequireAuthorization(AuthorizationPolicies.GlobalAdminOrHr)
+            .ProducesProblem(StatusCodes.Status401Unauthorized)
+            .ProducesProblem(StatusCodes.Status403Forbidden)
+            .ProducesProblem(StatusCodes.Status404NotFound)
+            .ProducesProblem(StatusCodes.Status409Conflict);
+
+        group.MapGet(string.Empty, PreviewAsync).WithName("PreviewPromotionWaveRollback");
+        group.MapPost(string.Empty, RollbackAsync).WithName("RollbackPromotionWave").ProducesETag();
+    }
+
+    /// <summary>
+    /// Tells what going back to a stage would reset or compute again, so the user can confirm it.
+    /// </summary>
+    private static async Task<Results<Ok<RollbackPreviewResponse>, NotFound, ValidationProblem, ProblemHttpResult>> PreviewAsync(
+        Guid id,
+        int stage,
+        AppDbContext context,
+        WaveReader reader,
+        WaveRollback rollback,
+        PromotionCalendar calendar,
+        CancellationToken cancellationToken)
+    {
+        var wave = await context.Set<PromotionWave>().AsNoTracking().FirstOrDefaultAsync(candidate => candidate.Id == id, cancellationToken);
+        if (wave is null || !await reader.CanSeeAsync(wave, cancellationToken))
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (!reader.CanEdit(wave))
+        {
+            return Rejection.Forbidden();
+        }
+
+        var current = calendar.StageOf(wave);
+        if (wave.IsFinished || current == PromotionCalendar.AfterLastStage)
+        {
+            return Rejection.Conflict(FinishedMessage);
+        }
+
+        return stage < 1 || stage >= current
+            ? Rejection.Invalid(StageField, StageMessage)
+            : TypedResults.Ok(await rollback.PreviewAsync(wave, stage, cancellationToken));
+    }
+
+    /// <summary>
+    /// Takes an unfinished wave back to a stage that has passed: the stage becomes the current one today, with the new end dates of it and the
+    /// stages after it, and the end actions of those stages are carried out again when they end.
+    /// </summary>
+    private static async Task<Results<Ok<WaveResponse>, NotFound, ValidationProblem, ProblemHttpResult>> RollbackAsync(
+        Guid id,
+        RollbackRequest request,
+        IfMatch ifMatch,
+        AppDbContext context,
+        PromotionLocks locks,
+        PromotionCalendar calendar,
+        WaveReader reader,
+        WaveRollback rollback,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        await using var transaction = await locks.BeginSharedAsync(cancellationToken);
+        if (await locks.FindWaveForUpdateAsync(id, cancellationToken) is not { } wave || !await reader.CanSeeAsync(wave, cancellationToken))
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (!reader.CanEdit(wave))
+        {
+            return Rejection.Forbidden();
+        }
+
+        var current = calendar.StageOf(wave);
+        if (wave.IsFinished || current == PromotionCalendar.AfterLastStage)
+        {
+            return Rejection.Conflict(FinishedMessage);
+        }
+
+        if (request.Stage < 1 || request.Stage >= current)
+        {
+            return Rejection.Invalid(StageField, StageMessage);
+        }
+
+        ifMatch.ApplyTo(context, wave);
+        if (WaveDates.ValidateRollback(request, wave, calendar.Today) is { Count: > 0 } errors)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        await rollback.ApplyAsync(wave, request, cancellationToken);
+        context.Entry(wave).Property(entry => entry.Version).IsModified = true;
+        await context.SaveChangesAsync(cancellationToken);
+        await transaction.CommitAsync(cancellationToken);
+
+        response.SetETag(wave.Version);
+        return TypedResults.Ok((await reader.DescribeAsync([wave], cancellationToken))[0]);
+    }
+}
diff --git a/src/Competency.Promotion/WaveStep.cs b/src/Competency.Promotion/WaveStep.cs
new file mode 100644
index 00000000..56f4c271
--- /dev/null
+++ b/src/Competency.Promotion/WaveStep.cs
@@ -0,0 +1,154 @@
+using Competency.Platform;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging;
+
+namespace Competency.Promotion;
+
+/// <summary>
+/// How an attempt to carry out the next step of a wave ended.
+/// </summary>
+internal enum StepResult
+{
+    /// <summary>
+    /// Nothing was due, or another transaction was changing the wave.
+    /// </summary>
+    Idle,
+
+    /// <summary>
+    /// A step was carried out and committed.
+    /// </summary>
+    Done,
+
+    /// <summary>
+    /// A step is due but must wait for a precondition; nothing was changed.
+    /// </summary>
+    Held,
+}
+
+/// <summary>
+/// Carries out one step of a wave in one transaction: the changes and the stage marker commit together, and the letters are composed after the commit.
+/// Scoped to a request, because it shares the request's database context.
+/// </summary>
+internal sealed class WaveStep(
+    AppDbContext context,
+    PromotionLocks locks,
+    PromotionCalendar calendar,
+    StageActions actions,
+    PromotionMail mail,
+    ILogger<WaveStep> logger)
+{
+    /// <summary>
+    /// The stages whose end sends letters.
+    /// </summary>
+    public static readonly IReadOnlyList<int> StagesWithEndLetters = [1, 2, 3, 4, 5, 6];
+
+    /// <summary>
+    /// Carries out the next step a wave is owed. Applications reach a commission only if it has a chair who acts: the end of the rating stage, which
+    /// finds who meets the requirements, and the end of the artifact stage wait for one, and the wave is tried again on the next call.
+    /// </summary>
+    /// <param name="waveId">The wave.</param>
+    /// <param name="cancellationToken">Cancels the step.</param>
+    /// <returns>Whether a step was carried out, and if not, why.</returns>
+    public async Task<StepResult> RunAsync(Guid waveId, CancellationToken cancellationToken)
+    {
+        PromotionWave wave;
+        DueStep due;
+        IReadOnlyDictionary<Guid, int> arrivals;
+        await using (var transaction = await locks.BeginSharedAsync(cancellationToken))
+        {
+            if (await locks.FindWaveForUpdateSkippingLockedAsync(waveId, cancellationToken) is not { } locked
+                || DueStep.Next(locked, calendar, await HasArrivalsAsync(waveId, cancellationToken)) is not { } next)
+            {
+                return StepResult.Idle;
+            }
+
+            if (next is { Kind: DueKind.EndStage, Stage: PromotionStage.Rating or PromotionStage.Artifacts }
+                && await actions.UnitsWithoutChairAsync(locked, cancellationToken) is { Count: > 0 } chairless)
+            {
+                logger.LogWarning("Applications of wave {WaveId} wait for a chair in: {Units}", waveId, string.Join(", ", chairless));
+                return StepResult.Held;
+            }
+
+            await ApplyAsync(locked, next, cancellationToken);
+            arrivals = next.Kind == DueKind.NotifyCommissions || next is { Kind: DueKind.EndStage, Stage: PromotionStage.Rating or PromotionStage.Artifacts }
+                ? await actions.TakeArrivalsAsync(waveId, cancellationToken)
+                : new Dictionary<Guid, int>();
+            await context.SaveChangesAsync(cancellationToken);
+            await transaction.CommitAsync(cancellationToken);
+            wave = locked;
+            due = next;
+        }
+
+        await TellAsync(wave, due, arrivals, cancellationToken);
+        return StepResult.Done;
+    }
+
+    private Task<bool> HasArrivalsAsync(Guid waveId, CancellationToken cancellationToken) =>
+        context.Set<PromotionApplication>().AnyAsync(application => application.WaveId == waveId && application.ReviewLetterPending, cancellationToken);
+
+    private async Task ApplyAsync(PromotionWave wave, DueStep due, CancellationToken cancellationToken)
+    {
+        switch (due.Kind)
+        {
+            case DueKind.StartFirstStage:
+                await actions.FixVersionsAsync(wave, cancellationToken);
+                wave.VersionsFixed = true;
+                break;
+            case DueKind.RemindRaters:
+                wave.RaterReminderSent = true;
+                break;
+            case DueKind.EndStage:
+                await EndAsync(wave, due.Stage, cancellationToken);
+                wave.ProcessedStage = due.Stage;
+                break;
+        }
+    }
+
+    private async Task EndAsync(PromotionWave wave, int stage, CancellationToken cancellationToken)
+    {
+        switch (stage)
+        {
+            case PromotionStage.FormalCheck:
+                await actions.CheckFormalAsync(wave, cancellationToken);
+                break;
+            case PromotionStage.Rating:
+                await actions.CheckRatingAsync(wave, cancellationToken);
+                await actions.ReachCommissionAsync(wave, isDeadline: false, cancellationToken);
+                break;
+            case PromotionStage.Artifacts:
+                await actions.ReachCommissionAsync(wave, isDeadline: true, cancellationToken);
+                break;
+            case PromotionStage.Review:
+                await actions.CloseReviewAsync(wave, cancellationToken);
+                break;
+        }
+    }
+
+    /// <summary>
+    /// Queues the letters of a committed step. A failure to compose them is logged and does not stop the wave from catching up.
+    /// </summary>
+    private async Task TellAsync(PromotionWave wave, DueStep due, IReadOnlyDictionary<Guid, int> arrivals, CancellationToken cancellationToken)
+    {
+        try
+        {
+            await LettersOf(wave, due, arrivals, cancellationToken);
+        }
+        catch (Exception exception) when (!cancellationToken.IsCancellationRequested)
+        {
+            logger.LogError(exception, "The letters of step {Kind} of stage {Stage} of wave {WaveId} were not queued.", due.Kind, due.Stage, wave.Id);
+        }
+    }
+
+    private Task LettersOf(PromotionWave wave, DueStep due, IReadOnlyDictionary<Guid, int> arrivals, CancellationToken cancellationToken) => (due.Kind, due.Stage) switch
+    {
+        (DueKind.StartFirstStage, _) => mail.ApplicationsOpenedAsync(wave, cancellationToken),
+        (DueKind.RemindRaters, _) => mail.RatingReminderAsync(wave, cancellationToken),
+        (DueKind.NotifyCommissions, _) => mail.ReviewArrivedAsync(wave, arrivals, cancellationToken),
+        (_, PromotionStage.Submission) => mail.FormalCheckStartedAsync(wave, cancellationToken),
+        (_, PromotionStage.FormalCheck) => mail.FormalCheckFinishedAsync(wave, cancellationToken),
+        (_, PromotionStage.Rating or PromotionStage.Artifacts) => mail.ReviewArrivedAsync(wave, arrivals, cancellationToken),
+        (_, PromotionStage.Review) => mail.ResultsPublishedAsync(wave, cancellationToken),
+        (_, PromotionStage.Feedback) => mail.FeedbackFinishedAsync(wave, cancellationToken),
+        _ => Task.CompletedTask,
+    };
+}
