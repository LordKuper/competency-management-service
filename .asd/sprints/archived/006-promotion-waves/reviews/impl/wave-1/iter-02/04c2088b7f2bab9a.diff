+import { act, renderHook } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { useUnitTreeSearch } from "./useUnitTreeSearch";
+
+interface Node {
+  value: string;
+  title: string;
+  disabled?: boolean;
+  children: Node[];
+}
+
+const node = (
+  value: string,
+  title: string,
+  children: Node[] = [],
+  disabled = false,
+): Node => ({ value, title, disabled, children });
+
+const TREE = [
+  node("company", "Компания", [
+    node("sales", "Продажи", [
+      node("retail", "Розница"),
+      node("wholesale", "Опт", [], true),
+    ]),
+    node("support", "Поддержка"),
+  ]),
+];
+
+function search(text: string) {
+  const hook = renderHook(() => useUnitTreeSearch(TREE));
+  act(() => hook.result.current.showSearch.onSearch(text));
+  return hook.result.current;
+}
+
+const valuesOf = (nodes: Node[]): string[] =>
+  nodes.flatMap((item) => [item.value, ...valuesOf(item.children)]);
+
+describe("search of a unit tree select", () => {
+  it("leaves the tree and its expansion to the select while nothing is typed", () => {
+    const { result } = renderHook(() => useUnitTreeSearch(TREE));
+
+    expect(result.current.treeData).toBe(TREE);
+    expect(result.current.treeExpandedKeys).toBeUndefined();
+    expect(result.current.showSearch.searchValue).toBe("");
+  });
+
+  it("keeps a match with the units above it, and opens that path, whatever the case of the text", () => {
+    const found = search("РОЗН");
+
+    expect(valuesOf(found.treeData)).toEqual(["company", "sales", "retail"]);
+    expect(found.treeExpandedKeys).toEqual(["company", "sales", "retail"]);
+    expect(found.showSearch.searchValue).toBe("РОЗН");
+  });
+
+  it("keeps everything below a unit whose title matches, a unit that cannot be chosen included", () => {
+    const found = search("прод");
+
+    expect(valuesOf(found.treeData)).toEqual([
+      "company",
+      "sales",
+      "retail",
+      "wholesale",
+    ]);
+    expect(found.treeData[0]?.children[0]?.children[1]?.disabled).toBe(true);
+  });
+
+  it("offers nothing when no title matches", () => {
+    expect(search("нет такого").treeData).toEqual([]);
+  });
+
+  it("gives the tree back when the text is cleared", () => {
+    const hook = renderHook(() => useUnitTreeSearch(TREE));
+    act(() => hook.result.current.showSearch.onSearch("розн"));
+
+    act(() => hook.result.current.showSearch.onSearch(""));
+
+    expect(hook.result.current.treeData).toBe(TREE);
+    expect(hook.result.current.treeExpandedKeys).toBeUndefined();
+  });
+});
diff --git a/web/src/features/org-structure/useUnitTreeSearch.ts b/web/src/features/org-structure/useUnitTreeSearch.ts
new file mode 100644
index 00000000..2d14ef38
--- /dev/null
+++ b/web/src/features/org-structure/useUnitTreeSearch.ts
@@ -0,0 +1,70 @@
+import { theme } from "antd";
+import { useDeferredValue, useMemo, useState } from "react";
+
+/** Popup width, in control heights; the global popup max-width still caps it. */
+const POPUP_WIDTH_IN_CONTROLS = 20;
+
+interface SearchableNode<TNode> {
+  value: string;
+  title: string;
+  children: TNode[];
+}
+
+/** The nodes whose title contains the needle (lower-cased) with everything below them, and the nodes above such a match. */
+function keep<TNode extends SearchableNode<TNode>>(
+  nodes: readonly TNode[],
+  needle: string,
+): TNode[] {
+  const kept: TNode[] = [];
+  for (const node of nodes) {
+    if (node.title.toLowerCase().includes(needle)) {
+      kept.push(node);
+      continue;
+    }
+    const children = keep(node.children, needle);
+    if (children.length > 0) kept.push({ ...node, children });
+  }
+  return kept;
+}
+
+function keysOf<TNode extends SearchableNode<TNode>>(
+  nodes: readonly TNode[],
+  keys: string[] = [],
+): string[] {
+  for (const node of nodes) {
+    keys.push(node.value);
+    keysOf(node.children, keys);
+  }
+  return keys;
+}
+
+/**
+ * Props that make a unit TreeSelect filter its own tree. rc-tree-select would filter and re-expand the whole tree
+ * synchronously on every keystroke; here the typed text shows at once and the tree follows from a deferred render.
+ * The popup gets a fixed width, because the app-wide `popupMatchSelectWidth={false}` would make the list non-virtual.
+ */
+export function useUnitTreeSearch<TNode extends SearchableNode<TNode>>(
+  treeData: TNode[],
+) {
+  const { token } = theme.useToken();
+  const [text, setText] = useState("");
+  const needle = useDeferredValue(text.toLowerCase());
+  const { shown, expandedKeys } = useMemo(() => {
+    if (!needle) return { shown: treeData, expandedKeys: [] };
+    const found = keep(treeData, needle);
+    return { shown: found, expandedKeys: keysOf(found) };
+  }, [treeData, needle]);
+  return {
+    treeData: shown,
+    popupMatchSelectWidth: token.controlHeight * POPUP_WIDTH_IN_CONTROLS,
+    showSearch: {
+      searchValue: text,
+      onSearch: setText,
+      filterTreeNode: false,
+      // Still names what the tree lights up as a match.
+      treeNodeFilterProp: "title",
+    },
+    // While searching every unit of the found tree is open; otherwise the select keeps its own expansion.
+    treeExpandedKeys: text ? expandedKeys : undefined,
+  };
+}
