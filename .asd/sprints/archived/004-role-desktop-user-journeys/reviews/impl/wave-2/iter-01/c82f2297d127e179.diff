+    fakeApi.on("GET /api/v1/desk/items", (request) => {
+      const limit = Number(new URL(request.url).searchParams.get("limit"));
+      return Response.json({
+        items: manyItems("UnitsToConnect", Math.min(limit, 25)),
+        total: 25,
+      });
