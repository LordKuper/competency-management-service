@@ -0,0 +1,84 @@
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { App, Button, Flex, Form } from "antd";
+import { api } from "../../api/client";
+import { ifMatchOf } from "../../api/ifMatch";
+import { unwrap } from "../../api/unwrap";
+import { useFormSubmit } from "../../app/useFormSubmit";
+import {
+  type Employee,
+  invalidateOrgStructure,
+} from "../org-structure/orgStructureApi";
+import { PositionSelect } from "../org-structure/PositionSelect";
+import { DecisionError } from "./DecisionError";
+import { ORG_FINDING_MUTATION, useIsFindingBusy } from "./findingBusy";
+
+interface ChangePositionFormProps {
+  /** The employee as the server last returned them, with the version the change is based on. */
+  employee: Employee;
+  /** Lays the field and the button in one row, for a table cell. */
+  isInline?: boolean;
+}
+
+/** The choice of a new position from the employee's unit and the button that saves it; the other fields stay as they are. */
+export function ChangePositionForm({
+  employee,
+  isInline = false,
+}: ChangePositionFormProps) {
+  const queryClient = useQueryClient();
+  const { message } = App.useApp();
+  const isBusy = useIsFindingBusy();
+  const [form] = Form.useForm<{ positionId?: string }>();
+  const change = useMutation({
+    mutationKey: ORG_FINDING_MUTATION,
+    mutationFn: async (positionId: string) =>
+      unwrap(
+        await api.PUT("/api/v1/employees/{id}", {
+          params: {
+            path: { id: employee.id },
+            header: { "If-Match": ifMatchOf(employee.version ?? 0) },
+          },
+          body: {
+            lastName: employee.lastName,
+            firstName: employee.firstName,
+            middleName: employee.middleName,
+            orgUnitId: employee.orgUnitId,
+            positionId,
+          },
+        }),
+      ),
+    onSuccess: () =>
+      message.success(`Должность сотрудника ${employee.fullName} изменена`),
+    onSettled: () => invalidateOrgStructure(queryClient),
+  });
+  const { submit } = useFormSubmit(form, async (values) => {
+    if (values.positionId) await change.mutateAsync(values.positionId);
+  });
+
+  return (
+    <Flex vertical gap="small">
+      {change.isError && (
+        <DecisionError title="Должность не изменена" error={change.error} />
+      )}
+      <Form
+        key={employee.version}
+        form={form}
+        name={`employee-position-${employee.id}`}
+        layout={isInline ? "inline" : "vertical"}
+        disabled={isBusy}
+        onFinish={submit}
+      >
+        <Form.Item
+          name="positionId"
+          label={isInline ? undefined : "Новая должность"}
+          rules={[{ required: true, message: "Выберите должность" }]}
+          style={isInline ? { minWidth: 220 } : undefined}
+        >
+          <PositionSelect orgUnitId={employee.orgUnitId} />
+        </Form.Item>
+        <Button htmlType="submit" loading={change.isPending}>
+          Сменить должность
+        </Button>
+      </Form>
+    </Flex>
+  );
+}
diff --git a/web/src/features/desk/ChangesBlock.tsx b/web/src/features/desk/ChangesBlock.tsx
new file mode 100644
index 0000000..51085f2
--- /dev/null
+++ b/web/src/features/desk/ChangesBlock.tsx
@@ -0,0 +1,94 @@
+import { Empty, Table, type TableColumnsType, Tag } from "antd";
+import { CHANGE_TYPES, describeChanges } from "../career/MatrixChanges";
+import type { MatrixChange, MatrixDiff } from "../career/matrixApi";
+import "./scenario.css";
+
+const NO_VALUE = "—";
+
+const TAG_COLORS: Record<MatrixChange["type"], string> = {
+  Added: "success",
+  Removed: "error",
+  Changed: "warning",
+};
+
+interface ChangesBlockProps {
+  diff: MatrixDiff;
+  levelNames: ReadonlyMap<string, string>;
+  competencyNames: ReadonlyMap<string, string>;
+  blockNames: ReadonlyMap<string, string>;
+  pointsOf: (
+    competencyId: string,
+  ) => readonly { score: number; label: string }[];
+  /** Heads of the columns with the values before and after. */
+  columns: { before: string; after: string };
+  /** What the table says when nothing changed. */
+  emptyText: string;
+}
+
+interface Row {
+  key: string;
+  change: MatrixChange;
+  place: string;
+  before: string | undefined;
+  after: string | undefined;
+}
+
+/** The changes of a diff as a table: each row names its kind in words and is tinted, so colour is never the only sign. */
+export function ChangesBlock({
+  diff,
+  levelNames,
+  competencyNames,
+  blockNames,
+  pointsOf,
+  columns: heads,
+  emptyText,
+}: ChangesBlockProps) {
+  const describe = describeChanges(
+    diff,
+    levelNames,
+    competencyNames,
+    blockNames,
+    pointsOf,
+  );
+  const rows: Row[] = diff.changes.map((change) => ({
+    key: `${change.kind}:${change.levelId}:${change.blockId}:${change.competencyId}`,
+    change,
+    ...describe(change),
+  }));
+  const columns: TableColumnsType<Row> = [
+    {
+      title: "Что",
+      key: "type",
+      render: (_, { change }) => (
+        <Tag color={TAG_COLORS[change.type]}>{CHANGE_TYPES[change.type]}</Tag>
+      ),
+    },
+    { title: "Где", dataIndex: "place" },
+    {
+      title: heads.before,
+      dataIndex: "before",
+      render: (value?: string) => value ?? NO_VALUE,
+    },
+    {
+      title: heads.after,
+      dataIndex: "after",
+      render: (value?: string) => value ?? NO_VALUE,
+    },
+  ];
+  return (
+    <Table<Row>
+      size="small"
+      rowKey="key"
+      columns={columns}
+      dataSource={rows}
+      pagination={false}
+      className="desk-table"
+      rowClassName={({ change }) => `change-row-${change.type.toLowerCase()}`}
+      locale={{
+        emptyText: (
+          <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={emptyText} />
+        ),
+      }}
+    />
+  );
+}
diff --git a/web/src/features/desk/CompletenessBlock.tsx b/web/src/features/desk/CompletenessBlock.tsx
new file mode 100644
index 0000000..0937490
--- /dev/null
+++ b/web/src/features/desk/CompletenessBlock.tsx
@@ -0,0 +1,169 @@
+import { CheckCircleOutlined, WarningOutlined } from "@ant-design/icons";
+import { useQuery } from "@tanstack/react-query";
+import {
+  Alert,
+  Button,
+  Flex,
+  Skeleton,
+  Table,
+  type TableColumnsType,
+  Tag,
+} from "antd";
+import { Link, useLocation } from "react-router";
+import { effectiveHr, unitHrQuery } from "../career/careerApi";
+import { trackQuery } from "../career/catalogApi";
+import type { MatrixProblem } from "../career/matrixApi";
+import { deskPaths } from "./deskTexts";
+import { type ReturnLink, returnState } from "./returnLink";
+import { CompactAlert } from "./ScenarioContext";
+import { PROBLEM_STEP, stepText } from "./scenarioTexts";
+
+interface PositionGapActionProps {
+  trackId: string;
+  /** Name of the scenario the linking screen is reached from. */
+  originName: string;
+  /** Why linking is not possible now; the link is replaced by this text. */
+  unavailable?: string;
+}
+
+/** What can be done about a level without an active position: the link to put it right, or who can. */
+export function PositionGapAction({
+  trackId,
+  originName,
+  unavailable,
+}: PositionGapActionProps) {
+  const location = useLocation();
+  const track = useQuery(trackQuery(trackId));
+  const ownerUnitId = track.data?.ownerOrgUnitId;
+  const unitHr = useQuery({
+    ...unitHrQuery(ownerUnitId ?? ""),
+    enabled: ownerUnitId !== undefined,
+  });
+  const hr = unitHr.data && effectiveHr(unitHr.data);
+  const back: ReturnLink = {
+    to: location.pathname + location.search,
+    crumb: originName,
+  };
+  if (track.data?.canEdit !== true) {
+    return hr ? `Обратитесь к ответственному HR: ${hr.name}` : null;
+  }
+  return unavailable ? (
+    unavailable
+  ) : (
+    <Link to={deskPaths.trackPositionsOf(trackId)} state={returnState(back)}>
+      Связать должности с треком
+    </Link>
+  );
+}
+
+/** The word that a level has no active position, as a tag. */
+export function NoPositionTag() {
+  return (
+    <Tag icon={<WarningOutlined />} color="warning">
+      Нет действующей должности
+    </Tag>
+  );
+}
+
+const sentence = (text: string) => (text.endsWith(".") ? text : `${text}.`);
+
+interface CompletenessBlockProps {
+  /** Null while the check is read. */
+  problems: readonly MatrixProblem[] | null;
+  trackId: string;
+  /** Title of the warning over the problems, given their number. */
+  warning: (count: number) => string;
+  /** Name of the scenario the user links positions from. */
+  originName: string;
+  /** Takes the user to the wizard step where a problem is put right; without it the step is only named. */
+  onStep?: (step: number) => void;
+  /** One short explanation after the warning, such as what the check was made on. */
+  note?: string;
+}
+
+/**
+ * The check of a version: one line when it passes, a warning with the single problem inside it, or a warning over
+ * a table of problems with where to put each right.
+ */
+export function CompletenessBlock({
+  problems,
+  trackId,
+  warning,
+  originName,
+  onStep,
+  note,
+}: CompletenessBlockProps) {
+  if (!problems) return <Skeleton active />;
+  if (problems.length === 0) {
+    return (
+      <CompactAlert
+        type="success"
+        icon={<CheckCircleOutlined />}
+        lead="Проверка полноты:"
+        text="версия полна, замечаний нет."
+      />
+    );
+  }
+  const what = (problem: MatrixProblem) =>
+    problem.code === "LevelWithoutActivePosition" ? (
+      <>
+        <NoPositionTag /> {problem.message}
+        {" — "}
+        <PositionGapAction trackId={trackId} originName={originName} />
+      </>
+    ) : (
+      problem.message
+    );
+  const where = (problem: MatrixProblem) => {
+    const step = PROBLEM_STEP[problem.code];
+    if (step === null) return null;
+    return onStep ? (
+      <Button type="link" onClick={() => onStep(step)}>
+        {stepText(step)}
+      </Button>
+    ) : (
+      stepText(step)
+    );
+  };
+  const [only] = problems;
+  if (problems.length === 1 && only) {
+    return (
+      <Alert
+        type="warning"
+        showIcon
+        title={
+          <>
+            <strong>{sentence(warning(1))}</strong>
+            {note && ` ${note}`}
+            <div>
+              {what(only)} {where(only)}
+            </div>
+          </>
+        }
+      />
+    );
+  }
+  const columns: TableColumnsType<MatrixProblem> = [
+    { title: "Что исправить", key: "message", render: (_, p) => what(p) },
+    { title: "Где", key: "where", render: (_, p) => where(p) },
+  ];
+  return (
+    <Flex vertical gap="middle">
+      <CompactAlert
+        type="warning"
+        lead={sentence(warning(problems.length))}
+        text={note}
+      />
+      <Table<MatrixProblem>
+        size="small"
+        rowKey={(problem) =>
+          `${problem.code}:${problem.levelId}:${problem.competencyId}:${problem.message}`
+        }
+        columns={columns}
+        dataSource={[...problems]}
+        pagination={false}
+        className="desk-table"
+      />
+    </Flex>
+  );
+}
diff --git a/web/src/features/desk/ConnectUnitPage.tsx b/web/src/features/desk/ConnectUnitPage.tsx
new file mode 100644
index 0000000..cf146fd
--- /dev/null
+++ b/web/src/features/desk/ConnectUnitPage.tsx
@@ -0,0 +1,347 @@
+import { type UseQueryResult, useQuery } from "@tanstack/react-query";
+import { Button, Card, Flex, Skeleton, Tag, Typography } from "antd";
+import { type ReactNode, useState } from "react";
+import { useNavigate, useParams } from "react-router";
+import { OrgUnitSelect } from "../org-structure/OrgUnitSelect";
+import { UnitHrModal } from "../org-structure/UnitHrModal";
+import { UnitPositionsModal } from "../org-structure/UnitPositionsModal";
+import { useBlockUser } from "../users/useBlockUser";
+import { AccountModal } from "./AccountModal";
+import { AssignHeadModal } from "./AssignHeadModal";
+import { type UnitSetup, unitSetupQuery } from "./deskApi";
+import { deskPaths } from "./deskTexts";
+import { LinkButton } from "./LinkButton";
+import { CompactAlert, ContextLine } from "./ScenarioContext";
+import { LoadFailure, ScenarioPage } from "./ScenarioPage";
+import {
+  type InvitationResend,
+  useResendInvitation,
+} from "./useResendInvitation";
+
+type Row = UnitSetup["rows"][number];
+type Account = NonNullable<UnitSetup["headAccount"]>;
+type Dialog = "head" | "account" | "hr" | "positions" | null;
+
+interface RowContent {
+  value: ReactNode;
+  note?: string;
+  action?: ReactNode;
+}
+
+const ROW_TITLES: Record<Row["row"], string> = {
+  Head: "Руководитель",
+  HeadAccount: "Учётная запись руководителя",
+  Hr: "Ответственный HR",
+  HrAccount: "Учётная запись HR",
+  Positions: "Перечень должностей",
+};
+
+const WAITING_TAGS: Partial<Record<Row["row"], string>> = {
+  HeadAccount: "Ждёт руководителя",
+  HrAccount: "Ждёт HR",
+};
+
+const WAITING_TEXTS: Partial<Record<Row["row"], string>> = {
+  HeadAccount: "Появится после назначения руководителя.",
+  HrAccount: "Появится после закрепления HR.",
+};
+
+const MISSING_TEXTS: Record<Row["row"], string> = {
+  Head: "руководителя",
+  HeadAccount: "учётной записи руководителя",
+  Hr: "ответственного HR",
+  HrAccount: "учётной записи HR",
+  Positions: "перечня должностей",
+};
+
+/** «Нет руководителя, ответственного HR и перечня должностей.» for the rows that lack something. */
+function missingText(rows: readonly Row[]): string {
+  const names = rows
+    .filter((row) => row.status === "Missing")
+    .map((row) => MISSING_TEXTS[row.row]);
+  const last = names.pop();
+  return `Нет ${names.length > 0 ? `${names.join(", ")} и ` : ""}${last}.`;
+}
+
+const NO_CANDIDATES_NOTE =
+  "некого закрепить: нужен работающий сотрудник с действующей учётной записью и ролью «HR». Выдайте роль в разделе «Пользователи», проверив привязку записи к сотруднику; пробел закроется после этого.";
+
+const HR_INACTIVE_CAUSES: Record<Account["state"], string> = {
+  None: "у него нет учётной записи",
+  Invited: "его учётная запись не приняла приглашение",
+  Blocked: "его учётная запись заблокирована",
+  NoHrRole: "у его учётной записи нет роли «HR»",
+  Active: "его учётная запись не может действовать",
+};
+
+const ACCOUNT_STATES: Record<Account["state"], string> = {
+  None: "нет учётной записи",
+  Invited: "Приглашена: пароль не задан, вход невозможен",
+  Blocked: "Заблокирована: вход невозможен",
+  NoHrRole: "Нет роли «HR»: закрепление не действует",
+  Active: "Действует",
+};
+
+/** «Подключить подразделение»: what the unit lacks to work, row by row, and the action that closes each gap on the spot. */
+export function ConnectUnitPage() {
+  const { unitId } = useParams();
+  const navigate = useNavigate();
+  const resend = useResendInvitation();
+  const setup = useQuery({
+    ...unitSetupQuery(unitId ?? ""),
+    enabled: unitId !== undefined,
+  });
+  return (
+    <ScenarioPage title="Подключить подразделение">
+      <ContextLine>
+        <Typography.Text strong id="connect-unit-label">
+          Подразделение
+        </Typography.Text>
+        <div className="context-select">
+          <OrgUnitSelect
+            value={unitId}
+            placeholder="Выберите подразделение"
+            disabled={resend.sendingAccountId !== null}
+            onChange={(id) => id && void navigate(deskPaths.connectUnitOf(id))}
+          />
+        </div>
+        {setup.data && (
+          <Typography.Text type="secondary">
+            {setup.data.unit.map((part) => part.name).join(" → ")}
+          </Typography.Text>
+        )}
+      </ContextLine>
+      {unitId ? (
+        <SetupScreen
+          key={unitId}
+          unitId={unitId}
+          setup={setup}
+          resend={resend}
+        />
+      ) : (
+        <Typography.Text type="secondary">
+          Выберите подразделение, чтобы увидеть, чего ему не хватает.
+        </Typography.Text>
+      )}
+    </ScenarioPage>
+  );
+}
+
+interface SetupScreenProps {
+  unitId: string;
+  setup: UseQueryResult<UnitSetup>;
+  resend: InvitationResend;
+}
+
+function SetupScreen({ unitId, setup, resend }: SetupScreenProps) {
+  if (setup.error) {
+    return (
+      <LoadFailure
+        title="Не удалось загрузить подразделение"
+        error={setup.error}
+        onRetry={() => void setup.refetch()}
+      />
+    );
+  }
+  if (!setup.data) return <Skeleton active />;
+  return <SetupRows unitId={unitId} data={setup.data} resend={resend} />;
+}
+
+interface SetupRowsProps {
+  unitId: string;
+  data: UnitSetup;
+  resend: InvitationResend;
+}
+
+function SetupRows({ unitId, data, resend }: SetupRowsProps) {
+  const [dialog, setDialog] = useState<Dialog>(null);
+  const confirmBlock = useBlockUser();
+  const unit = { id: unitId, name: data.unit.at(-1)?.name ?? "" };
+  const gaps = data.rows.filter((row) => row.status === "Missing").length;
+  const close = () => setDialog(null);
+  const open = (target: Dialog, label: string) => (
+    <Button onClick={() => setDialog(target)}>{label}</Button>
+  );
+
+  function accountAction(account: Account | null): ReactNode {
+    if (!account) return null;
+    if (account.state === "None" && data.head) {
+      return open("account", "Создать и отправить приглашение");
+    }
+    if (account.id === null || account.version === null) return null;
+    const { id, email, version } = account;
+    if (account.state === "Invited") {
+      return (
+        <Button
+          disabled={resend.sendingAccountId !== null}
+          loading={resend.sendingAccountId === id}
+          onClick={() => resend.send({ accountId: id, version })}
+        >
+          Отправить приглашение повторно
+        </Button>
+      );
+    }
+    if (account.state === "Blocked") {
+      return (
+        <Button
+          onClick={() =>
+            confirmBlock({ id, email: email ?? "", version, isBlocked: true })
+          }
+        >
+          Разблокировать
+        </Button>
+      );
+    }
+    if (account.state === "NoHrRole") {
+      return <LinkButton to={deskPaths.users}>Пользователи</LinkButton>;
+    }
+    return null;
+  }
+
+  function describeHr(row: Row): RowContent {
+    const { hr } = data;
+    if (!hr) {
+      if (row.reason === "NoHrCandidates") {
+        return {
+          value: "Не назначен",
+          note: NO_CANDIDATES_NOTE,
+          action: <LinkButton to={deskPaths.users}>Пользователи</LinkButton>,
+        };
+      }
+      return {
+        value: "Не назначен: ни своего, ни унаследованного закрепления",
+        action: open("hr", "Закрепить HR"),
+      };
+    }
+    const value =
+      hr.orgUnitId === unitId
+        ? hr.name
+        : `${hr.name} (унаследован из «${hr.orgUnitName}»)`;
+    if (row.status === "Ready") return { value };
+    const why = HR_INACTIVE_CAUSES[hr.account?.state ?? "None"];
+    return {
+      value: `Закреплён: ${value}, но ${why} и действовать не может, поэтому ответственного HR нет`,
+      action: open("hr", "Закрепить другого HR"),
+    };
+  }
+
+  function describePositions(row: Row): RowContent {
+    const { own, inherited } = data.positions;
+    if (row.status === "Ready") {
+      return {
+        value: `Своих: ${own.length} (${own.map((position) => position.name).join(", ") || "—"}) · унаследованных: ${inherited.length}`,
+        action: open("positions", "Изменить перечень"),
+      };
+    }
+    return {
+      value: `Пуст: ни своих, ни унаследованных должностей, а сотрудников ${data.employees}`,
+      note:
+        data.employees === 0
+          ? "В подразделении нет сотрудников, поэтому на рабочем столе этого пункта нет."
+          : undefined,
+      action: open("positions", "Добавить должность"),
+    };
+  }
+
+  function describe(row: Row): RowContent {
+    switch (row.row) {
+      case "Head":
+        return data.head
+          ? { value: data.head.fullName }
+          : {
+              value: "Не назначен",
+              note: `Руководителем может быть только работающий сотрудник этого подразделения. Сотрудников: ${data.employees}.`,
+              action: open("head", "Назначить руководителя"),
+            };
+      case "HeadAccount":
+      case "HrAccount": {
+        const account =
+          row.row === "HeadAccount" ? data.headAccount : data.hr?.account;
+        return {
+          value: account?.email
+            ? `${account.email} — ${ACCOUNT_STATES[account.state]}`
+            : "Нет учётной записи",
+          action: accountAction(account ?? null),
+        };
+      }
+      case "Hr":
+        return describeHr(row);
+      case "Positions":
+        return describePositions(row);
+    }
+  }
+
+  return (
+    <Flex vertical gap="middle">
+      {gaps === 0 ? (
+        <CompactAlert
+          type="success"
+          lead="Подразделение подключено."
+          text="Пробелов нет: руководитель, ответственный HR, должности и действующие учётные записи на месте."
+        />
+      ) : (
+        <CompactAlert
+          type="warning"
+          lead={`Не хватает: ${gaps} из ${data.rows.length}.`}
+          text={missingText(data.rows)}
+        />
+      )}
+      <Card size="small">
+        <Flex vertical>
+          {data.rows.map((row, index) => {
+            const { value, note, action } = describe(row);
+            const isWaiting = row.status === "Waiting";
+            return (
+              <Flex
+                key={row.row}
+                vertical
+                gap="small"
+                style={{
+                  paddingBlock: "var(--ant-padding-xs)",
+                  borderTop:
+                    index === 0
+                      ? undefined
+                      : "var(--ant-line-width) var(--ant-line-type) var(--ant-color-border-secondary)",
+                }}
+              >
+                <Flex justify="space-between" align="center" gap="small" wrap>
+                  <Flex align="center" gap="small" wrap>
+                    <Typography.Text strong>
+                      {ROW_TITLES[row.row]}
+                    </Typography.Text>
+                    <StatusTag row={row} />
+                  </Flex>
+                  {!isWaiting && action}
+                </Flex>
+                <Typography.Text>
+                  {isWaiting
+                    ? WAITING_TEXTS[row.row]
+                    : [value, note].filter(Boolean).join(" · ")}
+                </Typography.Text>
+              </Flex>
+            );
+          })}
+        </Flex>
+      </Card>
+      {dialog === "head" && <AssignHeadModal unitId={unitId} onClose={close} />}
+      {dialog === "hr" && <UnitHrModal unit={unit} onClose={close} />}
+      {dialog === "positions" && (
+        <UnitPositionsModal unit={unit} onClose={close} />
+      )}
+      {dialog === "account" && data.head && (
+        <AccountModal head={data.head} onClose={close} />
+      )}
+    </Flex>
+  );
+}
+
+function StatusTag({ row }: { row: Row }) {
+  switch (row.status) {
+    case "Ready":
+      return <Tag color="success">Готово</Tag>;
+    case "Missing":
+      return <Tag color="warning">Не хватает</Tag>;
+    case "Waiting":
+      return <Tag>{WAITING_TAGS[row.row] ?? "Ждёт"}</Tag>;
+  }
+}
