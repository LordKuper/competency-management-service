+/** What a screen of the matrix wizard is given for its step of an existing version. */
+export interface StepProps {
+  version: MatrixVersion;
+  /** The step shown. */
+  step: number;
+  onBack: () => void;
+  /** Called once a save that asked to go on or to leave succeeded. */
+  onSaved: (then: "next" | "exit") => void;
+  /** Goes on without saving, for a version the user may not edit. */
+  onSkip: () => void;
+  /** Told whether the step holds edits that are not saved yet and whether a save is in flight. */
+  onEditsChange: (edits: LeaveEdits) => void;
+}
diff --git a/web/src/features/desk/deskApi.ts b/web/src/features/desk/deskApi.ts
new file mode 100644
index 0000000..27ba9a7
--- /dev/null
+++ b/web/src/features/desk/deskApi.ts
@@ -0,0 +1,122 @@
+import {
+  keepPreviousData,
+  queryOptions,
+  useQuery,
+} from "@tanstack/react-query";
+import { api } from "../../api/client";
+import { deskQueryKey } from "../../api/queryClient";
+import type { components } from "../../api/schema";
+import { unwrap } from "../../api/unwrap";
+
+/** The signed-in user's desk: the number of expected actions and the non-empty groups with their first items. */
+export type Desk = components["schemas"]["DeskResponse"];
+/** One group of the desk with its full count. */
+export type DeskGroupView = components["schemas"]["DeskGroupResponse"];
+/** Kind of a desk group; the client words its title. */
+export type DeskGroup = components["schemas"]["DeskGroup"];
+/** One object on the desk with every reason it is there. */
+export type DeskItem = components["schemas"]["DeskItemResponse"];
+/** One reason of a desk item; the client words it from its kind. */
+export type DeskReason = components["schemas"]["DeskReasonResponse"];
+/** Kind of a desk reason. */
+export type DeskKind = components["schemas"]["DeskKind"];
+/** A record a desk item is about or names. */
+export type DeskObject = components["schemas"]["DeskObject"];
+
+/** A fact about the system that a scenario card needs before it is shown. */
+export type DeskPrerequisite = components["schemas"]["DeskPrerequisite"];
+
+/** How many items of a group the desk response carries. */
+export const FIRST_ITEMS = 10;
+
+/** How many more items each "Показать ещё" adds. */
+export const MORE_ITEMS = 20;
+
+/** Cache key of the number of the user's expected actions, reread on its own when the address changes. */
+export const deskCountQueryKey = [...deskQueryKey, "count"] as const;
+
+/** The desk; it stays fresh-by-default so it is reread on focus and after any successful change. */
+export function useDesk() {
+  return useQuery({
+    queryKey: [...deskQueryKey, "board"],
+    queryFn: async () => unwrap(await api.GET("/api/v1/desk")),
+  });
+}
+
+/** The number of the user's expected actions, shown on the desk menu entry. */
+export function useDeskCount() {
+  return useQuery({
+    queryKey: deskCountQueryKey,
+    queryFn: async () => unwrap(await api.GET("/api/v1/desk/count")),
+  });
+}
+
+/**
+ * The first `limit` items of one group, read again from the start because items leave as they are done; only asked
+ * for beyond what the desk response already carries. The rows shown stay while the next read runs.
+ */
+export function useDeskGroupItems(group: DeskGroup, limit: number) {
+  return useQuery({
+    queryKey: [...deskQueryKey, "items", group, limit],
+    queryFn: async () =>
+      unwrap(
+        await api.GET("/api/v1/desk/items", {
+          params: { query: { group: [group], limit } },
+        }),
+      ),
+    enabled: limit > FIRST_ITEMS,
+    placeholderData: keepPreviousData,
+  });
+}
+
+/** What a unit lacks to work, row by row. */
+export type UnitSetup = components["schemas"]["UnitSetupResponse"];
+/** The signed-in employee's place in the company. */
+export type MyPlace = components["schemas"]["MyPlaceResponse"];
+
+/**
+ * What a unit lacks to work. It lives under the desk key, so it is reread after any successful change, which is how
+ * every action on the screen recounts the rows.
+ */
+export function unitSetupQuery(unitId: string) {
+  return queryOptions({
+    queryKey: [...deskQueryKey, "unit-setup", unitId],
+    queryFn: async () =>
+      unwrap(
+        await api.GET("/api/v1/career/org-units/{id}/setup", {
+          params: { path: { id: unitId } },
+        }),
+      ),
+  });
+}
+
+/** The signed-in employee's unit, position, head, HR, tracks and requirements of the levels above. */
+export const myPlaceQuery = queryOptions({
+  queryKey: ["career", "my-place"],
+  queryFn: async () => unwrap(await api.GET("/api/v1/career/me/place")),
+});
+
+/** The groups of findings the organisation structure queue works through. */
+export const ORG_QUEUE_GROUPS = [
+  "OrgCleanup",
+  "UnitsToConnect",
+  "InactivePositions",
+  "UnusedPositions",
+  "EmptyUnits",
+] as const satisfies readonly DeskGroup[];
+
+/** The first `limit` findings of one group, or of all the groups of the queue; items leave as they are done, so it is read from the start. */
+export function orgQueueQuery(limit: number, group?: DeskGroup) {
+  return queryOptions({
+    queryKey: [...deskQueryKey, "org-queue", group ?? "all", limit],
+    queryFn: async () =>
+      unwrap(
+        await api.GET("/api/v1/desk/items", {
+          params: {
+            query: { group: group ? [group] : [...ORG_QUEUE_GROUPS], limit },
+          },
+        }),
+      ),
+    placeholderData: keepPreviousData,
+  });
+}
diff --git a/web/src/features/desk/deskTexts.test.ts b/web/src/features/desk/deskTexts.test.ts
new file mode 100644
index 0000000..51f8f3c
--- /dev/null
+++ b/web/src/features/desk/deskTexts.test.ts
@@ -0,0 +1,184 @@
+import { describe, expect, it } from "vitest";
+import type { DeskGroup, DeskItem, DeskKind, DeskObject } from "./deskApi";
+import { deskPaths, itemAction, itemLink } from "./deskTexts";
+
+const OBJECT_ID = "8f1c0a52-0000-4000-8000-000000000001";
+const VERSION_ID = "8f1c0a52-0000-4000-8000-000000000002";
+const OTHER_ID = "8f1c0a52-0000-4000-8000-000000000003";
+
+function objectOf(type: DeskObject["type"], id = OBJECT_ID): DeskObject {
+  return { type, id, name: "Имя" };
+}
+
+function itemOf(
+  kind: DeskKind,
+  options: {
+    type?: DeskObject["type"];
+    target?: DeskObject | null;
+    isReference?: boolean;
+    group?: DeskGroup;
+    entries?: DeskObject[];
+  } = {},
+): DeskItem {
+  return {
+    object: objectOf(options.type ?? "Matrix"),
+    group: options.group ?? "ReturnedVersions",
+    isReference: options.isReference ?? false,
+    reasons: [
+      {
+        kind,
+        details: options.entries ? { entries: options.entries } : undefined,
+      },
+    ],
+    target: options.target === null ? undefined : options.target,
+  };
+}
+
+const VERSION = objectOf("MatrixVersion", VERSION_ID);
+
+describe("the addresses the e-mails link to (AC-110)", () => {
+  it("keeps the review, rework and drafts routes the mail letters are built from", () => {
+    expect(deskPaths.review(VERSION_ID)).toBe(`/desk/review/${VERSION_ID}`);
+    expect(deskPaths.rework(VERSION_ID)).toBe(`/desk/rework/${VERSION_ID}`);
+    expect(deskPaths.draft("competency", OBJECT_ID)).toBe(
+      `/desk/drafts/competency/${OBJECT_ID}`,
+    );
+  });
+});
+
+describe("the screen an action item opens (AC-6, AC-160)", () => {
+  it.each([
+    ["VersionReturned", `/desk/rework/${VERSION_ID}`],
+    ["VersionNotSubmitted", `/desk/matrix-builder/${VERSION_ID}`],
+    ["VersionAwaitsHeadApproval", `/desk/review/${VERSION_ID}`],
+    ["VersionAwaitsHrApproval", `/desk/review/${VERSION_ID}`],
+  ] as const)("opens a %s item on the version the item names", (kind, path) => {
+    expect(itemAction(itemOf(kind, { target: VERSION }))?.path).toBe(path);
+  });
+
+  it("opens no scenario for a version item that names no version", () => {
+    expect(itemAction(itemOf("VersionReturned", { target: null }))).toBeNull();
+  });
+
+  it.each([
+    ["Direction", "direction"],
+    ["Track", "track"],
+    ["Competency", "competency"],
+    ["Scale", "scale"],
+    ["Block", "block"],
+  ] as const)(
+    "opens the draft %s on the queue's entry of its kind",
+    (type, kind) => {
+      expect(itemAction(itemOf("DraftAwaitsApproval", { type }))?.path).toBe(
+        `/desk/drafts/${kind}/${OBJECT_ID}`,
+      );
+    },
+  );
+
+  it("opens the whole drafts queue for a draft of a kind the queue has no entry for", () => {
+    expect(
+      itemAction(itemOf("DraftAwaitsApproval", { type: "Level" }))?.path,
+    ).toBe(deskPaths.drafts);
+  });
+
+  it("preselects the unit, and the track too when exactly one is named, for a unit that needs a matrix", () => {
+    const track = objectOf("Track", OTHER_ID);
+    const one = itemAction(
+      itemOf("UnitWithoutMatrix", { type: "OrgUnit", entries: [track] }),
+    )?.path;
+    const several = itemAction(
+      itemOf("UnitWithoutMatrix", {
+        type: "OrgUnit",
+        entries: [track, objectOf("Track", VERSION_ID)],
+      }),
+    )?.path;
+
+    expect(one).toBe(
+      `/desk/matrix-builder?${new URLSearchParams({ unitId: OBJECT_ID, trackId: OTHER_ID })}`,
+    );
+    expect(several).toBe(
+      `/desk/matrix-builder?${new URLSearchParams({ unitId: OBJECT_ID })}`,
+    );
+  });
+
+  it.each([
+    "UnitWithoutHead",
+    "HeadWithoutAccount",
+    "HeadAccountInvited",
+    "HeadAccountBlocked",
+    "UnitWithoutHr",
+    "UnitWithoutPositions",
+  ] as const)("sends %s to connecting the unit it is about", (kind) => {
+    expect(itemAction(itemOf(kind, { type: "OrgUnit" }))?.path).toBe(
+      `/desk/connect-unit/${OBJECT_ID}`,
+    );
+  });
+
+  it.each(["TrackWithoutPositions", "LevelWithoutPosition"] as const)(
+    "sends %s to linking the positions of the track",
+    (kind) => {
+      expect(itemAction(itemOf(kind, { type: "Track" }))?.path).toBe(
+        `/desk/track-positions/${OBJECT_ID}`,
+      );
+    },
+  );
+
+  it.each(["PositionOutsideList", "AccountWithoutEmployee"] as const)(
+    "sends %s to the organisation queue",
+    (kind) => {
+      expect(itemAction(itemOf(kind))?.path).toBe(deskPaths.orgCleanup);
+    },
+  );
+
+  it("leaves an item whose action is on the desk itself without a screen", () => {
+    expect(
+      itemAction(itemOf("InvitationNotAccepted", { type: "UserAccount" })),
+    ).toBeNull();
+  });
+});
+
+describe("where an item's name leads (AC-6)", () => {
+  it("leads an action to its scenario and a note for reference to a view of the object", () => {
+    expect(itemLink(itemOf("VersionReturned", { target: VERSION }))).toBe(
+      `/desk/rework/${VERSION_ID}`,
+    );
+    expect(
+      itemLink(
+        itemOf("OwnVersionInApproval", {
+          isReference: true,
+          group: "VersionsInApproval",
+        }),
+      ),
+    ).toBe(`/career/matrices/${OBJECT_ID}`);
+    expect(
+      itemLink(
+        itemOf("NoTrackForPosition", {
+          type: "Employee",
+          isReference: true,
+          group: "NoTrack",
+        }),
+      ),
+    ).toBe(deskPaths.myPlace);
+    expect(
+      itemLink(
+        itemOf("LevelWithoutPosition", {
+          type: "Track",
+          isReference: true,
+          group: "PositionLinksInfo",
+        }),
+      ),
+    ).toBe(`/desk/track-positions/${OBJECT_ID}`);
+  });
+
+  it("leads a reference item of a group with a queue to the queue", () => {
+    expect(
+      itemLink(
+        itemOf("UnusedCompetency", {
+          type: "Competency",
+          isReference: true,
+          group: "UnusedCatalogEntries",
+        }),
+      ),
+    ).toBe(deskPaths.catalogCleanup);
+  });
+});
diff --git a/web/src/features/desk/deskTexts.ts b/web/src/features/desk/deskTexts.ts
new file mode 100644
index 0000000..e5c592a
--- /dev/null
+++ b/web/src/features/desk/deskTexts.ts
@@ -0,0 +1,670 @@
+import { HOME_PATH } from "../../app/featureContract";
+import { paths as orgPaths } from "../org-structure/paths";
+import type {
+  DeskGroup,
+  DeskItem,
+  DeskKind,
+  DeskObject,
+  DeskReason,
+} from "./deskApi";
+
+/** A scenario or section a desk entry leads to. */
+export interface DeskLink {
+  /** Russian name of the scenario or section. */
+  title: string;
+  path: string;
+}
+
+/** Addresses of the desk and its scenario screens; the review, rework and drafts addresses are sent in e-mails. */
+export const deskPaths = {
+  desk: HOME_PATH,
+  review: (versionId: string) => `/desk/review/${versionId}`,
+  rework: (versionId: string) => `/desk/rework/${versionId}`,
+  drafts: "/desk/drafts",
+  draft: (kind: string, entryId: string) => `/desk/drafts/${kind}/${entryId}`,
+  matrixBuilder: "/desk/matrix-builder",
+  matrixBuilderOf: (versionId: string) => `/desk/matrix-builder/${versionId}`,
+  connectUnit: "/desk/connect-unit",
+  connectUnitOf: (unitId: string) => `/desk/connect-unit/${unitId}`,
+  onboardEmployee: "/desk/onboard-employee",
+  onboardEmployeeWith: (selection: { unitId?: string; positionId?: string }) =>
+    `/desk/onboard-employee?${new URLSearchParams(
+      Object.entries(selection).filter(
+        (entry): entry is [string, string] => entry[1] !== undefined,
+      ),
+    )}`,
+  myPlace: "/desk/my-place",
+  trackPositions: "/desk/track-positions",
+  trackPositionsOf: (trackId: string) => `/desk/track-positions/${trackId}`,
+  catalogCleanup: "/desk/catalog-cleanup",
+  orgCleanup: "/desk/org-cleanup",
+  positions: "/positions",
+  users: "/users",
+} as const;
+
+/** Titles of the matrix builder steps, in order. */
+export const BUILDER_STEPS = [
+  "Трек",
+  "Компетенции",
+  "Требования",
+  "Формула и пороги",
+  "Проверка полноты",
+  "Отправка",
+] as const;
+
+/** The step names for a matrix built on a track or, when `isPosition`, on a position, whose first step is named for it. */
+export function builderSteps(isPosition: boolean): readonly string[] {
+  return isPosition ? ["Должность", ...BUILDER_STEPS.slice(1)] : BUILDER_STEPS;
+}
+
+const CAREER_SECTION = "Карьерная модель";
+const ORG_SECTION = "Оргструктура";
+
+const DRAFTS_QUEUE: DeskLink = {
