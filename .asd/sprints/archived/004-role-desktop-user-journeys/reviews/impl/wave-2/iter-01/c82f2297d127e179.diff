@@ -0,0 +1,104 @@
+import { describe, expect, it } from "vitest";
+import { HOME_PATH, LOGIN_PATH } from "../../app/featureContract";
+import { FORGOT_PASSWORD_PATH } from "./ForgotPasswordPage";
+import {
+  ACCEPT_INVITATION_PATH,
+  RESET_PASSWORD_PATH,
+} from "./LinkPasswordPage";
+import { loginPathReturningTo, returnTargetOf, safeReturnTo } from "./returnTo";
+
+const SIGN_IN_SCREENS = [
+  LOGIN_PATH,
+  FORGOT_PASSWORD_PATH,
+  ACCEPT_INVITATION_PATH,
+  RESET_PASSWORD_PATH,
+];
+
+const FOREIGN_TARGETS = [
+  "//evil.example",
+  "///evil.example/path",
+  "/\\evil.example",
+  "/\\\\evil.example",
+  "https://evil.example/desk",
+  "http://evil.example",
+  "javascript:alert(1)",
+  "data:text/html,x",
+  "/.//evil.example",
+  "/a/..//evil.example",
+  "desk",
+  "",
+  " /desk",
+  "/\t/evil.example",
+  "/desk\nSet-Cookie: a=b",
+  "/desk\r",
+  "/de\u0000sk",
+  "/\u007f",
+];
+
+const IN_APP_TARGETS = [
+  ["/desk", "/desk"],
+  ["/desk/review/8c1d?step=3", "/desk/review/8c1d?step=3"],
+  ["/org-structure?q=%D0%B0&page=2", "/org-structure?q=%D0%B0&page=2"],
+  ["/desk#section", "/desk"],
+  ["/a/../desk", "/desk"],
+  ["/%2F%2Fevil.example", "/%2F%2Fevil.example"],
+] as const;
+
+describe("return target after sign-in (open redirect)", () => {
+  it.each(FOREIGN_TARGETS)(
+    "refuses %j, which leaves this origin or this app's paths",
+    (target) => {
+      expect(safeReturnTo(target)).toBeNull();
+    },
+  );
+
+  it("refuses an absent target", () => {
+    expect(safeReturnTo(null)).toBeNull();
+  });
+
+  it.each(SIGN_IN_SCREENS)(
+    "refuses the sign-in screen %s, which a signed-in user has no use for",
+    (screen) => {
+      expect(safeReturnTo(screen)).toBeNull();
+      expect(safeReturnTo(`${screen}?returnTo=%2Fdesk`)).toBeNull();
+    },
+  );
+
+  it.each(IN_APP_TARGETS)(
+    "opens %j as the parsed in-app path %j",
+    (target, opened) => {
+      expect(safeReturnTo(target)).toBe(opened);
+    },
+  );
+
+  it("builds a sign-in address that carries an in-app target and reads it back unchanged", () => {
+    for (const [target, opened] of IN_APP_TARGETS.filter(
+      ([target]) => target !== HOME_PATH,
+    )) {
+      const address = new URL(
+        loginPathReturningTo(target),
+        window.location.origin,
+      );
+
+      expect(address.pathname).toBe(LOGIN_PATH);
+      expect(returnTargetOf(address.searchParams)).toBe(opened);
+    }
+  });
+
+  it.each(["/", HOME_PATH, ...FOREIGN_TARGETS, ...SIGN_IN_SCREENS])(
+    "builds the plain sign-in address for %j, which nothing needs to be carried for",
+    (target) => {
+      expect(loginPathReturningTo(target)).toBe(LOGIN_PATH);
+    },
+  );
+
+  it("reads no target from a sign-in address that names none or a foreign one", () => {
+    expect(returnTargetOf(new URLSearchParams())).toBeNull();
+    expect(
+      returnTargetOf(new URLSearchParams({ returnTo: "//evil.example" })),
+    ).toBeNull();
+    expect(
+      returnTargetOf(new URLSearchParams({ returnTo: "https://evil.example" })),
+    ).toBeNull();
+  });
+});
diff --git a/web/src/features/auth/returnTo.ts b/web/src/features/auth/returnTo.ts
new file mode 100644
index 0000000..2e71dcd
--- /dev/null
+++ b/web/src/features/auth/returnTo.ts
@@ -0,0 +1,74 @@
+import { HOME_PATH, LOGIN_PATH } from "../../app/featureContract";
+import { FORGOT_PASSWORD_PATH } from "./ForgotPasswordPage";
+import {
+  ACCEPT_INVITATION_PATH,
+  RESET_PASSWORD_PATH,
+} from "./LinkPasswordPage";
+
+/** Query parameter of the sign-in address that carries the page to open after signing in. */
+const RETURN_TO_PARAM = "returnTo";
+
+/** Screens used without a session: returning to one after signing in makes no sense. */
+const SIGN_IN_PATHS: ReadonlySet<string> = new Set([
+  LOGIN_PATH,
+  FORGOT_PASSWORD_PATH,
+  ACCEPT_INVITATION_PATH,
+  RESET_PASSWORD_PATH,
+]);
+
+const FIRST_PRINTABLE_CODE = 0x20;
+const DELETE_CODE = 0x7f;
+
+/** Backslashes and control characters, which browsers may read as path separators or drop while parsing. */
+function hasUnsafeCharacter(value: string): boolean {
+  return [...value].some((char) => {
+    const code = char.charCodeAt(0);
+    return char === "\\" || code < FIRST_PRINTABLE_CODE || code === DELETE_CODE;
+  });
+}
+
+/**
+ * Sign-in address that returns to the given in-app page; pages a plain sign-in opens anyway, and the sign-in screens
+ * themselves, are not carried.
+ */
+export function loginPathReturningTo(target: string): string {
+  if (target === "/" || target === HOME_PATH || !safeReturnTo(target)) {
+    return LOGIN_PATH;
+  }
+  return `${LOGIN_PATH}?${new URLSearchParams({ [RETURN_TO_PARAM]: target })}`;
+}
+
+/** The return target carried by the sign-in address, once it passed {@link safeReturnTo}; null when absent or refused. */
+export function returnTargetOf(search: URLSearchParams): string | null {
+  return safeReturnTo(search.get(RETURN_TO_PARAM));
+}
+
+/**
+ * The in-app page a sign-in may return to, as the parsed path and query; null for anything else. The value comes from
+ * the address bar, so it is untrusted: it must stay on this origin, be a path starting with exactly one slash, carry no
+ * backslash or control character and not be a sign-in screen. The parsed path is returned rather than the raw string,
+ * so what is checked is what is opened.
+ */
+export function safeReturnTo(value: string | null): string | null {
+  if (
+    !value?.startsWith("/") ||
+    value.startsWith("//") ||
+    hasUnsafeCharacter(value)
+  ) {
+    return null;
+  }
+  let url: URL;
+  try {
+    url = new URL(value, window.location.origin);
+  } catch {
+    return null;
+  }
+  if (
+    url.origin !== window.location.origin ||
+    url.pathname.startsWith("//") ||
+    SIGN_IN_PATHS.has(url.pathname)
+  ) {
+    return null;
+  }
+  return url.pathname + url.search;
+}
