+import { unwrap } from "../../api/unwrap";
+import { AppModal } from "../../app/AppModal";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import { useFormSubmit } from "../../app/useFormSubmit";
+import {
+  invalidateOrgStructure,
+  orgUnitQuery,
+} from "../org-structure/orgStructureApi";
+import { EmployeePicker } from "../users/EmployeePicker";
+import { deskPaths } from "./deskTexts";
+import { returnState } from "./returnLink";
+
+interface AssignHeadModalProps {
+  unitId: string;
+  onClose: () => void;
+}
+
+/**
+ * Dialog that names a working employee of the unit its head. The unit is read when the dialog opens and again after a
+ * refusal, so the next save sends the version the form shows. Mount it only while it is shown.
+ */
+export function AssignHeadModal({ unitId, onClose }: AssignHeadModalProps) {
+  const queryClient = useQueryClient();
+  const { message } = App.useApp();
+  const { data: unit, error, refetch } = useQuery(orgUnitQuery(unitId));
+  const [form] = Form.useForm<{ headEmployeeId?: string }>();
+  const save = useMutation({
+    mutationFn: async (headEmployeeId: string) => {
+      if (!unit) throw new Error("The unit is not read yet");
+      return unwrap(
+        await api.PUT("/api/v1/org-units/{id}", {
+          params: {
+            path: { id: unit.id },
+            header: { "If-Match": ifMatchOf(unit.version) },
+          },
+          body: { name: unit.name, headEmployeeId },
+        }),
+      );
+    },
+    onSuccess: async () => {
+      await invalidateOrgStructure(queryClient);
+      message.success("Руководитель назначен");
+      onClose();
+    },
+    onError: () => invalidateOrgStructure(queryClient),
+  });
+  const { isSubmitting, submit } = useFormSubmit(form, async (values) => {
+    if (values.headEmployeeId) await save.mutateAsync(values.headEmployeeId);
+  });
+
+  return (
+    <AppModal
+      open
+      title="Назначить руководителя"
+      onCancel={onClose}
+      footer={null}
+      closable={!isSubmitting}
+      mask={{ closable: !isSubmitting }}
+      keyboard={!isSubmitting}
+    >
+      {error && (
+        <ErrorAlert
+          title="Не удалось загрузить подразделение"
+          error={error}
+          onRetry={() => void refetch()}
+        />
+      )}
+      {!unit && !error && <Skeleton active />}
+      {unit && (
+        <Space orientation="vertical" size="large" style={{ display: "flex" }}>
+          {save.isError && (
+            <ErrorAlert
+              title="Не удалось назначить руководителя"
+              error={save.error}
+            />
+          )}
+          <Form
+            key={unit.version}
+            form={form}
+            name="unit-head"
+            layout="vertical"
+            disabled={isSubmitting}
+            onFinish={submit}
+          >
+            <Form.Item
+              name="headEmployeeId"
+              label="Сотрудник"
+              extra="Только работающие сотрудники этого подразделения."
+              rules={[{ required: true, message: "Выберите сотрудника" }]}
+            >
+              <EmployeePicker orgUnitId={unit.id} />
+            </Form.Item>
+            <Typography.Paragraph type="secondary">
+              Если сотрудников нет, сначала{" "}
+              <Link
+                to={deskPaths.onboardEmployeeWith({ unitId: unit.id })}
+                state={returnState({
+                  to: deskPaths.connectUnitOf(unit.id),
+                  crumb: "Подключить подразделение",
+                })}
+              >
+                примите сотрудника
+              </Link>
+              .
+            </Typography.Paragraph>
+            <Space>
+              <Button type="primary" htmlType="submit" loading={isSubmitting}>
+                Назначить
+              </Button>
+              <Button disabled={isSubmitting} onClick={onClose}>
+                Отмена
+              </Button>
+            </Space>
+          </Form>
+        </Space>
+      )}
+    </AppModal>
+  );
+}
diff --git a/web/src/features/desk/BuilderCheckStep.tsx b/web/src/features/desk/BuilderCheckStep.tsx
new file mode 100644
index 0000000..68cdbea
--- /dev/null
+++ b/web/src/features/desk/BuilderCheckStep.tsx
@@ -0,0 +1,102 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { Button, Flex, Typography } from "antd";
+import { MatrixErrorAlert } from "../career/MatrixErrorAlert";
+import {
+  invalidateMatrices,
+  matrixCompletenessQuery,
+  saveMatrixContent,
+  storeSavedVersion,
+} from "../career/matrixApi";
+import type { StepProps } from "./builderStep";
+import { CompletenessBlock } from "./CompletenessBlock";
+import { ActionBar } from "./ScenarioContext";
+import { LoadFailure } from "./ScenarioPage";
+import { remarksText } from "./scenarioTexts";
+
+const SUBMIT_STEP = 6;
+
+interface BuilderCheckStepProps extends StepProps {
+  /** Takes the user to the step where a problem is put right. */
+  onGoToStep: (step: number) => void;
+}
+
+/** Step 5: what keeps the saved draft from being sent, and where to put each thing right. */
+export function BuilderCheckStep({
+  version,
+  onBack,
+  onSaved,
+  onSkip,
+  onGoToStep,
+}: BuilderCheckStepProps) {
+  const queryClient = useQueryClient();
+  const completeness = useQuery({
+    ...matrixCompletenessQuery(version.id),
+    refetchOnMount: "always",
+  });
+  const problems = completeness.data?.problems ?? null;
+  const goOn = useMutation({
+    mutationFn: () =>
+      saveMatrixContent(
+        version,
+        version.content,
+        Math.max(version.builderStep ?? 0, SUBMIT_STEP),
+      ),
+    onSuccess: async (saved) => {
+      await storeSavedVersion(queryClient, saved);
+      onSaved("next");
+    },
+    onSettled: () => invalidateMatrices(queryClient),
+  });
+  const isEditable = version.actions.includes("Edit");
+  const hasProblems = problems !== null && problems.length > 0;
+
+  return (
+    <Flex vertical gap="middle">
+      {completeness.error ? (
+        <LoadFailure
+          title="Не удалось выполнить проверку"
+          error={completeness.error}
+          onRetry={() => void completeness.refetch()}
+        />
+      ) : (
+        <CompletenessBlock
+          problems={problems}
+          trackId={version.entries.track?.id ?? ""}
+          warning={(count) =>
+            `Версию пока нельзя отправить: ${remarksText(count)}`
+          }
+          originName="Построить матрицу компетенций"
+          note="Проверка идёт по сохранённому черновику."
+          onStep={onGoToStep}
+        />
+      )}
+      {goOn.error != null && (
+        <MatrixErrorAlert
+          title="Не удалось перейти к отправке"
+          error={goOn.error}
+        />
+      )}
+      <ActionBar
+        start={
+          <Button disabled={goOn.isPending} onClick={onBack}>
+            Назад
+          </Button>
+        }
+      >
+        {hasProblems && (
+          <Typography.Text type="secondary">
+            {`Отправка недоступна: ${remarksText(problems.length)}`}
+          </Typography.Text>
+        )}
+        <Button
+          type="primary"
+          loading={goOn.isPending}
+          disabled={problems === null || hasProblems}
+          onClick={() => (isEditable ? goOn.mutate() : onSkip())}
+        >
+          Перейти к отправке
+        </Button>
+      </ActionBar>
+    </Flex>
+  );
+}
diff --git a/web/src/features/desk/BuilderCompetenciesStep.tsx b/web/src/features/desk/BuilderCompetenciesStep.tsx
new file mode 100644
index 0000000..c724d36
--- /dev/null
+++ b/web/src/features/desk/BuilderCompetenciesStep.tsx
@@ -0,0 +1,656 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import {
+  Alert,
+  Button,
+  Card,
+  ConfigProvider,
+  Flex,
+  Input,
+  Space,
+  Table,
+  type TableColumnsType,
+  Tag,
+  Typography,
+} from "antd";
+import { useEffect, useState } from "react";
+import { ApiError } from "../../api/ApiError";
+import { describeApiError } from "../../app/apiErrors";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import { TruncationNote } from "../../app/TruncationNote";
+import { useDebouncedValue } from "../../app/useDebouncedValue";
+import { useEditBase } from "../../app/useEditBase";
+import { BlockModal } from "../career/BlockModal";
+import { BuilderFooter } from "../career/BuilderFooter";
+import { CatalogStatusTag } from "../career/CatalogParts";
+import { CompetencyModal } from "../career/CompetencyModal";
+import { useProcessRoles } from "../career/careerApi";
+import {
+  blockQuery,
+  type Competency,
+  type CompetencyBlock,
+  competenciesQuery,
+  levelsQuery,
+  MAX_PAGE_SIZE,
+} from "../career/catalogApi";
+import { useCompetencies } from "../career/MatrixEditor";
+import { MatrixErrorAlert } from "../career/MatrixErrorAlert";
+import {
+  invalidateMatrices,
+  type MatrixVersion,
+  matrixChangesQuery,
+  matrixQuery,
+  saveMatrixContent,
+  storeSavedVersion,
+} from "../career/matrixApi";
+import {
+  competenciesText,
+  compositionChanges,
+  compositionsOf,
+  scaleNameOf,
+  versionCompetencyIds,
+} from "../career/matrixGroups";
+import { AddBlockModal } from "./AddBlockModal";
+import {
+  competencyIdsOf,
+  sharedBlockIdsOf,
+  withChosenCompetencies,
+  withSharedBlocks,
+} from "./builderContent";
+import type { StepProps } from "./builderStep";
+
+/** Step 2: the shared blocks and competencies of the matrix, chosen from the catalogues or created as drafts on the spot. */
+export function BuilderCompetenciesStep(props: StepProps) {
+  const { base, noteSaveFailure, rebase } = useEditBase(props.version);
+  const [highlightedBlockId, setHighlightedBlockId] = useState<string>();
+  const [leftover, setLeftover] = useState<AttachFailure>();
+  return (
+    <Flex vertical gap="middle">
+      {leftover && (
+        <Alert
+          type="warning"
+          showIcon
+          closable
+          onClose={() => setLeftover(undefined)}
+          title={`Блок «${leftover.block.name}» создан черновиком, но к версии не подключён`}
+          description={`${failureText(leftover.error)} Подключите его кнопкой «Добавить общий блок».`}
+        />
+      )}
+      <CompetenciesBody
+        key={base?.version}
+        {...props}
+        base={base ?? props.version}
+        noteSaveFailure={noteSaveFailure}
+        highlightedBlockId={highlightedBlockId}
+        onBlockAttached={(id, saved) => {
+          rebase(saved);
+          setLeftover(undefined);
+          setHighlightedBlockId(id);
+        }}
+        onAttachFailed={(block, error) => setLeftover({ block, error })}
+      />
+    </Flex>
+  );
+}
+
+/** A created block whose competencies the version already holds, found before it was attached. */
+class BlockOverlapError extends Error {}
+
+/** The reason an attach failed, in words: the server's own for a refused content, else the common explanation. */
+function failureText(error: unknown): string {
+  if (error instanceof BlockOverlapError) return error.message;
+  const reasons = error instanceof ApiError ? error.errors?.content : undefined;
+  return reasons && reasons.length > 0
+    ? reasons.join(" ")
+    : describeApiError(error);
+}
+
+/** A block created in the wizard that the version could not take, kept so the user is told where it stands. */
+interface AttachFailure {
+  block: CompetencyBlock;
+  error: unknown;
+}
+
+interface CompetenciesBodyProps extends StepProps {
+  base: MatrixVersion;
+  noteSaveFailure: (error: unknown) => void;
+  /** The block created last, whose row stands out. */
+  highlightedBlockId?: string;
+  /** Called once the block is in the saved version, which the step is then based on. */
+  onBlockAttached: (blockId: string, saved: MatrixVersion) => void;
+  onAttachFailed: (block: CompetencyBlock, error: unknown) => void;
+}
+
+const FOR_ALL = "Для всех";
+
+/** A shared block of the version as the step lists it, saved or just picked. */
+interface BlockLine {
+  id: string;
+  /** Just picked, so its details are known here and not yet in the version. */
+  isPicked?: boolean;
+  scopeName?: string | null;
+  name: string;
+  status: "Draft" | "Active" | "Inactive";
+  competencyIds: readonly string[];
+}
+
+function sameIds(left: readonly string[], right: readonly string[]) {
+  return left.length === right.length && left.every((id, i) => id === right[i]);
+}
+
+function CompetenciesBody({
+  version,
+  base,
+  step,
+  noteSaveFailure,
+  highlightedBlockId,
+  onBlockAttached,
+  onAttachFailed,
+  onBack,
+  onSaved,
+  onSkip,
+  onEditsChange,
+}: CompetenciesBodyProps) {
+  const queryClient = useQueryClient();
+  const isEditable = version.actions.includes("Edit");
+  const savedIds = competencyIdsOf(base.content);
+  const savedBlockIds = sharedBlockIdsOf(base.content);
+  const [chosen, setChosen] = useState(savedIds);
+  const [blockIds, setBlockIds] = useState(savedBlockIds);
+  const [picked, setPicked] = useState<ReadonlyMap<string, CompetencyBlock>>(
+    new Map(),
+  );
+  const [search, setSearch] = useState("");
+  const [highlightedId, setHighlightedId] = useState<string>();
+  const [isCreating, setIsCreating] = useState(false);
+  const [isPickingBlock, setIsPickingBlock] = useState(false);
+  const [isCreatingBlock, setIsCreatingBlock] = useState(false);
+  const q = useDebouncedValue(search.trim());
+  const { entries } = version;
+  const list = useQuery(
+    competenciesQuery({
+      q: q || undefined,
+      page: 1,
+      pageSize: MAX_PAGE_SIZE,
+      directionId: entries.direction?.id,
+      withGeneral: true,
+      inWork: true,
+    }),
+  );
+  const allowed = useQuery({
+    ...competenciesQuery({
+      page: 1,
+      pageSize: MAX_PAGE_SIZE,
+      directionId: entries.direction?.id,
+      withGeneral: true,
+      inWork: true,
+    }),
+    enabled: entries.direction !== null,
+  });
+  const allowedIds =
+    allowed.data && allowed.data.total <= MAX_PAGE_SIZE
+      ? new Set(allowed.data.items.map((item) => item.id))
+      : undefined;
+  const matrix = useQuery(matrixQuery(version.matrixId));
+  const roles = useProcessRoles();
+  const unit = matrix.data && {
+    id: matrix.data.orgUnitId,
+    name: matrix.data.orgUnitName,
+  };
+  const canCreateBlock =
+    isEditable &&
+    unit !== undefined &&
+    roles.data?.headedUnits.some((item) => item.id === unit.id) === true;
+  const changes = useQuery(matrixChangesQuery(version.id));
+  const compositionChange = compositionChanges(changes.data);
+  const trackLevels = useQuery({
+    ...levelsQuery(entries.track?.id ?? ""),
+    enabled: entries.track !== null,
+  });
+
+  const compositions = new Map<string, readonly string[]>([
+    ...compositionsOf(version),
+    ...[...picked].map(
+      ([id, block]) => [id, block.competencies.map((item) => item.id)] as const,
+    ),
+  ]);
+  const lines: BlockLine[] = blockIds.flatMap((id) => {
+    const entry = entries.sharedBlocks?.find((item) => item.id === id);
+    if (entry) {
+      return [
+        {
+          id,
+          name: entry.name,
+          status: entry.status,
+          competencyIds: entry.competencyIds,
+        },
+      ];
+    }
+    const block = picked.get(id);
+    return block
+      ? [
+          {
+            id,
+            name: block.name,
+            status: block.status,
+            isPicked: true,
+            scopeName: block.scopeUnitName,
+            competencyIds: block.competencies.map((item) => item.id),
+          },
+        ]
+      : [];
+  });
+  const brought = new Map(
+    lines.flatMap((line) =>
+      line.competencyIds.map((id) => [id, line.name] as const),
+    ),
+  );
+
+  const save = useMutation({
+    mutationFn: (request: { step: number; then: "next" | "exit" }) =>
+      saveMatrixContent(
+        base,
+        withSharedBlocks(
+          withChosenCompetencies(
+            base.content,
+            chosen,
+            trackLevels.data?.items ?? [],
+          ),
+          blockIds,
+          compositions,
+        ),
+        Math.max(base.builderStep ?? 0, request.step),
+      ),
+    onSuccess: async (saved, request) => {
+      await storeSavedVersion(queryClient, saved);
+      onSaved(request.then);
+    },
+    onError: noteSaveFailure,
+    onSettled: () => invalidateMatrices(queryClient),
+  });
+  const attach = useMutation({
+    mutationFn: (block: CompetencyBlock) => {
+      const held = new Set([...versionCompetencyIds(version), ...chosen]);
+      const repeated = block.competencies.find((item) => held.has(item.id));
+      if (repeated) {
+        return Promise.reject(
+          new BlockOverlapError(
+            `Компетенция «${repeated.name}» уже входит в версию.`,
+          ),
+        );
+      }
+      return saveMatrixContent(
+        base,
+        withSharedBlocks(
+          withChosenCompetencies(
+            base.content,
+            chosen,
+            trackLevels.data?.items ?? [],
+          ),
+          [...blockIds, block.id],
+          new Map([
+            ...compositions,
+            [block.id, block.competencies.map((item) => item.id)],
+          ]),
+        ),
+      );
+    },
+    onSuccess: async (saved, block) => {
+      await storeSavedVersion(queryClient, saved);
+      onBlockAttached(block.id, saved);
+    },
+    onError: (error, block) => {
+      noteSaveFailure(error);
+      onAttachFailed(block, error);
+    },
+    onSettled: () => invalidateMatrices(queryClient),
+  });
+  const isUnsaved =
+    isEditable &&
+    (chosen.size !== savedIds.size ||
+      [...chosen].some((id) => !savedIds.has(id)) ||
+      !sameIds(blockIds, savedBlockIds));
+  const isSaving = save.isPending || attach.isPending;
+  useEffect(
+    () => onEditsChange({ isUnsaved, isSaving }),
+    [isUnsaved, isSaving, onEditsChange],
+  );
+
+  function choose(id: string, isChosen: boolean) {
+    setChosen((previous) => {
+      const next = new Set(previous);
+      if (isChosen) next.add(id);
+      else next.delete(id);
+      return next;
+    });
+  }
+
+  function reasonOf(block: CompetencyBlock) {
+    if (blockIds.includes(block.id)) return "уже в версии";
+    const taken = block.competencies.find(
+      (item) => chosen.has(item.id) || brought.has(item.id),
+    );
+    return taken ? `компетенция «${taken.name}» уже в версии` : undefined;
+  }
+
+  const columns: TableColumnsType<Competency> = [
+    {
+      title: "Компетенция",
+      key: "name",
+      render: (_, competency) =>
+        brought.has(competency.id)
+          ? `${competency.name} · уже в версии: общий блок «${brought.get(competency.id)}»`
+          : competency.name,
+    },
+    { title: "Шкала", dataIndex: "scaleName" },
+    {
+      title: "Статус",
+      dataIndex: "status",
+      render: (status: Competency["status"]) => (
+        <CatalogStatusTag status={status} />
+      ),
+    },
+  ];
+
+  return (
+    <ConfigProvider componentDisabled={isSaving}>
+      <Flex vertical gap="middle">
+        <Card
+          size="small"
+          title="Блоки компетенций"
+          extra={
+            isEditable && (
+              <Space>
+                <Button onClick={() => setIsPickingBlock(true)}>
+                  Добавить общий блок
+                </Button>
+                {canCreateBlock && (
+                  <Button onClick={() => setIsCreatingBlock(true)}>
+                    Создать блок
+                  </Button>
+                )}
+              </Space>
+            )
+          }
+        >
+          <BlocksTable
+            version={version}
+            lines={lines}
+            isEditable={isEditable}
+            highlightedId={highlightedBlockId}
+            compositionChange={compositionChange}
+            onRemove={(id) =>
+              setBlockIds((previous) => previous.filter((item) => item !== id))
+            }
+          />
+          <Typography.Text type="secondary">
+            Состав общего блока здесь не правится: он меняется в справочнике
+            «Общие блоки». Требуемые баллы и коэффициент блока задаются на
+            следующих шагах.
+          </Typography.Text>
+        </Card>
+        <Flex vertical gap="small">
+          <Typography.Title level={4} style={{ margin: 0 }}>
+            Компетенции вне блоков
+          </Typography.Title>
+          <Flex align="center" gap="middle" wrap>
+            <Input.Search
+              aria-label="Найти компетенцию"
+              placeholder="Найти компетенцию"
+              allowClear
+              style={{ flex: 1 }}
+              value={search}
+              onChange={(event) => {
+                setSearch(event.target.value);
+              }}
+            />
+            <Typography.Text
+              strong
+            >{`Выбрано: ${chosen.size}`}</Typography.Text>
+            {isEditable && (
+              <Button onClick={() => setIsCreating(true)}>
+                Создать компетенцию
+              </Button>
+            )}
+          </Flex>
+        </Flex>
+        {list.error ? (
+          <ErrorAlert
+            title="Не удалось загрузить каталог компетенций"
+            error={list.error}
+            onRetry={() => void list.refetch()}
+          />
+        ) : (
+          <Table<Competency>
+            rowKey="id"
+            columns={columns}
+            dataSource={list.data?.items}
+            loading={list.isFetching}
+            className="desk-table"
+            rowClassName={(row) =>
+              row.id === highlightedId ? "queue-row-selected" : ""
+            }
+            rowSelection={{
+              selectedRowKeys: [...chosen, ...brought.keys()],
+              getCheckboxProps: (row) => ({
+                disabled: !isEditable || brought.has(row.id),
+              }),
+              onSelect: (row, isChosen) => choose(row.id, isChosen),
+              onSelectAll: (isChosen, _rows, changed) => {
+                for (const row of changed) {
+                  if (!brought.has(row.id)) choose(row.id, isChosen);
+                }
+              },
+            }}
+            pagination={false}
+            locale={{
+              emptyText: q
+                ? `Компетенция «${q}» не найдена. Измените запрос или создайте компетенцию кнопкой выше.`
+                : "Компетенции не найдены. В каталоге нет подходящих компетенций: создайте компетенцию кнопкой выше.",
+            }}
+          />
+        )}
+        <TruncationNote
+          shown={list.data?.items.length ?? 0}
+          total={list.data?.total}
+        />
+        <Typography.Text type="secondary">
+          Черновые компетенции опубликуются вместе с матрицей компетенций.
+        </Typography.Text>
+        {save.error != null && (
+          <MatrixErrorAlert
+            title="Не удалось сохранить шаг"
+            error={save.error}
+          />
+        )}
+        <BuilderFooter
+          step={step}
+          onBack={onBack}
+          onSkip={onSkip}
+          isEditable={isEditable}
+          isUnsaved={isUnsaved}
+          isSaving={save.isPending}
+          nextBlock={
+            (chosen.size === 0 && blockIds.length === 0) ||
+            (entries.track !== null && !trackLevels.data)
+              ? "Выберите хотя бы одну компетенцию или общий блок"
+              : undefined
+          }
+          onSave={(nextStep, then) => save.mutate({ step: nextStep, then })}
+          onCancelEdits={() => {
+            setChosen(savedIds);
+            setBlockIds(savedBlockIds);
+          }}
+        />
+      </Flex>
+      {isCreating && (
+        <CompetencyModal
+          onSaved={(created) => {
+            choose(created.id, true);
+            setHighlightedId(created.id);
+          }}
+          onClose={() => setIsCreating(false)}
+        />
+      )}
+      {isCreatingBlock && unit && (
+        <BlockModal
+          fixedScope={unit}
+          takenIds={new Set([...chosen, ...brought.keys()])}
+          onSaved={(created) => attach.mutate(created)}
+          onClose={() => setIsCreatingBlock(false)}
+        />
+      )}
+      {isPickingBlock && (
+        <AddBlockModal
+          entries={entries}
+          reasonOf={reasonOf}
+          allowedIds={allowedIds}
+          availableFor={unit?.id}
+          onPick={(block) => {
+            setPicked((previous) => new Map(previous).set(block.id, block));
+            setBlockIds((previous) => [...previous, block.id]);
+            setIsPickingBlock(false);
+          }}
+          onClose={() => setIsPickingBlock(false)}
+        />
+      )}
+    </ConfigProvider>
+  );
+}
+
+interface BlocksTableProps {
+  version: MatrixVersion;
+  lines: readonly BlockLine[];
+  isEditable: boolean;
+  highlightedId?: string;
+  compositionChange: ReturnType<typeof compositionChanges>;
+  onRemove: (id: string) => void;
+}
+
+/** The shared blocks of the version, each opening to its composition for reading. */
+function BlocksTable({
+  version,
+  lines,
+  isEditable,
+  highlightedId,
+  compositionChange,
+  onRemove,
+}: BlocksTableProps) {
+  const columns: TableColumnsType<BlockLine> = [
+    {
+      title: "Блок",
+      key: "name",
+      render: (_, line) => (
+        <Space size="small" wrap>
+          {line.name}
+          {line.status === "Draft" && <CatalogStatusTag status="Draft" />}
+        </Space>
+      ),
+    },
+    {
+      title: "Действует для",
+      key: "scope",
+      render: (_, line) => <ScopeCell line={line} />,
+    },
+    {
+      title: "Состав",
+      key: "count",
+      render: (_, line) => competenciesText(line.competencyIds.length),
+    },
+    {
+      title: "Действия",
+      key: "actions",
+      render: (_, line) =>
+        isEditable && (
+          <Button
+            type="link"
+            size="small"
+            danger
+            aria-label={`Убрать блок «${line.name}»`}
+            onClick={() => onRemove(line.id)}
+          >
+            Убрать блок
+          </Button>
+        ),
+    },
+  ];
+  return (
+    <Table<BlockLine>
+      size="small"
+      rowKey="id"
+      columns={columns}
+      dataSource={[...lines]}
+      pagination={false}
+      rowClassName={(line) =>
+        line.id === highlightedId ? "queue-row-selected" : ""
+      }
+      locale={{ emptyText: "Общих блоков в версии нет" }}
+      expandable={{
+        defaultExpandedRowKeys: lines
+          .filter((line) => compositionChange.has(line.id))
+          .map((line) => line.id),
+        expandedRowRender: (line) => (
+          <Composition
+            version={version}
+            line={line}
+            change={compositionChange.get(line.id)}
+          />
+        ),
+      }}
+    />
+  );
+}
+
+/** Where the block applies, in words: the unit it is for, or «Для всех». */
+function ScopeCell({ line }: { line: BlockLine }) {
+  const read = useQuery({ ...blockQuery(line.id), enabled: !line.isPicked });
+  return (line.isPicked ? line.scopeName : read.data?.scopeUnitName) ?? FOR_ALL;
+}
+
+interface CompositionProps {
+  version: MatrixVersion;
+  line: BlockLine;
+  change?: { added: readonly string[]; removed: readonly string[] };
+}
+
+function Composition({ version, line, change }: CompositionProps) {
+  const competencies = useCompetencies(version.entries, [
+    ...line.competencyIds,
+    ...(change?.removed ?? []),
+  ]);
+  const rows = [...line.competencyIds];
+  return (
+    <Flex vertical gap="small">
+      <Table
+        size="small"
+        rowKey="id"
+        pagination={false}
+        dataSource={rows.map((id) => ({ id }))}
+        columns={[
+          {
+            title: "Компетенция",
+            key: "name",
+            render: (_, { id }) => (
+              <Space size="small" wrap>
+                {competencies.get(id)?.name}
+                {change?.added.includes(id) && (
+                  <Tag color="warning">⚠ Добавлена в блок</Tag>
+                )}
+              </Space>
+            ),
+          },
+          {
+            title: "Шкала",
+            key: "scale",
+            render: (_, { id }) =>
+              scaleNameOf(version, id, competencies.get(id)),
+          },
+        ]}
+      />
+      {change && change.removed.length > 0 && (
+        <Typography.Text type="secondary">
+          {`Убрана из блока: ${change.removed.map((id) => `«${competencies.get(id)?.name}»`).join(", ")}`}
+        </Typography.Text>
+      )}
+    </Flex>
+  );
+}
diff --git a/web/src/features/desk/BuilderSubmitStep.tsx b/web/src/features/desk/BuilderSubmitStep.tsx
new file mode 100644
index 0000000..43f9f42
--- /dev/null
+++ b/web/src/features/desk/BuilderSubmitStep.tsx
@@ -0,0 +1,178 @@
+import { CheckCircleOutlined } from "@ant-design/icons";
+import { useQuery } from "@tanstack/react-query";
+import { App, Button, Flex, Skeleton, Typography } from "antd";
+import { useNavigate } from "react-router";
+import { trackQuery } from "../career/catalogApi";
+import {
+  type MatrixVersion,
+  matrixCompletenessQuery,
+  matrixPublicationQuery,
+  matrixQuery,
+} from "../career/matrixApi";
+import { sharedBlocksOf } from "../career/matrixContent";
+import { versionCompetencyIds } from "../career/matrixGroups";
+import { SKIPPED_NOTE } from "../career/matrixLabels";
+import { draftRecords, publishedCount } from "../career/usePublishEntry";
+import { CascadeTable } from "./CascadeTable";
+import { CompletenessBlock } from "./CompletenessBlock";
+import { DecisionError } from "./DecisionError";
+import { deskPaths, shortName } from "./deskTexts";
+import { ActionBar, CompactAlert } from "./ScenarioContext";
+import { outcomeText, remarksText } from "./scenarioTexts";
+import { useVersionTransition } from "./useVersionTransition";
+
+interface BuilderSubmitStepProps {
+  version: MatrixVersion;
+  onBack: () => void;
+}
+
+/** Step 6: the summary of the version and the route it takes, and the sending. */
+export function BuilderSubmitStep({ version, onBack }: BuilderSubmitStepProps) {
+  const { message } = App.useApp();
+  const navigate = useNavigate();
+  const track = useQuery({
+    ...trackQuery(version.entries.track?.id ?? ""),
+    enabled: version.entries.track !== null,
+  });
+  const matrix = useQuery(matrixQuery(version.matrixId));
+  const completeness = useQuery({
+    ...matrixCompletenessQuery(version.id),
+    refetchOnMount: "always",
+  });
+  const publication = useQuery({
+    ...matrixPublicationQuery(version.id),
+    refetchOnMount: "always",
+  });
+  const transition = useVersionTransition();
+  const problems = completeness.data?.problems ?? null;
+  const preview = publication.data;
+  const isPublishing = preview?.publishingActions.includes("Submit") === true;
+  const canSubmit = version.actions.includes("Submit");
+  const { content, authorName, superiorApprover, hr } = version;
+  const route = [
+    `Автор: ${shortName(authorName ?? "")}`,
+    superiorApprover
+      ? `Вышестоящий руководитель: ${shortName(superiorApprover.name)}`
+      : `Вышестоящий руководитель: ${SKIPPED_NOTE}`,
+    hr ? `HR: ${shortName(hr.name)}` : "HR",
+    "Публикация",
+  ].join(" → ");
+  const receiver = superiorApprover ?? hr;
+
+  function submit() {
+    void transition.decide({
+      version,
+      transition: "submit",
+      preview,
+      publishing: {
+        isAskedFirst: false,
+        title: "Отправить и опубликовать версию?",
+        okText: "Отправить и опубликовать",
+        lead: (count) =>
+          count > 0
+            ? `Вместе с версией станут действующими ${draftRecords(count)}:`
+            : "Черновых записей нет: публикуется только версия.",
+      },
+      onDone: (saved, count) => {
+        message.success(
+          outcomeText(saved, count, "Версия отправлена на согласование"),
+        );
+        void navigate(deskPaths.desk);
+      },
+    });
+  }
+
+  if (problems === null || !preview) return <Skeleton active />;
+  const cascadeCount = publishedCount(preview);
+
+  return (
+    <Flex vertical gap="middle">
+      {problems.length > 0 ? (
+        <CompletenessBlock
+          problems={problems}
+          trackId={version.entries.track?.id ?? ""}
+          warning={(count) =>
+            `Версию пока нельзя отправить: ${remarksText(count)}`
+          }
+          originName="Построить матрицу компетенций"
+        />
+      ) : (
+        <CompactAlert
+          type="success"
+          icon={<CheckCircleOutlined />}
+          lead="Версия полна:"
+          text="замечаний нет, можно отправлять на согласование."
+        />
+      )}
+      {version.entries.position && (
+        <Typography.Text strong>
+          {`Матрица должности «${version.entries.position.name}» — ${matrix.data?.orgUnitName ?? ""}`}
+        </Typography.Text>
+      )}
+      <Typography.Text>
+        {[
+          `Содержание: компетенций ${versionCompetencyIds(version).length}`,
+          version.entries.position ? null : `уровней ${content.levels.length}`,
+          `общих блоков ${sharedBlocksOf(content).length}`,
+        ]
+          .filter(Boolean)
+          .join(" · ")}
+      </Typography.Text>
+      {isPublishing ? (
+        <Flex vertical gap="small">
+          <CompactAlert
+            type="warning"
+            lead="Отправка опубликует версию"
+            text={
+              cascadeCount > 0
+                ? `и вместе с ней ${draftRecords(cascadeCount)}: вы — ответственный HR этого подразделения, шаг 2 согласуется автоматически.`
+                : "без черновых записей: вы — ответственный HR этого подразделения, шаг 2 согласуется автоматически."
+            }
+          />
+          {cascadeCount > 0 && <CascadeTable drafts={preview} />}
+        </Flex>
+      ) : (
+        <section>
+          <Typography.Title level={4}>Маршрут согласования</Typography.Title>
+          <Typography.Paragraph>{route}</Typography.Paragraph>
+          {receiver && (
+            <Typography.Paragraph type="secondary">
+              {`Версия уйдёт ${shortName(receiver.name)}; ему и далее HR придёт письмо.`}
+              {track.data?.status === "Draft" &&
+                ` Трек «${version.entries.track?.name}» — черновой: он опубликуется вместе с версией, если HR вправе его утвердить.`}
+            </Typography.Paragraph>
+          )}
+        </section>
+      )}
+      {transition.error != null && (
+        <DecisionError
+          title="Версию нельзя отправить"
+          error={transition.error}
+        />
+      )}
+      <ActionBar
+        start={
+          <Button disabled={transition.isPending} onClick={onBack}>
+            Назад
+          </Button>
+        }
+      >
+        {problems.length > 0 && (
+          <Typography.Text type="secondary">
+            {`Отправка недоступна: ${remarksText(problems.length)}`}
+          </Typography.Text>
+        )}
+        <Button
+          type="primary"
+          loading={transition.isPending}
+          disabled={!canSubmit || problems.length > 0}
+          onClick={submit}
+        >
+          {isPublishing
+            ? "Отправить и опубликовать"
+            : "Отправить на согласование"}
+        </Button>
+      </ActionBar>
+    </Flex>
+  );
+}
diff --git a/web/src/features/desk/BuilderTrackStep.tsx b/web/src/features/desk/BuilderTrackStep.tsx
new file mode 100644
index 0000000..db1b47b
--- /dev/null
+++ b/web/src/features/desk/BuilderTrackStep.tsx
@@ -0,0 +1,466 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import {
+  Button,
+  Flex,
+  Form,
+  Input,
+  Radio,
+  Select,
+  Table,
+  type TableColumnsType,
+  Typography,
+} from "antd";
+import { useEffect, useState } from "react";
+import { useNavigate } from "react-router";
+import { type LeaveEdits, useLeaveGuard } from "../../app/leaveGuard";
+import { useFormSubmit } from "../../app/useFormSubmit";
+import { CatalogSelect, IN_WORK } from "../career/CatalogSelect";
+import { useProcessRoles } from "../career/careerApi";
+import {
+  MAX_PAGE_SIZE,
+  readTrack,
+  type TrackPositions,
+  trackPositionsQuery,
+  trackQuery,
+} from "../career/catalogApi";
+import { employees } from "../career/LevelPositionsModal";
+import { MatrixErrorAlert } from "../career/MatrixErrorAlert";
+import { MatrixPositionSelect } from "../career/MatrixPositionSelect";
+import {
+  createMatrix,
+  createMatrixVersion,
+  invalidateMatrices,
+  type MatrixVersion,
+  matricesQuery,
+  matrixPositionsQuery,
+  matrixQuery,
+} from "../career/matrixApi";
+import { TrackModal } from "../career/TrackModal";
+import { NoPositionTag, PositionGapAction } from "./CompletenessBlock";
+import { deskPaths } from "./deskTexts";
+import { ActionBar, CompactAlert, FormColumn } from "./ScenarioContext";
+import "./scenario.css";
+
+type LevelRow = TrackPositions["levels"][number];
+
+interface LevelsTableProps {
+  trackId: string;
+  trackName: string;
+  /** Why linking positions is not possible now, if it is not. */
+  unavailable?: string;
+}
+
+/** The levels of a track with their positions; a level without an active one carries the word and the way to put it right. */
+function LevelsTable({ trackId, trackName, unavailable }: LevelsTableProps) {
+  const read = useQuery(trackPositionsQuery(trackId));
+  const columns: TableColumnsType<LevelRow> = [
+    {
+      title: "Уровень",
+      key: "level",
+      render: (_, level, index) => `${index + 1}. ${level.name}`,
+    },
+    {
+      title: "Должности",
+      key: "positions",
+      render: (_, level) =>
+        level.hasActivePosition ? (
+          level.positions
+            .map(
+              (position) =>
+                `${position.name} · ${employees(position.employeeCount)}`,
+            )
+            .join("; ")
+        ) : (
+          <NoPositionTag />
+        ),
+    },
+    {
+      title: "Действия",
+      key: "actions",
+      render: (_, level) =>
+        !level.hasActivePosition && (
+          <PositionGapAction
+            trackId={trackId}
+            originName="Построить матрицу компетенций"
+            unavailable={unavailable}
+          />
+        ),
+    },
+  ];
+  return (
+    <section>
+      <Typography.Title level={4}>
+        {`Уровни трека «${trackName}» и их должности`}
+      </Typography.Title>
+      <Table<LevelRow>
+        size="small"
+        rowKey="id"
+        columns={columns}
+        dataSource={read.data?.levels}
+        loading={read.isFetching}
+        pagination={false}
+      />
+    </section>
+  );
+}
+
+interface FormValues {
+  orgUnitId?: string;
+  trackId?: string;
+  positionId?: string;
+}
+
+/** What a matrix is built on: a career track, or a position that has no track. */
+export type Basis = "track" | "position";
+
+const BASIS_OPTIONS = [
+  { value: "track", label: "По треку" },
+  { value: "position", label: "По должности" },
+] as const;
+
+interface BuilderTrackStepProps {
+  /** The version already created; its basis, unit and scale can no longer be changed. */
+  version?: MatrixVersion;
+  preselected: {
+    unitId?: string;
+    trackId?: string;
+    positionId?: string;
+    positionName?: string;
+  };
+  basis: Basis;
+  onBasisChange: (basis: Basis) => void;
+  onNext: () => void;
+  onEditsChange: (edits: LeaveEdits) => void;
+}
+
+/** Step 1: the basis, the unit, and the track or the position. Saving it creates the draft version, or the next version of a published matrix. */
+export function BuilderTrackStep({
+  version,
+  preselected,
+  basis,
+  onBasisChange,
+  onNext,
+  onEditsChange,
+}: BuilderTrackStepProps) {
+  if (version) return <CreatedVersion version={version} onNext={onNext} />;
+  return (
+    <NewVersionForm
+      preselected={preselected}
+      basis={basis}
+      onBasisChange={onBasisChange}
+      onEditsChange={onEditsChange}
+    />
+  );
+}
+
+function CreatedVersion({
+  version,
+  onNext,
+}: {
+  version: MatrixVersion;
+  onNext: () => void;
+}) {
+  const matrix = useQuery(matrixQuery(version.matrixId));
+  const { track, position } = version.entries;
+  return (
+    <FormColumn>
+      <Form layout="vertical" disabled className="compact-form">
+        <Flex vertical gap="middle">
+          <Form.Item label="Основа матрицы">
+            <Radio.Group
+              value={position ? "position" : "track"}
+              options={[...BASIS_OPTIONS]}
+            />
+          </Form.Item>
+          <Form.Item label="Подразделение">
+            <Input value={matrix.data?.orgUnitName} />
+          </Form.Item>
+          <Form.Item label={position ? "Должность" : "Трек"}>
+            <Input value={position?.name ?? track?.name} />
+          </Form.Item>
+        </Flex>
+      </Form>
+      {track && <LevelsTable trackId={track.id} trackName={track.name} />}
+      <ActionBar>
+        <Button type="primary" onClick={onNext}>
+          Далее
+        </Button>
+      </ActionBar>
+    </FormColumn>
+  );
+}
+
+function NewVersionForm({
+  preselected,
+  basis,
+  onBasisChange,
+  onEditsChange,
+}: Pick<
+  BuilderTrackStepProps,
+  "preselected" | "basis" | "onBasisChange" | "onEditsChange"
+>) {
+  const navigate = useNavigate();
+  const { leaveAfterSave } = useLeaveGuard();
+  const queryClient = useQueryClient();
+  const [form] = Form.useForm<FormValues>();
+  const [isDirty, setIsDirty] = useState(false);
+  const [isTrackCreating, setIsTrackCreating] = useState(false);
+  const roles = useProcessRoles();
+  const orgUnitId = Form.useWatch("orgUnitId", form);
+  const trackId = Form.useWatch("trackId", form);
+  const positionId = Form.useWatch("positionId", form);
+  const isPosition = basis === "position";
+  const headedUnits = roles.data?.headedUnits ?? [];
+  const unit = headedUnits.find((item) => item.id === orgUnitId);
+  const track = useQuery({
+    ...trackQuery(trackId ?? ""),
+    enabled: !isPosition && trackId !== undefined,
+  });
+  const subject = isPosition ? positionId : trackId;
+  const existing = useQuery({
+    ...matricesQuery({
+      orgUnitId: orgUnitId ?? "",
+      ...(isPosition ? { positionId } : { trackId }),
+      page: 1,
+      pageSize: 1,
+    }),
+    enabled: orgUnitId !== undefined && subject !== undefined,
+  });
+  const positions = useQuery({
+    ...matrixPositionsQuery(orgUnitId ?? "", "", 1, MAX_PAGE_SIZE),
+    enabled: isPosition && orgUnitId !== undefined,
+  });
+  const isNoPositionAvailable =
+    positions.data !== undefined &&
+    positions.data.total <= MAX_PAGE_SIZE &&
+    positions.data.items.every((item) => item.isLinked);
+  const matrix = existing.data?.items[0];
+
+  useEffect(() => {
+    if (headedUnits.length === 1 && !form.getFieldValue("orgUnitId")) {
+      form.setFieldValue("orgUnitId", headedUnits[0]?.id);
+    }
+  }, [headedUnits, form]);
+
+  const create = useMutation({
+    mutationFn: async (values: FormValues) => {
+      const subjectId = isPosition ? values.positionId : values.trackId;
+      if (!values.orgUnitId || !subjectId) {
+        throw new Error("The unit and the track or position are required");
+      }
+      if (matrix?.inWorkVersion) return matrix.inWorkVersion.id;
+      if (matrix?.publishedVersion) {
+        return (await createMatrixVersion(matrix.id)).id;
+      }
+      const basisFields = isPosition
+        ? { positionId: subjectId }
+        : {
+            directionId: (await readTrack(subjectId)).directionId,
+            trackId: subjectId,
+          };
+      const created = await createMatrix({
+        orgUnitId: values.orgUnitId,
+        ...basisFields,
+      });
+      if (!created.inWorkVersion)
+        throw new Error("The version was not created");
+      return created.inWorkVersion.id;
+    },
+    onSuccess: (versionId) => {
+      setIsDirty(false);
+      leaveAfterSave(
+        () =>
+          void navigate(deskPaths.matrixBuilderOf(versionId), {
+            replace: true,
+          }),
+      );
+    },
+    onSettled: () => invalidateMatrices(queryClient),
+  });
+  const { isSubmitting, submit } = useFormSubmit(form, create.mutateAsync);
+  const isLocked = isSubmitting;
+  useEffect(
+    () => onEditsChange({ isUnsaved: isDirty, isSaving: isSubmitting }),
+    [isDirty, isSubmitting, onEditsChange],
+  );
+
+  return (
+    <Form
+      form={form}
+      name="matrix-builder-track"
+      layout="vertical"
+      className="compact-form"
+      disabled={isLocked}
+      initialValues={{
+        orgUnitId: preselected.unitId,
+        trackId: preselected.trackId,
+        positionId: preselected.positionId,
+      }}
+      onValuesChange={() => setIsDirty(true)}
+      onFinish={submit}
+    >
+      <FormColumn>
+        {roles.isSuccess && headedUnits.length === 0 && (
+          <CompactAlert
+            type="info"
+            lead="Построить матрицу может руководитель подразделения."
+            text="Вы не руководите ни одним подразделением, поэтому создать матрицу здесь нельзя. Обратитесь к руководителю подразделения."
+          />
+        )}
+        {create.error != null && (
+          <MatrixErrorAlert
+            title="Не удалось сохранить шаг"
+            error={create.error}
+          />
+        )}
+        <Form.Item label="Основа матрицы">
+          <Radio.Group
+            value={basis}
+            options={[...BASIS_OPTIONS]}
+            onChange={(event) => {
+              onBasisChange(event.target.value as Basis);
+              form.resetFields(["trackId", "positionId"]);
+              setIsDirty(true);
+            }}
+          />
+        </Form.Item>
+        {isPosition && (
+          <CompactAlert
+            type="info"
+            lead="Матрица должности обычно нужна для управленческих должностей, которые не связаны напрямую с карьерными треками специалистов."
+          />
+        )}
+        <Form.Item
+          name="orgUnitId"
+          label="Подразделение"
+          rules={[{ required: true }]}
+        >
+          <Select
+            options={headedUnits.map((item) => ({
+              value: item.id,
+              label: item.name,
+            }))}
+            onChange={() => form.resetFields(["trackId", "positionId"])}
+          />
+        </Form.Item>
+        {isPosition ? (
+          isNoPositionAvailable ? (
+            <Form.Item label="Должность">
+              <CompactAlert
+                type="warning"
+                lead={`Все должности подразделения «${unit?.name ?? ""}» и вышестоящих связаны с уровнями треков или не входят в перечень.`}
+                text="Добавьте должность в перечень в «Справочники → Оргструктура»."
+              />
+            </Form.Item>
+          ) : (
+            <Form.Item
+              name="positionId"
+              label="Должность"
+              rules={[{ required: true, message: "Выберите должность" }]}
+            >
+              <MatrixPositionSelect
+                orgUnitId={orgUnitId}
+                knownName={preselected.positionName}
+              />
+            </Form.Item>
+          )
+        ) : (
+          <Form.Item label="Трек" required>
+            <Flex gap="small">
+              <Form.Item
+                name="trackId"
+                noStyle
+                rules={[{ required: true, message: "Выберите трек" }]}
+              >
+                <CatalogSelect
+                  segment="tracks"
+                  aria-label="Трек"
+                  style={{ flex: 1, minWidth: 0 }}
+                  filters={{ ...IN_WORK, forOrgUnitId: orgUnitId }}
+                  disabled={!orgUnitId}
+                />
+              </Form.Item>
+              <Button disabled={!unit} onClick={() => setIsTrackCreating(true)}>
+                Добавить трек
+              </Button>
+            </Flex>
+          </Form.Item>
+        )}
+        {matrix?.inWorkVersion ? (
+          <CompactAlert
+            type="info"
+            lead={
+              isPosition
+                ? `У подразделения уже есть матрица на должность «${matrix.positionName}»: версия ${matrix.inWorkVersion.number} в работе.`
+                : `По этому треку уже есть версия ${matrix.inWorkVersion.number} в работе.`
+            }
+            text="Продолжим с неё."
+          />
+        ) : matrix?.publishedVersion ? (
+          <CompactAlert
+            type="info"
+            lead={
+              isPosition
+                ? `У подразделения уже есть матрица на должность «${matrix.positionName}»: версия ${matrix.publishedVersion.number} опубликована.`
+                : `У подразделения по этому треку уже есть опубликованная матрица (версия ${matrix.publishedVersion.number}).`
+            }
+            text={`Будет создана версия ${matrix.publishedVersion.number + 1} на её основе.`}
+          />
+        ) : (
+          !isPosition &&
+          track.data?.status === "Draft" && (
+            <CompactAlert
+              type="info"
+              lead={`Трек «${track.data.name}» — черновой.`}
+              text="Он опубликуется вместе с версией, если ответственный HR подразделения вправе его утвердить; иначе публикацию отклонят, а версия останется неопубликованной."
+            />
+          )
+        )}
+        {!isPosition && trackId && track.data && (
+          <LevelsTable
+            trackId={trackId}
+            trackName={track.data.name}
+            unavailable="Сохраните шаг, чтобы связать должности"
+          />
+        )}
+        {existing.error != null && (
+          <MatrixErrorAlert
+            title="Не удалось проверить существующую матрицу"
+            error={existing.error}
+          />
+        )}
+        <ActionBar>
+          {isDirty && !isSubmitting && (
+            <Button
+              type="link"
+              onClick={() => {
+                form.resetFields();
+                setIsDirty(false);
+              }}
+            >
+              Отменить правки
+            </Button>
+          )}
+          <Button
+            type="primary"
+            htmlType="submit"
+            loading={isSubmitting}
+            disabled={existing.isFetching}
+          >
+            Сохранить и далее
+          </Button>
+        </ActionBar>
+      </FormColumn>
+      {isTrackCreating && unit && (
+        <TrackModal
+          fixedOwner={unit}
+          onSaved={(created) => {
+            form.setFieldValue("trackId", created.id);
+            setIsDirty(true);
+          }}
+          onClose={() => setIsTrackCreating(false)}
+        />
+      )}
+    </Form>
+  );
+}
diff --git a/web/src/features/desk/CascadeTable.tsx b/web/src/features/desk/CascadeTable.tsx
new file mode 100644
index 0000000..a9c790f
--- /dev/null
+++ b/web/src/features/desk/CascadeTable.tsx
@@ -0,0 +1,51 @@
+import { Table, type TableColumnsType } from "antd";
+import type { PublicationEntry } from "../career/catalogApi";
+import {
+  hiddenDraftsText,
+  KIND_LABELS,
+  type PublishedDrafts,
+} from "../career/usePublishEntry";
+
+const COLUMNS: TableColumnsType<PublicationEntry> = [
+  {
+    title: "Вид",
+    dataIndex: "kind",
+    render: (kind: PublicationEntry["kind"]) => KIND_LABELS[kind],
+  },
+  {
+    title: "Название",
+    dataIndex: "name",
+    render: (name: string, entry) =>
+      entry.context ? `${name} (${entry.context})` : name,
+  },
+  { title: "Статус", key: "status", render: () => "Черновик" },
+];
+
+interface CascadeTableProps {
+  /** The draft records that become active together with the action. */
+  drafts: PublishedDrafts;
+}
+
+/**
+ * The records an action publishes with its object, one row each, always with the word for their state; the ones the
+ * user may not read only by number under the table.
+ */
+export function CascadeTable({ drafts }: CascadeTableProps) {
+  return (
+    <>
+      {drafts.entries.length > 0 && (
+        <Table<PublicationEntry>
+          size="small"
+          rowKey={(entry) => `${entry.kind}:${entry.id}`}
+          columns={COLUMNS}
+          dataSource={[...drafts.entries]}
+          pagination={false}
+          className="desk-table"
+        />
+      )}
+      {drafts.hiddenEntryCount > 0 && (
+        <p>{hiddenDraftsText(drafts.hiddenEntryCount)}</p>
+      )}
+    </>
+  );
+}
diff --git a/web/src/features/desk/CatalogCleanupPage.tsx b/web/src/features/desk/CatalogCleanupPage.tsx
new file mode 100644
index 0000000..9d7cda6
--- /dev/null
+++ b/web/src/features/desk/CatalogCleanupPage.tsx
@@ -0,0 +1,186 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { Alert, App, Button, Flex, Skeleton, Tag, Typography } from "antd";
+import { type RefObject, useState } from "react";
+import { ApiError } from "../../api/ApiError";
+import { describeApiError } from "../../app/apiErrors";
+import { NotFoundPage } from "../../app/NotFoundPage";
+import { useProcessRoles } from "../career/careerApi";
+import {
+  type CatalogKind,
+  changeCatalogStatus,
+  deleteEntry,
+  invalidateCatalogs,
+  SEGMENT_OF_KIND,
+  type UnusedEntry,
+  unusedEntriesQuery,
+} from "../career/catalogApi";
+import { KIND_LABELS } from "../career/DraftsSection";
+import { useCatalogRights } from "../career/useCatalogRights";
+import { useConfirmDeletion } from "../career/useConfirmDeletion";
+import { KIND_ACCUSATIVE } from "../career/usePublishEntry";
+import {
+  QueueLayout,
+  useQueueSelection,
+  useRecordFocus,
+  useShownCount,
+} from "./QueueLayout";
+import { LoadFailure, ScenarioPage } from "./ScenarioPage";
+
+const FIRST_COUNT = 20;
+const MORE_COUNT = 20;
+const STALE_STATUS = 412;
+
+const KIND_OPTIONS = (["Competency", "Scale", "Direction"] as const).map(
+  (kind) => ({ value: kind, label: KIND_LABELS[kind] }),
+);
+
+const REASONS: Partial<Record<CatalogKind, string>> = {
+  Competency: "Компетенция нигде не используется",
+  Scale: "Шкала нигде не используется",
+  Direction: "У области нет треков",
+};
+
+const keyOf = (entry: UnusedEntry) => `${entry.kind}:${entry.id}`;
+
+/** «Привести каталог в порядок»: entries nothing uses, each deleted or deactivated on the spot. */
+export function CatalogCleanupPage() {
+  const roles = useProcessRoles();
+  const rights = useCatalogRights();
+  const [filterKind, setFilterKind] = useState<CatalogKind>();
+  const { shown, showMore } = useShownCount(FIRST_COUNT, MORE_COUNT);
+  const list = useQuery({
+    ...unusedEntriesQuery(shown, filterKind),
+    enabled: rights.isHr,
+  });
+  const entries = list.data?.items ?? [];
+  const selection = useQueueSelection(
+    entries.map(keyOf),
+    list.data !== undefined,
+  );
+  const current = entries.find(
+    (entry) => keyOf(entry) === selection.selectedKey,
+  );
+  const headingRef = useRecordFocus(selection.selectedKey);
+
+  if (roles.isSuccess && !rights.isHr) return <NotFoundPage />;
+
+  return (
+    <ScenarioPage title="Привести каталог в порядок">
+      {list.error ? (
+        <LoadFailure
+          title="Не удалось загрузить очередь"
+          error={list.error}
+          onRetry={() => void list.refetch()}
+        />
+      ) : (
+        <QueueLayout
+          items={entries}
+          total={list.data?.total ?? 0}
+          getKey={keyOf}
+          selectedKey={selection.selectedKey}
+          onSelect={selection.select}
+          renderItem={(entry) => (
+            <Flex vertical gap={2}>
+              <Flex align="center" gap="small" wrap>
+                <Tag>{KIND_LABELS[entry.kind]}</Tag>
+                <Typography.Text strong>{entry.name}</Typography.Text>
+              </Flex>
+              <Typography.Text type="secondary">
+                {REASONS[entry.kind]}
+              </Typography.Text>
+            </Flex>
+          )}
+          filter={{
+            value: filterKind,
+            options: KIND_OPTIONS,
+            onChange: (value) => setFilterKind(value as CatalogKind),
+          }}
+          onShowMore={showMore}
+          moreCount={MORE_COUNT}
+          isLoading={list.isPending}
+          emptyText="Неиспользуемых записей каталога нет: всё, что есть, где-то используется. Если появятся, они будут на рабочем столе в группе «К сведению»."
+        >
+          {list.isPending ? (
+            <Skeleton active />
+          ) : current ? (
+            <UnusedRecord
+              key={keyOf(current)}
+              entry={current}
+              headingRef={headingRef}
+            />
+          ) : (
+            <Typography.Paragraph>
+              Записей этого вида в очереди нет.
+            </Typography.Paragraph>
+          )}
+        </QueueLayout>
+      )}
+    </ScenarioPage>
+  );
+}
+
+interface UnusedRecordProps {
+  entry: UnusedEntry;
+  headingRef: RefObject<HTMLHeadingElement | null>;
+}
+
+function UnusedRecord({ entry, headingRef }: UnusedRecordProps) {
+  const { message } = App.useApp();
+  const queryClient = useQueryClient();
+  const confirmDeletion = useConfirmDeletion();
+  const segment = SEGMENT_OF_KIND[entry.kind];
+  const deactivate = useMutation({
+    mutationFn: () => changeCatalogStatus(segment, entry, "deactivate"),
+    onSuccess: () => message.success(`Запись «${entry.name}» деактивирована`),
+    onError: (failure) =>
+      message.warning(
+        failure instanceof ApiError && failure.status === STALE_STATUS
+          ? "Запись уже используется или изменена другим пользователем"
+          : describeApiError(failure),
+      ),
+    onSettled: () => invalidateCatalogs(queryClient),
+  });
+
+  return (
+    <Flex vertical gap="middle">
+      <Typography.Title
+        level={4}
+        tabIndex={-1}
+        ref={headingRef}
+        style={{ margin: 0 }}
+      >
+        {`${KIND_LABELS[entry.kind]} ${entry.name}`}
+      </Typography.Title>
+      <Alert type="info" showIcon title={REASONS[entry.kind]} />
+      <Flex gap="small" wrap>
+        <Button
+          loading={deactivate.isPending}
+          onClick={() => deactivate.mutate()}
+        >
+          Деактивировать
+        </Button>
+        <Button
+          danger
+          disabled={deactivate.isPending}
+          onClick={() =>
+            confirmDeletion({
+              kind: KIND_ACCUSATIVE[segment],
+              name: entry.name,
+              content:
+                "Запись и её история будут удалены без возможности восстановления.",
+              run: () => deleteEntry(segment, entry),
+              onDeleted: () =>
+                message.success(`Запись «${entry.name}» удалена`),
+            })
+          }
+        >
+          Удалить
+        </Button>
+      </Flex>
+      <Typography.Text type="secondary">
+        «Деактивировать» — запись перестанет предлагаться при построении матриц;
+        «Удалить» — вместе с историей версий.
+      </Typography.Text>
+    </Flex>
+  );
+}
