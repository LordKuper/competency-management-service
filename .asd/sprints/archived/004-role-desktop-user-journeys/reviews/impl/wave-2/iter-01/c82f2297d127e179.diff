+      </section>
+      {canApprove && (
+        <ActionBar
+          start={
+            isEarly &&
+            (draft.readiness?.hasLevels ? (
+              <Link
+                to={deskPaths.trackPositionsOf(draft.id)}
+                state={returnState(back)}
+              >
+                Связать должности с треком
+              </Link>
+            ) : (
+              <Link to="/career">Править трек</Link>
+            ))
+          }
+        >
+          {isEarly && (
+            <Typography.Text type="secondary">
+              {draft.readiness?.hasLevels
+                ? "Утвердить недоступно: свяжите должности с уровнями трека."
+                : "Утвердить недоступно: добавьте уровни трека."}
+            </Typography.Text>
+          )}
+          <Button disabled={isBusy} onClick={() => setIsEditing(true)}>
+            Поправить и утвердить
+          </Button>
+          <Button
+            type="primary"
+            loading={isBusy}
+            disabled={!preview.data || isEarly || isBusy}
+            onClick={() =>
+              preview.data && void approveShown(target, preview.data)
+            }
+          >
+            {label}
+          </Button>
+        </ActionBar>
+      )}
+      {isEditing && (
+        <EditDraftModal
+          draft={draft}
+          onSaved={(saved) =>
+            void publish({ segment, entry: saved }, "approve")
+          }
+          onClose={() => setIsEditing(false)}
+        />
+      )}
+    </Flex>
+  );
+}
diff --git a/web/src/features/desk/EditDraftModal.tsx b/web/src/features/desk/EditDraftModal.tsx
new file mode 100644
index 0000000..dd53c6c
--- /dev/null
+++ b/web/src/features/desk/EditDraftModal.tsx
@@ -0,0 +1,127 @@
+import { useQuery } from "@tanstack/react-query";
+import { BlockModal } from "../career/BlockModal";
+import { CatalogModal } from "../career/CatalogModal";
+import { CompetencyModal } from "../career/CompetencyModal";
+import {
+  blockQuery,
+  type CatalogDraft,
+  competencyQuery,
+  entryQuery,
+  SEGMENT_OF_KIND,
+  scaleQuery,
+  trackQuery,
+} from "../career/catalogApi";
+import { NameModal } from "../career/NameModal";
+import { ScaleModal } from "../career/ScaleModal";
+import { TrackModal } from "../career/TrackModal";
+
+/** The entry as a save left it, which the draft is approved under. */
+export interface SavedEntry {
+  id: string;
+  version: number;
+  name: string;
+}
+
+interface EditDraftModalProps {
+  draft: CatalogDraft;
+  onSaved: (saved: SavedEntry) => void;
+  onClose: () => void;
+}
+
+function ReadFailure({
+  error,
+  onClose,
+}: {
+  error: unknown;
+  onClose: () => void;
+}) {
+  return (
+    <CatalogModal
+      title="Не удалось загрузить запись"
+      error={error}
+      fields={[]}
+      onClose={onClose}
+    >
+      {null}
+    </CatalogModal>
+  );
+}
+
+/** The dialog that edits a draft entry, which is the entry's own dialog of the career model section. */
+export function EditDraftModal({
+  draft,
+  onSaved,
+  onClose,
+}: EditDraftModalProps) {
+  const { kind } = draft;
+  if (kind === "Competency") {
+    return <EditCompetency draft={draft} onSaved={onSaved} onClose={onClose} />;
+  }
+  if (kind === "Scale") {
+    return <EditScale draft={draft} onSaved={onSaved} onClose={onClose} />;
+  }
+  if (kind === "Track") {
+    return <EditTrack draft={draft} onSaved={onSaved} onClose={onClose} />;
+  }
+  if (kind === "Block") {
+    return <EditBlock draft={draft} onSaved={onSaved} onClose={onClose} />;
+  }
+  return <EditNamed draft={draft} onSaved={onSaved} onClose={onClose} />;
+}
+
+function EditNamed({ draft, onSaved, onClose }: EditDraftModalProps) {
+  const segment = SEGMENT_OF_KIND[draft.kind];
+  const read = useQuery(entryQuery(segment, draft.id));
+  if (read.error) return <ReadFailure error={read.error} onClose={onClose} />;
+  if (!read.data) return null;
+  return (
+    <NameModal
+      segment="directions"
+      title="Изменение области"
+      entry={read.data}
+      onSaved={onSaved}
+      onClose={onClose}
+    />
+  );
+}
+
+function EditCompetency({ draft, onSaved, onClose }: EditDraftModalProps) {
+  const read = useQuery(competencyQuery(draft.id));
+  if (read.error) return <ReadFailure error={read.error} onClose={onClose} />;
+  if (!read.data) return null;
+  return (
+    <CompetencyModal
+      competency={read.data}
+      onSaved={onSaved}
+      onClose={onClose}
+    />
+  );
+}
+
+function EditScale({ draft, onSaved, onClose }: EditDraftModalProps) {
+  const read = useQuery(scaleQuery(draft.id));
+  if (read.error) return <ReadFailure error={read.error} onClose={onClose} />;
+  if (!read.data) return null;
+  return <ScaleModal scale={read.data} onSaved={onSaved} onClose={onClose} />;
+}
+
+function EditBlock({ draft, onSaved, onClose }: EditDraftModalProps) {
+  const read = useQuery(blockQuery(draft.id));
+  if (read.error) return <ReadFailure error={read.error} onClose={onClose} />;
+  if (!read.data) return null;
+  return <BlockModal block={read.data} onSaved={onSaved} onClose={onClose} />;
+}
+
+function EditTrack({ draft, onSaved, onClose }: EditDraftModalProps) {
+  const read = useQuery(trackQuery(draft.id));
+  if (read.error) return <ReadFailure error={read.error} onClose={onClose} />;
+  if (!read.data) return null;
+  return (
+    <TrackModal
+      directionId={read.data.directionId}
+      track={read.data}
+      onSaved={onSaved}
+      onClose={onClose}
+    />
+  );
+}
diff --git a/web/src/features/desk/LinkButton.tsx b/web/src/features/desk/LinkButton.tsx
new file mode 100644
index 0000000..0cd8e7c
--- /dev/null
+++ b/web/src/features/desk/LinkButton.tsx
@@ -0,0 +1,25 @@
+import { Button, type ButtonProps } from "antd";
+import { useNavigate } from "react-router";
+
+interface LinkButtonProps extends Pick<ButtonProps, "type" | "children"> {
+  to: string;
+  /** Navigation state handed to the opened screen, such as the return link of its breadcrumb. */
+  state?: unknown;
+}
+
+/** A link that looks like a button: it is an anchor, so it opens in a new tab on request, and navigates inside the application otherwise. */
+export function LinkButton({ to, type, state, children }: LinkButtonProps) {
+  const navigate = useNavigate();
+  return (
+    <Button
+      type={type}
+      href={to}
+      onClick={(event) => {
+        event.preventDefault();
+        void navigate(to, { state });
+      }}
+    >
+      {children}
+    </Button>
+  );
+}
diff --git a/web/src/features/desk/MatrixBuilderPage.tsx b/web/src/features/desk/MatrixBuilderPage.tsx
new file mode 100644
index 0000000..03dd5b5
--- /dev/null
+++ b/web/src/features/desk/MatrixBuilderPage.tsx
@@ -0,0 +1,291 @@
+import { useQuery } from "@tanstack/react-query";
+import { Alert, Flex, Skeleton, Tag, Typography } from "antd";
+import { useState } from "react";
+import { useNavigate, useParams, useSearchParams } from "react-router";
+import {
+  type LeaveEdits,
+  NO_LEAVE_EDITS,
+  useLeaveGuard,
+} from "../../app/leaveGuard";
+import { trackQuery } from "../career/catalogApi";
+import { MatrixEditor } from "../career/MatrixEditor";
+import {
+  type Matrix,
+  type MatrixVersion,
+  matrixCompletenessQuery,
+  matrixQuery,
+  matrixVersionQuery,
+} from "../career/matrixApi";
+import { VERSION_STATUS_LABELS } from "../career/matrixLabels";
+import { BuilderCheckStep } from "./BuilderCheckStep";
+import { BuilderCompetenciesStep } from "./BuilderCompetenciesStep";
+import { BuilderSubmitStep } from "./BuilderSubmitStep";
+import { type Basis, BuilderTrackStep } from "./BuilderTrackStep";
+import type { StepProps } from "./builderStep";
+import { BUILDER_STEPS, builderSteps, deskPaths } from "./deskTexts";
+import { ContextLine } from "./ScenarioContext";
+import { LoadFailure, ScenarioPage } from "./ScenarioPage";
+import { StepRuler } from "./StepRuler";
+import { PROBLEM_STEP } from "./scenarioTexts";
+
+const FIRST_STEP = 1;
+const COMPETENCIES_STEP = 2;
+const LAST_STEP = BUILDER_STEPS.length;
+
+/** «Построить матрицу компетенций»: six steps from the track to the sending, each saved as the draft of a version. */
+export function MatrixBuilderPage() {
+  const { versionId } = useParams();
+  const [params] = useSearchParams();
+  const matrixId = params.get("matrixId") ?? undefined;
+  const read = useQuery({
+    ...matrixVersionQuery(versionId ?? ""),
+    enabled: versionId !== undefined,
+  });
+  const startedFrom = useQuery({
+    ...matrixQuery(matrixId ?? ""),
+    enabled: versionId === undefined && matrixId !== undefined,
+  });
+  return (
+    <ScenarioPage title="Построить матрицу компетенций">
+      {startedFrom.error ? (
+        <LoadFailure
+          title="Не удалось загрузить матрицу"
+          error={startedFrom.error}
+          onRetry={() => void startedFrom.refetch()}
+        />
+      ) : matrixId !== undefined &&
+        versionId === undefined &&
+        !startedFrom.data ? (
+        <Skeleton active />
+      ) : read.error ? (
+        <LoadFailure
+          title="Не удалось загрузить версию"
+          error={read.error}
+          onRetry={() => void read.refetch()}
+        />
+      ) : versionId !== undefined && !read.data ? (
+        <Skeleton active />
+      ) : (
+        <BuilderShell
+          key={read.data?.id}
+          version={read.data}
+          startedFrom={startedFrom.data}
+        />
+      )}
+    </ScenarioPage>
+  );
+}
+
+/** The step a version opens on: the one asked for by the address, else where the author stopped. */
+function openingStep(
+  version: MatrixVersion | undefined,
+  requested: string | null,
+) {
+  if (!version) return FIRST_STEP;
+  const asked = Number(requested);
+  if (Number.isInteger(asked) && asked > FIRST_STEP && asked <= LAST_STEP) {
+    return asked;
+  }
+  return version.builderStep ?? COMPETENCIES_STEP;
+}
+
+interface BuilderShellProps {
+  version: MatrixVersion | undefined;
+  /** The matrix a new version is started for, when the desk sent the user here from it. */
+  startedFrom?: Matrix;
+}
+
+function BuilderShell({ version, startedFrom }: BuilderShellProps) {
+  const navigate = useNavigate();
+  const [params] = useSearchParams();
+  const requested = params.get("step");
+  const opening = openingStep(version, requested);
+  const [step, setStep] = useState(opening);
+  const [reached, setReached] = useState(
+    Math.max(opening, version?.builderStep ?? COMPETENCIES_STEP),
+  );
+  const [edits, setEdits] = useState(NO_LEAVE_EDITS);
+  const { confirmLeave, leaveAfterSave } = useLeaveGuard(edits);
+  const preselected = {
+    unitId: params.get("unitId") ?? startedFrom?.orgUnitId ?? undefined,
+    trackId: params.get("trackId") ?? startedFrom?.trackId ?? undefined,
+    positionId:
+      params.get("positionId") ?? startedFrom?.positionId ?? undefined,
+    positionName: startedFrom?.positionName ?? undefined,
+  };
+  const [chosenBasis, setBasis] = useState<Basis>(
+    preselected.positionId ? "position" : "track",
+  );
+  const basis: Basis = version
+    ? version.entries.position
+      ? "position"
+      : "track"
+    : chosenBasis;
+  const matrix = useQuery({
+    ...matrixQuery(version?.matrixId ?? ""),
+    enabled: version !== undefined,
+  });
+  const track = useQuery({
+    ...trackQuery(version?.entries.track?.id ?? ""),
+    enabled: !!version?.entries.track,
+  });
+  const completeness = useQuery({
+    ...matrixCompletenessQuery(version?.id ?? ""),
+    enabled: version !== undefined && reached >= LAST_STEP - 1,
+  });
+
+  const remarksByStep = new Map<number, number>();
+  for (const problem of completeness.data?.problems ?? []) {
+    const problemStep = PROBLEM_STEP[problem.code];
+    if (problemStep !== null) {
+      remarksByStep.set(problemStep, (remarksByStep.get(problemStep) ?? 0) + 1);
+    }
+  }
+
+  function goTo(next: number) {
+    setEdits(NO_LEAVE_EDITS);
+    setStep(next);
+    setReached((previous) => Math.max(previous, next));
+  }
+
+  const isEditable = version?.actions.includes("Edit") === true;
+  const stepProps: StepProps | undefined = version && {
+    version,
+    step,
+    onBack: () => goTo(step - 1),
+    onSkip: () => goTo(step + 1),
+    onSaved: (then) =>
+      then === "next"
+        ? goTo(step + 1)
+        : leaveAfterSave(() => void navigate(deskPaths.desk)),
+    onEditsChange: setEdits,
+  };
+
+  return (
+    <Flex vertical gap="middle">
+      {version && (
+        <ContextLine>
+          <Typography.Text>
+            {[
+              matrix.data?.orgUnitName,
+              version.entries.position
+                ? `должность «${version.entries.position.name}»`
+                : `трек «${version.entries.track?.name}»`,
+            ]
+              .filter(Boolean)
+              .join(" · ")}
+          </Typography.Text>
+          {track.data?.status === "Draft" && <Tag>Трек черновой</Tag>}
+          <Tag>{`Версия ${version.number}`}</Tag>
+          <Tag>{VERSION_STATUS_LABELS[version.status]}</Tag>
+        </ContextLine>
+      )}
+      <StepRuler
+        steps={builderSteps(basis === "position")}
+        current={step}
+        reached={version ? reached : FIRST_STEP}
+        isLocked={edits.isSaving}
+        remarks={remarksByStep}
+        onChange={(next) => confirmLeave(() => goTo(next))}
+      />
+      {version && !isEditable ? (
+        <Alert
+          type="info"
+          showIcon
+          title={
+            version.status === "Draft"
+              ? `Версия сейчас не ваша: править её может ${version.authorName}`
+              : `Версия уже не черновик: сейчас она «${VERSION_STATUS_LABELS[version.status]}»`
+          }
+        />
+      ) : (
+        version &&
+        version.builderStep !== null &&
+        version.builderStep !== undefined &&
+        version.builderStep > COMPETENCIES_STEP &&
+        !requested &&
+        step === version.builderStep && (
+          <Alert
+            type="info"
+            showIcon
+            title={`Продолжаем с шага ${step} «${builderSteps(basis === "position")[step - 1]}», где вы остановились. Шаги до него сохранены.`}
+          />
+        )
+      )}
+      <StepBody
+        step={step}
+        version={version}
+        stepProps={stepProps}
+        preselected={preselected}
+        basis={basis}
+        onBasisChange={setBasis}
+        onGoToStep={goTo}
+        onEditsChange={setEdits}
+      />
+    </Flex>
+  );
+}
+
+interface StepBodyProps {
+  step: number;
+  version: MatrixVersion | undefined;
+  stepProps: StepProps | undefined;
+  preselected: {
+    unitId?: string;
+    trackId?: string;
+    positionId?: string;
+    positionName?: string;
+  };
+  basis: Basis;
+  onBasisChange: (basis: Basis) => void;
+  onGoToStep: (step: number) => void;
+  onEditsChange: (edits: LeaveEdits) => void;
+}
+
+function StepBody({
+  step,
+  version,
+  stepProps,
+  preselected,
+  basis,
+  onBasisChange,
+  onGoToStep,
+  onEditsChange,
+}: StepBodyProps) {
+  if (step === FIRST_STEP || !version || !stepProps) {
+    return (
+      <BuilderTrackStep
+        version={version}
+        preselected={preselected}
+        basis={basis}
+        onBasisChange={onBasisChange}
+        onNext={() => onGoToStep(COMPETENCIES_STEP)}
+        onEditsChange={onEditsChange}
+      />
+    );
+  }
+  switch (step) {
+    case 2:
+      return <BuilderCompetenciesStep {...stepProps} />;
+    case 3:
+    case 4:
+      return (
+        <MatrixEditor
+          key={step}
+          version={version}
+          onEditsChange={onEditsChange}
+          builder={{
+            part: step === 3 ? "requirements" : "formula",
+            step,
+            onBack: stepProps.onBack,
+            onSaved: stepProps.onSaved,
+            onSkip: stepProps.onSkip,
+          }}
+        />
+      );
+    case 5:
+      return <BuilderCheckStep {...stepProps} onGoToStep={onGoToStep} />;
+    default:
+      return <BuilderSubmitStep version={version} onBack={stepProps.onBack} />;
+  }
+}
diff --git a/web/src/features/desk/MyPlacePage.tsx b/web/src/features/desk/MyPlacePage.tsx
new file mode 100644
index 0000000..62cbb9c
--- /dev/null
+++ b/web/src/features/desk/MyPlacePage.tsx
@@ -0,0 +1,442 @@
+import { useQuery } from "@tanstack/react-query";
+import {
+  Alert,
+  theme as antdTheme,
+  Button,
+  Card,
+  Col,
+  Descriptions,
+  Empty,
+  Flex,
+  Row,
+  Skeleton,
+  Table,
+  type TableColumnsType,
+  Tag,
+  Typography,
+} from "antd";
+import { useState } from "react";
+import { Link } from "react-router";
+import { COMPETENCY_TYPES } from "../career/competencyType";
+import { matrixVersionQuery } from "../career/matrixApi";
+import { chipLevel } from "../career/matrixContent";
+import {
+  OUTSIDE_LABEL,
+  scaleOfCompetency,
+  sharedBlockOf,
+} from "../career/matrixGroups";
+import "../career/matrix.css";
+import { type MyPlace, myPlaceQuery } from "./deskApi";
+import { deskPaths, formatDate } from "./deskTexts";
+import { LinkButton } from "./LinkButton";
+import { CompactAlert } from "./ScenarioContext";
+import { LoadFailure, ScenarioPage } from "./ScenarioPage";
+
+type TrackView = MyPlace["tracks"][number];
+type LevelView = TrackView["nextLevels"][number];
+type Requirement = NonNullable<LevelView["requirements"]>[number];
+type MatrixView = MyPlace["publishedMatrices"][number];
+type PositionMatrix = NonNullable<MyPlace["positionMatrix"]>;
+type PositionRequirement = PositionMatrix["requirements"][number];
+
+const matrixPath = (matrixId: string) => `/career/matrices/${matrixId}`;
+
+/** «Моё место в компании»: the unit, position, head and HR, the tracks of the position and what the levels above ask. */
+export function MyPlacePage() {
+  const place = useQuery(myPlaceQuery);
+  return (
+    <ScenarioPage title="Моё место в компании">
+      {place.error ? (
+        <LoadFailure
+          title="Не удалось загрузить данные о вашем месте в компании"
+          error={place.error}
+          onRetry={() => void place.refetch()}
+        />
+      ) : !place.data ? (
+        <Skeleton active />
+      ) : (
+        <PlaceContent place={place.data} />
+      )}
+    </ScenarioPage>
+  );
+}
+
+function PlaceContent({ place }: { place: MyPlace }) {
+  const { token } = antdTheme.useToken();
+  if (!place.employee) {
+    return (
+      <Empty
+        description={
+          <>
+            <Typography.Title level={4}>
+              Нет данных о вашем месте в компании
+            </Typography.Title>
+            <Typography.Paragraph>
+              Ваша учётная запись не привязана к карточке сотрудника, поэтому
+              подразделение, должность и треки показать нельзя. Обратитесь к
+              администратору, чтобы вас привязали.
+            </Typography.Paragraph>
+          </>
+        }
+      >
+        <LinkButton to={deskPaths.desk} type="primary">
+          К рабочему столу
+        </LinkButton>
+      </Empty>
+    );
+  }
+  const unitName = place.unit.at(-1)?.name ?? "";
+  const hr = place.responsibleHr;
+  return (
+    <Flex vertical gap="middle">
+      <section>
+        <Typography.Title level={4}>Подразделение и должность</Typography.Title>
+        <Row gutter={[token.margin, 0]}>
+          <Col xs={24} lg={12}>
+            <Descriptions
+              column={1}
+              size="small"
+              items={[
+                {
+                  key: "unit",
+                  label: "Подразделение",
+                  children: place.unit.map((part) => part.name).join(" → "),
+                },
+                {
+                  key: "position",
+                  label: "Должность",
+                  children: place.position?.name ?? "—",
+                },
+              ]}
+            />
+          </Col>
+          <Col xs={24} lg={12}>
+            <Descriptions
+              column={1}
+              size="small"
+              items={[
+                {
+                  key: "head",
+                  label: "Руководитель",
+                  children: place.head?.fullName ?? "Не назначен",
+                },
+                {
+                  key: "hr",
+                  label: "Ответственный HR",
+                  children: hr
+                    ? `${hr.name} · ${hr.orgUnitName === unitName ? "закрепление за вашим подразделением" : `унаследовано из «${hr.orgUnitName}»`}`
+                    : "Не назначен",
+                },
+              ]}
+            />
+          </Col>
+        </Row>
+      </section>
+      {place.positionMatrix ? (
+        <PositionMatrixPanel
+          matrix={place.positionMatrix}
+          unitName={unitName}
+        />
+      ) : (
+        <Flex vertical gap="middle">
+          <Typography.Title level={4} style={{ margin: 0 }}>
+            Мои карьерные треки
+          </Typography.Title>
+          {place.noTrack ? (
+            <CompactAlert
+              type="info"
+              lead="Для вашей должности нет карьерного трека."
+              text={`Должность «${place.position?.name ?? ""}» не связана ни с одним уровнем действующего трека, поэтому уровень не определён.${place.head ? ` Обратитесь к руководителю: ${place.head.fullName}.` : ""}`}
+            />
+          ) : (
+            place.tracks.map((track) => (
+              <TrackPanel
+                key={track.track.id}
+                track={track}
+                positionName={place.position?.name ?? ""}
+                unitName={unitName}
+              />
+            ))
+          )}
+        </Flex>
+      )}
+      <PublishedMatrices
+        matrices={place.publishedMatrices}
+        unitName={unitName}
+      />
+    </Flex>
+  );
+}
+
+/** The requirements of the published position matrix of the user's unit for their position, as one column of scores. */
+function PositionMatrixPanel({
+  matrix,
+  unitName,
+}: {
+  matrix: PositionMatrix;
+  unitName: string;
+}) {
+  const version = useQuery(matrixVersionQuery(matrix.versionId));
+  const blockOf = (competencyId: string) => {
+    const shared = version.data && sharedBlockOf(version.data, competencyId);
+    if (shared) return `Общий блок «${shared.name}»`;
+    return version.data ? OUTSIDE_LABEL : undefined;
+  };
+  const examplesOf = (competencyId: string) =>
+    version.data?.entries.competencies.find((item) => item.id === competencyId)
+      ?.evidenceExamples;
+  const columns: TableColumnsType<PositionRequirement> = [
+    {
+      title: "Компетенция",
+      key: "name",
+      render: (_, item) => (
+        <Flex vertical>
+          {item.competencyName}
+          {examplesOf(item.competencyId) && (
+            <Typography.Text type="secondary">
+              {`Примеры подтверждений: ${examplesOf(item.competencyId)}`}
+            </Typography.Text>
+          )}
+        </Flex>
+      ),
+    },
+    {
+      title: "Требуемый балл",
+      key: "score",
+      render: (_, item) => {
+        if (item.requiredScore === null) return "—";
+        const scale =
+          version.data && scaleOfCompetency(version.data, item.competencyId);
+        return (
+          <Flex align="center" gap="small" wrap>
+            <span
+              className={`rating-chip rating-chip--${scale ? chipLevel(item.requiredScore, scale.points) : 0}`}
+            >
+              {item.requiredScore}
+            </span>
+            {[item.scoreLabel, scale && `шкала ${scale.name}`]
+              .filter(Boolean)
+              .join(" · ")}
+          </Flex>
+        );
+      },
+    },
+    {
+      title: "Тип в матрице",
+      key: "type",
+      render: (_, item) => COMPETENCY_TYPES[item.type],
+    },
+    {
+      title: "Блок",
+      key: "block",
+      render: (_, item) => blockOf(item.competencyId),
+    },
+  ];
+  return (
+    <Flex vertical gap="middle">
+      <Typography.Title level={4} style={{ margin: 0 }}>
+        Требования моей должности
+      </Typography.Title>
+      <Card
+        size="small"
+        title={
+          <Flex align="center" gap="small" wrap>
+            <span>{matrix.positionName}</span>
+            <Tag>Матрица должности</Tag>
+          </Flex>
+        }
+      >
+        <Flex vertical gap="small">
+          <Typography.Text>
+            {`Требования взяты из опубликованной матрицы должности подразделения «${unitName}», версия ${matrix.number}. `}
+            <Link to={matrixPath(matrix.matrixId)}>Смотреть матрицу</Link>
+          </Typography.Text>
+          <Table
+            size="small"
+            rowKey="competencyId"
+            pagination={false}
+            columns={columns}
+            dataSource={[...matrix.requirements]}
+          />
+        </Flex>
+      </Card>
+    </Flex>
+  );
+}
+
+function TrackPanel({
+  track,
+  positionName,
+  unitName,
+}: {
+  track: TrackView;
+  positionName: string;
+  unitName: string;
+}) {
+  const [expanded, setExpanded] = useState<string[]>([]);
+  const toggle = (id: string) =>
+    setExpanded((keys) =>
+      keys.includes(id) ? keys.filter((key) => key !== id) : [...keys, id],
+    );
+  const columns: TableColumnsType<LevelView> = [
+    { title: "Следующий уровень", dataIndex: "name" },
+    {
+      title: "Требования",
+      key: "requirements",
+      render: (_, level) =>
+        level.requirements
+          ? `Компетенций: ${level.requirements.length} · критических: ${level.requirements.filter((item) => item.type === "Critical").length}`
+          : "Нет данных",
+    },
+    {
+      title: "Действия",
+      key: "actions",
+      render: (_, level) =>
+        level.requirements && (
+          <Button
+            type="link"
+            size="small"
+            aria-expanded={expanded.includes(level.id)}
+            onClick={() => toggle(level.id)}
+          >
+            {expanded.includes(level.id)
+              ? "Скрыть требования"
+              : "Показать требования"}
+          </Button>
+        ),
+    },
+  ];
+  return (
+    <Card
+      size="small"
+      title={
+        <Flex align="center" gap="small" wrap>
+          <span>{track.track.name}</span>
+          <Tag>{`Область: ${track.direction.name}`}</Tag>
+        </Flex>
+      }
+    >
+      <Flex vertical gap="small">
+        <Flex align="center" gap="small" wrap>
+          <Typography.Text strong>Мой уровень:</Typography.Text>
+          <Tag color="processing">{track.currentLevel.name}</Tag>
+          <Typography.Text type="secondary">
+            {`определён по вашей должности «${positionName}»`}
+          </Typography.Text>
+        </Flex>
+        {track.matrix ? (
+          <Typography.Text>
+            {`Требования взяты из опубликованной матрицы подразделения «${unitName}», версия ${track.matrix.number}. `}
+            <Link to={matrixPath(track.matrix.matrixId)}>Смотреть матрицу</Link>
+          </Typography.Text>
+        ) : (
+          <Alert
+            type="info"
+            showIcon
+            title="Для вашего подразделения нет опубликованной матрицы по этому треку: следующие уровни показаны без требований."
+          />
+        )}
+        {track.nextLevels.length === 0 ? (
+          <Typography.Text type="secondary">
+            Это высший уровень трека: следующих уровней нет.
+          </Typography.Text>
+        ) : (
+          <Table
+            size="small"
+            rowKey="id"
+            pagination={false}
+            columns={columns}
+            dataSource={track.nextLevels}
+            expandable={{
+              showExpandColumn: false,
+              expandedRowKeys: expanded,
+              expandedRowRender: (level) => (
+                <RequirementsTable requirements={level.requirements ?? []} />
+              ),
+            }}
+          />
+        )}
+      </Flex>
+    </Card>
+  );
+}
+
+function RequirementsTable({
+  requirements,
+}: {
+  requirements: readonly Requirement[];
+}) {
+  return (
+    <Table
+      size="small"
+      rowKey="competencyId"
+      pagination={false}
+      dataSource={[...requirements]}
+      columns={[
+        { title: "Компетенция", dataIndex: "competencyName" },
+        {
+          title: "Требуемый уровень",
+          key: "score",
+          render: (_, item: Requirement) =>
+            item.requiredScore === null
+              ? "—"
+              : [item.requiredScore, item.scoreLabel].filter(Boolean).join(" "),
+        },
+        {
+          title: "Тип в матрице",
+          key: "type",
+          render: (_, item: Requirement) => COMPETENCY_TYPES[item.type],
+        },
+      ]}
+    />
+  );
+}
+
+function PublishedMatrices({
+  matrices,
+  unitName,
+}: {
+  matrices: readonly MatrixView[];
+  unitName: string;
+}) {
+  return (
+    <Flex vertical gap="middle">
+      <Typography.Title level={4} style={{ margin: 0 }}>
+        Опубликованные матрицы моего подразделения
+      </Typography.Title>
+      {matrices.length === 0 ? (
+        <CompactAlert
+          type="info"
+          lead="Опубликованных матриц пока нет."
+          text={`Для подразделения «${unitName}» ещё не опубликована ни одна матрица, поэтому требований к уровням нет. Матрицу готовит руководитель подразделения, публикует её ответственный HR при согласовании.`}
+        />
+      ) : (
+        <Table
+          size="small"
+          rowKey="matrixId"
+          pagination={false}
+          dataSource={[...matrices]}
+          columns={[
+            { title: "Трек", dataIndex: "trackName" },
+            { title: "Версия", dataIndex: "number" },
+            {
+              title: "Опубликована",
+              key: "publishedAt",
+              render: (_, matrix: MatrixView) =>
+                matrix.publishedAt ? formatDate(matrix.publishedAt) : "—",
+            },
+            {
+              title: "Действия",
+              key: "actions",
+              render: (_, matrix: MatrixView) => (
+                <Link to={matrixPath(matrix.matrixId)}>
+                  Смотреть требования
+                </Link>
+              ),
+            },
+          ]}
+        />
+      )}
+    </Flex>
+  );
+}
diff --git a/web/src/features/desk/OnboardEmployeePage.tsx b/web/src/features/desk/OnboardEmployeePage.tsx
new file mode 100644
index 0000000..0821991
--- /dev/null
+++ b/web/src/features/desk/OnboardEmployeePage.tsx
@@ -0,0 +1,455 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { Button, Skeleton, Table, Tag } from "antd";
+import { type ReactNode, useEffect, useRef, useState } from "react";
+import { useNavigate, useSearchParams } from "react-router";
+import { api } from "../../api/client";
+import { ifMatchOf } from "../../api/ifMatch";
+import { unwrap } from "../../api/unwrap";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import {
+  type LeaveEdits,
+  NO_LEAVE_EDITS,
+  useLeaveGuard,
+} from "../../app/leaveGuard";
+import { EmployeeForm } from "../org-structure/EmployeeForm";
+import {
+  type Employee,
+  type EmployeeInput,
+  invalidateOrgStructure,
+  orgUnitTreeQuery,
+} from "../org-structure/orgStructureApi";
+import {
+  invalidatePositions,
+  positionQuery,
+  unitPositionsQuery,
+} from "../positions/positionsApi";
+import type { UserResponse } from "../users/usersApi";
+import { CreateAccountForm } from "./CreateAccountForm";
+import { deskPaths } from "./deskTexts";
+import { LinkButton } from "./LinkButton";
+import { useReturnLink } from "./returnLink";
+import { ActionBar, CompactAlert, FormColumn } from "./ScenarioContext";
+import { ScenarioPage } from "./ScenarioPage";
+import { StepRuler } from "./StepRuler";
+
+interface AddedPosition {
+  id: string;
+  name: string;
+}
+
+/** The unit and position a finding of the organisation queue opens the scenario with; only still-active ones are kept. */
+interface Selection {
+  unitId?: string;
+  position?: AddedPosition;
+}
+
+/** Reads the requested unit and position from the address and keeps what is still active; a refused or unreadable one is dropped silently. */
+function useSelection(): Selection & { isPending: boolean } {
+  const [searchParams] = useSearchParams();
+  const requestedUnit = searchParams.get("unitId") ?? undefined;
+  const requestedPosition = searchParams.get("positionId") ?? undefined;
+  const tree = useQuery({
+    ...orgUnitTreeQuery,
+    enabled: requestedUnit !== undefined,
+  });
+  const position = useQuery({
+    ...positionQuery(requestedPosition ?? ""),
+    enabled: requestedPosition !== undefined,
+  });
+  const isUnitActive = tree.data?.some(
+    (unit) => unit.id === requestedUnit && unit.isActive,
+  );
+  return {
+    isPending: tree.isLoading || position.isLoading,
+    unitId: isUnitActive ? requestedUnit : undefined,
+    position: position.data?.isActive
+      ? { id: position.data.id, name: position.data.name }
+      : undefined,
+  };
+}
+
+/** What the scenario has done so far: the employee, the position added for them, and the account (null when skipped). */
+interface Outcome {
+  employee: Employee;
+  position?: AddedPosition;
+  account?: UserResponse | null;
+}
+
+const STEPS = ["Сотрудник", "Учётная запись", "Итог"] as const;
+const EMPLOYEE_STEP = 1;
+const ACCOUNT_STEP = 2;
+const SUMMARY_STEP = 3;
+
+/** «Принять сотрудника»: the employee card, then an account with an invitation if wanted, then what was created. */
+export function OnboardEmployeePage() {
+  const requested = useSelection();
+  const [outcome, setOutcome] = useState<Outcome>();
+  const [step, setStep] = useState(EMPLOYEE_STEP);
+  const [round, setRound] = useState(0);
+  const [edits, setEdits] = useState(NO_LEAVE_EDITS);
+  const { confirmLeave, leaveAfterSave } = useLeaveGuard(edits);
+  const navigate = useNavigate();
+  const origin = useReturnLink();
+  const selection: Selection = round === 0 ? requested : {};
+  const reached = outcome?.account === undefined ? EMPLOYEE_STEP : SUMMARY_STEP;
+
+  function goTo(next: number) {
+    setEdits(NO_LEAVE_EDITS);
+    setStep(next);
+  }
+
+  return (
+    <ScenarioPage title="Принять сотрудника">
+      <StepRuler
+        steps={STEPS}
+        current={step}
+        reached={reached}
+        isLocked={edits.isSaving}
+        onChange={(next) => confirmLeave(() => goTo(next))}
+      />
+      {step === EMPLOYEE_STEP && requested.isPending && <Skeleton active />}
+      {step === EMPLOYEE_STEP && !requested.isPending && (
+        <EmployeeStep
+          key={round}
+          selection={selection}
+          outcome={outcome}
+          onSaved={(saved) => {
+            setOutcome(saved);
+            goTo(ACCOUNT_STEP);
+          }}
+          onEditsChange={setEdits}
+          onCancel={() =>
+            leaveAfterSave(() => void navigate(origin?.to ?? deskPaths.desk))
+          }
+        />
+      )}
+      {step === ACCOUNT_STEP && outcome && (
+        <AccountStep
+          outcome={outcome}
+          onDone={(done) => {
+            setOutcome(done);
+            goTo(SUMMARY_STEP);
+          }}
+          onBack={() => goTo(EMPLOYEE_STEP)}
+          onEditsChange={setEdits}
+        />
+      )}
+      {step === SUMMARY_STEP && outcome && (
+        <SummaryStep
+          outcome={outcome}
+          onBack={() => goTo(ACCOUNT_STEP)}
+          onAnother={() => {
+            setOutcome(undefined);
+            setRound((count) => count + 1);
+            goTo(EMPLOYEE_STEP);
+          }}
+        />
+      )}
+    </ScenarioPage>
+  );
+}
+
+function selectionHints({ unitId, position }: Selection) {
+  if (!unitId && !position) return undefined;
+  return {
+    orgUnit: unitId ? "Выбрано из находки; можно выбрать другое." : undefined,
+    position: position
+      ? "Выбрана из находки; можно выбрать другую. Если её нет в перечне подразделения, она будет добавлена в него."
+      : "Нужной должности нет в перечне подразделения — добавьте её в списке.",
+  };
+}
+
+function isChanged(employee: Employee, input: EmployeeInput): boolean {
+  return (
+    employee.lastName !== input.lastName ||
+    employee.firstName !== input.firstName ||
+    (employee.middleName ?? "") !== (input.middleName ?? "") ||
+    employee.orgUnitId !== input.orgUnitId ||
+    employee.positionId !== input.positionId
+  );
+}
+
+interface EmployeeStepProps {
+  selection: Selection;
+  /** The employee already created; the step then shows their saved values and saves a change to the same card. */
+  outcome?: Outcome;
+  onSaved: (outcome: Outcome) => void;
+  onEditsChange: (edits: LeaveEdits) => void;
+  /** Explicit discard: leaves the scenario without asking. */
+  onCancel: () => void;
+}
+
+function EmployeeStep({
+  selection,
+  outcome,
+  onSaved,
+  onEditsChange,
+  onCancel,
+}: EmployeeStepProps) {
+  const queryClient = useQueryClient();
+  const added = useRef<AddedPosition>(undefined);
+  const [isDirty, setIsDirty] = useState(false);
+  const save = useMutation({
+    mutationFn: async (input: EmployeeInput) => {
+      const { position } = selection;
+      if (position?.id === input.positionId) {
+        await allowInUnit(position, input.orgUnitId);
+      }
+      if (!outcome) {
+        return unwrap(await api.POST("/api/v1/employees", { body: input }));
+      }
+      const { employee } = outcome;
+      if (!isChanged(employee, input)) return employee;
+      return unwrap(
+        await api.PUT("/api/v1/employees/{id}", {
+          params: {
+            path: { id: employee.id },
+            header: { "If-Match": ifMatchOf(employee.version ?? 0) },
+          },
+          body: input,
+        }),
+      );
+    },
+    onSettled: () =>
+      Promise.all([
+        invalidateOrgStructure(queryClient),
+        invalidatePositions(queryClient),
+      ]),
+  });
+  async function allowInUnit(position: AddedPosition, orgUnitId: string) {
+    const allowed = await queryClient.fetchQuery({
+      ...unitPositionsQuery(orgUnitId),
+      staleTime: 0,
+    });
+    if (allowed.some((entry) => entry.positionId === position.id)) return;
+    unwrap(
+      await api.POST("/api/v1/org-units/{id}/positions", {
+        params: { path: { id: orgUnitId } },
+        body: { positionId: position.id },
+      }),
+    );
+    added.current = position;
+  }
+  const isSaving = save.isPending;
+  useEffect(
+    () => onEditsChange({ isUnsaved: isDirty, isSaving }),
+    [isDirty, isSaving, onEditsChange],
+  );
+
+  const employee = outcome?.employee;
+  const positionOf = (positionId: string) =>
+    added.current?.id === positionId
+      ? added.current
+      : outcome?.position?.id === positionId
+        ? outcome.position
+        : undefined;
+
+  return (
+    <FormColumn>
+      {employee && (
+        <CompactAlert
+          type="info"
+          lead="Сотрудник уже создан:"
+          text="«Сохранить и далее» обновит его карточку, второго сотрудника не будет."
+        />
+      )}
+      {save.isError && (
+        <ErrorAlert
+          title={
+            employee
+              ? "Карточка сотрудника не обновлена"
+              : "Сотрудник не создан"
+          }
+          error={save.error}
+        />
+      )}
+      <EmployeeForm
+        initialValues={
+          employee
+            ? {
+                lastName: employee.lastName,
+                firstName: employee.firstName,
+                middleName: employee.middleName ?? undefined,
+                orgUnitId: employee.orgUnitId,
+                positionId: employee.positionId,
+              }
+            : {
+                orgUnitId: selection.unitId,
+                positionId: selection.position?.id,
+              }
+        }
+        preselectedPosition={selection.position}
+        hints={selectionHints(selection)}
+        position={
+          employee && { id: employee.positionId, name: employee.position }
+        }
+        onDirtyChange={setIsDirty}
+        onCancel={onCancel}
+        onPositionAdded={(position) => {
+          added.current = position;
+        }}
+        submitLabel={
+          employee ? "Сохранить и далее" : "Создать сотрудника и продолжить"
+        }
+        onSubmit={async (input) => {
+          const saved = await save.mutateAsync(input);
+          onSaved({
+            employee: saved,
+            position: positionOf(input.positionId),
+            account: outcome?.account,
+          });
+        }}
+      />
+    </FormColumn>
+  );
+}
+
+interface AccountStepProps {
+  outcome: Outcome;
+  onDone: (outcome: Outcome) => void;
+  onBack: () => void;
+  onEditsChange: (edits: LeaveEdits) => void;
+}
+
+function AccountStep({
+  outcome,
+  onDone,
+  onBack,
+  onEditsChange,
+}: AccountStepProps) {
+  const { employee, account } = outcome;
+  const [isDirty, setIsDirty] = useState(false);
+  const { confirmLeave } = useLeaveGuard();
+  useEffect(
+    () => onEditsChange({ isUnsaved: isDirty }),
+    [isDirty, onEditsChange],
+  );
+
+  return (
+    <FormColumn>
+      <CompactAlert
+        type="success"
+        lead="Сотрудник создан:"
+        text={`${employee.fullName}, ${employee.orgUnitName}, ${employee.position}.`}
+      />
+      {account ? (
+        <>
+          <ResultTable rows={accountRows(account)} />
+          <ActionBar start={<Button onClick={onBack}>Назад</Button>}>
+            <Button
+              type="primary"
+              onClick={() => onDone({ ...outcome, account })}
+            >
+              Далее
+            </Button>
+          </ActionBar>
+        </>
+      ) : (
+        <CreateAccountForm
+          employeeId={employee.id}
+          submitLabel="Создать учётную запись и отправить приглашение"
+          onDirtyChange={setIsDirty}
+          onCreated={(created) => onDone({ ...outcome, account: created })}
+          scenarioActions={{
+            start: <Button onClick={() => confirmLeave(onBack)}>Назад</Button>,
+            end: (
+              <Button
+                onClick={() =>
+                  confirmLeave(() => onDone({ ...outcome, account: null }))
+                }
+              >
+                Пропустить
+              </Button>
+            ),
+          }}
+        />
+      )}
+    </FormColumn>
+  );
+}
+
+interface ResultRow {
+  key: string;
+  tag: ReactNode;
+  text: string;
+}
+
+function ResultTable({ rows }: { rows: ResultRow[] }) {
+  return (
+    <Table
+      size="small"
+      pagination={false}
+      showHeader={false}
+      rowKey="key"
+      dataSource={rows}
+      columns={[{ dataIndex: "tag", width: 160 }, { dataIndex: "text" }]}
+    />
+  );
+}
+
+function accountRows(account: UserResponse): ResultRow[] {
+  return [
+    {
+      key: "account",
+      tag: <Tag color="success">Создана</Tag>,
+      text: `Учётная запись: ${account.email}`,
+    },
+    account.mailSent === false
+      ? {
+          key: "mail",
+          tag: <Tag color="warning">Не отправлено</Tag>,
+          text: "Почтовый сервер не принял письмо. Сотрудник приглашения не получил. Отправьте приглашение повторно из «Администрирование → Пользователи» или с рабочего стола, когда там появится пункт «Приглашение не принято».",
+        }
+      : {
+          key: "mail",
+          tag: <Tag color="success">Отправлено</Tag>,
+          text: `Письмо с приглашением ушло на ${account.email}`,
+        },
+  ];
+}
+
+function resultRows({ employee, position, account }: Outcome): ResultRow[] {
+  const rows: ResultRow[] = [
+    {
+      key: "employee",
+      tag: <Tag color="success">Создан</Tag>,
+      text: `Сотрудник: ${employee.fullName}, ${employee.orgUnitName}`,
+    },
+  ];
+  if (position) {
+    rows.push({
+      key: "position",
+      tag: <Tag color="success">Добавлена</Tag>,
+      text: `Должность «${position.name}» в перечне подразделения`,
+    });
+  }
+  if (!account) {
+    rows.push({
+      key: "account",
+      tag: <Tag>Не создана</Tag>,
+      text: "Учётная запись: её можно создать позже в «Администрирование → Пользователи»",
+    });
+    return rows;
+  }
+  return [...rows, ...accountRows(account)];
+}
+
+interface SummaryStepProps {
+  outcome: Outcome;
+  onBack: () => void;
+  onAnother: () => void;
+}
+
+function SummaryStep({ outcome, onBack, onAnother }: SummaryStepProps) {
+  return (
+    <FormColumn>
+      <ResultTable rows={resultRows(outcome)} />
+      <ActionBar start={<Button onClick={onBack}>Назад</Button>}>
+        <Button onClick={onAnother}>Принять ещё одного сотрудника</Button>
+        <LinkButton to={deskPaths.desk} type="primary">
+          К рабочему столу
+        </LinkButton>
+      </ActionBar>
+    </FormColumn>
+  );
+}
diff --git a/web/src/features/desk/OrgCleanupPage.tsx b/web/src/features/desk/OrgCleanupPage.tsx
new file mode 100644
index 0000000..136f10d
--- /dev/null
+++ b/web/src/features/desk/OrgCleanupPage.tsx
@@ -0,0 +1,113 @@
+import { useQuery } from "@tanstack/react-query";
+import { Flex, Skeleton, Tag, Typography } from "antd";
+import { useState } from "react";
+import { type DeskGroup, type DeskItem, orgQueueQuery } from "./deskApi";
+import { reasonLines, typeLabelOf } from "./deskTexts";
+import { useIsFindingBusy } from "./findingBusy";
+import { OrgFinding } from "./OrgFinding";
+import {
+  QueueLayout,
+  useQueueSelection,
+  useRecordFocus,
+  useShownCount,
+} from "./QueueLayout";
+import { LoadFailure, ScenarioPage } from "./ScenarioPage";
+
+const FIRST_COUNT = 20;
+const MORE_COUNT = 20;
+const SHOWN_REASONS = 2;
+
+const KIND_OPTIONS: ReadonlyArray<{ value: DeskGroup; label: string }> = [
+  { value: "OrgCleanup", label: "Расхождения" },
+  { value: "UnitsToConnect", label: "Подразделение не подключено" },
+  { value: "InactivePositions", label: "Неактивная должность занята" },
+  { value: "UnusedPositions", label: "Неиспользуемая должность" },
+  { value: "EmptyUnits", label: "Пустое подразделение" },
+];
+
+const keyOf = (item: DeskItem) => `${item.object.type}:${item.object.id}`;
+
+/** The reasons of a finding in a row of the queue: the first two, the rest by number. */
+function summary(item: DeskItem): string {
+  const lines = reasonLines(item).map((line) => line.text);
+  const more = lines.length - SHOWN_REASONS;
+  return [
+    ...lines.slice(0, SHOWN_REASONS),
+    ...(more > 0 ? [`ещё ${more}`] : []),
+  ].join(" · ");
+}
+
+/** «Навести порядок в оргструктуре»: the findings of the organisation structure, each put right on the spot. */
+export function OrgCleanupPage() {
+  const [group, setGroup] = useState<DeskGroup>();
+  const { shown, showMore } = useShownCount(FIRST_COUNT, MORE_COUNT);
+  const list = useQuery(orgQueueQuery(shown, group));
+  const items = list.data?.items ?? [];
+  const selection = useQueueSelection(
+    items.map(keyOf),
+    list.data !== undefined,
+  );
+  const current = items.find((item) => keyOf(item) === selection.selectedKey);
+  const headingRef = useRecordFocus(selection.selectedKey);
+  const isBusy = useIsFindingBusy();
+
+  return (
+    <ScenarioPage title="Навести порядок в оргструктуре">
+      {list.error ? (
+        <LoadFailure
+          title="Не удалось загрузить очередь"
+          error={list.error}
+          onRetry={() => void list.refetch()}
+        />
+      ) : (
+        <QueueLayout
+          items={items}
+          total={list.data?.total ?? 0}
+          getKey={keyOf}
+          selectedKey={selection.selectedKey}
+          onSelect={selection.select}
+          renderItem={(item) => (
+            <Flex vertical gap={2}>
+              <Flex align="center" gap="small" wrap>
+                <Tag>{typeLabelOf(item) ?? "Подразделение"}</Tag>
+                <Typography.Text strong>{item.object.name}</Typography.Text>
+                {item.isReference && <Tag>Справочно</Tag>}
+              </Flex>
+              <Typography.Text type="secondary">
+                {summary(item)}
+              </Typography.Text>
+            </Flex>
+          )}
+          filter={{
+            value: group,
+            options: KIND_OPTIONS,
+            onChange: (value) => setGroup(value as DeskGroup | undefined),
+          }}
+          onShowMore={showMore}
+          moreCount={MORE_COUNT}
+          isLoading={list.isPending}
+          lockedReason={
+            isBusy
+              ? "Идёт сохранение: другую находку можно выбрать после него."
+              : undefined
+          }
+          emptyText="Расхождений в оргструктуре нет: должности, подразделения и учётные записи согласованы. Если они появятся, пункт вернётся на рабочий стол."
+        >
+          {list.isPending ? (
+            <Skeleton active />
+          ) : current ? (
+            <OrgFinding
+              key={keyOf(current)}
+              item={current}
+              headingRef={headingRef}
+            />
+          ) : (
+            <Typography.Paragraph>
+              Находок этого вида в очереди нет.
+            </Typography.Paragraph>
+          )}
+        </QueueLayout>
+      )}
+    </ScenarioPage>
+  );
+}
diff --git a/web/src/features/desk/OrgFinding.tsx b/web/src/features/desk/OrgFinding.tsx
new file mode 100644
index 0000000..d1e0169
--- /dev/null
+++ b/web/src/features/desk/OrgFinding.tsx
@@ -0,0 +1,465 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import {
+  App,
+  theme as antdTheme,
+  Button,
+  Col,
+  Flex,
+  Form,
+  Row,
+  Table,
+  Typography,
+} from "antd";
+import type { ReactNode, RefObject } from "react";
+import { api } from "../../api/client";
+import { ifMatchOf } from "../../api/ifMatch";
+import { unwrap } from "../../api/unwrap";
+import { describeApiError } from "../../app/apiErrors";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import { useFormSubmit } from "../../app/useFormSubmit";
+import {
+  type Employee,
+  employeeQuery,
+  employeeSearchQuery,
+  invalidateOrgStructure,
+  orgUnitQuery,
+  orgUnitTreeQuery,
+} from "../org-structure/orgStructureApi";
+import { useUnitActivation } from "../org-structure/useUnitActivation";
+import { invalidatePositions, positionQuery } from "../positions/positionsApi";
+import { EmployeePicker } from "../users/EmployeePicker";
+import { userQuery, usersQueryKey } from "../users/usersApi";
+import { ChangePositionForm } from "./ChangePositionForm";
+import { DecisionError } from "./DecisionError";
+import type { DeskItem } from "./deskApi";
+import { deskPaths, objectTitle, reasonLines, typeLabelOf } from "./deskTexts";
+import { ORG_FINDING_MUTATION, useIsFindingBusy } from "./findingBusy";
+import { LinkButton } from "./LinkButton";
+import { returnState } from "./returnLink";
+import { CompactAlert } from "./ScenarioContext";
+
+const QUEUE_RETURN = returnState({
+  to: deskPaths.orgCleanup,
+  crumb: "Навести порядок в оргструктуре",
+});
+
+interface OrgFindingProps {
+  item: DeskItem;
+  headingRef: RefObject<HTMLHeadingElement | null>;
+}
+
+/** The open finding of the organisation queue: what is wrong, and the action that puts it right on the spot. */
+export function OrgFinding({ item, headingRef }: OrgFindingProps) {
+  const lines = reasonLines(item);
+  const [first, ...rest] = lines;
+  const label = typeLabelOf(item);
+  return (
+    <Flex vertical gap="middle">
+      <Typography.Title
+        level={4}
+        tabIndex={-1}
+        ref={headingRef}
+        style={{ margin: 0 }}
+      >
+        {label ? `${label} ${item.object.name}` : objectTitle(item.object)}
+      </Typography.Title>
+      {first && (
+        <CompactAlert
+          type={item.isReference ? "info" : "warning"}
+          lead={first.text}
+          text={rest.map((line) => line.text).join(" · ") || undefined}
+        />
+      )}
+      <Typography.Title level={4} style={{ margin: 0 }}>
+        Как исправить
+      </Typography.Title>
+      <FindingAction item={item} />
+    </Flex>
+  );
+}
+
+function FindingAction({ item }: { item: DeskItem }) {
+  switch (item.reasons[0]?.kind) {
+    case "PositionOutsideList":
+      return <OutsideList item={item} />;
+    case "AccountWithoutEmployee":
+      return <LinkAccount accountId={item.object.id} />;
+    case "InactivePositionInUse":
+      return <InactivePosition item={item} />;
+    case "UnusedPosition":
+      return <UnusedPosition item={item} />;
+    case "EmptyUnit":
+      return <EmptyUnit item={item} />;
+    default:
+      return (
+        <LinkButton to={deskPaths.connectUnitOf(item.object.id)} type="primary">
+          Открыть «Подключить подразделение»
+        </LinkButton>
+      );
+  }
+}
+
+function OutsideList({ item }: { item: DeskItem }) {
+  const { token } = antdTheme.useToken();
+  const queryClient = useQueryClient();
+  const { message } = App.useApp();
+  const isBusy = useIsFindingBusy();
+  const [position, unit] = item.reasons[0]?.details?.entries ?? [];
+  const employee = useQuery(employeeQuery(item.object.id));
+  const add = useMutation({
+    mutationKey: ORG_FINDING_MUTATION,
+    mutationFn: async () => {
+      if (!position || !unit) throw new Error("The finding names no position");
+      return unwrap(
+        await api.POST("/api/v1/org-units/{id}/positions", {
+          params: { path: { id: unit.id } },
+          body: { positionId: position.id },
+        }),
+      );
+    },
+    onSuccess: () =>
+      message.success(
+        `Должность «${position?.name}» добавлена в перечень подразделения «${unit?.name}»`,
+      ),
+    onSettled: () => invalidatePositions(queryClient),
+  });
+
+  return (
+    <Flex vertical gap="middle">
+      {add.isError && (
+        <DecisionError title="Должность не добавлена" error={add.error} />
+      )}
+      <Row gutter={[token.margin, token.margin]}>
+        <Col xs={24} lg={12}>
+          <Flex
+            vertical
+            gap="small"
+            style={{
+              height: "100%",
+              padding: "var(--ant-padding-sm)",
+              border:
+                "var(--ant-line-width) var(--ant-line-type) var(--ant-color-primary)",
+              borderRadius: "var(--ant-border-radius)",
+              background: "var(--ant-color-primary-bg)",
+            }}
+          >
+            <Typography.Text strong>
+              {`Добавить должность «${position?.name}» в перечень подразделения «${unit?.name}»`}
+            </Typography.Text>
+            <div>
+              <Button
+                type="primary"
+                loading={add.isPending}
+                disabled={isBusy && !add.isPending}
+                onClick={() => add.mutate()}
+              >
+                Добавить в перечень
+              </Button>
+            </div>
+          </Flex>
+        </Col>
+        <Col xs={24} lg={12}>
+          <Flex vertical gap="small">
+            <Typography.Text strong>
+              Сменить должность сотрудника
+            </Typography.Text>
+            {employee.error ? (
+              <ErrorAlert
+                title="Не удалось загрузить сотрудника"
+                error={employee.error}
+                onRetry={() => void employee.refetch()}
+              />
+            ) : employee.data?.version == null ? (
+              <Typography.Text type="secondary">Загрузка…</Typography.Text>
+            ) : (
+              <ChangePositionForm employee={employee.data} />
+            )}
+          </Flex>
+        </Col>
+      </Row>
+    </Flex>
+  );
+}
+
+function LinkAccount({ accountId }: { accountId: string }) {
+  const queryClient = useQueryClient();
+  const { message } = App.useApp();
+  const isBusy = useIsFindingBusy();
+  const user = useQuery(userQuery(accountId));
+  const [form] = Form.useForm<{ employeeId?: string }>();
+  const link = useMutation({
+    mutationKey: ORG_FINDING_MUTATION,
+    mutationFn: async (employeeId: string) => {
+      const account = user.data;
+      if (!account) throw new Error("The account is not read yet");
+      return unwrap(
+        await api.PUT("/api/v1/users/{id}", {
+          params: {
+            path: { id: account.id },
+            header: { "If-Match": ifMatchOf(account.version) },
+          },
+          body: { email: account.email, roles: account.roles, employeeId },
+        }),
+      );
+    },
+    onSuccess: () => message.success("Учётная запись привязана к сотруднику"),
+    onSettled: () =>
+      Promise.all([
+        queryClient.invalidateQueries({ queryKey: usersQueryKey }),
+        invalidateOrgStructure(queryClient),
+      ]),
+  });
+  const { submit } = useFormSubmit(form, async (values) => {
+    if (values.employeeId) await link.mutateAsync(values.employeeId);
+  });
+
+  if (user.error) {
+    return (
+      <ErrorAlert
+        title="Не удалось загрузить учётную запись"
+        error={user.error}
+        onRetry={() => void user.refetch()}
+      />
+    );
+  }
+  return (
+    <Flex vertical gap="small">
+      {link.isError && (
+        <DecisionError title="Учётная запись не привязана" error={link.error} />
+      )}
+      <Form
+        key={user.data?.version}
+        form={form}
+        name="link-account"
+        layout="vertical"
+        disabled={isBusy}
+        onFinish={submit}
+      >
+        <Form.Item
+          name="employeeId"
+          label="Сотрудник"
+          extra="В списке видны подразделение и должность. После привязки ссылка приглашения перестанет действовать: отправьте приглашение повторно."
+          rules={[{ required: true, message: "Выберите сотрудника" }]}
+        >
+          <EmployeePicker />
+        </Form.Item>
+        <Button
+          type="primary"
+          htmlType="submit"
+          loading={link.isPending}
+          disabled={!user.data}
+        >
+          Привязать
+        </Button>
+      </Form>
+    </Flex>
+  );
+}
+
+// ponytail: the employee search returns one page of 200; a position held by more employees shows its first 200.
+function InactivePosition({ item }: { item: DeskItem }) {
+  const holders = useQuery(employeeSearchQuery(item.object.name));
+  const rows = (holders.data?.items ?? []).filter(
+    (employee) =>
+      employee.positionId === item.object.id && employee.isActive !== false,
+  );
+  const queryClient = useQueryClient();
+  const { message } = App.useApp();
+  const isBusy = useIsFindingBusy();
+  const restore = useMutation({
+    mutationKey: ORG_FINDING_MUTATION,
+    mutationFn: async () => {
+      const position = await queryClient.fetchQuery(
+        positionQuery(item.object.id),
+      );
+      return unwrap(
+        await api.POST("/api/v1/positions/{id}/activate", {
+          params: {
+            path: { id: position.id },
+            header: { "If-Match": ifMatchOf(position.version) },
+          },
+        }),
+      );
+    },
+    onSuccess: () =>
+      message.success(`Должность «${item.object.name}» восстановлена`),
+    onSettled: () => invalidatePositions(queryClient),
+  });
+  if (holders.error) {
+    return (
+      <ErrorAlert
+        title="Не удалось загрузить сотрудников"
+        error={holders.error}
+        onRetry={() => void holders.refetch()}
+      />
+    );
+  }
+  return (
+    <Flex vertical gap="small">
+      {restore.isError && (
+        <DecisionError
+          title="Должность не восстановлена"
+          error={restore.error}
+        />
+      )}
+      <div>
+        <Button
+          type="primary"
+          loading={restore.isPending}
+          disabled={isBusy && !restore.isPending}
+          onClick={() => restore.mutate()}
+        >
+          Восстановить должность
+        </Button>
+      </div>
+      <Typography.Text type="secondary">
+        Должность вернётся в работу, сотрудники останутся на своих местах. Или
+        смените должность сотрудникам:
+      </Typography.Text>
+      <HoldersTable isLoading={holders.isPending} rows={rows} />
+    </Flex>
+  );
+}
+
+function HoldersTable({
+  isLoading,
+  rows,
+}: {
+  isLoading: boolean;
+  rows: Employee[];
+}) {
+  return (
+    <Table
+      size="small"
+      rowKey="id"
+      pagination={false}
+      loading={isLoading}
+      dataSource={rows}
+      locale={{ emptyText: "Работающих сотрудников с этой должностью нет" }}
+      columns={[
+        { title: "Сотрудник", dataIndex: "fullName" },
+        { title: "Подразделение", dataIndex: "orgUnitName" },
+        {
+          title: "Новая должность",
+          key: "change",
+          render: (_, employee) =>
+            employee.version == null ? null : (
+              <ChangePositionForm employee={employee} isInline />
+            ),
+        },
+      ]}
+    />
+  );
+}
+
+function UnusedPosition({ item }: { item: DeskItem }) {
+  const queryClient = useQueryClient();
+  const { message } = App.useApp();
+  const isBusy = useIsFindingBusy();
+  const deactivate = useMutation({
+    mutationKey: ORG_FINDING_MUTATION,
+    mutationFn: async () => {
+      const params = { path: { id: item.object.id } };
+      const position = unwrap(
+        await api.GET("/api/v1/positions/{id}", { params }),
+      );
+      return unwrap(
+        await api.POST("/api/v1/positions/{id}/deactivate", {
+          params: {
+            ...params,
+            header: { "If-Match": ifMatchOf(position.version) },
+          },
+        }),
+      );
+    },
+    onSuccess: () =>
+      message.success(`Должность «${item.object.name}» деактивирована`),
+    onSettled: () => invalidatePositions(queryClient),
+  });
+  const units = useQuery(orgUnitTreeQuery);
+  const canOnboard = units.data?.some((unit) => unit.isActive) ?? false;
+  return (
+    <ActionWithError
+      error={deactivate.isError ? deactivate.error : null}
+      title="Должность не деактивирована"
+    >
+      <Flex vertical gap="small">
+        <Flex gap="small" wrap>
+          {canOnboard && (
+            <LinkButton
+              type="primary"
+              to={deskPaths.onboardEmployeeWith({ positionId: item.object.id })}
+              state={QUEUE_RETURN}
+            >
+              Принять сотрудника
+            </LinkButton>
+          )}
+          <Button
+            loading={deactivate.isPending}
+            disabled={isBusy && !deactivate.isPending}
+            onClick={() => deactivate.mutate()}
+          >
+            Деактивировать должность
+          </Button>
+        </Flex>
+        {canOnboard && (
+          <Typography.Text type="secondary">
+            {`«Принять сотрудника» — откроется сценарий, должность «${item.object.name}» в нём уже выбрана; «Деактивировать» — должность перестанет предлагаться.`}
+          </Typography.Text>
+        )}
+      </Flex>
+    </ActionWithError>
+  );
+}
+
+function EmptyUnit({ item }: { item: DeskItem }) {
+  const queryClient = useQueryClient();
+  const { message } = App.useApp();
+  const isBusy = useIsFindingBusy();
+  const confirm = useUnitActivation();
+  const read = useMutation({
+    mutationFn: () => queryClient.fetchQuery(orgUnitQuery(item.object.id)),
+    onSuccess: confirm,
+    onError: (failure) => message.error(describeApiError(failure)),
+  });
+  return (
+    <Flex vertical gap="small">
+      <Flex gap="small" wrap>
+        <LinkButton
+          type="primary"
+          to={deskPaths.onboardEmployeeWith({ unitId: item.object.id })}
+          state={QUEUE_RETURN}
+        >
+          Принять сотрудника
+        </LinkButton>
+        <Button
+          loading={read.isPending}
+          disabled={isBusy}
+          onClick={() => read.mutate()}
+        >
+          Деактивировать подразделение
+        </Button>
+      </Flex>
+      <Typography.Text type="secondary">
+        {`«Принять сотрудника» — откроется сценарий, подразделение «${item.object.name}» в нём уже выбрано; «Деактивировать» — подразделение исчезнет из дерева.`}
+      </Typography.Text>
+    </Flex>
+  );
+}
+
+function ActionWithError({
+  error,
+  title,
+  children,
+}: {
+  error: unknown;
+  title: string;
+  children: ReactNode;
+}) {
+  return (
+    <Flex vertical gap="small">
+      {error !== null && <DecisionError title={title} error={error} />}
+      <div>{children}</div>
+    </Flex>
+  );
+}
diff --git a/web/src/features/desk/QueueLayout.tsx b/web/src/features/desk/QueueLayout.tsx
new file mode 100644
index 0000000..33a9112
--- /dev/null
+++ b/web/src/features/desk/QueueLayout.tsx
@@ -0,0 +1,192 @@
+import { Button, Empty, Flex, Select, Typography } from "antd";
+import { type ReactNode, useEffect, useRef, useState } from "react";
+import { deskPaths } from "./deskTexts";
+import { LinkButton } from "./LinkButton";
+import "./scenario.css";
+
+interface Selection {
+  key: string | undefined;
+  index: number;
+}
+
+/**
+ * Which record of a queue is open. A record that leaves the queue, being decided, gives way to the one that took its
+ * place, so the next one opens by itself; before the queue is read the record asked for stays remembered.
+ */
+export function useQueueSelection(
+  keys: readonly string[],
+  isReady: boolean,
+  requestedKey?: string,
+) {
+  const [selection, setSelection] = useState<Selection>({
+    key: requestedKey,
+    index: 0,
+  });
+  const found = selection.key === undefined ? -1 : keys.indexOf(selection.key);
+  const index =
+    found >= 0
+      ? found
+      : Math.max(0, Math.min(selection.index, keys.length - 1));
+  const key = isReady ? keys[index] : selection.key;
+
+  useEffect(() => {
+    if (isReady && (key !== selection.key || index !== selection.index)) {
+      setSelection({ key, index });
+    }
+  }, [isReady, key, index, selection]);
+
+  return {
+    selectedKey: key,
+    wasRequestedFound:
+      requestedKey === undefined || keys.includes(requestedKey),
+    select: (next: string) =>
+      setSelection({ key: next, index: Math.max(keys.indexOf(next), 0) }),
+  };
+}
+
+/** A ref for the heading of the open record, which takes the focus whenever another record opens. */
+export function useRecordFocus(recordKey: string | undefined) {
+  const ref = useRef<HTMLHeadingElement>(null);
+  const isFirst = useRef(true);
+  useEffect(() => {
+    if (isFirst.current) {
+      isFirst.current = false;
+      return;
+    }
+    if (recordKey !== undefined) ref.current?.focus();
+  }, [recordKey]);
+  return ref;
+}
+
+interface QueueLayoutProps<T> {
+  items: readonly T[];
+  /** How many records the queue holds in all. */
+  total: number;
+  getKey: (item: T) => string;
+  selectedKey: string | undefined;
+  onSelect: (key: string) => void;
+  renderItem: (item: T) => ReactNode;
+  filter: {
+    value: string | undefined;
+    options: ReadonlyArray<{ value: string; label: string }>;
+    onChange: (value: string | undefined) => void;
+  };
+  /** Reads more of the queue; given only while some records are not shown. */
+  onShowMore?: () => void;
+  /** How many records each «Показать ещё» adds. */
+  moreCount: number;
+  isLoading: boolean;
+  /** Text of an empty queue: what it means and what comes next. */
+  emptyText: string;
+  /** Why another record cannot be chosen now, such as a change being saved; the list is off while this is given. */
+  lockedReason?: string;
+  /** The open record. */
+  children: ReactNode;
+}
+
+/** Two columns: the queue on the left, the open record on the right (one column on a tablet). */
+export function QueueLayout<T>({
+  items,
+  total,
+  getKey,
+  selectedKey,
+  onSelect,
+  renderItem,
+  filter,
+  onShowMore,
+  moreCount,
+  isLoading,
+  emptyText,
+  lockedReason,
+  children,
+}: QueueLayoutProps<T>) {
+  const listRef = useRef<HTMLDivElement>(null);
+  if (!isLoading && total === 0 && filter.value === undefined) {
+    return (
+      <Empty
+        description={
+          <>
+            <Typography.Title level={4}>Очередь пуста</Typography.Title>
+            <Typography.Paragraph>{emptyText}</Typography.Paragraph>
+          </>
+        }
+      >
+        <LinkButton to={deskPaths.desk} type="primary">
+          К рабочему столу
+        </LinkButton>
+      </Empty>
+    );
+  }
+  return (
+    <div className="queue-columns">
+      <Flex vertical gap="small">
+        <div ref={listRef} tabIndex={-1} />
+        <Flex justify="space-between" align="center" gap="small" wrap>
+          <Typography.Text strong>{`В очереди: ${total}`}</Typography.Text>
+          <Select
+            allowClear
+            aria-label="Вид"
+            placeholder="Вид"
+            style={{ minWidth: 160 }}
+            value={filter.value}
+            options={[...filter.options]}
+            onChange={(value) => filter.onChange(value ?? undefined)}
+          />
+        </Flex>
+        {lockedReason && (
+          <Typography.Text type="secondary">{lockedReason}</Typography.Text>
+        )}
+        <ul style={{ listStyle: "none", margin: 0, padding: 0 }}>
+          {items.map((item) => {
+            const key = getKey(item);
+            const isSelected = key === selectedKey;
+            return (
+              <li key={key}>
+                <button
+                  type="button"
+                  className={`queue-row${isSelected ? " queue-row-selected" : ""}`}
+                  aria-current={isSelected ? "true" : undefined}
+                  disabled={lockedReason !== undefined}
+                  onClick={() => onSelect(key)}
+                >
+                  {renderItem(item)}
+                </button>
+              </li>
+            );
+          })}
+        </ul>
+        {items.length < total && (
+          <Flex justify="space-between" align="center">
+            <Typography.Text type="secondary">
+              {`Показано ${items.length} из ${total}`}
+            </Typography.Text>
+            {onShowMore && (
+              <Button
+                onClick={onShowMore}
+              >{`Показать ещё ${moreCount}`}</Button>
+            )}
+          </Flex>
+        )}
+      </Flex>
+      <div>
+        <Button
+          type="link"
+          className="queue-back"
+          onClick={() => {
+            listRef.current?.scrollIntoView();
+            listRef.current?.focus();
+          }}
+        >
+          К списку
+        </Button>
+        {children}
+      </div>
+    </div>
+  );
+}
+
+/** Keeps the number of records a queue shows: the first page, and each «Показать ещё» adds one more. */
+export function useShownCount(firstCount: number, moreCount: number) {
+  const [shown, setShown] = useState(firstCount);
+  return { shown, showMore: () => setShown((count) => count + moreCount) };
+}
