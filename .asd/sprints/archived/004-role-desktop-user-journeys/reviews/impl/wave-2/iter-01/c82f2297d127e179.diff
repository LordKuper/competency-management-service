+/* Rows of a table of changes: the tint comes from the status tokens and always goes with a word. */
+.change-row-added > td {
+  background: var(--ant-color-success-bg);
+}
+
+.change-row-changed > td {
+  background: var(--ant-color-warning-bg);
+}
+
+.change-row-removed > td {
+  background: var(--ant-color-error-bg);
+}
+
+/* The list of a queue: the chosen record stands out by the primary subtle tone and keeps its text colour. */
+.queue-row-selected {
+  background: var(--ant-color-primary-bg);
+}
+
+.queue-row {
+  display: block;
+  width: 100%;
+  padding: var(--ant-padding-sm) var(--ant-padding);
+  border: 0;
+  border-bottom: var(--ant-line-width) var(--ant-line-type)
+    var(--ant-color-border-secondary);
+  background: transparent;
+  color: inherit;
+  text-align: start;
+  cursor: pointer;
+}
+
+.queue-row:hover {
+  background: var(--ant-color-primary-bg-hover);
+}
+
+.queue-back {
+  display: none;
+}
+
+.queue-columns {
+  display: grid;
+  grid-template-columns: minmax(var(--queue-list-min-width), 2fr) 3fr;
+  gap: var(--ant-margin-lg);
+  align-items: start;
+  --queue-list-min-width: 320px;
+}
+
+@media (width < 992px) {
+  .queue-columns {
+    grid-template-columns: 1fr;
+  }
+
+  .queue-back {
+    display: inline-flex;
+  }
+}
+
+/* The choice of the object of a scenario, in the context line: it grows to fit the names it holds. */
+.context-select {
+  flex: 1 1 var(--context-select-basis);
+  max-width: var(--context-select-max-width);
+  --context-select-basis: 320px;
+  --context-select-max-width: 560px;
+}
+
+.context-select > * {
+  width: 100%;
+}
+
+/* Fields of a scenario form stand closer: the gaps between blocks come from the layout around them. */
+.compact-form .ant-form-item {
+  margin-bottom: 0;
+}
+
+.queue-row:disabled {
+  cursor: not-allowed;
+  color: var(--ant-color-text-disabled);
+}
+
+/* A level of a track that has no active position: the tint always goes with the word in the row. */
+.level-row-missing > td {
+  background: var(--ant-color-warning-bg);
+}
+
+/* The column of a form step: it does not stretch, and on a narrow screen it takes the whole width. */
+.form-column {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: var(--ant-margin);
+  width: calc(var(--ant-size-xxl) * 15);
+  max-width: 100%;
+  margin-inline: auto;
