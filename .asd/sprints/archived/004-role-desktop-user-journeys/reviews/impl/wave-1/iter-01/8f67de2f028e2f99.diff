@@ -0,0 +1,60 @@
+using System.Net;
+using AwesomeAssertions;
+using Competency.Tests.Infrastructure;
+using Xunit;
+
+namespace Competency.Tests;
+
+/// <summary>
+/// The scenario prerequisites the desk reports follow the current data on a host that starts empty: each appears when the data
+/// allows its scenario, goes when the data stops allowing it, and the one about accounts is told to the administrator alone.
+/// </summary>
+public sealed class DeskPrerequisiteTests(CareerHost fixture) : IClassFixture<CareerHost>
+{
+    [Fact]
+    public async Task Ac204_Ac205_Ac209_Ac210_Ac218_PrerequisitesAppearAndGoWithTheData_InTheOrderOfTheirDeclaration()
+    {
+        var admin = await fixture.Host.AdminAsync();
+        var plain = await (await admin.CreateUserAsync()).SignInAsync(fixture.Host);
+
+        var empty = await PrerequisitesAsync(admin);
+        var unit = await admin.CreateUnitAsync();
+        var withUnit = await PrerequisitesAsync(admin);
+        (await admin.PostAsync("/api/v1/positions", new { name = Scenarios.Unique("Должность") })).Expect(HttpStatusCode.Created);
+        var withPosition = await PrerequisitesAsync(admin);
+        var employee = await admin.CreateEmployeeAsync(unit.Id, position: Scenarios.Unique("Должность"));
+        var withEmployee = await PrerequisitesAsync(admin);
+        var direction = await admin.MakeDirectionAsync();
+        var track = await admin.MakeTrackAsync(unit.Id, direction.Id);
+        var adminSeesDraft = await PrerequisitesAsync(admin);
+        var plainBeforeApproval = await PrerequisitesAsync(plain);
+        await admin.MakeLevelAsync(track.Id);
+        (await admin.ActivateAsync(track, unit.Id)).Expect(HttpStatusCode.OK);
+        var plainAfterApproval = await PrerequisitesAsync(plain);
+        var hr = await admin.CreateUserAsync(Scenarios.Hr);
+        var withHr = await PrerequisitesAsync(admin);
+        var plainWithHr = await PrerequisitesAsync(plain);
+        (await admin.PostAsync($"/api/v1/users/{hr.Id}/block", ifMatch: (await admin.GetUserAsync(hr.Id)).ETag)).Expect(HttpStatusCode.OK);
+        var blockedHr = await PrerequisitesAsync(admin);
+        (await admin.PostAsync($"/api/v1/employees/{employee.Id}/dismiss", ifMatch: employee.ETag)).Expect(HttpStatusCode.OK);
+        var dismissed = await PrerequisitesAsync(admin);
+        (await admin.PostAsync($"/api/v1/org-units/{unit.Id}/deactivate", ifMatch: (await admin.GetUnitAsync(unit.Id)).ETag)).Expect(HttpStatusCode.OK);
+        var noActiveUnit = await PrerequisitesAsync(admin);
+
+        empty.Should().BeEmpty();
+        withUnit.Should().Equal("ActiveUnit");
+        withPosition.Should().Equal("ActiveUnit", "ActivePosition");
+        withEmployee.Should().Equal("ActiveUnit", "ActivePosition", "WorkingEmployee");
+        adminSeesDraft.Should().Equal("ActiveUnit", "ActivePosition", "WorkingEmployee", "VisibleTrack");
+        plainBeforeApproval.Should().Equal("ActiveUnit", "ActivePosition", "WorkingEmployee");
+        plainAfterApproval.Should().Equal("ActiveUnit", "ActivePosition", "WorkingEmployee", "VisibleTrack");
+        withHr.Should().Equal("ActiveUnit", "ActivePosition", "WorkingEmployee", "VisibleTrack", "HrAccount");
+        plainWithHr.Should().Equal("ActiveUnit", "ActivePosition", "WorkingEmployee", "VisibleTrack");
+        blockedHr.Should().Equal("ActiveUnit", "ActivePosition", "WorkingEmployee", "VisibleTrack");
+        dismissed.Should().Equal("ActiveUnit", "ActivePosition", "VisibleTrack");
+        noActiveUnit.Should().Equal("ActivePosition", "VisibleTrack");
+    }
+
+    private static async Task<string[]> PrerequisitesAsync(ApiClient client) =>
+        [.. (await client.DeskAsync())["prerequisites"]!.AsArray().Select(prerequisite => prerequisite!.GetValue<string>())];
+}
diff --git a/tests/Competency.Tests/DeskRulesTests.cs b/tests/Competency.Tests/DeskRulesTests.cs
new file mode 100644
index 0000000..75253c0
--- /dev/null
+++ b/tests/Competency.Tests/DeskRulesTests.cs
@@ -0,0 +1,248 @@
+using AwesomeAssertions;
+using Competency.Desk;
+using Competency.Platform;
+using Xunit;
+using static Competency.Platform.DeskKind;
+
+namespace Competency.Tests;
+
+/// <summary>
+/// How the desk turns the findings of every source into items: one item per object, what an absorbing finding hides, what is for
+/// reference giving way to an action, the order of reasons and of items. The rules run on findings alone, so they are checked without a host.
+/// </summary>
+public sealed class DeskRulesTests
+{
+    private static readonly DateTimeOffset Noon = new(2026, 10, 20, 12, 0, 0, TimeSpan.Zero);
+
+    public static TheoryData<DeskKind> AllKinds => new(Enum.GetValues<DeskKind>());
+
+    public static TheoryData<DeskKind, DeskKind> AbsorptionsOfOneObject => new()
+    {
+        { TrackWithoutLevels, TrackWithoutPositions },
+        { TrackWithoutLevels, LevelWithoutPosition },
+        { TrackWithoutPositions, LevelWithoutPosition },
+        { DraftAwaitsApproval, TrackWithoutLevels },
+        { DraftAwaitsApproval, TrackWithoutPositions },
+        { DraftAwaitsApproval, LevelWithoutPosition },
+        { UnitWithoutHead, ResponsibleUnitWithoutMatrix },
+        { ResponsibleUnitWithoutHead, ResponsibleUnitWithoutMatrix },
+        { EmptyUnit, UnitWithoutHead },
+        { EmptyUnit, UnitWithoutHr },
+        { EmptyUnit, ResponsibleUnitWithoutMatrix },
+        { EmptyUnit, ResponsibleUnitWithoutHead },
+        { VersionAwaitsHeadApproval, OwnVersionInApproval },
+        { VersionAwaitsHeadApproval, VersionStuckAtHead },
+        { VersionAwaitsHrApproval, OwnVersionInApproval },
+        { VersionReturned, MatrixLevelsChanged },
+        { VersionNotSubmitted, MatrixUsesInactive },
+        { OwnVersionInApproval, MatrixSharedBlockChanged },
+        { VersionStuckAtHead, MatrixCompetencyChanged },
+        { MatrixLevelsChanged, MatrixCompetencyChanged },
+        { MatrixUsesInactive, MatrixCompetencyChanged },
+        { MatrixSharedBlockChanged, MatrixCompetencyChanged },
+    };
+
+    [Theory]
+    [MemberData(nameof(AllKinds))]
+    public void Ac154_EveryKind_HasAGroupAndAPlaceInTheOrderOfReasons(DeskKind kind)
+    {
+        var matrix = Matrix();
+        var findings = new[] { Finding(kind, matrix), Finding(kind, matrix, subject: Matrix("Другой")) };
+
+        var items = DeskRules.Merge(findings);
+
+        items.Should().ContainSingle().Which.Reasons.Select(reason => reason.Kind).Should().Equal(kind, kind);
+    }
+
+    [Theory]
+    [MemberData(nameof(AbsorptionsOfOneObject))]
+    public void Ac155_AnAbsorbedFinding_IsNotShownWhileTheAbsorbingOneIsVisible(DeskKind absorbing, DeskKind absorbed)
+    {
+        var subject = Matrix();
+
+        var items = DeskRules.Merge([Finding(absorbed, subject), Finding(absorbing, subject)]);
+
+        items.Should().ContainSingle().Which.Reasons.Select(reason => reason.Kind).Should().Equal(absorbing);
+    }
+
+    [Fact]
+    public void Ac155_AnAbsorbingFinding_HidesOnlyWhatConcernsItsOwnObject()
+    {
+        var emptyUnit = new DeskObject(DeskObjectType.OrgUnit, Guid.NewGuid(), "Пустой");
+        var otherUnit = new DeskObject(DeskObjectType.OrgUnit, Guid.NewGuid(), "Другой");
+
+        var items = DeskRules.Merge([Finding(EmptyUnit, emptyUnit), Finding(UnitWithoutHead, otherUnit)]);
+
+        items.Select(item => item.Object).Should().BeEquivalentTo([emptyUnit, otherUnit]);
+    }
+
+    [Fact]
+    public void Ac155_AFindingThatIsNotAnAbsorbedKind_StaysBesideTheAbsorbingOne()
+    {
+        var track = new DeskObject(DeskObjectType.Track, Guid.NewGuid(), "Трек");
+
+        var items = DeskRules.Merge([Finding(TrackWithoutLevels, track), Finding(TrackWithOneLevel, track)]);
+
+        items.Single().Reasons.Select(reason => reason.Kind).Should().Equal(TrackWithoutLevels, TrackWithOneLevel);
+    }
+
+    [Fact]
+    public void Ac159_AnInvitationNotAccepted_AbsorbsTheHeadAccountInvitedOfTheUnitThroughTheSubject()
+    {
+        var unit = new DeskObject(DeskObjectType.OrgUnit, Guid.NewGuid(), "Отдел");
+        var account = new DeskObject(DeskObjectType.UserAccount, Guid.NewGuid(), "head@test.local");
+
+        var items = DeskRules.Merge([Finding(HeadAccountInvited, unit, subject: account), Finding(InvitationNotAccepted, account)]);
+
+        items.Should().ContainSingle().Which.Object.Should().Be(account);
+        items.Single().Reasons.Select(reason => reason.Kind).Should().Equal(InvitationNotAccepted);
+    }
+
+    [Fact]
+    public void Ac159_AHeadAccountInvited_StaysWhenNoInvitationNotAcceptedIsVisible()
+    {
+        var unit = new DeskObject(DeskObjectType.OrgUnit, Guid.NewGuid(), "Отдел");
+        var account = new DeskObject(DeskObjectType.UserAccount, Guid.NewGuid(), "head@test.local");
+
+        var items = DeskRules.Merge([Finding(HeadAccountInvited, unit, subject: account)]);
+
+        items.Should().ContainSingle().Which.Object.Should().Be(unit);
+    }
+
+    [Fact]
+    public void Ac155_APositionWithoutATrack_AbsorbsTheNoTrackFindingOfAnEmployeeOnThatPositionOnly()
+    {
+        var position = new DeskObject(DeskObjectType.Position, Guid.NewGuid(), "Инженер");
+        var otherPosition = new DeskObject(DeskObjectType.Position, Guid.NewGuid(), "Аналитик");
+        var onPosition = new DeskObject(DeskObjectType.Employee, Guid.NewGuid(), "Иванов");
+        var onOther = new DeskObject(DeskObjectType.Employee, Guid.NewGuid(), "Петров");
+
+        var items = DeskRules.Merge(
+        [
+            Finding(PositionWithoutTrack, position),
+            Finding(NoTrackForPosition, onPosition, false, position),
+            Finding(NoTrackForPosition, onOther, false, otherPosition),
+        ]);
+
+        items.Select(item => item.Object).Should().BeEquivalentTo([position, onOther]);
+    }
+
+    [Fact]
+    public void Ac156_AFindingForReference_GivesWayToAnActionOnTheSameObject_AndTheItemCountsAsAnAction()
+    {
+        var track = new DeskObject(DeskObjectType.Track, Guid.NewGuid(), "Трек");
+
+        var items = DeskRules.Merge([Finding(OwnDraftAwaitsApproval, track, false), Finding(DraftAwaitsApproval, track)]);
+
+        var item = items.Should().ContainSingle().Subject;
+        item.IsReference.Should().BeFalse();
+        item.Reasons.Select(reason => reason.Kind).Should().Equal(DraftAwaitsApproval);
+    }
+
+    [Fact]
+    public void Ac156_FindingsForReference_AreTwoReasonsOfOneItemForReference()
+    {
+        var track = new DeskObject(DeskObjectType.Track, Guid.NewGuid(), "Трек");
+
+        var items = DeskRules.Merge([Finding(OwnDraftAwaitsApproval, track, false), Finding(TrackWithOneLevel, track, false)]);
+
+        var item = items.Should().ContainSingle().Subject;
+        item.IsReference.Should().BeTrue();
+        item.Reasons.Select(reason => reason.Kind).Should().BeEquivalentTo([OwnDraftAwaitsApproval, TrackWithOneLevel]);
+    }
+
+    [Theory]
+    [InlineData(true)]
+    [InlineData(false)]
+    public void Ac157_TheSameFindingFromSeveralRoles_IsShownOnce_AsAnActionWhenAnyOfThemIs(bool actionComesFirst)
+    {
+        var track = new DeskObject(DeskObjectType.Track, Guid.NewGuid(), "Трек");
+        var action = Finding(TrackWithoutLevels, track);
+        var reference = Finding(TrackWithoutLevels, track, false);
+
+        var items = DeskRules.Merge(actionComesFirst ? [action, reference] : [reference, action]);
+
+        var item = items.Should().ContainSingle().Subject;
+        item.IsReference.Should().BeFalse();
+        item.Reasons.Should().ContainSingle();
+    }
+
+    [Fact]
+    public void Ac154_ReasonsFollowTheOrderOfTheTable_AndTheFirstReasonDecidesTheGroup()
+    {
+        var unit = new DeskObject(DeskObjectType.OrgUnit, Guid.NewGuid(), "Отдел");
+
+        var items = DeskRules.Merge([Finding(UnitWithoutPositions, unit), Finding(UnitWithoutHr, unit), Finding(HeadWithoutAccount, unit)]);
+
+        var item = items.Should().ContainSingle().Subject;
+        item.Reasons.Select(reason => reason.Kind).Should().Equal(HeadWithoutAccount, UnitWithoutHr, UnitWithoutPositions);
+        item.Group.Should().Be(DeskGroup.UnitsToConnect);
+    }
+
+    [Fact]
+    public void Ac160_TheLinkOfAnItem_IsTheTargetOfItsFirstReason()
+    {
+        var matrix = Matrix();
+        var firstTarget = new DeskObject(DeskObjectType.MatrixVersion, Guid.NewGuid(), "Версия 1");
+        var otherTarget = new DeskObject(DeskObjectType.MatrixVersion, Guid.NewGuid(), "Версия 2");
+
+        var items = DeskRules.Merge(
+        [
+            Finding(OwnVersionInApproval, matrix, false, target: otherTarget),
+            Finding(VersionStuckAtHead, matrix, false, target: firstTarget),
+        ]);
+
+        items.Single().Target.Should().Be(firstTarget, "the stuck version comes before the own version in approval in the table of reasons");
+    }
+
+    [Fact]
+    public void Ac160_AnInvitationToSendAgain_StaysOnTheItemWhicheverReasonBringsIt()
+    {
+        var account = new DeskObject(DeskObjectType.UserAccount, Guid.NewGuid(), "user@test.local");
+        var invitation = new DeskInvitation(account.Id, 3);
+
+        var items = DeskRules.Merge([Finding(AccountWithoutEmployee, account), Finding(InvitationNotAccepted, account, invitation: invitation)]);
+
+        var item = items.Should().ContainSingle().Subject;
+        item.Reasons.First().Kind.Should().Be(AccountWithoutEmployee);
+        item.Invitation.Should().Be(invitation);
+    }
+
+    [Fact]
+    public void Ac7_Items_FollowTheGroupThenTheOldestEventThenTheNameThenTheId()
+    {
+        var undated = Matrix("В");
+        var oldest = Matrix("Б");
+        var tiedLowerCase = Matrix("а");
+        var tiedUpperCase = Matrix("Б");
+        var newer = Matrix("А");
+        var twins = new[] { Matrix("Д"), Matrix("Д") }.OrderBy(twin => twin.Id).ToArray();
+        var awaiting = Matrix("Я");
+
+        var items = DeskRules.Merge(
+        [
+            Finding(VersionAwaitsHeadApproval, awaiting, at: Noon.AddDays(-1)),
+            Finding(VersionReturned, twins[1], at: Noon.AddHours(3)),
+            Finding(VersionReturned, newer, at: Noon.AddHours(2)),
+            Finding(VersionReturned, twins[0], at: Noon.AddHours(3)),
+            Finding(VersionReturned, tiedUpperCase, at: Noon.AddHours(1)),
+            Finding(VersionReturned, oldest, at: Noon),
+            Finding(VersionReturned, tiedLowerCase, at: Noon.AddHours(1)),
+            Finding(VersionReturned, undated),
+        ]);
+
+        items.Select(item => item.Object).Should().Equal(undated, oldest, tiedLowerCase, tiedUpperCase, newer, twins[0], twins[1], awaiting);
+    }
+
+    private static DeskObject Matrix(string name = "Трек") => new(DeskObjectType.Matrix, Guid.NewGuid(), name);
+
+    private static DeskFinding Finding(
+        DeskKind kind,
+        DeskObject subjectOfFinding,
+        bool isAction = true,
+        DeskObject? subject = null,
+        DateTimeOffset? at = null,
+        DeskObject? target = null,
+        DeskInvitation? invitation = null) =>
+        new(kind, subjectOfFinding, isAction, subject, at, Target: target, Invitation: invitation);
+}
diff --git a/tests/Competency.Tests/DeskTrackTests.cs b/tests/Competency.Tests/DeskTrackTests.cs
new file mode 100644
index 0000000..12f3518
--- /dev/null
+++ b/tests/Competency.Tests/DeskTrackTests.cs
@@ -0,0 +1,179 @@
+using System.Net;
+using System.Text.Json.Nodes;
+using AwesomeAssertions;
+using Competency.Tests.Infrastructure;
+using Xunit;
+
+namespace Competency.Tests;
+
+/// <summary>
+/// What the desk says about tracks, their levels and the positions linked to them, about positions and employees left without a track,
+/// and about units that still lack a matrix: who is asked to act, who is only told, and what takes an item away.
+/// </summary>
+public sealed class DeskTrackTests(CareerHost fixture) : IClassFixture<CareerHost>
+{
+    [Fact]
+    public async Task Ac123_Ac124_Ac125_Ac134_ADraftTrack_AsksTheHeadToFinishItsLevelsAndPositions_AndMarksTheApprovalEarlyForTheHr()
+    {
+        var org = await CareerOrg.CreateAsync(fixture.Host);
+        var track = await org.Admin.MakeTrackAsync(org.Team.Id, (await org.Admin.MakeDirectionAsync()).Id);
+
+        var withoutLevels = await TrackItemsAsync(org, track);
+        var first = await org.Admin.MakeLevelAsync(track.Id);
+        var oneLevel = await TrackItemsAsync(org, track);
+        var linked = await org.Admin.LinkToNewPositionAsync(first, org.Team.Id);
+        var oneLevelLinked = await TrackItemsAsync(org, track);
+        var second = await org.Admin.MakeLevelAsync(track.Id);
+        var gap = await TrackItemsAsync(org, track);
+        await org.Admin.LinkToNewPositionAsync(second, org.Team.Id);
+        var readyHr = (await org.Hr.Client.ItemsAsync()).ItemFor(track.Id);
+        var readyHead = (await org.TeamHead.Client.ItemsAsync()).ItemOf(track.Id);
+
+        withoutLevels.Head.Kinds().Should().Equal("TrackWithoutLevels");
+        withoutLevels.Head["group"]!.GetValue<string>().Should().Be("PositionsToLink");
+        withoutLevels.Head["isReference"]!.GetValue<bool>().Should().BeFalse("a head edits the draft track of their unit");
+        withoutLevels.Hr.Kinds().Should().Equal("DraftAwaitsApproval");
+        withoutLevels.Hr["group"]!.GetValue<string>().Should().Be("DraftsToApprove");
+        withoutLevels.Hr.FirstReason()["details"]!["levelCount"]!.GetValue<int>().Should().Be(0);
+        withoutLevels.Hr.FirstReason()["occurredAt"].Should().NotBeNull("a draft is dated by its creation");
+        oneLevel.Head.Kinds().Should().Equal("TrackWithOneLevel", "TrackWithoutPositions");
+        oneLevel.Head.FirstReason()["details"]!["levelCount"]!.GetValue<int>().Should().Be(1);
+        EntryIds(oneLevel.Hr.FirstReason()).Should().Equal(first.Id);
+        oneLevelLinked.Head.Kinds().Should().Equal("TrackWithOneLevel");
+        EntryIds(oneLevelLinked.Hr.FirstReason()).Should().BeEmpty("the one level has a position now");
+        gap.Head.Kinds().Should().Equal("LevelWithoutPosition");
+        EntryIds(gap.Head.FirstReason()).Should().Equal(second.Id);
+        EntryIds(gap.Hr.FirstReason()).Should().Equal(second.Id);
+        readyHead.Should().BeNull();
+        readyHr.Kinds().Should().Equal("DraftAwaitsApproval");
+        EntryIds(readyHr.FirstReason()).Should().BeEmpty();
+        linked.Json!["id"]!.GetValue<Guid>().Should().Be(first.Id);
+    }
+
+    [Fact]
+    public async Task Ac132_ForAnActiveTrack_TheHrIsAskedToLinkPositions_AndTheHeadIsOnlyToldWhomToAsk()
+    {
+        var org = await CareerOrg.CreateAsync(fixture.Host);
+        var track = await org.Admin.MakeTrackAsync(org.Team.Id, (await org.Admin.MakeDirectionAsync()).Id);
+        await org.Admin.MakeLevelAsync(track.Id);
+        var last = await org.Admin.MakeLevelAsync(track.Id);
+        (await org.Admin.ActivateAsync(track, org.Team.Id)).Expect(HttpStatusCode.OK);
+        var levels = (await org.Admin.GetAsync($"/api/v1/career/tracks/{track.Id}/positions")).Expect(HttpStatusCode.OK).Json!["levels"]!.AsArray();
+        var lastLevel = levels.Single(level => level!["id"]!.GetValue<Guid>() == last.Id)!;
+        foreach (var position in lastLevel["positions"]!.AsArray())
+        {
+            var current = (await org.Admin.GetAsync($"/api/v1/positions/{position!["id"]!.GetValue<Guid>()}")).Expect(HttpStatusCode.OK);
+            (await org.Admin.PostAsync($"/api/v1/positions/{current.Id}/deactivate", ifMatch: current.ETag)).Expect(HttpStatusCode.OK);
+        }
+
+        var items = await TrackItemsAsync(org, track);
+
+        items.Head.Kinds().Should().Equal("LevelWithoutPosition");
+        items.Head["isReference"]!.GetValue<bool>().Should().BeTrue("a head cannot edit an active track");
+        items.Head["group"]!.GetValue<string>().Should().Be("PositionLinksInfo");
+        items.Head.FirstReason()["details"]!["person"]!["id"]!.GetValue<Guid>().Should().Be(org.Hr.Employee, "the head is told whom to ask");
+        EntryIds(items.Head.FirstReason()).Should().Equal(last.Id);
+        items.Hr.Kinds().Should().Equal("LevelWithoutPosition");
+        items.Hr["isReference"]!.GetValue<bool>().Should().BeFalse();
+        items.Hr["group"]!.GetValue<string>().Should().Be("PositionsToLink");
+        items.Hr.FirstReason()["details"]!["person"].Should().BeNull();
+    }
+
+    [Fact]
+    public async Task Ac122_Ac151_APositionNoActiveTrackStandsFor_IsTheHeadsToLinkOnlyWhenATrackTheyMayEditCanTakeIt_AndItAbsorbsTheHeadsOwnNoTrackNote()
+    {
+        var org = await CareerOrg.CreateAsync(fixture.Host);
+        var positionId = (await org.Admin.GetEmployeeAsync(org.TeamHead.Employee)).Json!["positionId"]!.GetValue<Guid>();
+
+        var noTrack = await org.TeamHead.Client.ItemsAsync();
+        var track = await org.Admin.MakeTrackAsync(org.Team.Id, (await org.Admin.MakeDirectionAsync()).Id);
+        var draftTrack = await org.TeamHead.Client.ItemsAsync();
+        var level = await org.Admin.MakeLevelAsync(track.Id);
+        var availableBefore = AvailableIds((await org.Admin.GetAsync($"/api/v1/career/tracks/{track.Id}/available-positions")).Expect(HttpStatusCode.OK));
+        (await org.Admin.PostAsync($"/api/v1/career/levels/{level.Id}/positions", new { positionId }, level.ETag)).Expect(HttpStatusCode.OK);
+        var availableAfter = AvailableIds((await org.Admin.GetAsync($"/api/v1/career/tracks/{track.Id}/available-positions")).Expect(HttpStatusCode.OK));
+        var linkedToDraft = await org.TeamHead.Client.ItemsAsync();
+        (await org.Admin.ActivateAsync(track, org.Team.Id)).Expect(HttpStatusCode.OK);
+        var linkedToActive = await org.TeamHead.Client.ItemsAsync();
+
+        availableBefore.Should().Contain(positionId);
+        availableAfter.Should().NotContain(positionId, "a position is linked to one level of a track at most");
+
+        var reference = noTrack.ItemFor(positionId);
+        reference.Kinds().Should().Equal("PositionWithoutTrack");
+        reference["isReference"]!.GetValue<bool>().Should().BeTrue("no track exists that the head may edit and that could take the position");
+        reference["group"]!.GetValue<string>().Should().Be("PositionLinksInfo");
+        reference.FirstReason()["details"]!["person"]!["id"]!.GetValue<Guid>().Should().Be(org.Hr.Employee);
