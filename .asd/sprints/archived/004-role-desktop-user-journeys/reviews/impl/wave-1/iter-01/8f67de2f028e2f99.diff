+        (await admin.PostAsync($"/api/v1/users/{invited.Id}/block", ifMatch: (await admin.GetUserAsync(invited.Id)).ETag)).Expect(HttpStatusCode.OK);
+
+        (await admin.ItemsAsync()).ItemOf(invited.Id).Should().BeNull();
+    }
+
+    [Fact]
