+  fakeApi.on("GET /api/v1/career/competencies", () =>
+    Response.json({
+      items: COMPETENCIES,
+      total: COMPETENCIES.length,
+      page: 1,
+      pageSize: 200,
+    }),
+  );
+}
+
+function lockedControls() {
+  const dialog = screen
+    .getByText("Новый общий блок", { selector: ".ant-modal-title" })
