index 0000000..de17728
--- /dev/null
+++ b/deploy/k8s/db.yaml
@@ -0,0 +1,106 @@
+apiVersion: v1
+kind: Service
+metadata:
+  name: db
+  labels:
+    app.kubernetes.io/name: db
+    app.kubernetes.io/part-of: competency
+spec:
+  selector:
+    app.kubernetes.io/name: db
+  ports:
+    - name: postgres
+      port: 5432
+      targetPort: postgres
+---
+apiVersion: apps/v1
+kind: StatefulSet
+metadata:
+  name: db
+  labels:
+    app.kubernetes.io/name: db
+    app.kubernetes.io/part-of: competency
+spec:
+  serviceName: db
+  replicas: 1
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: db
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: db
+        app.kubernetes.io/part-of: competency
+    spec:
+      automountServiceAccountToken: false
+      # The image stops on SIGINT (fast shutdown); a runtime that sends SIGTERM instead makes PostgreSQL
+      # wait for clients, so the grace period must outlast that or the pod is killed into crash recovery.
+      terminationGracePeriodSeconds: 120
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 999
+        runAsGroup: 999
+        # A non-root entrypoint does not chown the volume; initdb needs it writable by uid 999.
+        fsGroup: 999
+        fsGroupChangePolicy: OnRootMismatch
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: db
+          image: postgres:18.6-trixie@sha256:<DIGEST>
+          imagePullPolicy: IfNotPresent
+          ports:
+            - name: postgres
+              containerPort: 5432
+          envFrom:
+            - configMapRef:
+                name: db-config
+          env:
+            - name: POSTGRES_PASSWORD
+              valueFrom:
+                secretKeyRef:
+                  name: competency-secret
+                  key: POSTGRES_PASSWORD
+          securityContext:
+            allowPrivilegeEscalation: false
+            capabilities:
+              drop: [ALL]
+          # TCP on purpose: during first-start initialisation the entrypoint runs a temporary server on the socket only.
+          startupProbe:
+            exec:
+              command: ["sh", "-c", "pg_isready -h 127.0.0.1 -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""]
+            periodSeconds: 5
+            failureThreshold: 60
+          readinessProbe:
+            exec:
+              command: ["sh", "-c", "pg_isready -h 127.0.0.1 -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""]
+            periodSeconds: 10
+            timeoutSeconds: 5
+          livenessProbe:
+            exec:
+              command: ["sh", "-c", "pg_isready -h 127.0.0.1 -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""]
+            periodSeconds: 20
+            timeoutSeconds: 5
+            failureThreshold: 6
+          volumeMounts:
+            # PostgreSQL 18 images declare VOLUME /var/lib/postgresql and keep the cluster in the 18/docker subdirectory of it.
+            # A mount at /var/lib/postgresql/data makes the entrypoint refuse to start (checked on the image); a mount elsewhere
+            # leaves the cluster in the container layer. The data directory variable is left at the image default for the same reason.
+            - name: data
+              mountPath: /var/lib/postgresql
+            - name: dshm
+              mountPath: /dev/shm
+      volumes:
+        # The default 64 MiB /dev/shm runs out under parallel queries.
+        - name: dshm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 256Mi
+  volumeClaimTemplates:
+    - metadata:
+        name: data
+      spec:
+        accessModes: [ReadWriteOnce]
+        resources:
+          requests:
+            storage: 10Gi
diff --git a/deploy/secret.template.yaml b/deploy/secret.template.yaml
new file mode 100644
index 0000000..2b557c3
--- /dev/null
+++ b/deploy/secret.template.yaml
@@ -0,0 +1,19 @@
+# Template only. Copy it outside the repository, replace every <PLACEHOLDER>, apply it, delete the copy.
+# Real values are never committed. It sits above deploy/k8s so that `kubectl apply -f deploy/k8s/`
+# cannot create a Secret with placeholders (PostgreSQL would keep such a password in its data directory).
+apiVersion: v1
+kind: Secret
+metadata:
+  name: competency-secret
+  labels:
+    app.kubernetes.io/part-of: competency
+type: Opaque
+stringData:
+  POSTGRES_PASSWORD: "<POSTGRES_PASSWORD>"
+  # Same password as above; Database and Username must match db-config. No ';' or quotes in the password.
+  # "GSS Encryption Mode=Disable": the image has no Kerberos library, and without it every start prints
+  # "Cannot load library libgssapi_krb5.so.2" to stderr (harmless, but noise in a JSON log).
+  ConnectionStrings__Default: "Host=db;Port=5432;Database=competency;Username=competency;Password=<POSTGRES_PASSWORD>;GSS Encryption Mode=Disable"
+  # E-mail and password of the first global administrator are deployment parameters. The e-mail is the sign-in name.
+  Bootstrap__AdminEmail: "<ADMIN_EMAIL>"
+  Bootstrap__AdminPassword: "<ADMIN_PASSWORD>"
