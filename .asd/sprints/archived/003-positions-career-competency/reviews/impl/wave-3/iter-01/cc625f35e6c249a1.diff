@@ -0,0 +1,116 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import {
+  App,
+  Button,
+  Empty,
+  Table,
+  type TableColumnsType,
+  Typography,
+} from "antd";
+import { useState } from "react";
+import { describeApiError } from "../../app/apiErrors";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import {
+  approveDraft,
+  type CatalogDraft,
+  type CatalogKind,
+  type DraftListParams,
+  draftsQuery,
+  invalidateCatalogs,
+} from "./catalogApi";
+import { choiceFilter, onFilterChange } from "./columnFilters";
+import { unitFilter } from "./UnitTreeFilter";
+import { useCatalogRights } from "./useCatalogRights";
+
+const KIND_LABELS: Record<CatalogKind, string> = {
+  Direction: "Направление",
+  Track: "Трек",
+  Category: "Категория",
+  Competency: "Компетенция",
+  Scale: "Шкала",
+};
+
+/** Draft entries waiting for the signed-in HR, each approved from the row. Nothing is shown to a user who is no HR. */
+export function DraftsSection() {
+  const rights = useCatalogRights();
+  const { message } = App.useApp();
+  const queryClient = useQueryClient();
+  const [params, setParams] = useState<DraftListParams>({});
+  const { data, error, isFetching, refetch } = useQuery({
+    ...draftsQuery(params),
+    enabled: rights.isHr,
+  });
+  const approve = useMutation({
+    mutationFn: approveDraft,
+    onError: (failure) => message.error(describeApiError(failure)),
+    onSettled: () => invalidateCatalogs(queryClient),
+  });
+
+  if (!rights.isHr) return null;
+
+  const columns: TableColumnsType<CatalogDraft> = [
+    { title: "Запись", dataIndex: "name" },
+    {
+      title: "Тип",
+      dataIndex: "kind",
+      ...choiceFilter(
+        "kind",
+        params.kind,
+        Object.entries(KIND_LABELS).map(([value, text]) => ({ text, value })),
+      ),
+      render: (kind: CatalogKind) => KIND_LABELS[kind],
+    },
+    {
+      title: "Подразделение",
+      dataIndex: "ownerOrgUnitName",
+      ...unitFilter("orgUnitId", params.orgUnitId),
+      render: (name: string | null) => name ?? "Общая",
+    },
+    { title: "Автор", dataIndex: "authorName" },
+    {
+      title: "Действия",
+      key: "actions",
+      render: (_, draft) =>
+        rights.canManage(draft.ownerOrgUnitId ?? undefined) && (
+          <Button
+            type="link"
+            size="small"
+            disabled={approve.isPending}
+            onClick={() => approve.mutate(draft)}
+          >
+            Согласовать
+          </Button>
+        ),
+    },
+  ];
+
+  return (
+    <section>
+      <Typography.Title level={2}>Черновые записи</Typography.Title>
+      {error && (
+        <ErrorAlert
+          title="Не удалось загрузить черновые записи"
+          error={error}
+          onRetry={() => void refetch()}
+        />
+      )}
+      <Table<CatalogDraft>
+        rowKey={(draft) => `${draft.kind}:${draft.id}`}
+        columns={columns}
+        dataSource={data}
+        loading={isFetching}
+        pagination={false}
+        scroll={{ x: "max-content" }}
+        onChange={onFilterChange(setParams)}
+        locale={{
+          emptyText: (
+            <Empty
+              image={Empty.PRESENTED_IMAGE_SIMPLE}
+              description="Черновых записей нет"
+            />
+          ),
+        }}
+      />
+    </section>
+  );
+}
diff --git a/web/src/features/career/LevelModal.tsx b/web/src/features/career/LevelModal.tsx
new file mode 100644
index 0000000..9ce0cae
--- /dev/null
+++ b/web/src/features/career/LevelModal.tsx
@@ -0,0 +1,125 @@
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { Form, Input } from "antd";
+import { api } from "../../api/client";
+import { ifMatchOf } from "../../api/ifMatch";
+import { unwrap } from "../../api/unwrap";
+import { useEditBase } from "../../app/useEditBase";
+import { useFormSubmit } from "../../app/useFormSubmit";
+import { CatalogModal, FormActions } from "./CatalogModal";
+import { type CareerLevel, invalidateCatalogs } from "./catalogApi";
+
+const NAME_MAX_LENGTH = 200;
+const FIELDS = ["name"] as const;
+
+export interface LevelValues {
+  name: string;
+}
+
+/** Creates a level of the track; the server puts it after the track's other levels. */
+export async function createLevel(trackId: string, values: LevelValues) {
+  return unwrap(
+    await api.POST("/api/v1/career/levels", {
+      body: { name: values.name, trackId },
+    }),
+  );
+}
+
+interface LevelModalProps {
+  /** Track of a level being created and saved at once; omitted when the level waits for its track to be saved. */
+  trackId?: string;
+  /** Level being edited as the cache holds it now; omitted when one is created. */
+  level?: CareerLevel;
+  /** Values of a level that waits for its track; set with `onCollect`. */
+  draft?: LevelValues;
+  /** Takes the values instead of saving the level, for a track that is not saved yet. */
+  onCollect?: (values: LevelValues) => void;
+  onClose: () => void;
+}
+
+/** Dialog that creates a level of a track or renames one. */
+export function LevelModal({
+  trackId,
+  level: latest,
+  draft,
+  onCollect,
+  onClose,
+}: LevelModalProps) {
+  const queryClient = useQueryClient();
+  const { base: level, noteSaveFailure } = useEditBase(latest);
+  const save = useMutation({
+    mutationFn: async (values: LevelValues) => {
+      if (onCollect) {
+        onCollect(values);
+        return;
+      }
+      if (!level) {
+        if (trackId) await createLevel(trackId, values);
+        return;
+      }
+      unwrap(
+        await api.PUT("/api/v1/career/levels/{id}", {
+          params: {
+            path: { id: level.id },
+            header: { "If-Match": ifMatchOf(level.version) },
+          },
+          body: { name: values.name },
+        }),
+      );
+    },
+    onSuccess: onClose,
+    onError: noteSaveFailure,
+    onSettled: () => invalidateCatalogs(queryClient),
+  });
+
+  return (
+    <CatalogModal
+      title={level || draft ? "Изменение уровня" : "Новый уровень"}
+      error={save.error}
+      fields={FIELDS}
+      onClose={onClose}
+    >
+      <LevelForm
+        key={level?.version}
+        initialName={draft?.name ?? level?.name ?? ""}
+        onSubmit={(values) => save.mutateAsync(values)}
+        onCancel={onClose}
+      />
+    </CatalogModal>
+  );
+}
+
+interface LevelFormProps {
+  initialName: string;
+  onSubmit: (values: LevelValues) => Promise<unknown>;
+  onCancel: () => void;
+}
+
+function LevelForm({ initialName, onSubmit, onCancel }: LevelFormProps) {
+  const [form] = Form.useForm<LevelValues>();
+  const { isSubmitting, submit } = useFormSubmit(form, onSubmit);
+
+  return (
+    <Form
+      form={form}
+      name="career-level"
+      layout="vertical"
+      initialValues={{ name: initialName }}
+      onFinish={submit}
+    >
+      <Form.Item
+        name="name"
+        label="Название"
+        rules={[
+          { required: true, whitespace: true, message: "Укажите название" },
+          {
+            max: NAME_MAX_LENGTH,
+            message: `Не длиннее ${NAME_MAX_LENGTH} символов`,
+          },
+        ]}
+      >
+        <Input autoComplete="off" />
+      </Form.Item>
+      <FormActions isSubmitting={isSubmitting} onCancel={onCancel} />
+    </Form>
+  );
+}
diff --git a/web/src/features/career/MatricesTab.tsx b/web/src/features/career/MatricesTab.tsx
new file mode 100644
index 0000000..7348858
--- /dev/null
+++ b/web/src/features/career/MatricesTab.tsx
@@ -0,0 +1,134 @@
+import { useQuery } from "@tanstack/react-query";
+import {
+  Button,
+  Empty,
+  Flex,
+  Space,
+  Table,
+  type TableColumnsType,
+  Tag,
+} from "antd";
+import { useState } from "react";
+import { Link } from "react-router";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import { useProcessRoles } from "./careerApi";
+import { directionsQuery, tracksQuery } from "./catalogApi";
+import type { FilterOption } from "./columnFilters";
+import { choiceFilter, entryOptions, onFilterChange } from "./columnFilters";
+import { MatrixCreateModal } from "./MatrixCreateModal";
+import { MatrixDeleteButton } from "./MatrixDeleteButton";
+import { type Matrix, type MatrixListParams, matricesQuery } from "./matrixApi";
+import { VERSION_STATUS_LABELS } from "./matrixLabels";
+import { unitFilter } from "./UnitTreeFilter";
+
+const DEFAULT_PAGE_SIZE = 20;
+
+function versionCell(version: Matrix["inWorkVersion"]) {
+  return (
+    version && (
+      <Space size="small">
+        {`Версия ${version.number}`}
+        <Tag>{VERSION_STATUS_LABELS[version.status]}</Tag>
+      </Space>
+    )
+  );
+}
+
+function columns(
+  params: MatrixListParams,
+  directions: FilterOption[],
+  tracks: FilterOption[],
+): TableColumnsType<Matrix> {
+  return [
+    {
+      title: "Подразделение",
+      dataIndex: "orgUnitName",
+      ...unitFilter("orgUnitId", params.orgUnitId),
+    },
+    {
+      title: "Направление",
+      dataIndex: "directionName",
+      ...choiceFilter("directionId", params.directionId, directions, true),
+    },
+    {
+      title: "Трек",
+      dataIndex: "trackName",
+      ...choiceFilter("trackId", params.trackId, tracks, true),
+      render: (name: string, matrix) => (
+        <Link to={`/career/matrices/${matrix.id}`}>{name}</Link>
+      ),
+    },
+    {
+      title: "Опубликована",
+      dataIndex: "publishedVersion",
+      render: versionCell,
+    },
+    { title: "В работе", dataIndex: "inWorkVersion", render: versionCell },
+    {
+      title: "Действия",
+      key: "actions",
+      render: (_, matrix) => <MatrixDeleteButton matrix={matrix} />,
+    },
+  ];
+}
+
+/** The matrices of the units, filtered by unit, direction and track in the column headers; a unit head may start one. */
+export function MatricesTab() {
+  const roles = useProcessRoles();
+  const [isCreating, setIsCreating] = useState(false);
+  const [params, setParams] = useState<MatrixListParams>({
+    page: 1,
+    pageSize: DEFAULT_PAGE_SIZE,
+  });
+  const { data, error, isFetching, refetch } = useQuery({
+    ...matricesQuery(params),
+    placeholderData: (previous) => previous,
+  });
+  const directions = entryOptions(useQuery(directionsQuery()).data?.items);
+  const tracks = entryOptions(useQuery(tracksQuery()).data?.items);
+  const canCreate = (roles.data?.headedUnits.length ?? 0) > 0;
+
+  return (
+    <Space orientation="vertical" size="large" style={{ display: "flex" }}>
+      {canCreate && (
+        <Flex>
+          <Button type="primary" onClick={() => setIsCreating(true)}>
+            Создать матрицу
+          </Button>
+        </Flex>
+      )}
+      {error && (
+        <ErrorAlert
+          title="Не удалось загрузить матрицы"
+          error={error}
+          onRetry={() => void refetch()}
+        />
+      )}
+      <Table<Matrix>
+        rowKey="id"
+        columns={columns(params, directions, tracks)}
+        dataSource={data?.items}
+        loading={isFetching}
+        scroll={{ x: "max-content" }}
+        onChange={onFilterChange(setParams)}
+        locale={{
+          emptyText: (
+            <Empty
+              image={Empty.PRESENTED_IMAGE_SIMPLE}
+              description="Матриц пока нет"
+            />
+          ),
+        }}
+        pagination={{
+          current: params.page,
+          pageSize: params.pageSize,
+          total: data?.total ?? 0,
+          showSizeChanger: true,
+          onChange: (page, pageSize) =>
+            setParams((previous) => ({ ...previous, page, pageSize })),
+        }}
+      />
+      {isCreating && <MatrixCreateModal onClose={() => setIsCreating(false)} />}
+    </Space>
+  );
+}
diff --git a/web/src/features/career/MatrixBlocks.tsx b/web/src/features/career/MatrixBlocks.tsx
new file mode 100644
index 0000000..5823296
--- /dev/null
+++ b/web/src/features/career/MatrixBlocks.tsx
@@ -0,0 +1,242 @@
+import { EditOutlined } from "@ant-design/icons";
+import {
+  Button,
+  Checkbox,
+  Input,
+  InputNumber,
+  Space,
+  Table,
+  type TableColumnsType,
+  Tag,
+  Typography,
+} from "antd";
+import type { MatrixBlock, MatrixContent } from "./matrixApi";
+import {
+  addBlock,
+  type ChangedPlaces,
+  cellKey,
+  hasCompetencies,
+  removeBlock,
+  setBlockWeight,
+  updateBlock,
+} from "./matrixContent";
+import { CHANGED_NOTE } from "./matrixLabels";
+
+const MAX_PERCENT = 100;
+const NO_VALUE = "—";
+
+interface PercentFieldProps {
+  label: string;
+  value: number | null;
+  isEditable: boolean;
+  isChanged: boolean;
+  onChange: (value: number | null) => void;
+}
+
+function PercentField({
+  label,
+  value,
+  isEditable,
+  isChanged,
+  onChange,
+}: PercentFieldProps) {
+  return (
+    <Space size="small">
+      {isEditable ? (
+        <InputNumber
+          aria-label={label}
+          min={0}
+          max={MAX_PERCENT}
+          value={value}
+          onChange={onChange}
+        />
+      ) : (
+        (value ?? NO_VALUE)
+      )}
+      {isChanged && (
+        <EditOutlined
+          role="img"
+          aria-label={CHANGED_NOTE}
+          title={CHANGED_NOTE}
+        />
+      )}
+    </Space>
+  );
+}
+
+interface MatrixBlocksProps {
+  content: MatrixContent;
+  /** The levels of the content in track order. */
+  levelIds: readonly string[];
+  levelNames: ReadonlyMap<string, string>;
+  changed: ChangedPlaces;
+  isEditable: boolean;
+  onChange: (content: MatrixContent) => void;
+}
+
+/** The blocks of competencies with their coefficients and thresholds per level. */
+export function MatrixBlocks({
+  content,
+  levelIds,
+  levelNames,
+  changed,
+  isEditable,
+  onChange,
+}: MatrixBlocksProps) {
+  const levelColumns: TableColumnsType<MatrixBlock> = levelIds.map(
+    (levelId) => {
+      const levelName = levelNames.get(levelId) ?? "";
+      const weightOf = (block: MatrixBlock) =>
+        content.blockWeights.find(
+          (weight) => weight.levelId === levelId && weight.blockId === block.id,
+        );
+      const isChanged = (block: MatrixBlock) =>
+        changed.weightCells.has(cellKey(levelId, block.id));
+      return {
+        key: levelId,
+        title: levelName,
+        children: [
+          {
+            key: `${levelId}:percent`,
+            title: "Коэффициент, %",
+            onCell: (block) => ({
+              className: isChanged(block) ? "matrix-changed" : undefined,
+            }),
+            render: (_, block) => (
+              <PercentField
+                label={`Коэффициент, %: ${levelName}, ${block.name}`}
+                value={weightOf(block)?.percent ?? null}
+                isEditable={isEditable}
+                isChanged={isChanged(block)}
+                onChange={(value) =>
+                  onChange(
+                    setBlockWeight(
+                      content,
+                      levelId,
+                      block.id,
+                      "percent",
+                      value,
+                    ),
+                  )
+                }
+              />
+            ),
+          },
+          {
+            key: `${levelId}:min`,
+            title: "Минимальный порог блока",
+            onCell: (block) => ({
+              className: isChanged(block) ? "matrix-changed" : undefined,
+            }),
+            render: (_, block) => (
+              <PercentField
+                label={`Минимальный порог блока: ${levelName}, ${block.name}`}
+                value={weightOf(block)?.minPercent ?? null}
+                isEditable={isEditable}
+                isChanged={false}
+                onChange={(value) =>
+                  onChange(
+                    setBlockWeight(
+                      content,
+                      levelId,
+                      block.id,
+                      "minPercent",
+                      value,
+                    ),
+                  )
+                }
+              />
+            ),
+          },
+        ],
+      };
+    },
+  );
+  const columns: TableColumnsType<MatrixBlock> = [
+    {
+      title: "Название блока",
+      key: "name",
+      render: (_, block) => (
+        <Space orientation="vertical" size="small">
+          {isEditable ? (
+            <Input
+              aria-label="Название блока"
+              autoComplete="off"
+              value={block.name}
+              onChange={(event) =>
+                onChange(
+                  updateBlock(content, block.id, { name: event.target.value }),
+                )
+              }
+            />
+          ) : (
+            block.name
+          )}
+          {changed.blocks.has(block.id) && (
+            <Tag icon={<EditOutlined />} color="warning">
+              {CHANGED_NOTE}
+            </Tag>
+          )}
+        </Space>
+      ),
+    },
+    {
+      title: "Обязательный блок",
+      key: "isMandatory",
+      render: (_, block) => (
+        <Checkbox
+          disabled={!isEditable}
+          checked={block.isMandatory}
+          onChange={(event) =>
+            onChange(
+              updateBlock(content, block.id, {
+                isMandatory: event.target.checked,
+              }),
+            )
+          }
+        >
+          Обязательный блок
+        </Checkbox>
+      ),
+    },
+    ...levelColumns,
+  ];
+  if (isEditable) {
+    columns.push({
+      title: "Действия",
+      key: "actions",
+      render: (_, block) => (
+        <Button
+          type="link"
+          size="small"
+          danger
+          disabled={hasCompetencies(content, block.id)}
+          onClick={() => onChange(removeBlock(content, block.id))}
+        >
+          Удалить
+        </Button>
+      ),
+    });
+  }
+
+  return (
+    <section>
+      <Typography.Title level={2}>Блоки компетенций</Typography.Title>
+      <Space orientation="vertical" size="middle" style={{ display: "flex" }}>
+        <Table<MatrixBlock>
+          className="matrix-grid"
+          rowKey="id"
+          columns={columns}
+          dataSource={[...content.blocks]}
+          pagination={false}
+          scroll={{ x: "max-content" }}
+        />
+        {isEditable && (
+          <Button onClick={() => onChange(addBlock(content))}>
+            Добавить блок
+          </Button>
+        )}
+      </Space>
+    </section>
+  );
+}
diff --git a/web/src/features/career/MatrixCreateModal.test.tsx b/web/src/features/career/MatrixCreateModal.test.tsx
new file mode 100644
index 0000000..4be8741
--- /dev/null
+++ b/web/src/features/career/MatrixCreateModal.test.tsx
@@ -0,0 +1,227 @@
+import { act, render, screen, waitFor, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { MemoryRouter, Route, Routes } from "react-router";
+import { beforeEach, describe, expect, it } from "vitest";
+import { queryClient } from "../../api/queryClient";
+import { Providers } from "../../app/Providers";
+import { fakeApi, problem } from "../../test/fakeApi";
+import { LONG_FLOW_TIMEOUT } from "../../test/timeouts";
+import { careerQueryKey } from "./careerApi";
+import { MatrixCreateModal } from "./MatrixCreateModal";
+
+const unit = (id: string, name: string, parentId: string | null) => ({
+  id,
+  name,
+  parentId,
+  headEmployeeId: null,
+  isActive: true,
+  version: 1,
+});
+
+const UNITS = [
+  unit("root", "Компания", null),
+  unit("department", "Департамент", "root"),
+  unit("team", "Команда", "department"),
+  unit("sibling", "Соседняя команда", "department"),
+  unit("branch", "Филиал", "team"),
+];
+
+const track = (id: string, name: string, ownerOrgUnitId: string) => ({
+  id,
+  name,
+  directionId: "direction",
+  status: "Active",
+  ownerOrgUnitId,
+  ownerOrgUnitName: ownerOrgUnitId,
+  version: 1,
+});
+
+const page = (items: object[]) => ({
+  items,
+  total: items.length,
+  page: 1,
+  pageSize: 200,
+});
+
+function serve() {
+  fakeApi.on("GET /api/v1/auth/me", () =>
+    Response.json({ id: "account", email: "head@test.local", role: "User" }),
+  );
+  fakeApi.on("GET /api/v1/career/me", () =>
+    Response.json({
+      headedUnits: [
+        { id: "team", name: "Команда" },
+        { id: "department", name: "Департамент" },
+      ],
+      hrUnits: [],
+    }),
+  );
+  fakeApi.on("GET /api/v1/org-units/tree", () => Response.json(UNITS));
+  fakeApi.on("GET /api/v1/career/directions", () =>
+    Response.json(
+      page([
+        { id: "direction", name: "Разработка", status: "Active", version: 1 },
+      ]),
+    ),
+  );
+  fakeApi.on("GET /api/v1/career/tracks", () =>
+    Response.json(
+      page([
+        track("t-root", "Трек компании", "root"),
+        track("t-department", "Трек департамента", "department"),
+        track("t-team", "Трек команды", "team"),
+        track("t-sibling", "Трек соседей", "sibling"),
+        track("t-branch", "Трек филиала", "branch"),
+      ]),
+    ),
+  );
+  fakeApi.on("GET /api/v1/career/scales", () =>
+    Response.json(
+      page([
+        {
+          id: "scale",
+          name: "Базовая 0–4",
+          points: [],
+          isDefault: true,
+          status: "Active",
+          version: 1,
+        },
+      ]),
+    ),
+  );
+}
+
+async function openModal() {
+  serve();
+  render(
+    <Providers>
+      <MemoryRouter initialEntries={["/career"]}>
+        <Routes>
+          <Route
+            path="/career"
+            element={<MatrixCreateModal onClose={() => undefined} />}
+          />
+          <Route path="/career/matrices/:id" element={<p>Открыта матрица</p>} />
+        </Routes>
+      </MemoryRouter>
+    </Providers>,
+  );
+  await waitFor(() =>
+    expect(queryClient.getQueryData([...careerQueryKey, "me"])).toBeDefined(),
+  );
+  await act(async () => undefined);
+  return userEvent.setup();
+}
+
+async function choose(
+  user: ReturnType<typeof userEvent.setup>,
+  field: string,
+  option: string,
+) {
+  await user.click(screen.getByRole("combobox", { name: field }));
+  await user.click(
+    await screen.findByText(option, {
+      selector: ".ant-select-item-option-content",
+    }),
+  );
+}
+
+async function openTracks(user: ReturnType<typeof userEvent.setup>) {
+  const combobox = screen.getByRole("combobox", { name: "Трек" });
+  await user.click(combobox);
+  const dropdown = await waitFor(() => {
+    const list = document.getElementById(
+      combobox.getAttribute("aria-controls") ?? "",
+    );
+    expect(list).not.toBeNull();
+    return list?.closest(".ant-select-dropdown") as HTMLElement;
+  });
+  return Array.from(
+    dropdown.querySelectorAll(".ant-select-item-option-content"),
+  ).map((option) => option.textContent);
+}
+
+beforeEach(() => {
+  queryClient.clear();
+});
+
+describe("starting a matrix (AC-14)", { timeout: LONG_FLOW_TIMEOUT }, () => {
+  it("offers the units the user heads, and only the tracks of the chosen unit and of the units above it", async () => {
+    const user = await openModal();
+    await choose(user, "Подразделение", "Команда");
+    await choose(user, "Направление", "Разработка");
+
+    expect(await openTracks(user)).toEqual([
+      "Трек компании",
+      "Трек департамента",
+      "Трек команды",
+    ]);
+  });
+
+  it("changes the tracks when another unit is chosen and clears the track chosen before", async () => {
+    const user = await openModal();
+    await choose(user, "Подразделение", "Команда");
+    await choose(user, "Направление", "Разработка");
+    await choose(user, "Трек", "Трек команды");
+
+    await choose(user, "Подразделение", "Департамент");
+
+    const track = screen.getByRole("combobox", { name: "Трек" });
+    expect(
+      within(track.closest(".ant-select") as HTMLElement).queryByText(
+        "Трек команды",
+      ),
+    ).not.toBeInTheDocument();
+    expect(await openTracks(user)).toEqual([
+      "Трек компании",
+      "Трек департамента",
+    ]);
+  });
+
+  it("creates the matrix with the four choices and opens it", async () => {
+    fakeApi.on("POST /api/v1/career/matrices", () =>
+      Response.json({ id: "new-matrix" }),
+    );
+    const user = await openModal();
+    await choose(user, "Подразделение", "Команда");
+    await choose(user, "Направление", "Разработка");
+    await choose(user, "Трек", "Трек департамента");
+    await choose(user, "Шкала", "Базовая 0–4");
+
+    await user.click(screen.getByRole("button", { name: "Сохранить" }));
+
+    expect(await screen.findByText("Открыта матрица")).toBeInTheDocument();
+    expect(
+      await fakeApi.calls("POST /api/v1/career/matrices")[0]?.json(),
+    ).toEqual({
+      orgUnitId: "team",
+      directionId: "direction",
+      trackId: "t-department",
+      scaleId: "scale",
+    });
+  });
+
+  it("shows under the track that the unit has a matrix for it already", async () => {
+    fakeApi.on("POST /api/v1/career/matrices", () =>
+      problem(409, {
+        errors: {
+          trackId: ["У подразделения уже есть матрица для этого трека"],
+        },
+      }),
+    );
+    const user = await openModal();
+    await choose(user, "Подразделение", "Команда");
+    await choose(user, "Направление", "Разработка");
+    await choose(user, "Трек", "Трек команды");
+    await choose(user, "Шкала", "Базовая 0–4");
+
+    await user.click(screen.getByRole("button", { name: "Сохранить" }));
+
+    expect(
+      await screen.findByText(
+        "У подразделения уже есть матрица для этого трека",
+      ),
+    ).toBeInTheDocument();
+    expect(screen.queryByText("Открыта матрица")).not.toBeInTheDocument();
+  });
+});
diff --git a/web/src/features/career/MatrixCreateModal.tsx b/web/src/features/career/MatrixCreateModal.tsx
