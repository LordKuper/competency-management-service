+import type { OrgUnit } from "./orgStructureApi";
+import { UnitHrModal } from "./UnitHrModal";
+
+const UNIT: OrgUnit = {
+  id: "sales",
+  name: "Продажи",
+  parentId: "company",
+  headEmployeeId: null,
+  isActive: true,
+  version: 1,
+};
+
+const person = (
+  userId: string,
+  name: string,
+  unit: string,
+  unitName: string,
+) => ({
+  userId,
+  name,
+  orgUnitId: unit,
+  orgUnitName: unitName,
+});
+
+function serve(
+  role: "GlobalAdmin" | "User",
+  hr: { assigned: unknown; inherited: unknown },
+) {
+  fakeApi.on("GET /api/v1/auth/me", () =>
+    Response.json({ id: "a", email: "a@test.local", role }),
+  );
+  fakeApi.on("GET /api/v1/career/org-units/sales/hr", () => Response.json(hr));
+  fakeApi.on("GET /api/v1/users", () =>
+    Response.json({
+      items: [
+        { id: "u1", email: "ivanova@test.local", employeeName: "Иванова Анна" },
+        { id: "u2", email: "petrov@test.local", employeeName: null },
+      ],
+      total: 2,
+      page: 1,
+      pageSize: 20,
+    }),
+  );
+}
+
+async function openModal() {
+  render(
+    <Providers>
+      <UnitHrModal unit={UNIT} onClose={() => undefined} />
+    </Providers>,
+  );
+  return userEvent.setup();
+}
+
+async function dialogTitled(title: string) {
+  const [heading] = await screen.findAllByText(title, {
+    selector: ".ant-modal-title, .ant-modal-confirm-title",
+  });
+  return heading?.closest('[role="dialog"]') as HTMLElement;
+}
+
+beforeEach(() => {
+  queryClient.clear();
+});
+
+describe("HR of a unit (AC-8)", { timeout: LONG_FLOW_TIMEOUT }, () => {
+  it("shows the assigned HR and the one inherited from above", async () => {
+    serve("User", {
+      assigned: person("u1", "Иванова Анна", "sales", "Продажи"),
+      inherited: person("u2", "Петров Пётр", "company", "Компания"),
+    });
+    await openModal();
+
+    const dialog = await dialogTitled("HR подразделения «Продажи»");
+    expect(
+      await within(dialog).findByText("Закреплён: Иванова Анна"),
+    ).toBeInTheDocument();
+    expect(
+      within(dialog).getByText("Унаследован из «Компания»: Петров Пётр"),
+    ).toBeInTheDocument();
+  });
+
+  it("says «HR не назначен» for a unit with neither", async () => {
+    serve("User", { assigned: null, inherited: null });
+    await openModal();
+
+    expect(await screen.findByText("HR не назначен")).toBeInTheDocument();
+  });
+
+  it("leaves assigning and removing to administrators", async () => {
+    serve("User", {
+      assigned: person("u1", "Иванова Анна", "sales", "Продажи"),
+      inherited: null,
+    });
+    await openModal();
+
+    await screen.findByText("Закреплён: Иванова Анна");
+    expect(
+      screen.queryByRole("button", { name: "Закрепить" }),
+    ).not.toBeInTheDocument();
+    expect(
+      screen.queryByRole("button", { name: "Снять закрепление" }),
+    ).not.toBeInTheDocument();
+  });
+
+  it("assigns the chosen account, offering accounts by employee name and e-mail", async () => {
+    serve("GlobalAdmin", { assigned: null, inherited: null });
+    fakeApi.on(
+      "PUT /api/v1/career/org-units/sales/hr",
+      () => new Response(null, { status: 204 }),
+    );
+    const user = await openModal();
+    await screen.findByText("HR не назначен");
+
+    await user.click(screen.getByRole("combobox", { name: "Пользователь" }));
+    expect(await screen.findByText("petrov@test.local")).toBeInTheDocument();
+    await user.click(screen.getByText("Иванова Анна (ivanova@test.local)"));
+    await user.click(screen.getByRole("button", { name: "Закрепить" }));
+
+    await waitFor(() =>
+      expect(
+        fakeApi.calls("PUT /api/v1/career/org-units/sales/hr"),
+      ).toHaveLength(1),
+    );
+    expect(
+      await fakeApi.calls("PUT /api/v1/career/org-units/sales/hr")[0]?.json(),
+    ).toEqual({
+      userId: "u1",
+    });
+  });
+
+  it("shows the refusal of an account that cannot act under the field", async () => {
+    serve("GlobalAdmin", { assigned: null, inherited: null });
+    fakeApi.on("PUT /api/v1/career/org-units/sales/hr", () =>
+      problem(400, {
+        errors: {
+          userId: ["Учётная запись заблокирована или не завершила регистрацию"],
+        },
+      }),
+    );
+    const user = await openModal();
+    await screen.findByText("HR не назначен");
+
+    await user.click(screen.getByRole("combobox", { name: "Пользователь" }));
+    await user.click(await screen.findByText("petrov@test.local"));
+    await user.click(screen.getByRole("button", { name: "Закрепить" }));
+
+    expect(
+      await screen.findByText(
+        "Учётная запись заблокирована или не завершила регистрацию",
+      ),
+    ).toBeInTheDocument();
+  });
+
+  it("removes the assignment after a confirmation that names what follows, focused on «Отмена»", async () => {
+    serve("GlobalAdmin", {
+      assigned: person("u1", "Иванова Анна", "sales", "Продажи"),
+      inherited: null,
+    });
+    fakeApi.on(
+      "DELETE /api/v1/career/org-units/sales/hr",
+      () => new Response(null, { status: 204 }),
+    );
+    const user = await openModal();
+    await screen.findByText("Закреплён: Иванова Анна");
+
+    await user.click(screen.getByRole("button", { name: "Снять закрепление" }));
+
+    const confirm = await dialogTitled("Снять закрепление HR?");
+    expect(
+      within(confirm).getByText(
+        "Ответственным станет HR вышестоящего подразделения, если он назначен.",
+      ),
+    ).toBeInTheDocument();
+    expect(
+      within(confirm).getByRole("button", { name: "Отмена" }),
+    ).toHaveFocus();
+    await user.click(
+      within(confirm).getByRole("button", { name: "Снять закрепление" }),
+    );
+    await waitFor(() =>
+      expect(
+        fakeApi.calls("DELETE /api/v1/career/org-units/sales/hr"),
+      ).toHaveLength(1),
+    );
+  });
+
+  it("offers no removal for a unit that only inherits its HR", async () => {
+    serve("GlobalAdmin", {
+      assigned: null,
+      inherited: person("u2", "Петров Пётр", "company", "Компания"),
+    });
+    await openModal();
+
+    await screen.findByText("Унаследован из «Компания»: Петров Пётр");
+    expect(
+      screen.queryByRole("button", { name: "Снять закрепление" }),
+    ).not.toBeInTheDocument();
+    expect(
+      screen.getByRole("button", { name: "Закрепить" }),
+    ).toBeInTheDocument();
+  });
+});
diff --git a/web/src/features/org-structure/UnitHrModal.tsx b/web/src/features/org-structure/UnitHrModal.tsx
new file mode 100644
index 0000000..f133345
--- /dev/null
+++ b/web/src/features/org-structure/UnitHrModal.tsx
@@ -0,0 +1,166 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { App, Button, Form, Select, Skeleton, Space, Typography } from "antd";
+import { useState } from "react";
+import { api } from "../../api/client";
+import { unwrap } from "../../api/unwrap";
+import { AppModal } from "../../app/AppModal";
+import { describeApiError } from "../../app/apiErrors";
+import { destructiveConfirm } from "../../app/destructiveConfirm";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import { useDebouncedValue } from "../../app/useDebouncedValue";
+import { useFormSubmit } from "../../app/useFormSubmit";
+import { useIsAdmin } from "../auth/useCurrentUser";
+import { careerQueryKey, unitHrQuery } from "../career/careerApi";
+import { userListQuery } from "../users/usersApi";
+import type { OrgUnit } from "./orgStructureApi";
+
+const PICKER_PAGE_SIZE = 20;
+
+interface UnitHrModalProps {
+  unit: OrgUnit;
+  onClose: () => void;
+}
+
+/**
+ * Dialog of the HR who answers for a unit: the assigned and the inherited one, for everyone; administrators also assign
+ * an account and remove the assignment. Mount it only while it is shown.
+ */
+export function UnitHrModal({ unit, onClose }: UnitHrModalProps) {
+  const isAdmin = useIsAdmin();
+  const queryClient = useQueryClient();
+  const { modal, message } = App.useApp();
+  const { data, error, isPending, refetch } = useQuery(unitHrQuery(unit.id));
+  const { mutateAsync: assign } = useMutation({
+    mutationFn: async (userId: string) =>
+      unwrap(
+        await api.PUT("/api/v1/career/org-units/{id}/hr", {
+          params: { path: { id: unit.id } },
+          body: { userId },
+        }),
+      ),
+    onSettled: () =>
+      queryClient.invalidateQueries({ queryKey: careerQueryKey }),
+  });
+  const { mutateAsync: remove } = useMutation({
+    mutationFn: async () =>
+      unwrap(
+        await api.DELETE("/api/v1/career/org-units/{id}/hr", {
+          params: { path: { id: unit.id } },
+        }),
+      ),
+    onSettled: () =>
+      queryClient.invalidateQueries({ queryKey: careerQueryKey }),
+  });
+
+  function confirmRemoval() {
+    modal.confirm({
+      title: "Снять закрепление HR?",
+      content:
+        "Ответственным станет HR вышестоящего подразделения, если он назначен.",
+      okText: "Снять закрепление",
+      ...destructiveConfirm(true),
+      cancelText: "Отмена",
+      onOk: () =>
+        remove().then(
+          () => undefined,
+          (failure) => message.error(describeApiError(failure)),
+        ),
+    });
+  }
+
+  return (
+    <AppModal
+      open
+      title={`HR подразделения «${unit.name}»`}
+      onCancel={onClose}
+      footer={null}
+    >
+      {isPending && <Skeleton active />}
+      {error && (
+        <ErrorAlert
+          title="Не удалось загрузить HR подразделения"
+          error={error}
+          onRetry={() => void refetch()}
+        />
+      )}
+      {data && (
+        <Space orientation="vertical" size="large" style={{ display: "flex" }}>
+          <div>
+            {data.assigned && (
+              <Typography.Paragraph>
+                Закреплён: {data.assigned.name}
+              </Typography.Paragraph>
+            )}
+            {data.inherited && (
+              <Typography.Paragraph>
+                Унаследован из «{data.inherited.orgUnitName}»:{" "}
+                {data.inherited.name}
+              </Typography.Paragraph>
+            )}
+            {!data.assigned && !data.inherited && (
+              <Typography.Text type="secondary">HR не назначен</Typography.Text>
+            )}
+          </div>
+          {isAdmin && (
+            <>
+              <AssignHrForm onAssign={assign} />
+              {data.assigned && (
+                <Button danger onClick={confirmRemoval}>
+                  Снять закрепление
+                </Button>
+              )}
+            </>
+          )}
+        </Space>
+      )}
+    </AppModal>
+  );
+}
+
+interface AssignHrValues {
+  userId: string;
+}
+
+/** Remote-search choice of an account and the button that assigns it as the unit's HR; a refusal shows under the field. */
+function AssignHrForm({
+  onAssign,
+}: {
+  onAssign: (userId: string) => Promise<unknown>;
+}) {
+  const [form] = Form.useForm<AssignHrValues>();
+  const { isSubmitting, submit } = useFormSubmit(form, async (values) => {
+    await onAssign(values.userId);
+    form.resetFields();
+  });
+  const [search, setSearch] = useState("");
+  const text = useDebouncedValue(search.trim());
+  const { data, error, isFetching } = useQuery(
+    userListQuery({
+      q: text || undefined,
+      page: 1,
+      pageSize: PICKER_PAGE_SIZE,
+    }),
+  );
+  const options = (data?.items ?? []).map((user) => ({
+    value: user.id,
+    label: user.employeeName
+      ? `${user.employeeName} (${user.email})`
+      : user.email,
+  }));
+
+  return (
+    <Form form={form} name="unit-hr" layout="vertical" onFinish={submit}>
+      <Form.Item name="userId" label="Пользователь">
+        <Select
+          showSearch={{ filterOption: false, onSearch: setSearch }}
+          options={options}
+          loading={isFetching}
+          notFoundContent={error ? describeApiError(error) : undefined}
+        />
+      </Form.Item>
+      <Button htmlType="submit" loading={isSubmitting}>
+        Закрепить
+      </Button>
+    </Form>
+  );
+}
