@@ -0,0 +1,223 @@
+import { type QueryClient, queryOptions } from "@tanstack/react-query";
+import { api } from "../../api/client";
+import { ifMatchOf } from "../../api/ifMatch";
+import type { components } from "../../api/schema";
+import { unwrap } from "../../api/unwrap";
+import { careerQueryKey } from "./careerApi";
+
+type Schemas = components["schemas"];
+
+export type Matrix = Schemas["MatrixResponse"];
+export type MatrixVersion = Schemas["MatrixVersionResponse"];
+export type MatrixVersionStatus = Schemas["MatrixVersionStatus"];
+export type MatrixContent = Schemas["MatrixContent"];
+export type MatrixRequirement = Schemas["MatrixRequirement"];
+export type MatrixBlock = Schemas["MatrixBlock"];
+export type MatrixAction = Schemas["MatrixAction"];
+export type MatrixHistory = Schemas["MatrixHistoryResponse"];
+export type MatrixDecision = Schemas["MatrixDecisionResponse"];
+export type MatrixDiff = Schemas["MatrixDiffResponse"];
+export type MatrixChange = Schemas["MatrixChange"];
+export type Approval = Schemas["ApprovalResponse"];
+export type NewMatrix = Schemas["NewMatrixRequest"];
+
+/** Cache key prefix of every matrix query, so one invalidation rereads whatever a transition touched. */
+export const matrixQueryKey = [...careerQueryKey, "matrices"] as const;
+
+/** Transitions of a version that take no body. */
+export type MatrixTransition =
+  | "submit"
+  | "approve"
+  | "accept-changes"
+  | "accept-and-revise"
+  | "rollback-changes";
+
+/** Paging and column filters of the matrix list; pages count from 1. */
+export interface MatrixListParams {
+  orgUnitId?: string;
+  directionId?: string;
+  trackId?: string;
+  page: number;
+  pageSize: number;
+}
+
+export function matricesQuery(params: MatrixListParams) {
+  return queryOptions({
+    queryKey: [...matrixQueryKey, "list", params],
+    queryFn: async () =>
+      unwrap(
+        await api.GET("/api/v1/career/matrices", { params: { query: params } }),
+      ),
+  });
+}
+
+export function matrixQuery(id: string) {
+  return queryOptions({
+    queryKey: [...matrixQueryKey, "matrix", id],
+    queryFn: async () =>
+      unwrap(
+        await api.GET("/api/v1/career/matrices/{id}", {
+          params: { path: { id } },
+        }),
+      ),
+  });
+}
+
+export function matrixVersionsQuery(matrixId: string) {
+  return queryOptions({
+    queryKey: [...matrixQueryKey, "versions", matrixId],
+    queryFn: async () =>
+      unwrap(
+        await api.GET("/api/v1/career/matrices/{id}/versions", {
+          params: { path: { id: matrixId } },
+        }),
+      ),
+  });
+}
+
+export function matrixVersionQuery(id: string) {
+  return queryOptions({
+    queryKey: [...matrixQueryKey, "version", id],
+    queryFn: async () =>
+      unwrap(
+        await api.GET("/api/v1/career/matrix-versions/{id}", {
+          params: { path: { id } },
+        }),
+      ),
+  });
+}
+
+/** Variants and decisions of a version; the server answers 404 to a user who may not read them. */
+export function matrixHistoryQuery(versionId: string) {
+  return queryOptions({
+    queryKey: [...matrixQueryKey, "history", versionId],
+    queryFn: async () =>
+      unwrap(
+        await api.GET("/api/v1/career/matrix-versions/{id}/history", {
+          params: { path: { id: versionId } },
+        }),
+      ),
+    retry: false,
+  });
+}
+
+/** Changes a variant made against the one before it. */
+export function matrixDiffQuery(versionId: string, number: number) {
+  return queryOptions({
+    queryKey: [...matrixQueryKey, "diff", versionId, number],
+    queryFn: async () =>
+      unwrap(
+        await api.GET(
+          "/api/v1/career/matrix-versions/{id}/variants/{number}/diff",
+          { params: { path: { id: versionId, number } } },
+        ),
+      ),
+    retry: false,
+  });
+}
+
+/** Column filters of the approvals list. */
+export interface ApprovalListParams {
+  orgUnitId?: string;
+  step?: NonNullable<Approval["step"]>;
+}
+
+/** Versions waiting for the signed-in user's decision. */
+export function approvalsQuery(params: ApprovalListParams = {}) {
+  return queryOptions({
+    queryKey: [...matrixQueryKey, "approvals", params],
+    queryFn: async () =>
+      unwrap(
+        await api.GET("/api/v1/career/approvals", {
+          params: { query: params },
+        }),
+      ),
+  });
+}
+
+/** Rereads every matrix query after a change. */
+export function invalidateMatrices(queryClient: QueryClient) {
+  return queryClient.invalidateQueries({ queryKey: matrixQueryKey });
+}
+
+export async function createMatrix(body: NewMatrix) {
+  return unwrap(await api.POST("/api/v1/career/matrices", { body }));
+}
+
+/** Starts the next version of a matrix as a draft copy of the published one. */
+export async function createMatrixVersion(matrixId: string) {
+  return unwrap(
+    await api.POST("/api/v1/career/matrices/{id}/versions", {
+      params: { path: { id: matrixId } },
+    }),
+  );
+}
+
+/** Saves the content of a version under the version the form was built from. */
+export async function saveMatrixContent(
+  version: MatrixVersion,
+  content: MatrixContent,
+) {
+  return unwrap(
+    await api.PUT("/api/v1/career/matrix-versions/{id}/content", {
+      params: {
+        path: { id: version.id },
+        header: { "If-Match": ifMatchOf(version.version) },
+      },
+      body: content,
+    }),
+  );
+}
+
+/** Moves a version along its route; the transitions share one shape, so the path is typed by the first. */
+export async function transitMatrixVersion(
+  version: MatrixVersion,
+  transition: MatrixTransition,
+) {
+  return unwrap(
+    await api.POST(
+      `/api/v1/career/matrix-versions/{id}/${transition}` as "/api/v1/career/matrix-versions/{id}/submit",
+      {
+        params: {
+          path: { id: version.id },
+          header: { "If-Match": ifMatchOf(version.version) },
+        },
+      },
+    ),
+  );
+}
+
+/** Returns a version to its author with the changes made and a comment. */
+export async function returnMatrixVersion(
+  version: MatrixVersion,
+  comment: string,
+) {
+  return unwrap(
+    await api.POST("/api/v1/career/matrix-versions/{id}/return", {
+      params: {
+        path: { id: version.id },
+        header: { "If-Match": ifMatchOf(version.version) },
+      },
+      body: { comment: comment.trim() || null },
+    }),
+  );
+}
+
+/** Deletes a matrix that has no published version; its `If-Match` is the tag of the version in work, which is read first. */
+export async function deleteMatrix(matrix: Matrix) {
+  if (!matrix.inWorkVersion)
+    throw new Error("The matrix has no version in work");
+  const inWork = unwrap(
+    await api.GET("/api/v1/career/matrix-versions/{id}", {
+      params: { path: { id: matrix.inWorkVersion.id } },
+    }),
+  );
+  return unwrap(
+    await api.DELETE("/api/v1/career/matrices/{id}", {
+      params: {
+        path: { id: matrix.id },
+        header: { "If-Match": ifMatchOf(inWork.version) },
+      },
+    }),
+  );
+}
diff --git a/web/src/features/career/matrixContent.test.ts b/web/src/features/career/matrixContent.test.ts
new file mode 100644
index 0000000..17de3a3
--- /dev/null
+++ b/web/src/features/career/matrixContent.test.ts
@@ -0,0 +1,219 @@
+import { describe, expect, it } from "vitest";
+import type {
+  MatrixChange,
+  MatrixContent,
+  MatrixRequirement,
+} from "./matrixApi";
+import {
+  cellKey,
+  changedPlaces,
+  hasCompetencies,
+  removeBlock,
+  removeCompetency,
+  removeLevel,
+  setBlockWeight,
+  withRequirement,
+} from "./matrixContent";
+
+const JUNIOR = "junior";
+const SENIOR = "senior";
+const CORE = "core";
+const EXTRA = "extra";
+const DESIGN = "design";
+const TESTING = "testing";
+
+function requirement(
+  levelId: string,
+  competencyId: string,
+  requiredScore: number | null = 2,
+): MatrixRequirement {
+  return {
+    levelId,
+    competencyId,
+    requiredScore,
+    type: "Profile",
+    weight: 1,
+    isMandatory: false,
+    expectedBehavior: null,
+    evidenceExamples: null,
+    validFrom: null,
+  };
+}
+
+function content(): MatrixContent {
+  return {
+    levels: [
+      { levelId: JUNIOR, minOverallPercent: 60 },
+      { levelId: SENIOR, minOverallPercent: 70 },
+    ],
+    blocks: [
+      { id: CORE, name: "Основные", isMandatory: true },
+      { id: EXTRA, name: "Дополнительные", isMandatory: false },
+    ],
+    competencies: [
+      { competencyId: DESIGN, blockId: CORE },
+      { competencyId: TESTING, blockId: EXTRA },
+    ],
+    blockWeights: [
+      { levelId: JUNIOR, blockId: CORE, percent: 100, minPercent: 50 },
+      { levelId: SENIOR, blockId: CORE, percent: 70, minPercent: null },
+      { levelId: SENIOR, blockId: EXTRA, percent: 30, minPercent: null },
+    ],
+    requirements: [
+      requirement(JUNIOR, DESIGN),
+      requirement(SENIOR, DESIGN),
+      requirement(SENIOR, TESTING),
+    ],
+  };
+}
+
+const referencedLevels = (matrix: MatrixContent) => [
+  ...matrix.blockWeights.map((weight) => weight.levelId),
+  ...matrix.requirements.map((item) => item.levelId),
+];
+
+describe("editing the matrix document leaves no reference to what was removed (AC-14)", () => {
+  it("drops the weights and the requirements of a removed level, and nothing of the other level", () => {
+    const edited = removeLevel(content(), JUNIOR);
+
+    expect(edited.levels.map((level) => level.levelId)).toEqual([SENIOR]);
+    expect(referencedLevels(edited)).not.toContain(JUNIOR);
+    expect(edited.blockWeights).toHaveLength(2);
+    expect(edited.requirements).toHaveLength(2);
+  });
+
+  it("drops the requirements of a removed competency but keeps the weights of its block", () => {
+    const edited = removeCompetency(content(), TESTING);
+
+    expect(edited.competencies.map((item) => item.competencyId)).toEqual([
+      DESIGN,
+    ]);
+    expect(
+      edited.requirements.map((item) => `${item.levelId}:${item.competencyId}`),
+    ).toEqual([`${JUNIOR}:${DESIGN}`, `${SENIOR}:${DESIGN}`]);
+    expect(edited.blockWeights).toHaveLength(3);
+  });
+
+  it("drops the coefficients of a removed block, and tells a block with competencies from an empty one", () => {
+    const matrix = removeCompetency(content(), TESTING);
+
+    expect(hasCompetencies(matrix, CORE)).toBe(true);
+    expect(hasCompetencies(matrix, EXTRA)).toBe(false);
+    const edited = removeBlock(matrix, EXTRA);
+    expect(edited.blocks.map((block) => block.id)).toEqual([CORE]);
+    expect(edited.blockWeights.map((weight) => weight.blockId)).not.toContain(
+      EXTRA,
+    );
+  });
+});
+
+describe("block coefficients and thresholds of a level (AC-14)", () => {
+  it("changes the coefficient of a pair without touching its threshold or the other pairs", () => {
+    const edited = setBlockWeight(content(), JUNIOR, CORE, "percent", 80);
+
+    expect(
+      edited.blockWeights.find(
+        (w) => w.levelId === JUNIOR && w.blockId === CORE,
+      ),
+    ).toEqual({ levelId: JUNIOR, blockId: CORE, percent: 80, minPercent: 50 });
+    expect(edited.blockWeights).toHaveLength(3);
+  });
+
+  it("creates the pair when a threshold is set for a block the level had no coefficient for", () => {
+    const edited = setBlockWeight(content(), JUNIOR, EXTRA, "minPercent", 40);
+
+    expect(
+      edited.blockWeights.find(
+        (w) => w.levelId === JUNIOR && w.blockId === EXTRA,
+      ),
+    ).toEqual({ levelId: JUNIOR, blockId: EXTRA, percent: 0, minPercent: 40 });
+  });
+
+  it("removes the pair once both the coefficient and the threshold are cleared, and not before", () => {
+    const withoutPercent = setBlockWeight(
+      content(),
+      JUNIOR,
+      CORE,
+      "percent",
+      null,
+    );
+    expect(
+      withoutPercent.blockWeights.some(
+        (w) => w.levelId === JUNIOR && w.blockId === CORE,
+      ),
+    ).toBe(true);
+
+    const cleared = setBlockWeight(
+      withoutPercent,
+      JUNIOR,
+      CORE,
+      "minPercent",
+      null,
+    );
+    expect(
+      cleared.blockWeights.some(
+        (w) => w.levelId === JUNIOR && w.blockId === CORE,
+      ),
+    ).toBe(false);
+    expect(cleared.blockWeights).toHaveLength(2);
+  });
+});
+
+describe("requirements of a level and a competency (AC-14)", () => {
+  it("replaces the requirement of a cell instead of adding a second one", () => {
+    const edited = withRequirement(content(), requirement(SENIOR, DESIGN, 4));
+
+    const cell = edited.requirements.filter(
+      (item) => item.levelId === SENIOR && item.competencyId === DESIGN,
+    );
+    expect(cell).toHaveLength(1);
+    expect(cell[0]?.requiredScore).toBe(4);
+    expect(edited.requirements).toHaveLength(3);
+  });
+});
+
+describe("the places an approver changed (AC-19)", () => {
+  const change = (fields: Partial<MatrixChange>): MatrixChange => ({
+    kind: "Level",
+    type: "Changed",
+    levelId: null,
+    blockId: null,
+    competencyId: null,
+    ...fields,
+  });
+
+  it("marks a changed requirement by its cell and by its competency row", () => {
+    const places = changedPlaces([
+      change({ kind: "Requirement", levelId: JUNIOR, competencyId: DESIGN }),
+    ]);
+
+    expect(places.requirementCells).toEqual(new Set([cellKey(JUNIOR, DESIGN)]));
+    expect(places.competencies).toEqual(new Set([DESIGN]));
+    expect(places.weightCells.size).toBe(0);
+  });
+
+  it("marks levels, blocks, competencies and coefficient cells each in its own set", () => {
+    const places = changedPlaces([
+      change({ kind: "Level", levelId: SENIOR }),
+      change({ kind: "Block", blockId: EXTRA }),
+      change({ kind: "Competency", competencyId: TESTING }),
+      change({ kind: "BlockWeight", levelId: SENIOR, blockId: CORE }),
+    ]);
+
+    expect(places.levels).toEqual(new Set([SENIOR]));
+    expect(places.blocks).toEqual(new Set([EXTRA]));
+    expect(places.competencies).toEqual(new Set([TESTING]));
+    expect(places.weightCells).toEqual(new Set([cellKey(SENIOR, CORE)]));
+    expect(places.requirementCells.size).toBe(0);
+  });
+
+  it("ignores a change that does not name the place it concerns", () => {
+    const places = changedPlaces([
+      change({ kind: "Requirement", levelId: JUNIOR }),
+      change({ kind: "BlockWeight", blockId: CORE }),
+    ]);
+
+    expect(places.requirementCells.size).toBe(0);
+    expect(places.weightCells.size).toBe(0);
+  });
+});
