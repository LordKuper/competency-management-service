@@ -0,0 +1,48 @@
+import { Button } from "antd";
+import { useIsAdmin } from "../auth/useCurrentUser";
+import { useProcessRoles } from "./careerApi";
+import { deleteMatrix, type Matrix } from "./matrixApi";
+import { useConfirmDeletion } from "./useConfirmDeletion";
+
+/**
+ * «Удалить» of a matrix with no published version, for the head of its unit and administrators. The server decides
+ * again and explains a refusal.
+ */
+export function MatrixDeleteButton({
+  matrix,
+  onDeleted,
+}: {
+  matrix: Matrix;
+  onDeleted?: () => void;
+}) {
+  const isAdmin = useIsAdmin();
+  const { data } = useProcessRoles();
+  const confirmDeletion = useConfirmDeletion();
+  const isHead = !!data?.headedUnits.some(
+    (unit) => unit.id === matrix.orgUnitId,
+  );
+  if (
+    !(isAdmin || isHead) ||
+    matrix.publishedVersion ||
+    !matrix.inWorkVersion
+  ) {
+    return null;
+  }
+  return (
+    <Button
+      danger
+      type="link"
+      size="small"
+      onClick={() =>
+        confirmDeletion({
+          kind: "матрицу",
+          name: matrix.trackName,
+          run: () => deleteMatrix(matrix),
+          onDeleted,
+        })
+      }
+    >
+      Удалить
+    </Button>
+  );
+}
diff --git a/web/src/features/career/MatrixEditor.tsx b/web/src/features/career/MatrixEditor.tsx
new file mode 100644
index 0000000..0669630
--- /dev/null
+++ b/web/src/features/career/MatrixEditor.tsx
@@ -0,0 +1,470 @@
+import { EditOutlined, WarningOutlined } from "@ant-design/icons";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import {
+  Button,
+  Flex,
+  InputNumber,
+  Select,
+  Space,
+  Table,
+  type TableColumnsType,
+  Tag,
+  Typography,
+} from "antd";
+import { useState } from "react";
+import { useEditBase } from "../../app/useEditBase";
+import { COMPETENCY_TYPES } from "./CompetencyModal";
+import {
+  ALL_ENTRIES,
+  type CompetencyType,
+  competenciesQuery,
+  levelsQuery,
+} from "./catalogApi";
+import { MatrixBlocks } from "./MatrixBlocks";
+import { MatrixErrorAlert } from "./MatrixErrorAlert";
+import { AddCompetencyModal, AddLevelModal } from "./MatrixPickers";
+import {
+  invalidateMatrices,
+  type Matrix,
+  type MatrixContent,
+  type MatrixVersion,
+  matrixVersionQuery,
+  saveMatrixContent,
+} from "./matrixApi";
+import {
+  addCompetency,
+  addLevel,
+  type ChangedPlaces,
+  cellKey,
+  removeCompetency,
+  removeLevel,
+  requirementOf,
+  setCompetencyBlock,
+  setOverallMin,
+  withoutRequirement,
+  withRequirement,
+} from "./matrixContent";
+import { CHANGED_NOTE } from "./matrixLabels";
+import { RequirementModal } from "./RequirementModal";
+import "./matrix.css";
+
+const NO_VALUE = "—";
+const MAX_CHIP_LEVEL = 4;
+const MAX_PERCENT = 100;
+const UNNAMED_BLOCK = "Название блока";
+
+type Dialog =
+  | { kind: "level" }
+  | { kind: "competency" }
+  | { kind: "requirement"; levelId: string; competencyId: string };
+
+interface GridRow {
+  key: string;
+  competencyId: string | null;
+}
+
+interface CompetencyInfo {
+  name: string;
+  type: CompetencyType;
+  categoryName?: string;
+}
+
+interface MatrixEditorProps {
+  matrix: Matrix;
+  /** The version as the cache holds it now. */
+  version: MatrixVersion;
+  changed: ChangedPlaces;
+  /** Called after a save, once the cache holds the saved version. */
+  onSaved: () => void;
+}
+
+/**
+ * The competency-by-level grid with the blocks and thresholds of a version. It is editable when the version's
+ * actions allow, and then keeps the edits in the form until they are saved.
+ */
+export function MatrixEditor(props: MatrixEditorProps) {
+  const { base, noteSaveFailure } = useEditBase(props.version);
+  return (
+    <MatrixEditorBody
+      key={base?.version}
+      {...props}
+      base={base ?? props.version}
+      noteSaveFailure={noteSaveFailure}
+    />
+  );
+}
+
+interface MatrixEditorBodyProps extends MatrixEditorProps {
+  base: MatrixVersion;
+  noteSaveFailure: (error: unknown) => void;
+}
+
+function chipLevel(score: number) {
+  return Math.min(Math.max(score, 0), MAX_CHIP_LEVEL);
+}
+
+function MatrixEditorBody({
+  version,
+  base,
+  changed,
+  noteSaveFailure,
+  onSaved,
+}: MatrixEditorBodyProps) {
+  const queryClient = useQueryClient();
+  const isEditable = version.actions.includes("Edit");
+  const [edited, setEdited] = useState<MatrixContent>(base.content);
+  const [dialog, setDialog] = useState<Dialog | null>(null);
+  const shown = isEditable ? edited : version.content;
+  const { entries } = version;
+
+  const catalogLevels = useQuery({
+    ...levelsQuery(entries.track.id),
+    enabled: isEditable,
+  });
+  const catalogCompetencies = useQuery({
+    ...competenciesQuery(ALL_ENTRIES),
+    enabled: isEditable,
+  });
+  const save = useMutation({
+    mutationFn: () => saveMatrixContent(base, edited),
+    onSuccess: (saved) => {
+      queryClient.setQueryData(matrixVersionQuery(saved.id).queryKey, saved);
+      onSaved();
+    },
+    onError: noteSaveFailure,
+    onSettled: () => invalidateMatrices(queryClient),
+  });
+
+  const levelNames = new Map<string, string>([
+    ...(catalogLevels.data?.items ?? []).map(
+      (level) => [level.id, level.name] as const,
+    ),
+    ...entries.levels.map((level) => [level.id, level.name] as const),
+  ]);
+  const trackOrder = [
+    ...(catalogLevels.data?.items ?? []),
+    ...entries.levels,
+  ].map((level) => level.id);
+  const rank = (levelId: string) => {
+    const index = trackOrder.indexOf(levelId);
+    return index === -1 ? trackOrder.length : index;
+  };
+  const shownLevelIds = shown.levels
+    .map((level) => level.levelId)
+    .sort((left, right) => rank(left) - rank(right));
+  const competencies = new Map<string, CompetencyInfo>([
+    ...(catalogCompetencies.data?.items ?? []).map(
+      (competency) => [competency.id, competency] as const,
+    ),
+    ...entries.competencies.map(
+      (competency) =>
+        [
+          competency.id,
+          {
+            name: competency.name,
+            type: competency.type,
+            categoryName: competency.categoryName,
+          },
+        ] as const,
+    ),
+  ]);
+  const blockOptions = shown.blocks.map((block) => ({
+    value: block.id,
+    label: block.name || UNNAMED_BLOCK,
+  }));
+  const blockNames = new Map(
+    blockOptions.map((option) => [option.value, option.label]),
+  );
+  const rows: GridRow[] = [
+    ...shown.competencies.map(({ competencyId }) => ({
+      key: competencyId,
+      competencyId,
+    })),
+    { key: "overall-minimum", competencyId: null },
+  ];
+  const levelOptions = (catalogLevels.data?.items ?? [])
+    .filter(
+      (level) =>
+        level.status !== "Inactive" &&
+        !shown.levels.some((used) => used.levelId === level.id),
+    )
+    .map((level) => ({ value: level.id, label: level.name }));
+  const competencyOptions = (catalogCompetencies.data?.items ?? [])
+    .filter(
+      (competency) =>
+        competency.scaleId === version.scaleId &&
+        !shown.competencies.some(
+          (used) => used.competencyId === competency.id,
+        ) &&
+        (competency.directionId === null ||
+          competency.directionId === entries.direction.id) &&
+        competency.status !== "Inactive",
+    )
+    .map((competency) => ({ value: competency.id, label: competency.name }));
+
+  function renderName(row: GridRow) {
+    if (row.competencyId === null) return "Минимальный общий порог";
+    const competency = competencies.get(row.competencyId);
+    const block = shown.competencies.find(
+      (item) => item.competencyId === row.competencyId,
+    );
+    const competencyId = row.competencyId;
+    return (
+      <Space orientation="vertical" size={0}>
+        <Typography.Text strong>{competency?.name}</Typography.Text>
+        {competency?.categoryName && (
+          <Typography.Text type="secondary">
+            {competency.categoryName}
+          </Typography.Text>
+        )}
+        {competency?.type === "Critical" && (
+          <Tag icon={<WarningOutlined />} color="error">
+            {COMPETENCY_TYPES.Critical}
+          </Tag>
+        )}
+        {isEditable ? (
+          <Select
+            size="small"
+            aria-label="Блок компетенций"
+            value={block?.blockId}
+            options={blockOptions}
+            onChange={(blockId) =>
+              setEdited(setCompetencyBlock(edited, competencyId, blockId))
+            }
+          />
+        ) : (
+          <Typography.Text type="secondary">
+            {block && blockNames.get(block.blockId)}
+          </Typography.Text>
+        )}
+        {changed.competencies.has(competencyId) && (
+          <Tag icon={<EditOutlined />} color="warning">
+            {CHANGED_NOTE}
+          </Tag>
+        )}
+        {isEditable && (
+          <Button
+            type="link"
+            size="small"
+            danger
+            onClick={() => setEdited(removeCompetency(edited, competencyId))}
+          >
+            Удалить
+          </Button>
+        )}
+      </Space>
+    );
+  }
+
+  function renderCell(levelId: string, row: GridRow) {
+    const levelName = levelNames.get(levelId) ?? "";
+    if (row.competencyId === null) {
+      const level = shown.levels.find((item) => item.levelId === levelId);
+      return isEditable ? (
+        <InputNumber
+          aria-label={`Минимальный общий порог: ${levelName}`}
+          min={0}
+          max={MAX_PERCENT}
+          value={level?.minOverallPercent ?? null}
+          onChange={(value) => setEdited(setOverallMin(edited, levelId, value))}
+        />
+      ) : (
+        (level?.minOverallPercent ?? NO_VALUE)
+      );
+    }
+    const competencyId = row.competencyId;
+    const requirement = requirementOf(shown, levelId, competencyId);
+    if (!requirement && !isEditable) return NO_VALUE;
+    const score = requirement?.requiredScore;
+    const label = entries.scale.points.find(
+      (point) => point.score === score,
+    )?.label;
+    return (
+      <button
+        type="button"
+        className="matrix-cell-button"
+        aria-label={`${competencies.get(competencyId)?.name}, ${levelName}`}
+        onClick={() =>
+          setDialog({ kind: "requirement", levelId, competencyId })
+        }
+      >
+        {score == null ? (
+          NO_VALUE
+        ) : (
+          <span
+            className={`rating-chip rating-chip--${chipLevel(score)}`}
+            title={label}
+          >
+            {score}
+          </span>
+        )}
+        {changed.requirementCells.has(cellKey(levelId, competencyId)) && (
+          <EditOutlined
+            role="img"
+            aria-label={CHANGED_NOTE}
+            title={CHANGED_NOTE}
+          />
+        )}
+      </button>
+    );
+  }
+
+  const columns: TableColumnsType<GridRow> = [
+    {
+      title: "Компетенции",
+      key: "competency",
+      fixed: "left",
+      className: "matrix-name-cell",
+      render: (_, row) => renderName(row),
+    },
+    ...shownLevelIds.map((levelId) => ({
+      key: levelId,
+      className: "matrix-cell",
+      title: (
+        <Space orientation="vertical" size={0}>
+          {levelNames.get(levelId)}
+          {changed.levels.has(levelId) && (
+            <Tag icon={<EditOutlined />} color="warning">
+              {CHANGED_NOTE}
+            </Tag>
+          )}
+          {isEditable && (
+            <Button
+              type="link"
+              size="small"
+              danger
+              onClick={() => setEdited(removeLevel(edited, levelId))}
+            >
+              Удалить
+            </Button>
+          )}
+        </Space>
+      ),
+      onCell: (row: GridRow) => ({
+        className:
+          row.competencyId &&
+          changed.requirementCells.has(cellKey(levelId, row.competencyId))
+            ? "matrix-changed"
+            : undefined,
+      }),
+      render: (_: unknown, row: GridRow) => renderCell(levelId, row),
+    })),
+  ];
+  const requested = dialog?.kind === "requirement" ? dialog : null;
+
+  return (
+    <Space orientation="vertical" size="large" style={{ display: "flex" }}>
+      {isEditable && (
+        <Flex gap="small" wrap>
+          <Button onClick={() => setDialog({ kind: "competency" })}>
+            Добавить компетенцию
+          </Button>
+          <Button onClick={() => setDialog({ kind: "level" })}>
+            Добавить уровень
+          </Button>
+          <Button
+            type="primary"
+            loading={save.isPending}
+            onClick={() => save.mutate()}
+          >
+            Сохранить
+          </Button>
+        </Flex>
+      )}
+      {save.error != null && (
+        <MatrixErrorAlert
+          title="Не удалось сохранить запись"
+          error={save.error}
+        />
+      )}
+      <ul className="matrix-legend">
+        {entries.scale.points.map((point) => (
+          <li key={point.score}>
+            <span
+              className={`rating-chip rating-chip--${chipLevel(point.score)}`}
+            >
+              {point.score}
+            </span>
+            {point.label}
+          </li>
+        ))}
+      </ul>
+      <Table<GridRow>
+        className="matrix-grid"
+        rowKey="key"
+        columns={columns}
+        dataSource={rows}
+        pagination={false}
+        scroll={{ x: "max-content" }}
+        rowClassName={(row) =>
+          row.competencyId && changed.competencies.has(row.competencyId)
+            ? "matrix-changed-row"
+            : ""
+        }
+      />
+      <MatrixBlocks
+        content={shown}
+        levelIds={shownLevelIds}
+        levelNames={levelNames}
+        changed={changed}
+        isEditable={isEditable}
+        onChange={setEdited}
+      />
+      {dialog?.kind === "level" && (
+        <AddLevelModal
+          options={levelOptions}
+          isLoading={catalogLevels.isFetching}
+          onPick={(levelId) => {
+            setEdited(addLevel(edited, levelId));
+            setDialog(null);
+          }}
+          onClose={() => setDialog(null)}
+        />
+      )}
+      {dialog?.kind === "competency" && (
+        <AddCompetencyModal
+          competencies={competencyOptions}
+          blocks={blockOptions}
+          isLoading={catalogCompetencies.isFetching}
+          onPick={(competencyId, blockId) => {
+            setEdited(addCompetency(edited, competencyId, blockId));
+            setDialog(null);
+          }}
+          onClose={() => setDialog(null)}
+        />
+      )}
+      {requested && (
+        <RequirementModal
+          title={`${competencies.get(requested.competencyId)?.name}, ${levelNames.get(requested.levelId)}`}
+          levelId={requested.levelId}
+          competencyId={requested.competencyId}
+          requirement={requirementOf(
+            shown,
+            requested.levelId,
+            requested.competencyId,
+          )}
+          defaultType={
+            competencies.get(requested.competencyId)?.type ?? "Profile"
+          }
+          scalePoints={entries.scale.points}
+          isEditable={isEditable}
+          onSave={(requirement) => {
+            setEdited(withRequirement(edited, requirement));
+            setDialog(null);
+          }}
+          onRemove={() => {
+            setEdited(
+              withoutRequirement(
+                edited,
+                requested.levelId,
+                requested.competencyId,
+              ),
+            );
+            setDialog(null);
+          }}
+          onClose={() => setDialog(null)}
+        />
+      )}
+    </Space>
+  );
+}
diff --git a/web/src/features/career/MatrixErrorAlert.tsx b/web/src/features/career/MatrixErrorAlert.tsx
new file mode 100644
index 0000000..6da0cee
--- /dev/null
+++ b/web/src/features/career/MatrixErrorAlert.tsx
@@ -0,0 +1,49 @@
+import { Alert } from "antd";
+import { ApiError } from "../../api/ApiError";
+import { describeApiError } from "../../app/apiErrors";
+import { ErrorAlert } from "../../app/ErrorAlert";
+
+const FORBIDDEN_STATUS = 403;
+const PROBLEMS_FIELD = "content";
+
+interface MatrixErrorAlertProps {
+  /** What failed, in a few words. */
+  title: string;
+  error: unknown;
+}
+
+/**
+ * Failure of a matrix call. A refusal by turn and the list of everything wrong with a version are the server's own
+ * words and are shown as written; any other failure gets the common explanation.
+ */
+export function MatrixErrorAlert({ title, error }: MatrixErrorAlertProps) {
+  const problems =
+    error instanceof ApiError ? (error.errors?.[PROBLEMS_FIELD] ?? []) : [];
+  const isForbidden =
+    error instanceof ApiError && error.status === FORBIDDEN_STATUS;
+  if (!(error instanceof ApiError) || (problems.length === 0 && !isForbidden)) {
+    return <ErrorAlert title={title} error={error} />;
+  }
+
+  const summary =
+    error.detail ?? (problems.length === 0 ? describeApiError(error) : null);
+  return (
+    <Alert
+      type="error"
+      showIcon
+      title={title}
+      description={
+        <>
+          {summary}
+          {problems.length > 0 && (
+            <ul>
+              {problems.map((problem) => (
+                <li key={problem}>{problem}</li>
+              ))}
+            </ul>
+          )}
+        </>
+      }
+    />
+  );
+}
