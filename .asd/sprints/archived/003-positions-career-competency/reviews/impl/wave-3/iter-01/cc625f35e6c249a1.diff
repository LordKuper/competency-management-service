@@ -0,0 +1,311 @@
+import type { Active, Over } from "@dnd-kit/core";
+import { render, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { queryClient } from "../../api/queryClient";
+import { Providers } from "../../app/Providers";
+import { fakeApi } from "../../test/fakeApi";
+import { stubRowLayout } from "../../test/stubRowLayout";
+import { LONG_FLOW_TIMEOUT } from "../../test/timeouts";
+import type { CareerLevel, CareerTrack } from "./catalogApi";
+import {
+  arrangeLevels,
+  type LevelRow,
+  levelAnnouncements,
+  movedOrder,
+  type PendingLevel,
+  TrackLevels,
+} from "./TrackLevels";
+
+const TRACK: CareerTrack = {
+  id: "track",
+  name: "Бэкенд",
+  directionId: "direction",
+  status: "Active",
+  ownerOrgUnitId: "unit",
+  ownerOrgUnitName: "Отдел",
+  version: 1,
+};
+
+function level(id: string, name: string, position: number): CareerLevel {
+  return {
+    id,
+    name,
+    directionId: "direction",
+    trackId: "track",
+    position,
+    status: "Active",
+    version: 1,
+  };
+}
+
+const SAVED = [
+  level("junior", "Младший", 1),
+  level("middle", "Средний", 2),
+  level("senior", "Старший", 3),
+];
+
+const pending = (key: string, name: string): PendingLevel => ({
+  key,
+  values: { name },
+});
+
+const keys = (rows: readonly LevelRow[]) => rows.map((row) => row.key);
+const active = (id: string) => ({ id }) as Active;
+const over = (id: string) => ({ id }) as Over;
+
+describe("arrangeLevels (AC-11)", () => {
+  it("lists the saved levels in track order and the pending ones after them", () => {
+    const rows = arrangeLevels(SAVED, [pending("new", "Ведущий")], undefined);
+
+    expect(rows.map((row) => row.name)).toEqual([
+      "Младший",
+      "Средний",
+      "Старший",
+      "Ведущий",
+    ]);
+    expect(rows[3]?.pending?.key).toBe("new");
+    expect(rows[0]?.level?.id).toBe("junior");
+  });
+
+  it("follows the order the user arranged, and keeps rows that order does not name after the named ones", () => {
+    const rows = arrangeLevels(
+      SAVED,
+      [pending("new", "Ведущий")],
+      ["senior", "junior"],
+    );
+
+    expect(keys(rows)).toEqual(["senior", "junior", "middle", "new"]);
+  });
+
+  it("puts a pending level that was moved among the saved ones where it was dropped", () => {
+    const rows = arrangeLevels(
+      SAVED,
+      [pending("new", "Ведущий")],
+      ["junior", "new", "middle", "senior"],
+    );
+
+    expect(keys(rows)).toEqual(["junior", "new", "middle", "senior"]);
+  });
+});
+
+describe("movedOrder (AC-11)", () => {
+  const rows = arrangeLevels(SAVED, [], undefined);
+
+  it("moves a level onto the place of another, in either direction", () => {
+    expect(
+      movedOrder(rows, { active: active("junior"), over: over("senior") }),
+    ).toEqual(["middle", "senior", "junior"]);
+    expect(
+      movedOrder(rows, { active: active("senior"), over: over("junior") }),
+    ).toEqual(["senior", "junior", "middle"]);
+  });
+
+  it("changes nothing when the level is dropped where it was or nowhere", () => {
+    expect(
+      movedOrder(rows, { active: active("middle"), over: over("middle") }),
+    ).toBeNull();
+    expect(
+      movedOrder(rows, { active: active("middle"), over: null }),
+    ).toBeNull();
+  });
+});
+
+describe("level announcements for a screen reader (AC-11)", () => {
+  const rows = arrangeLevels(SAVED, [], undefined);
+  const announcements = levelAnnouncements(rows);
+  const event = (activeId: string, overId: string | null = null) => ({
+    active: active(activeId),
+    over: overId === null ? null : over(overId),
+  });
+
+  it("names the level and its place of the total when it is picked up", () => {
+    expect(announcements.onDragStart?.(event("middle"))).toBe(
+      "Взят уровень «Средний», позиция 2 из 3",
+    );
+  });
+
+  it("says where the level is while it is moved over another's place", () => {
+    expect(announcements.onDragOver?.(event("middle", "senior"))).toBe(
+      "Уровень «Средний» на позиции 3 из 3",
+    );
+    expect(announcements.onDragOver?.(event("middle"))).toBeUndefined();
+  });
+
+  it("says where the level was dropped", () => {
+    expect(announcements.onDragEnd?.(event("junior", "senior"))).toBe(
+      "Уровень «Младший» перемещён на позицию 3 из 3",
+    );
+    expect(announcements.onDragEnd?.(event("junior"))).toBeUndefined();
+  });
+
+  it("says the move was cancelled and where the level stayed", () => {
+    expect(announcements.onDragCancel?.(event("senior"))).toBe(
+      "Перемещение отменено. Уровень «Старший» остался на позиции 3",
+    );
+  });
+});
+
+function renderLevels(rows: LevelRow[], onOrderChange = vi.fn()) {
+  fakeApi.on("GET /api/v1/auth/me", () =>
+    Response.json({ id: "a", email: "admin@test.local", role: "GlobalAdmin" }),
+  );
+  fakeApi.on("GET /api/v1/career/me", () =>
+    Response.json({ headedUnits: [], hrUnits: [] }),
+  );
+  render(
+    <Providers>
+      <TrackLevels
+        track={TRACK}
+        rows={rows}
+        isLoading={false}
+        error={null}
+        onRetry={vi.fn()}
+        pending={[]}
+        onPendingChange={vi.fn()}
+        onOrderChange={onOrderChange}
+      />
+    </Providers>,
+  );
+}
+
+const originalScrollIntoView = Element.prototype.scrollIntoView;
+
+beforeEach(() => {
+  queryClient.clear();
+  Element.prototype.scrollIntoView = vi.fn();
+});
+
+let restoreLayout: () => void = () => undefined;
+
+afterEach(() => {
+  Element.prototype.scrollIntoView = originalScrollIntoView;
+  restoreLayout();
+  restoreLayout = () => undefined;
+});
+
+describe("the level list of the track dialog (AC-11)", {
+  timeout: LONG_FLOW_TIMEOUT,
+}, () => {
+  it("shows the hint, a handle named after each level with the Russian role description, and the instructions for the keyboard", async () => {
+    renderLevels(arrangeLevels(SAVED, [], undefined));
+
+    expect(
+      screen.getByText(
+        "Уровни идут от младшего к старшему. Перетащите строку, чтобы изменить порядок",
+      ),
+    ).toBeInTheDocument();
+    const handles = screen
+      .getAllByRole("button", { name: /^Перетащить уровень/ })
+      .map((handle) => handle.getAttribute("aria-label"));
+    expect(handles).toEqual([
+      "Перетащить уровень «Младший»",
+      "Перетащить уровень «Средний»",
+      "Перетащить уровень «Старший»",
+    ]);
+    const handle = screen.getByRole("button", {
+      name: "Перетащить уровень «Средний»",
+    });
+    expect(handle).toHaveAttribute(
+      "aria-roledescription",
+      "перемещаемый элемент",
+    );
+    const description = document.getElementById(
+      handle.getAttribute("aria-describedby") ?? "",
+    );
+    expect(description?.textContent).toBe(
+      "Чтобы взять уровень, нажмите пробел или Enter. Перемещайте его стрелками вверх и вниз, отпустите пробелом или Enter, Escape — отмена",
+    );
+  });
+
+  it("lists the levels from the most junior, with the status and the actions of each saved one", async () => {
+    renderLevels(arrangeLevels(SAVED, [pending("new", "Ведущий")], undefined));
+
+    const rows = (await screen.findAllByRole("row")).slice(1);
+    expect(
+      rows.map((row) => within(row).getAllByRole("cell")[1]?.textContent),
+    ).toEqual(["Младший", "Средний", "Старший", "Ведущий"]);
+    expect(
+      within(rows[0] as HTMLElement).getByText("Действует"),
+    ).toBeInTheDocument();
+    expect(
+      within(rows[3] as HTMLElement).getByRole("button", { name: "Удалить" }),
+    ).toBeInTheDocument();
+    expect(
+      within(rows[3] as HTMLElement).queryByText("Действует"),
+    ).not.toBeInTheDocument();
+  });
+
+  it("says «В треке пока нет уровней» for a track without levels", () => {
+    renderLevels([]);
+
+    expect(screen.getByText("В треке пока нет уровней")).toBeInTheDocument();
+  });
+
+  it("announces in Russian, through the live region, the level taken with the keyboard and where it is dropped, and reports no new order for a drop in place", async () => {
+    const onOrderChange = vi.fn();
+    renderLevels(arrangeLevels(SAVED, [], undefined), onOrderChange);
+    const user = userEvent.setup();
+
+    screen
+      .getByRole("button", { name: "Перетащить уровень «Младший»" })
+      .focus();
+    await user.keyboard(" ");
+    expect(
+      await screen.findByText("Уровень «Младший» на позиции 1 из 3"),
+    ).toBeInTheDocument();
+    await user.keyboard(" ");
+
+    expect(
+      await screen.findByText("Уровень «Младший» перемещён на позицию 1 из 3"),
+    ).toBeInTheDocument();
+    expect(onOrderChange).not.toHaveBeenCalled();
+  });
+
+  it("moves a level down with the keyboard, says where it went, and reports the new order", async () => {
+    const onOrderChange = vi.fn();
+    renderLevels(arrangeLevels(SAVED, [], undefined), onOrderChange);
+    restoreLayout = stubRowLayout();
+    const user = userEvent.setup();
+
+    screen
+      .getByRole("button", { name: "Перетащить уровень «Младший»" })
+      .focus();
+    await user.keyboard(" ");
+    await user.keyboard("{ArrowDown}");
+    expect(
+      await screen.findByText("Уровень «Младший» на позиции 2 из 3"),
+    ).toBeInTheDocument();
+    await user.keyboard(" ");
+
+    expect(
+      await screen.findByText("Уровень «Младший» перемещён на позицию 2 из 3"),
+    ).toBeInTheDocument();
+    expect(onOrderChange).toHaveBeenCalledExactlyOnceWith([
+      "middle",
+      "junior",
+      "senior",
+    ]);
+  });
+
+  it("leaves the order alone when the move is cancelled with Escape, and says so", async () => {
+    const onOrderChange = vi.fn();
+    renderLevels(arrangeLevels(SAVED, [], undefined), onOrderChange);
+    restoreLayout = stubRowLayout();
+    const user = userEvent.setup();
+
+    screen
+      .getByRole("button", { name: "Перетащить уровень «Средний»" })
+      .focus();
+    await user.keyboard(" ");
+    await user.keyboard("{ArrowDown}");
+    await user.keyboard("{Escape}");
+
+    expect(
+      await screen.findByText(
+        "Перемещение отменено. Уровень «Средний» остался на позиции 2",
+      ),
+    ).toBeInTheDocument();
+    expect(onOrderChange).not.toHaveBeenCalled();
+  });
+});
diff --git a/web/src/features/career/TrackLevels.tsx b/web/src/features/career/TrackLevels.tsx
new file mode 100644
index 0000000..d2bb5ba
--- /dev/null
+++ b/web/src/features/career/TrackLevels.tsx
@@ -0,0 +1,385 @@
+import { HolderOutlined } from "@ant-design/icons";
+import {
+  type Announcements,
+  closestCenter,
+  DndContext,
+  type DragEndEvent,
+  KeyboardSensor,
+  type Modifier,
+  PointerSensor,
+  type ScreenReaderInstructions,
+  type UniqueIdentifier,
+  useSensor,
+  useSensors,
+} from "@dnd-kit/core";
+import {
+  arrayMove,
+  SortableContext,
+  sortableKeyboardCoordinates,
+  useSortable,
+  verticalListSortingStrategy,
+} from "@dnd-kit/sortable";
+import { CSS } from "@dnd-kit/utilities";
+import { useQuery } from "@tanstack/react-query";
+import {
+  Button,
+  Empty,
+  Flex,
+  Space,
+  Table,
+  type TableColumnsType,
+  Typography,
+  theme,
+} from "antd";
+import {
+  type CSSProperties,
+  createContext,
+  type HTMLAttributes,
+  useContext,
+  useMemo,
+  useState,
+} from "react";
+import { ErrorAlert } from "../../app/ErrorAlert";
+import { CatalogStatusTag, EntryActions, entryColumns } from "./CatalogParts";
+import { type CareerLevel, type CareerTrack, levelsQuery } from "./catalogApi";
+import { LevelModal, type LevelValues } from "./LevelModal";
+
+const EMPTY_TEXT = "В треке пока нет уровней";
+
+function EmptyLevels() {
+  return (
+    <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={EMPTY_TEXT} />
+  );
+}
+
+const READ_ONLY_COLUMNS: TableColumnsType<CareerLevel> = [
+  { title: "Название", dataIndex: "name" },
+  ...entryColumns<CareerLevel>(),
+];
+
+/** The saved levels of a track in track order, for reading. */
+export function LevelsTable({ track }: { track: CareerTrack }) {
+  const { data, error, isFetching, refetch } = useQuery(levelsQuery(track.id));
+
+  return (
+    <>
+      {error && (
+        <ErrorAlert
+          title="Не удалось загрузить уровни"
+          error={error}
+          onRetry={() => void refetch()}
+        />
+      )}
+      <Table<CareerLevel>
+        rowKey="id"
+        columns={READ_ONLY_COLUMNS}
+        dataSource={data?.items}
+        loading={isFetching}
+        pagination={false}
+        scroll={{ x: "max-content" }}
+        locale={{ emptyText: <EmptyLevels /> }}
+      />
+    </>
+  );
+}
+
+/** A level added in the track dialog and saved with the track; the key stands for it in the order until it is saved. */
+export interface PendingLevel {
+  key: string;
+  values: LevelValues;
+}
+
+/** A row of the track dialog's level list: a saved level, keyed by its id, or a pending one. */
+export interface LevelRow {
+  key: string;
+  name: string;
+  level?: CareerLevel;
+  pending?: PendingLevel;
+}
+
+/**
+ * The saved levels in track order followed by the pending ones, rearranged by `order`, the row keys as the user last
+ * arranged them; rows the order does not name yet keep their place after the named ones.
+ */
+export function arrangeLevels(
+  saved: readonly CareerLevel[],
+  pending: readonly PendingLevel[],
+  order: readonly string[] | undefined,
+): LevelRow[] {
+  const rows: LevelRow[] = [
+    ...saved.map((level) => ({ key: level.id, name: level.name, level })),
+    ...pending.map((item) => ({
+      key: item.key,
+      name: item.values.name,
+      pending: item,
+    })),
+  ];
+  if (!order) return rows;
+  const rank = (row: LevelRow) => {
+    const index = order.indexOf(row.key);
+    return index === -1 ? order.length : index;
+  };
+  return rows.sort((left, right) => rank(left) - rank(right));
+}
+
+const restrictToVerticalAxis: Modifier = ({ transform }) => ({
+  ...transform,
+  x: 0,
+});
+
+const screenReaderInstructions: ScreenReaderInstructions = {
+  draggable:
+    "Чтобы взять уровень, нажмите пробел или Enter. Перемещайте его стрелками вверх и вниз, отпустите пробелом или Enter, Escape — отмена",
+};
+
+/** What the screen reader hears while a level is moved, by name and by place from 1, in the order before the move. */
+export function levelAnnouncements(rows: readonly LevelRow[]): Announcements {
+  const position = (id: UniqueIdentifier) =>
+    rows.findIndex((row) => row.key === id) + 1;
+  const name = (id: UniqueIdentifier) =>
+    rows.find((row) => row.key === id)?.name ?? "";
+  const total = rows.length;
+  return {
+    onDragStart: ({ active }) =>
+      `Взят уровень «${name(active.id)}», позиция ${position(active.id)} из ${total}`,
+    onDragOver: ({ active, over }) =>
+      over
+        ? `Уровень «${name(active.id)}» на позиции ${position(over.id)} из ${total}`
+        : undefined,
+    onDragEnd: ({ active, over }) =>
+      over
+        ? `Уровень «${name(active.id)}» перемещён на позицию ${position(over.id)} из ${total}`
+        : undefined,
+    onDragCancel: ({ active }) =>
+      `Перемещение отменено. Уровень «${name(active.id)}» остался на позиции ${position(active.id)}`,
+  };
+}
+
+/** The row keys after a level was dropped onto another's place; null when it was dropped where it was or nowhere. */
+export function movedOrder(
+  rows: readonly LevelRow[],
+  { active, over }: Pick<DragEndEvent, "active" | "over">,
+): string[] | null {
+  const keys = rows.map((row) => row.key);
+  if (!over || active.id === over.id) return null;
+  return arrayMove(
+    keys,
+    keys.indexOf(String(active.id)),
+    keys.indexOf(String(over.id)),
+  );
+}
+
+type Handle = Pick<
+  ReturnType<typeof useSortable>,
+  "attributes" | "listeners" | "setActivatorNodeRef"
+>;
+
+const HandleContext = createContext<Handle | null>(null);
+
+type RowProps = HTMLAttributes<HTMLTableRowElement> & {
+  "data-row-key"?: string;
+};
+
+/** A table row that can be moved by its handle; the placeholder row of an empty table has no key and stays a plain row. */
+function SortableRow(props: RowProps) {
+  const id = props["data-row-key"];
+  if (id === undefined) return <tr {...props} />;
+  return <SortableRowWithId id={id} {...props} />;
+}
+
+function SortableRowWithId({ id, ...props }: RowProps & { id: string }) {
+  const { token } = theme.useToken();
+  const {
+    attributes,
+    listeners,
+    setNodeRef,
+    setActivatorNodeRef,
+    transform,
+    transition,
+    isDragging,
+  } = useSortable({
+    id,
+    attributes: { roleDescription: "перемещаемый элемент" },
+    transition: token.motion ? undefined : null,
+  });
+  const handle = useMemo(
+    () => ({ attributes, listeners, setActivatorNodeRef }),
+    [attributes, listeners, setActivatorNodeRef],
+  );
+  const style: CSSProperties = {
+    ...props.style,
+    transform: CSS.Translate.toString(transform),
+    transition,
+    ...(isDragging ? { position: "relative", zIndex: 1 } : {}),
+  };
+
+  return (
+    <HandleContext.Provider value={handle}>
+      <tr {...props} ref={setNodeRef} style={style} />
+    </HandleContext.Provider>
+  );
+}
+
+function DragHandle({ name }: { name: string }) {
+  const handle = useContext(HandleContext);
+  return (
+    <Button
+      type="text"
+      size="small"
+      icon={<HolderOutlined />}
+      aria-label={`Перетащить уровень «${name}»`}
+      ref={handle?.setActivatorNodeRef}
+      {...handle?.attributes}
+      {...handle?.listeners}
+    />
+  );
+}
+
+interface TrackLevelsProps {
+  /** The track as saved; omitted while it is not saved yet. */
+  track?: CareerTrack;
+  rows: readonly LevelRow[];
+  isLoading: boolean;
+  error: unknown;
+  onRetry: () => void;
+  pending: readonly PendingLevel[];
+  onPendingChange: (pending: PendingLevel[]) => void;
+  onOrderChange: (order: string[]) => void;
+}
+
+/**
+ * The levels of the track dialog, saved and pending, from the most junior: pending ones are added, renamed and removed
+ * before «Сохранить», saved ones take their actions at once, and every row is moved by its handle, also from the keyboard.
+ */
+export function TrackLevels({
+  track,
+  rows,
+  isLoading,
+  error,
+  onRetry,
+  pending,
+  onPendingChange,
+  onOrderChange,
+}: TrackLevelsProps) {
+  const { token } = theme.useToken();
+  const [dialog, setDialog] = useState<string | null>(null);
+  const sensors = useSensors(
+    useSensor(PointerSensor),
+    useSensor(KeyboardSensor, {
+      coordinateGetter: sortableKeyboardCoordinates,
+    }),
+  );
+  const edited = rows.find((row) => row.key === dialog);
+  const columns: TableColumnsType<LevelRow> = [
+    {
+      key: "handle",
+      width: token.controlHeight,
+      render: (_, row) => <DragHandle name={row.name} />,
+    },
+    { title: "Название", dataIndex: "name" },
+    {
+      title: "Статус",
+      key: "status",
+      render: (_, row) =>
+        row.level && <CatalogStatusTag status={row.level.status} />,
+    },
+    {
+      title: "Действия",
+      key: "actions",
+      render: (_, row) =>
+        row.level ? (
+          <EntryActions
+            segment="levels"
+            entry={row.level}
+            unitId={track?.ownerOrgUnitId}
+            onEdit={() => setDialog(row.key)}
+          />
+        ) : (
+          <Space size={0}>
+            <Button type="link" size="small" onClick={() => setDialog(row.key)}>
+              Изменить
+            </Button>
+            <Button
+              type="link"
+              size="small"
+              danger
+              onClick={() =>
+                onPendingChange(pending.filter((item) => item.key !== row.key))
+              }
+            >
+              Удалить
+            </Button>
+          </Space>
+        ),
+    },
+  ];
+
+  function collect(values: LevelValues) {
+    onPendingChange(
+      dialog === "new"
+        ? [...pending, { key: crypto.randomUUID(), values }]
+        : pending.map((item) =>
+            item.key === dialog ? { ...item, values } : item,
+          ),
+    );
+  }
+
+  return (
+    <Space orientation="vertical" size="small" style={{ display: "flex" }}>
+      <Typography.Text type="secondary">
+        Уровни идут от младшего к старшему. Перетащите строку, чтобы изменить
+        порядок
+      </Typography.Text>
+      {error != null && (
+        <ErrorAlert
+          title="Не удалось загрузить уровни"
+          error={error}
+          onRetry={onRetry}
+        />
+      )}
+      <DndContext
+        sensors={sensors}
+        collisionDetection={closestCenter}
+        modifiers={[restrictToVerticalAxis]}
+        accessibility={{
+          announcements: levelAnnouncements(rows),
+          screenReaderInstructions,
+        }}
+        onDragEnd={(event) => {
+          const order = movedOrder(rows, event);
+          if (order) onOrderChange(order);
+        }}
+      >
+        <SortableContext
+          items={rows.map((row) => row.key)}
+          strategy={verticalListSortingStrategy}
+        >
+          <Table<LevelRow>
+            rowKey="key"
+            components={{ body: { row: SortableRow } }}
+            columns={columns}
+            dataSource={[...rows]}
+            loading={isLoading}
+            pagination={false}
+            size="small"
+            scroll={{ x: "max-content" }}
+            locale={{ emptyText: <EmptyLevels /> }}
+          />
+        </SortableContext>
+      </DndContext>
+      <Flex>
+        <Button onClick={() => setDialog("new")}>Добавить уровень</Button>
+      </Flex>
+      {edited?.level && (
+        <LevelModal level={edited.level} onClose={() => setDialog(null)} />
+      )}
+      {(dialog === "new" || edited?.pending) && (
+        <LevelModal
+          draft={edited?.pending?.values}
+          onCollect={collect}
+          onClose={() => setDialog(null)}
+        />
+      )}
+    </Space>
+  );
+}
diff --git a/web/src/features/career/TrackModal.test.tsx b/web/src/features/career/TrackModal.test.tsx
