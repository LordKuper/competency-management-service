+import { render, screen, waitFor, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { beforeEach, describe, expect, it } from "vitest";
+import { queryClient } from "../../api/queryClient";
+import { Providers } from "../../app/Providers";
+import { fakeApi } from "../../test/fakeApi";
+import { LONG_FLOW_TIMEOUT } from "../../test/timeouts";
+import { CompetencyModal } from "./CompetencyModal";
+import type { Competency } from "./catalogApi";
+
+const page = (items: object[]) => ({
+  items,
+  total: items.length,
+  page: 1,
+  pageSize: 200,
+});
+
+const BASE_SCALE = {
+  id: "base",
+  name: "Базовая 0–4",
+  points: [],
+  isDefault: true,
+  status: "Active",
+  version: 1,
+};
+const OTHER_SCALE = {
+  ...BASE_SCALE,
+  id: "other",
+  name: "Расширенная",
+  isDefault: false,
+};
+
+const CATEGORY = {
+  id: "category",
+  name: "Профессиональные",
+  status: "Active",
+  version: 1,
+};
+
+const EXISTING: Competency = {
+  id: "competency",
+  name: "Проектирование",
+  description: null,
+  categoryId: CATEGORY.id,
+  directionId: null,
+  type: "Profile",
+  scaleId: OTHER_SCALE.id,
+  status: "Active",
+  createdAt: "2026-10-01T00:00:00Z",
+  versionNumber: 2,
+  version: 7,
+};
+
+function serve() {
+  fakeApi.on("GET /api/v1/auth/me", () =>
+    Response.json({
+      id: "account",
+      email: "admin@test.local",
+      role: "GlobalAdmin",
+    }),
+  );
+  fakeApi.on("GET /api/v1/career/me", () =>
+    Response.json({ headedUnits: [], hrUnits: [] }),
+  );
+  fakeApi.on("GET /api/v1/career/categories", () =>
+    Response.json(page([CATEGORY])),
+  );
+  fakeApi.on("GET /api/v1/career/directions", () => Response.json(page([])));
+  fakeApi.on("GET /api/v1/career/scales", () =>
+    Response.json(page([BASE_SCALE, OTHER_SCALE])),
+  );
+}
+
+function open(competency?: Competency) {
+  serve();
+  render(
+    <Providers>
+      <CompetencyModal competency={competency} onClose={() => undefined} />
+    </Providers>,
+  );
+  return userEvent.setup();
+}
+
+async function choose(
+  user: ReturnType<typeof userEvent.setup>,
+  field: string,
+  option: string,
+) {
+  await user.click(screen.getByRole("combobox", { name: field }));
+  await user.click(
+    await screen.findByText(option, {
+      selector: ".ant-select-item-option-content",
+    }),
+  );
+}
+
+async function fillRequiredFields(user: ReturnType<typeof userEvent.setup>) {
+  await user.type(await screen.findByLabelText("Название"), "Проектирование");
+  await choose(user, "Категория", CATEGORY.name);
+  await choose(user, "Тип", "Профильная");
+}
+
+beforeEach(() => {
+  queryClient.clear();
+});
+
+describe("scale of a new competency (AC-22)", {
+  timeout: LONG_FLOW_TIMEOUT,
+}, () => {
+  it("starts with the default scale, which a save sends", async () => {
+    fakeApi.on("POST /api/v1/career/competencies", () =>
+      Response.json({ ...EXISTING, version: 1 }),
+    );
+    const user = open();
+    await fillRequiredFields(user);
+    const scale = screen.getByRole("combobox", { name: "Шкала" });
+    await waitFor(() =>
+      expect(
+        within(scale.closest(".ant-select") as HTMLElement).getByText(
+          BASE_SCALE.name,
+        ),
+      ).toBeInTheDocument(),
+    );
+
+    await user.click(screen.getByRole("button", { name: "Сохранить" }));
+
+    await waitFor(() =>
+      expect(fakeApi.calls("POST /api/v1/career/competencies")).toHaveLength(1),
+    );
+    expect(
+      await fakeApi.calls("POST /api/v1/career/competencies")[0]?.json(),
+    ).toMatchObject({ scaleId: BASE_SCALE.id, type: "Profile" });
+  });
+
+  it("keeps the scale the user picks instead of the default", async () => {
+    fakeApi.on("POST /api/v1/career/competencies", () =>
+      Response.json({ ...EXISTING, version: 1 }),
+    );
+    const user = open();
+    await fillRequiredFields(user);
+    await waitFor(() =>
+      expect(
+        within(
+          screen
+            .getByRole("combobox", { name: "Шкала" })
+            .closest(".ant-select") as HTMLElement,
+        ).getByText(BASE_SCALE.name),
+      ).toBeInTheDocument(),
+    );
+
+    await choose(user, "Шкала", OTHER_SCALE.name);
+    await user.click(screen.getByRole("button", { name: "Сохранить" }));
+
+    await waitFor(() =>
+      expect(fakeApi.calls("POST /api/v1/career/competencies")).toHaveLength(1),
+    );
+    expect(
+      await fakeApi.calls("POST /api/v1/career/competencies")[0]?.json(),
+    ).toMatchObject({ scaleId: OTHER_SCALE.id });
+  });
+
+  it("leaves the scale of an existing competency alone and saves against its version", async () => {
+    fakeApi.on("PUT /api/v1/career/competencies/competency", () =>
+      Response.json({ ...EXISTING, version: 8, versionNumber: 3 }),
+    );
+    const user = open(EXISTING);
+    await screen.findByDisplayValue("Проектирование");
+    await waitFor(() =>
+      expect(
+        within(
+          screen
+            .getByRole("combobox", { name: "Шкала" })
+            .closest(".ant-select") as HTMLElement,
+        ).getByText(OTHER_SCALE.name),
+      ).toBeInTheDocument(),
+    );
+
+    await user.click(screen.getByRole("button", { name: "Сохранить" }));
+
+    await waitFor(() =>
+      expect(
+        fakeApi.calls("PUT /api/v1/career/competencies/competency"),
+      ).toHaveLength(1),
+    );
+    const call = fakeApi.calls("PUT /api/v1/career/competencies/competency")[0];
+    expect(call?.headers.get("If-Match")).toBe('"7"');
+    expect(await call?.json()).toMatchObject({ scaleId: OTHER_SCALE.id });
+  });
+});
diff --git a/web/src/features/career/CompetencyModal.tsx b/web/src/features/career/CompetencyModal.tsx
new file mode 100644
index 0000000..a6dd620
--- /dev/null
+++ b/web/src/features/career/CompetencyModal.tsx
@@ -0,0 +1,201 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { Form, Input, Select } from "antd";
+import { useEffect } from "react";
+import { api } from "../../api/client";
+import { ifMatchOf } from "../../api/ifMatch";
+import { unwrap } from "../../api/unwrap";
+import { useEditBase } from "../../app/useEditBase";
+import { useFormSubmit } from "../../app/useFormSubmit";
+import { CatalogModal, FormActions } from "./CatalogModal";
+import { CategorySelect } from "./CategorySelect";
+import {
+  type Competency,
+  type CompetencyType,
+  directionsQuery,
+  invalidateCatalogs,
+  scalesQuery,
+  usableEntries,
+} from "./catalogApi";
+
+const NAME_MAX_LENGTH = 200;
+const FIELDS = [
+  "name",
+  "description",
+  "categoryId",
+  "directionId",
+  "type",
+  "scaleId",
+] as const;
+
+export const COMPETENCY_TYPES: Record<CompetencyType, string> = {
+  Critical: "Критическая",
+  Profile: "Профильная",
+  Additional: "Дополнительная",
+};
+
+const TYPE_OPTIONS = Object.entries(COMPETENCY_TYPES).map(([value, label]) => ({
+  value: value as CompetencyType,
+  label,
+}));
+
+interface CompetencyValues {
+  name: string;
+  description?: string | null;
+  categoryId: string;
+  directionId?: string | null;
+  type: CompetencyType;
+  scaleId?: string;
+}
+
+interface CompetencyModalProps {
+  /** Competency being edited as the cache holds it now; omitted when one is created. */
+  competency?: Competency;
+  onClose: () => void;
+}
+
+/** Dialog that creates a competency or edits one; every saved change becomes a new version. */
+export function CompetencyModal({
+  competency: latest,
+  onClose,
+}: CompetencyModalProps) {
+  const queryClient = useQueryClient();
+  const { base: competency, noteSaveFailure } = useEditBase(latest);
+  const save = useMutation({
+    mutationFn: async (values: CompetencyValues) => {
+      const body = {
+        name: values.name,
+        description: values.description?.trim() || null,
+        categoryId: values.categoryId,
+        directionId: values.directionId ?? null,
+        type: values.type,
+        scaleId: values.scaleId ?? null,
+      };
+      return unwrap(
+        competency
+          ? await api.PUT("/api/v1/career/competencies/{id}", {
+              params: {
+                path: { id: competency.id },
+                header: { "If-Match": ifMatchOf(competency.version) },
+              },
+              body,
+            })
+          : await api.POST("/api/v1/career/competencies", { body }),
+      );
+    },
+    onSuccess: onClose,
+    onError: noteSaveFailure,
+    onSettled: () => invalidateCatalogs(queryClient),
+  });
+
+  return (
+    <CatalogModal
+      title={competency ? "Изменение компетенции" : "Новая компетенция"}
+      error={save.error}
+      fields={FIELDS}
+      onClose={onClose}
+    >
+      <CompetencyForm
+        key={competency?.version}
+        competency={competency}
+        onSubmit={(values) => save.mutateAsync(values)}
+        onCancel={onClose}
+      />
+    </CatalogModal>
+  );
+}
+
+interface CompetencyFormProps {
+  competency?: Competency;
+  onSubmit: (values: CompetencyValues) => Promise<unknown>;
+  onCancel: () => void;
+}
+
+function CompetencyForm({
+  competency,
+  onSubmit,
+  onCancel,
+}: CompetencyFormProps) {
+  const [form] = Form.useForm<CompetencyValues>();
+  const { isSubmitting, submit } = useFormSubmit(form, onSubmit);
+  const directions = useQuery(directionsQuery());
+  const scales = useQuery(scalesQuery());
+  const defaultScaleId = scales.data?.items.find(
+    (scale) => scale.isDefault,
+  )?.id;
+
+  // The scales arrive after the form opens; a new competency starts with the default one unless the user chose first.
+  useEffect(() => {
+    if (!competency && defaultScaleId && !form.getFieldValue("scaleId")) {
+      form.setFieldValue("scaleId", defaultScaleId);
+    }
+  }, [competency, defaultScaleId, form]);
+
+  return (
+    <Form
+      form={form}
+      name="competency"
+      layout="vertical"
+      initialValues={{
+        name: competency?.name ?? "",
+        description: competency?.description ?? "",
+        categoryId: competency?.categoryId,
+        directionId: competency?.directionId ?? undefined,
+        type: competency?.type,
+        scaleId: competency?.scaleId,
+      }}
+      onFinish={submit}
+    >
+      <Form.Item
+        name="name"
+        label="Название"
+        rules={[
+          { required: true, whitespace: true, message: "Укажите название" },
+          {
+            max: NAME_MAX_LENGTH,
+            message: `Не длиннее ${NAME_MAX_LENGTH} символов`,
+          },
+        ]}
+      >
+        <Input autoComplete="off" />
+      </Form.Item>
+      <Form.Item name="description" label="Описание">
+        <Input.TextArea autoSize={{ minRows: 3 }} />
+      </Form.Item>
+      <Form.Item
+        name="categoryId"
+        label="Категория"
+        rules={[{ required: true }]}
+      >
+        <CategorySelect />
+      </Form.Item>
+      <Form.Item name="directionId" label="Направление">
+        <Select
+          allowClear
+          placeholder="Общая"
+          showSearch={{ optionFilterProp: "label" }}
+          loading={directions.isFetching}
+          options={usableEntries(
+            directions.data?.items,
+            competency?.directionId,
+          ).map((direction) => ({
+            value: direction.id,
+            label: direction.name,
+          }))}
+        />
+      </Form.Item>
+      <Form.Item name="type" label="Тип" rules={[{ required: true }]}>
+        <Select options={TYPE_OPTIONS} />
+      </Form.Item>
+      <Form.Item name="scaleId" label="Шкала" rules={[{ required: true }]}>
+        <Select
+          showSearch={{ optionFilterProp: "label" }}
+          loading={scales.isFetching}
+          options={usableEntries(scales.data?.items, competency?.scaleId).map(
+            (scale) => ({ value: scale.id, label: scale.name }),
+          )}
+        />
+      </Form.Item>
+      <FormActions isSubmitting={isSubmitting} onCancel={onCancel} />
+    </Form>
+  );
+}
