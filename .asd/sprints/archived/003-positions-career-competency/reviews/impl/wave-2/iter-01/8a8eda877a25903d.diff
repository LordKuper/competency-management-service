+using Competency.Platform;
+
+namespace Competency.CareerFramework;
+
+/// <summary>
+/// A scale that competencies are assessed on, with its points. The points are stored on the scale itself, so changing them changes
+/// the scale's version and is journaled with it. Exactly one scale is the default, which a new competency gets unless it names another.
+/// </summary>
+[Audited]
+internal sealed class CompetencyScale : CatalogEntry
+{
+    public const int MinPoints = 2;
+    public const int MaxScore = 100;
+    public const int LabelMaxLength = 500;
+
+    /// <summary>
+    /// The points in ascending order of score.
+    /// </summary>
+    [Audited]
+    public List<ScalePoint> Points { get; set; } = [];
+
+    [Audited]
+    public bool IsDefault { get; set; }
+}
diff --git a/src/Competency.CareerFramework/CompetencyScaleEndpoints.cs b/src/Competency.CareerFramework/CompetencyScaleEndpoints.cs
new file mode 100644
index 0000000..66d0f77
--- /dev/null
+++ b/src/Competency.CareerFramework/CompetencyScaleEndpoints.cs
@@ -0,0 +1,205 @@
+using Competency.Platform;
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Http.HttpResults;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.Routing;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.CareerFramework;
+
+/// <summary>
+/// The API of competency scales. Scale names are unique across the catalogue. A scale a published matrix version has used never changes,
+/// so the version keeps meaning what it meant; the catalogue lock, which publication also takes, keeps the check and a publication apart.
+/// Exactly one scale is the default; making another active scale the default takes the flag from the previous one. A scale other than
+/// the default that no competency, version in a competency's history or matrix version is on can be deleted.
+/// </summary>
+internal static class CompetencyScaleEndpoints
+{
+    private const string Route = "/api/v1/career/scales";
+    private const string PublishedMessage = "Используется в опубликованной матрице — изменить нельзя";
+    private const string InactiveDefaultMessage = "По умолчанию может быть только действующая шкала";
+    private const string DefaultDeletionMessage = "Шкалу по умолчанию удалить нельзя";
+    private const string InUseMessage = "Шкалу используют компетенции или матрицы — удалить нельзя";
+
+    internal static readonly CatalogKind<CompetencyScale, CompetencyScaleResponse> Kind = new("CompetencyScale", (scale, _) => CompetencyScaleResponse.From(scale));
+
+    public static void Map(IEndpointRouteBuilder endpoints)
+    {
+        var group = endpoints.MapCatalogGroup(Route);
+        group.MapGet(string.Empty, ListAsync).WithName("ListCompetencyScales");
+        group.MapPost(string.Empty, CreateAsync).WithName("CreateCompetencyScale").ProducesETag()
+            .ProducesProblem(StatusCodes.Status403Forbidden)
+            .ProducesProblem(StatusCodes.Status409Conflict);
+        group.MapPut("/{id:guid}", UpdateAsync).WithName("UpdateCompetencyScale").ProducesETag()
+            .ProducesProblem(StatusCodes.Status403Forbidden)
+            .ProducesProblem(StatusCodes.Status404NotFound)
+            .ProducesProblem(StatusCodes.Status409Conflict);
+        group.MapPost("/{id:guid}/make-default", MakeDefaultAsync).WithName("MakeCompetencyScaleDefault").ProducesETag()
+            .ProducesProblem(StatusCodes.Status403Forbidden)
+            .ProducesProblem(StatusCodes.Status404NotFound)
+            .ProducesProblem(StatusCodes.Status409Conflict);
+        group.MapEntryEndpoints(Kind);
+        group.MapDeleteEntry(Kind, InUseAsync);
+    }
+
+    private static async Task<string?> InUseAsync(
+        CompetencyScale scale,
+        DeletionBlockers blockers,
+        AppDbContext context,
+        CatalogStore store,
+        CancellationToken cancellationToken)
+    {
+        if (scale.IsDefault)
+        {
+            return DefaultDeletionMessage;
+        }
+
+        var id = scale.Id;
+        var competencies = context.Set<CareerCompetency>();
+        await blockers.AddAsync(competencies.Where(competency => competency.ScaleId == id), DeletionBlockerKind.Competency);
+        await blockers.AddAsync(
+            competencies.Where(competency => competency.ScaleId != id
+                && context.Set<CompetencyVersion>().Any(version => version.CompetencyId == competency.Id && version.ScaleId == id)),
+            DeletionBlockerKind.CompetencyVersion);
+        await blockers.AddMatricesAsync(context.Set<CompetencyMatrix>()
+            .Where(matrix => context.Set<MatrixVersion>().Any(version => version.MatrixId == matrix.Id && version.ScaleId == id)));
+        return blockers.Any ? InUseMessage : null;
+    }
+
+    private static Task<Results<Ok<PageResponse<CompetencyScaleResponse>>, ValidationProblem>> ListAsync(
+        [AsParameters] CatalogListQuery query,
+        [FromQuery(Name = "isDefault")] bool? isDefault,
+        AppDbContext context,
+        CatalogStore store,
+        CancellationToken cancellationToken) =>
+        CatalogEndpoints.ListAsync(
+            context.Set<CompetencyScale>().WhereIf(isDefault is not null, scale => scale.IsDefault == isDefault),
+            query,
+            Kind,
+            store,
+            cancellationToken);
+
+    private static async Task<Results<Created<CompetencyScaleResponse>, ValidationProblem, ProblemHttpResult>> CreateAsync(
+        CompetencyScaleRequest request,
+        AppDbContext context,
+        CatalogStore store,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        var errors = request.Validate();
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        await using var transaction = await store.BeginWriteAsync(cancellationToken);
+        var viewer = await store.ViewerAsync(cancellationToken);
+        if (viewer.StatusOfNew(unitId: null) is not { } status)
+        {
+            return Rejection.Forbidden();
+        }
+
+        var scale = new CompetencyScale
+        {
+            Name = request.TrimmedName(),
+            Points = request.StoredPoints(),
+            Status = status,
+            AuthorId = viewer.UserId,
+        };
+        if (await CatalogEndpoints.NameProblemAsync(scale, Kind, store, cancellationToken) is { } taken)
+        {
+            return taken;
+        }
+
+        context.Add(scale);
+        var created = await CatalogEndpoints.CommitAsync(scale, Kind, store, transaction, response, cancellationToken);
+        return TypedResults.Created($"{Route}/{scale.Id}", created);
+    }
+
+    private static async Task<Results<Ok<CompetencyScaleResponse>, NotFound, ValidationProblem, ProblemHttpResult>> UpdateAsync(
+        Guid id,
+        CompetencyScaleRequest request,
+        IfMatch ifMatch,
+        AppDbContext context,
+        CatalogStore store,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        var errors = request.Validate();
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        await using var transaction = await store.BeginWriteAsync(cancellationToken);
+        var viewer = await store.ViewerAsync(cancellationToken);
+        if (await store.FindVisibleAsync<CompetencyScale>(id, viewer, cancellationToken) is not { } scale)
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (!viewer.CanEdit(scale))
+        {
+            return Rejection.Forbidden();
+        }
+
+        if (await context.Set<MatrixVersion>().AnyAsync(
+                version => version.ScaleId == scale.Id
+                    && (version.Status == MatrixVersionStatus.Published || version.Status == MatrixVersionStatus.Archived),
+                cancellationToken))
+        {
+            return Rejection.Conflict(PublishedMessage);
+        }
+
+        ifMatch.ApplyTo(context, scale);
+        scale.Name = request.TrimmedName();
+        scale.Points = request.StoredPoints();
+        if (await CatalogEndpoints.NameProblemAsync(scale, Kind, store, cancellationToken) is { } taken)
+        {
+            return taken;
+        }
+
+        return TypedResults.Ok(await CatalogEndpoints.CommitAsync(scale, Kind, store, transaction, response, cancellationToken));
+    }
+
+    /// <summary>
+    /// Makes an active scale the default. The previous default loses the flag in a save of its own first, so the index that allows one
+    /// default never sees two.
+    /// </summary>
+    private static async Task<Results<Ok<CompetencyScaleResponse>, NotFound, ProblemHttpResult>> MakeDefaultAsync(
+        Guid id,
+        IfMatch ifMatch,
+        AppDbContext context,
+        CatalogStore store,
+        HttpResponse response,
+        CancellationToken cancellationToken)
+    {
+        await using var transaction = await store.BeginWriteAsync(cancellationToken);
+        var viewer = await store.ViewerAsync(cancellationToken);
+        if (await store.FindVisibleAsync<CompetencyScale>(id, viewer, cancellationToken) is not { } scale)
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (!viewer.CanManage(scale))
+        {
+            return Rejection.Forbidden();
+        }
+
+        if (scale.Status != CatalogStatus.Active)
+        {
+            return Rejection.Conflict(InactiveDefaultMessage);
+        }
+
+        if (await context.Set<CompetencyScale>().FirstOrDefaultAsync(other => other.IsDefault && other.Id != id, cancellationToken) is { } previous)
+        {
+            previous.IsDefault = false;
+            await context.SaveChangesAsync(cancellationToken);
+        }
+
+        ifMatch.ApplyTo(context, scale);
+        scale.IsDefault = true;
+        return TypedResults.Ok(await CatalogEndpoints.CommitAsync(scale, Kind, store, transaction, response, cancellationToken));
+    }
+}
diff --git a/src/Competency.CareerFramework/CompetencyScaleRequest.cs b/src/Competency.CareerFramework/CompetencyScaleRequest.cs
new file mode 100644
index 0000000..e6a10d2
--- /dev/null
+++ b/src/Competency.CareerFramework/CompetencyScaleRequest.cs
@@ -0,0 +1,47 @@
+namespace Competency.CareerFramework;
+
+/// <summary>
+/// The name and points of a new scale or of a change of one; the points replace the scale's points as a whole.
+/// </summary>
+internal record CompetencyScaleRequest : CatalogNameRequest
+{
+    private const string PointsField = "points";
+
+    public required IReadOnlyList<ScalePoint> Points { get; init; }
+
+    /// <inheritdoc />
+    public override Dictionary<string, string[]> Validate()
+    {
+        var errors = base.Validate();
+        var points = Points ?? [];
+        if (points.Count < CompetencyScale.MinPoints)
+        {
+            errors[PointsField] = [$"Укажите не меньше {CompetencyScale.MinPoints} баллов"];
+        }
+        else if (points.Any(point => point is null || point.Score is < 0 or > CompetencyScale.MaxScore))
+        {
+            errors[PointsField] = [$"Балл — целое число от 0 до {CompetencyScale.MaxScore}"];
+        }
+        else if (points.DistinctBy(point => point.Score).Count() != points.Count)
+        {
+            errors[PointsField] = ["Баллы не должны повторяться"];
+        }
+        else if (points.Any(point => string.IsNullOrWhiteSpace(point.Label)))
+        {
+            errors[PointsField] = ["Укажите значение каждого балла"];
+        }
+        else if (points.Any(point => point.Label.Trim().Length > CompetencyScale.LabelMaxLength))
+        {
+            errors[PointsField] = [$"Значение балла — не длиннее {CompetencyScale.LabelMaxLength} символов"];
+        }
+
+        return errors;
+    }
+
+    /// <summary>
+    /// The points as stored: values trimmed, in ascending order of score; call after <see cref="Validate"/> succeeded.
+    /// </summary>
+    /// <returns>The points.</returns>
+    public List<ScalePoint> StoredPoints() =>
+        [.. Points.Select(point => new ScalePoint(point.Score, point.Label.Trim())).OrderBy(point => point.Score)];
+}
