+        mismatch.Should().BeEmpty();
+    }
+
+    private static async Task<List<Approval>> ApprovalsAsync(ApiClient client, string query = "") =>
+        [.. (await client.GetAsync($"/api/v1/career/approvals?{query}")).Expect(HttpStatusCode.OK).Json!.AsArray()
