diff --git a/src/Competency.UserManagement/IUserDirectory.cs b/src/Competency.UserManagement/IUserDirectory.cs
new file mode 100644
index 0000000..872a659
--- /dev/null
+++ b/src/Competency.UserManagement/IUserDirectory.cs
@@ -0,0 +1,24 @@
+namespace Competency.UserManagement;
+
+/// <summary>
+/// Access to accounts for other modules, which never see the module's entities.
+/// Implementations are scoped to a request, because they share its database context.
+/// </summary>
+public interface IUserDirectory
+{
+    /// <summary>
+    /// Finds an account.
+    /// </summary>
+    /// <param name="userId">The account identifier.</param>
+    /// <param name="cancellationToken">Cancels the lookup.</param>
+    /// <returns>The account's status, or <see langword="null"/> when no such account exists.</returns>
+    Task<UserStatus?> FindAsync(Guid userId, CancellationToken cancellationToken = default);
+
+    /// <summary>
+    /// Finds the accounts bound to many employees in one query.
+    /// </summary>
+    /// <param name="employeeIds">The employee identifiers.</param>
+    /// <param name="cancellationToken">Cancels the lookup.</param>
+    /// <returns>The status of each bound account, by employee identifier; employees without an account are absent.</returns>
+    Task<IReadOnlyDictionary<Guid, UserStatus>> FindByEmployeeIdsAsync(IReadOnlyCollection<Guid> employeeIds, CancellationToken cancellationToken = default);
+}
diff --git a/src/Competency.UserManagement/UserDirectory.cs b/src/Competency.UserManagement/UserDirectory.cs
new file mode 100644
index 0000000..c3ed9bb
--- /dev/null
+++ b/src/Competency.UserManagement/UserDirectory.cs
@@ -0,0 +1,34 @@
+using System.Linq.Expressions;
+using Competency.Platform;
+using Microsoft.EntityFrameworkCore;
+
+namespace Competency.UserManagement;
+
+/// <summary>
+/// Answers <see cref="IUserDirectory"/> lookups straight from the account table.
+/// </summary>
+internal sealed class UserDirectory(AppDbContext context) : IUserDirectory
+{
+    private static readonly Expression<Func<AppUser, UserStatus>> StatusProjection = user => new UserStatus(
+        user.Id, user.Email!, user.EmployeeId, user.IsBlocked, user.PasswordHash != null);
+
+    public Task<UserStatus?> FindAsync(Guid userId, CancellationToken cancellationToken = default) => context
+        .Set<AppUser>()
+        .AsNoTracking()
+        .Where(user => user.Id == userId)
+        .Select(StatusProjection)
+        .FirstOrDefaultAsync(cancellationToken);
+
+    public async Task<IReadOnlyDictionary<Guid, UserStatus>> FindByEmployeeIdsAsync(
+        IReadOnlyCollection<Guid> employeeIds,
+        CancellationToken cancellationToken = default)
+    {
+        var ids = employeeIds.ToArray();
+        return await context
+            .Set<AppUser>()
+            .AsNoTracking()
+            .Where(user => user.EmployeeId != null && ids.Contains(user.EmployeeId.Value))
+            .Select(StatusProjection)
+            .ToDictionaryAsync(status => status.EmployeeId!.Value, cancellationToken);
+    }
+}
