{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.EntityFrameworkCore.Database.Transaction": "None",
      "Microsoft.EntityFrameworkCore.Query": "None",
      "Microsoft.EntityFrameworkCore.Update": "None"
    },
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'",
        "UseUtcTimestamp": true
      }
    }
  },
  "Authentication": {
    "Cookie": {
      "Name": ".competency.auth",
      "SecurePolicy": "SameAsRequest",
      "ExpireTimeSpan": "08:00:00"
    }
  },
  "Identity": {
    "Password": {
      "RequiredLength": 10
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpan": "00:15:00"
    }
  },
  "AccountLinks": {
    "InvitationLifetime": "7.00:00:00",
    "PasswordResetLifetime": "01:00:00",
    "PasswordResetInterval": "00:05:00"
  },
  "Smtp": {
    "SecureSocketOptions": "StartTls",
    "Timeout": "00:00:15"
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "PasswordReset": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
